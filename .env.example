# Marketr — environment template.
# Copy to .env and fill in. Self-hosted: you only need DATABASE_URL,
# REDIS_URL, DATAFORSEO_*, and one LLM provider key.

# --- Database (matches docker-compose.yml defaults) ---
# Day-1 hardening (L11): NO default password ships here anymore. Generate one
# with: openssl rand -base64 32   (then set the same value in docker-compose.yml)
DATABASE_URL="postgresql://marketr:CHANGE_ME@localhost:5432/marketr?schema=public"
POSTGRES_USER="marketr"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="marketr"

# --- Queue / cache ---
REDIS_URL="redis://localhost:6379"

# --- App ---
APP_PORT="3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Auth.js v5 canonical secret (falls back to NEXTAUTH_SECRET above)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Auth providers ---
# Google OAuth (optional if you use the admin login below)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Self-hosted admin login (used by the credentials provider on /login).
# Day-1 hardening (H1): this is a full-owner account. Use a strong,
# unique password — minimum 20 characters, generated, e.g.:
#   openssl rand -base64 24
# The login is rate-limited (5 failures → 15-min lockout, doubling), but a
# weak password on an internet-exposed instance is still the fastest way in.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_min_20_chars"

# --- SEO data provider (DataForSEO) ---
# Get credentials at https://dataforseo.com — pay-as-you-go, no subscription.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- LLM provider (pick one; used by the content engine + fix agent) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OpenAI-compatible provider (used when LLM_API_KEY or OPENAI_API_KEY is set).
# Point LLM_BASE_URL at any OpenAI-style endpoint: OpenAI, a proxy, Ollama, vLLM…
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# --- Billing (hosted SaaS only; not needed for self-host) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# --- Scheduled rank checks (self-host cron) ---
# Long random string used as the bearer token for cron-triggered endpoints
# (e.g. POST /api/rankings/check, POST /api/cron/fix-agent). Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Fix agent snapshots (milestone 10) ---
# Directory for pre-change snapshots taken before scheduled fix runs
# (one JSON file per run, used by one-click revert). Defaults to .data/fix-snapshots.
# FIX_SNAPSHOT_DIR="/var/lib/marketr/fix-snapshots"

# --- Reports (milestone 12: white-label PDF reporting) ---
# Directory for generated report PDFs and brand-kit logos.
# Defaults to ./.data/reports. Needs durable storage in production (see DEPLOY.md).
# REPORT_STORAGE_DIR="/var/lib/marketr/reports"

# --- Alert hub (milestone 13: Slack / Telegram / email alerts) ---
# Public base URL used to build absolute dashboard links inside alert messages.
# MARKETR_BASE_URL="https://marketr.example.com"
# SMTP settings for alert emails (per-channel recipient is stored encrypted in
# the channel config). If SMTP_HOST is unset, email channels report a config
# error instead of sending.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Marketr Alerts <alerts@example.com>"
# Flush digests + quiet-hours holds every 15 minutes alongside the other crons:
#   curl -X POST -H "Authorization: Bearer <CRON_SECRET>" $MARKETR_BASE_URL/api/cron/alerts

# --- Site IDE / fix agent (milestone 6) ---
# AES-256-GCM key encrypting stored SFTP credentials at rest.
# Generate with: openssl rand -hex 32
# Production note: for hosted SaaS, replace this env-key scheme with a
# KMS/vault (AWS KMS, HashiCorp Vault) with key rotation.
MARKETR_CREDENTIALS_KEY=""

# --- Secrets provider (milestone 11: enterprise security) ---
# "env" (default): AES-256-GCM via MARKETR_CREDENTIALS_KEY above.
# "aws-kms": managed KMS provider (implement lib/secrets AwsKmsSecretsProvider
#   against @aws-sdk/client-kms first — currently a documented stub).
# SECRETS_PROVIDER="env"
# AWS_REGION="us-east-1"
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/…"

# --- Enterprise SSO (milestone 11) ---
# Generic OIDC — any OIDC-compliant IdP (Okta, Entra ID, Google Workspace,
# Keycloak, Authentik). The "Continue with SSO" button appears on /login only
# when these are set.
# OIDC_ISSUER="https://your-idp.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=<redacted>
# OIDC_DISPLAY_NAME="Okta"
# SAML via BoxyHQ Jackson bridge (open-source, self-hostable).
# SAML_ENABLED="true"
# BOXYHQ_SAML_ISSUER="https://jackson.your-domain.com"
# BOXYHQ_SAML_CLIENT_ID=""
# BOXYHQ_SAML_CLIENT_SECRET=<redacted>
# Domain-based auto-provisioning: SSO users whose email ends with SSO_DOMAIN
# join SSO_WORKSPACE_ID with SSO_DEFAULT_ROLE instead of a personal workspace.
# SSO_DOMAIN="acme.com"
# SSO_WORKSPACE_ID=""
# SSO_DEFAULT_ROLE="editor"   # viewer | editor | admin ("owner" is rejected —
# day-1 hardening: SSO must never mint owners)
# Auto-provisioning requires a verified email claim (email_verified=true);
# unverified addresses are ignored.

# Directory for site working copies (milestone 7). Defaults to ./.data/sites.
SITE_STORAGE_DIR=""

# Local SEO (milestone 16).
# GBP management scaffold stays OFF until the Google Business Profile API
# application is approved and credentials are configured. Keep false until then.
FEATURE_GBP_MANAGEMENT="false"

# Newsletter (milestone 19) — BYO Resend.
# Workspace Resend API keys are entered in the UI (Domains & settings) and
# stored encrypted; only the webhook signing secret goes here.
# Create a webhook in the Resend dashboard pointing at
# https://<your-domain>/api/newsletter/webhooks/resend and paste its secret:
RESEND_WEBHOOK_SECRET=""

# Studio (milestone 22) — Canva Connect (default studio) + Porkbun domains.
# Porkbun API keys are entered in the UI (Studio → Domains) and stored
# encrypted; only the Canva OAuth client goes here. Create the app at
# https://www.canva.com/developers, request the brand_template:read and
# design:content:read scopes, and set the redirect URI to
# https://<your-domain>/api/studio/canva/callback.
# NOTE: public Canva integrations may require Canva review/approval, and
# brand-template/autofill availability depends on the connected Canva plan.
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=<redacted>

# =====================================================================
# Phase 2–7 keys (all placeholders — leave unset unless you use the feature).
# Added 2026-09-25 (F6 launch-readiness audit): every env var the code
# reads must be documented here. Values below are placeholders, never real.
# =====================================================================

# --- App URLs ---
# Public base URL used for customer-facing links (physical mail bundles,
# messaging). NEXT_PUBLIC_APP_URL is the client-visible one.
#APP_URL="http://localhost:3000"
#APP_PUBLIC_URL="http://localhost:3000"
#NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Self-hosted flag consumed by connectors/MCP behavior.
#MARKETR_SELF_HOSTED="true"

# --- LLM routing (beyond the base provider keys above) ---
# Per-task model overrides for the content engine.
#LLM_MODEL_BULK="gpt-4o-mini"
#LLM_MODEL_COPY="gpt-4o-mini"
# Alternate OpenAI-compatible endpoint (proxy / gateway).
#OPENAI_BASE_URL="https://api.openai.com/v1"
# Set to "true" to force self-hosted LLM routing behavior.
#LLM_SELF_HOST="false"
# Model override for the copy benchmark script (dev only).
#BENCH_MODEL=""

# --- Approval HMAC secrets (Phase 5/6 safety) ---
# Sign per-buy approval objects (media buying) and authority approvals
# (outreach/PR). Generate each with: openssl rand -hex 32
#MARKETR_APPROVAL_SECRET=<redacted>
#AUTHORITY_APPROVAL_SECRET=<redacted>

# --- Messaging (Phase: speed-to-lead, sequences) ---
# Providers: "resend" | "smtp" for email; SMS provider per dispatcher config.
#MESSAGING_EMAIL_PROVIDER="resend"
#MESSAGING_EMAIL_FROM="Marketr <hello@example.com>"
#MESSAGING_SMS_PROVIDER=""
#MESSAGING_SMS_FROM=""
# Sender used by the calls/booking mailer.
#BOOKING_MAIL_FROM="Marketr <bookings@example.com>"

# --- Calls / call tracking (Phase: R5) ---
# Which telephony provider backs call tracking ("callrail" | "fake").
#CALLS_PROVIDER="fake"
# CallRail (native) — BYO credentials.
#CALLRAIL_PROVIDER=""
#CALLRAIL_API_KEY=<redacted>
#CALLRAIL_WEBHOOK_SECRET=<redacted>
# Shared secret gating the fake-telephony adapter (dev/test).
#FAKE_TELEPHONY_SECRET=<redacted>

# --- GBP (local SEO) ---
# GBP management scaffold stays OFF (FEATURE_GBP_MANAGEMENT="false" above)
# until the GBP API application is approved. Webhook secret for GBP webhooks.
#GBP_API_KEY=<redacted>
#MARKETR_GBP_WEBHOOK_SECRET=<redacted>

# --- Short links (Phase 5: Dub OSS, self-hosted QR/pURL) ---
#DUB_BASE_URL=""

# --- Outreach sending (Phase 6) ---
# Which partner sends outreach mail ("smartlead" | "instantly").
# Keys are BYO; stored encrypted per workspace. Only set here for local dev.
#OUTREACH_SENDING_PROVIDER="smartlead"
#SMARTLEAD_API_KEY=<redacted>
#INSTANTLY_API_KEY=<redacted>
# Resend API key for workspace mail (BYO; prefer the in-UI encrypted store).
#RESEND_API_KEY=<redacted>

# --- Cron secrets (per-surface bearer tokens) ---
# Long random strings; generate with: openssl rand -hex 32
#REMINDERS_CRON_SECRET=<redacted>

# --- Webhook hardening ---
# Dev/test only: allow unsigned webhooks. NEVER "true" in production.
#ALLOW_UNSIGNED_WEBHOOKS="false"

# --- MCP (Phase: connectors) ---
# Rate-limiter backend for the MCP server ("memory" | "redis").
#MCP_RATE_LIMITER="memory"

# --- Media safety ---
# Card rendering mode for media safety checks.
#MEDIA_CARD_MODE=""

# --- File storage ---
# Storage backend ("local" | "s3") and base directory for workspace files.
#MARKETR_STORAGE="local"
#MARKETR_STORAGE_DIR="./.data"
# S3-compatible backend (BYO bucket).
#MARKETR_S3_ENDPOINT=""
#MARKETR_S3_REGION="us-east-1"
#MARKETR_S3_BUCKET=""
#MARKETR_S3_ACCESS_KEY=<redacted>
#MARKETR_S3_SECRET_KEY=<redacted>
#MARKETR_S3_FORCE_PATH_STYLE="false"
# Per-artifact storage dirs (default under ./.data).
#AUDIO_BRIEF_STORAGE_DIR=""
#EDDM_BRIEF_STORAGE_DIR=""
#IO_BRIEF_STORAGE_DIR=""
#LAUNCH_PACKET_STORAGE_DIR=""
#SITEMAP_STORAGE_DIR=""

# --- Antivirus (upload scanning, optional) ---
#CLAMAV_HOST="localhost"
#CLAMAV_PORT="3310"

# --- Alerts: Telegram adapter ---
# Override for the Telegram Bot API base (proxies / test doubles).
#TELEGRAM_API_BASE="https://api.telegram.org"

# --- Google OAuth (connector health / skills) ---
# Distinct from the login provider above; used by connector OAuth flows.
#GOOGLE_OAUTH_CLIENT_ID=""
#GOOGLE_OAUTH_CLIENT_SECRET=<redacted>

# --- E2E / dev test doubles (never set in production) ---
#E2E_BASE_URL="http://localhost:3000"
#E2E_ADMIN_EMAIL="admin@example.com"
#E2E_EDITOR_EMAIL="editor@example.com"
#E2E_MOCK_OAUTH="true"

# --- Phase 7 flywheel keys (all placeholders) ---

# F1 reallocation: signs Standing Reallocation Approval envelopes.
# Generate with: openssl rand -hex 32
#SRA_SIGNING_SECRET=<redacted>

# F3 Test Lab: set to "1" ONLY to allow real sends from test variants
# (default: dry-run / QA only — the lab never sends for real by accident).
#TESTLAB_REAL_SEND=""

# F4 CTV: signs attribution pixel URLs. Dev default is a fixed
# "dev-only-pixel-secret" — set a real one in production.
#PIXEL_SIGNING_SECRET=<redacted>
# Public base URL used to mint absolute pixel/QR URLs (CTV).
#APP_BASE_URL="http://localhost:3000"
