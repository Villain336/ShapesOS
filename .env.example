# Marketr — environment template.
# Copy to .env and fill in. Self-hosted: you only need DATABASE_URL,
# REDIS_URL, DATAFORSEO_*, and one LLM provider key.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://marketr:marketr@localhost:5432/marketr?schema=public"
POSTGRES_USER="marketr"
POSTGRES_PASSWORD="marketr"
POSTGRES_DB="marketr"

# --- Queue / cache ---
REDIS_URL="redis://localhost:6379"

# --- App ---
APP_PORT="3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Auth.js v5 canonical secret (falls back to NEXTAUTH_SECRET above)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Auth providers ---
# Google OAuth (optional if you use the admin login below)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Self-hosted admin login (used by the credentials provider on /login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- SEO data provider (DataForSEO) ---
# Get credentials at https://dataforseo.com — pay-as-you-go, no subscription.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- LLM provider (pick one; used by the content engine + fix agent) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OpenAI-compatible provider (used when LLM_API_KEY or OPENAI_API_KEY is set).
# Point LLM_BASE_URL at any OpenAI-style endpoint: OpenAI, a proxy, Ollama, vLLM…
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# --- Billing (hosted SaaS only; not needed for self-host) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# --- Scheduled rank checks (self-host cron) ---
# Long random string used as the bearer token for cron-triggered endpoints
# (e.g. POST /api/rankings/check, POST /api/cron/fix-agent). Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Fix agent snapshots (milestone 10) ---
# Directory for pre-change snapshots taken before scheduled fix runs
# (one JSON file per run, used by one-click revert). Defaults to .data/fix-snapshots.
# FIX_SNAPSHOT_DIR="/var/lib/marketr/fix-snapshots"

# --- Reports (milestone 12: white-label PDF reporting) ---
# Directory for generated report PDFs and brand-kit logos.
# Defaults to ./.data/reports. Needs durable storage in production (see DEPLOY.md).
# REPORT_STORAGE_DIR="/var/lib/marketr/reports"

# --- Alert hub (milestone 13: Slack / Telegram / email alerts) ---
# Public base URL used to build absolute dashboard links inside alert messages.
# MARKETR_BASE_URL="https://marketr.example.com"
# SMTP settings for alert emails (per-channel recipient is stored encrypted in
# the channel config). If SMTP_HOST is unset, email channels report a config
# error instead of sending.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Marketr Alerts <alerts@example.com>"
# Flush digests + quiet-hours holds every 15 minutes alongside the other crons:
#   curl -X POST -H "Authorization: Bearer <CRON_SECRET>" $MARKETR_BASE_URL/api/cron/alerts

# --- Site IDE / fix agent (milestone 6) ---
# AES-256-GCM key encrypting stored SFTP credentials at rest.
# Generate with: openssl rand -hex 32
# Production note: for hosted SaaS, replace this env-key scheme with a
# KMS/vault (AWS KMS, HashiCorp Vault) with key rotation.
MARKETR_CREDENTIALS_KEY=""

# --- Secrets provider (milestone 11: enterprise security) ---
# "env" (default): AES-256-GCM via MARKETR_CREDENTIALS_KEY above.
# "aws-kms": managed KMS provider (implement lib/secrets AwsKmsSecretsProvider
#   against @aws-sdk/client-kms first — currently a documented stub).
# SECRETS_PROVIDER="env"
# AWS_REGION="us-east-1"
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/…"

# --- Enterprise SSO (milestone 11) ---
# Generic OIDC — any OIDC-compliant IdP (Okta, Entra ID, Google Workspace,
# Keycloak, Authentik). The "Continue with SSO" button appears on /login only
# when these are set.
# OIDC_ISSUER="https://your-idp.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=<redacted>
# OIDC_DISPLAY_NAME="Okta"
# SAML via BoxyHQ Jackson bridge (open-source, self-hostable).
# SAML_ENABLED="true"
# BOXYHQ_SAML_ISSUER="https://jackson.your-domain.com"
# BOXYHQ_SAML_CLIENT_ID=""
# BOXYHQ_SAML_CLIENT_SECRET=<redacted>
# Domain-based auto-provisioning: SSO users whose email ends with SSO_DOMAIN
# join SSO_WORKSPACE_ID with SSO_DEFAULT_ROLE instead of a personal workspace.
# SSO_DOMAIN="acme.com"
# SSO_WORKSPACE_ID=""
# SSO_DEFAULT_ROLE="editor"   # owner | admin | editor | viewer

# Directory for site working copies (milestone 7). Defaults to ./.data/sites.
SITE_STORAGE_DIR=""

# Local SEO (milestone 16).
# GBP management scaffold stays OFF until the Google Business Profile API
# application is approved and credentials are configured. Keep false until then.
FEATURE_GBP_MANAGEMENT="false"

# Newsletter (milestone 19) — BYO Resend.
# Workspace Resend API keys are entered in the UI (Domains & settings) and
# stored encrypted; only the webhook signing secret goes here.
# Create a webhook in the Resend dashboard pointing at
# https://<your-domain>/api/newsletter/webhooks/resend and paste its secret:
RESEND_WEBHOOK_SECRET=""

# Studio (milestone 22) — Canva Connect (default studio) + Porkbun domains.
# Porkbun API keys are entered in the UI (Studio → Domains) and stored
# encrypted; only the Canva OAuth client goes here. Create the app at
# https://www.canva.com/developers, request the brand_template:read and
# design:content:read scopes, and set the redirect URI to
# https://<your-domain>/api/studio/canva/callback.
# NOTE: public Canva integrations may require Canva review/approval, and
# brand-template/autofill availability depends on the connected Canva plan.
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=<redacted>
