# Dataset Builder (Phase 4b). BriefNow pulls published datasets live over
# the ShapesOS MCP tool get_dataset_adapter; set BRIEFNOW_ADAPTERS_ROOT only
# to ALSO drop adapter files for a co-located BriefNow runtime
# (e.g. ../briefnow/runtime/dataset-adapters). Unset = no file drop.
# BRIEFNOW_ADAPTERS_ROOT=
# Days before a compiled dataset counts as stale (/api/cron/dataset-health; default 90).
# DATASET_STALE_AFTER_DAYS=
# NEMO_DATA_DESIGNER_ENDPOINT=
