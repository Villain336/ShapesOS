// Marketr — Prisma data model (spec §6).
// Source of truth: SPEC.md. Milestone 1: schema only, no business logic yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is provided by prisma.config.ts (env DATABASE_URL at runtime);
  // the env() reference below keeps `prisma generate`/`validate` happy
  // on Prisma 6.19, which requires a url key in this block.
  url      = env("DATABASE_URL")
}

enum Plan {
  self_hosted
  starter
  pro
  agency
}

enum KeywordIntent {
  informational
  navigational
  commercial
  transactional
  unknown
}

enum ContentStatus {
  brief
  draft
  editing
  published
}

enum ClientRole {
  viewer
  editor
  admin
}

enum IssueSeverity {
  info
  warning
  error
  critical
}

enum IssueStatus {
  open
  queued
  fixed
  ignored
}

// Marketr — per-site issue lifecycle for the fix-agent trust ladder
// (milestone 10). open → approved (explicit per-issue approval, or the
// issue's category is allow-listed in FixAgentSettings) → fixing → fixed
// (applied) → verified (a re-scan confirms the finding is gone).
enum SiteIssueStatus {
  open
  approved
  fixing
  fixed
  verified
  ignored
}

enum FixMode {
  manual
  scheduled
  autopilot
}

enum FixRunStatus {
  pending
  running
  completed
  failed
  rolled_back
}

enum SiteAuthType {
  password
  key
}

enum FileChangeActor {
  user
  ai
  // Milestone 10: the fix agent applying approved fixes on schedule.
  fix_agent
  // Milestone 12: scheduled/system report generation (cron actor).
  system
}

enum FileChangeAction {
  // Manual edit saved by the user.
  save
  // AI proposed a change (not yet applied — supervised rung).
  ai_proposal
  // User reviewed and explicitly applied an AI proposal.
  ai_applied
  // Milestone 9: working copy deployed to a hosting target (Vercel/Cloudflare).
  deploy
  // Milestone 10: fix agent applied an approved fix on schedule.
  fix_applied
  // Milestone 10: a fix-agent run was reverted (pre-change snapshot restored).
  fix_reverted
  // Milestone 11: enterprise audit coverage — credential lifecycle.
  credential_created
  credential_deleted
  // Milestone 11: enterprise audit coverage — workspace membership.
  member_added
  member_role_changed
  member_removed
  // Milestone 12: white-label report lifecycle.
  report_generated
  report_scheduled
  // Milestone 13: alert hub lifecycle.
  alert_channel_created
  alert_channel_updated
  alert_channel_deleted
  alert_rule_created
  alert_rule_updated
  alert_rule_deleted
  alert_sent
  alert_failed
  // Milestone 14: retention loops.
  ai_visibility_snapshot
  decay_finding_created
  decay_finding_resolved
  radar_event_detected
  visibility_score_computed
  // Milestone 15: link intelligence.
  backlink_pull
  internal_link_suggestion_created
  internal_link_suggestion_applied
  internal_link_suggestion_dismissed
  // Milestone 16: local SEO.
  local_grid_run
  local_competitor_snapshot
  reviews_ingested
  // Milestone 17: programmatic SEO.
  programmatic_template_created
  programmatic_template_updated
  programmatic_template_deleted
  programmatic_dataset_uploaded
  programmatic_dataset_deleted
  programmatic_pages_generated
  programmatic_page_approved
  programmatic_page_published
  programmatic_page_discarded
  // Milestone 17 push: a page was pushed to an external publish target.
  programmatic_page_pushed
  // Milestone 18: content autopilot.
  autopilot_rule_created
  autopilot_rule_updated
  autopilot_rule_deleted
  autopilot_run_started
  autopilot_run_finished
  autopilot_item_generated
  autopilot_item_approved
  autopilot_item_rejected
  autopilot_item_published
  autopilot_killed
  autopilot_unkilled
  // Milestone 19: newsletter builder.
  newsletter_template_created
  newsletter_template_updated
  newsletter_template_deleted
  newsletter_list_created
  newsletter_list_deleted
  newsletter_subscribers_imported
  newsletter_subscriber_unsubscribed
  newsletter_domain_added
  newsletter_domain_verified
  newsletter_test_sent
  newsletter_broadcast_created
  newsletter_broadcast_scheduled
  newsletter_broadcast_sent
  newsletter_broadcast_failed
  newsletter_broadcast_cancelled
  newsletter_resend_key_updated
  // Milestone 20: social scheduling via Buffer.
  social_buffer_key_updated
  social_buffer_key_revoked
  social_channels_synced
  social_channel_enabled
  social_channel_disabled
  social_post_created
  social_post_updated
  social_post_scheduled
  social_post_sent
  social_post_failed
  social_post_cancelled
  social_post_deleted
  social_analytics_synced
}

enum ProgrammaticPageStatus {
  draft
  ready
  published
  discarded
}

// Marketr — where a Site's files live (milestone 7).
// Milestone 8 adds content-level sources: wordpress + webflow.
enum SiteSourceType {
  github
  sftp
  file
  wordpress
  webflow
}

model Workspace {
  id          String @id @default(cuid())
  name        String
  // owner_user_id: external auth subject (Auth.js user id) — auth wired in milestone 2
  ownerUserId String @map("owner_user_id")
  plan        Plan   @default(self_hosted)

  // White-label config (spec §6): logo_url, custom_domain, brand_color
  whiteLabelLogoUrl      String? @map("white_label_logo_url")
  whiteLabelCustomDomain String? @map("white_label_custom_domain")
  whiteLabelBrandColor   String? @map("white_label_brand_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects             Project[]
  clients              Client[]
  apiUsage             ApiUsage[]
  // Milestone 11: workspace membership for RBAC (owner/admin/editor/viewer).
  members              WorkspaceMember[]
  // Milestone 11: workspace-scoped audit events.
  auditEvents          FileChangeLog[]
  // Milestone 12: white-label brand kits and report templates.
  brandKits            BrandKit[]
  reportTemplates      ReportTemplate[]
  // Milestone 13: alerting hub (channels, rules, event history).
  alertChannels        AlertChannel[]
  alertRules           AlertRule[]
  alertEvents          AlertEvent[]
  // Milestone 15: backlink pull audit trail (cost accounting).
  backlinkPulls        BacklinkPull[]
  // Milestone 19: newsletter settings (BYO Resend key) and sending domains.
  newsletterSettings   NewsletterSettings?
  newsletterDomains    NewsletterDomain[]
  // Milestone 20: social scheduling (BYO Buffer access token).
  socialSettings       SocialSettings?
  // Milestone 14: composite visibility score weights per workspace.
  // { rankings?: number, aiPresence?: number, freshness?: number, coverage?: number }
  // Null = defaults in lib/retention/visibility-score.ts.
  // NOTE (milestone 15): a `backlinks` component is reserved for a later
  // milestone — do not add it to the score until the backlink quality
  // signal is calibrated. visibility-score.ts documents the same note.
  visibilityWeights    Json?                 @map("visibility_weights")
  // Milestone 15: workspace-level monthly cap (USD) on DataForSEO Backlinks
  // spend. Null = DEFAULT_MONTHLY_SPEND_CAP_USD in lib/seo/backlinks-cost.ts.
  backlinksSpendCapUsd Float?                @map("backlinks_spend_cap_usd")
  // Milestone 16: workspace-level monthly cap (USD) on DataForSEO local-SEO
  // spend (maps SERP, business data, reviews). Null = DEFAULT_LOCAL_SPEND_CAP_USD.
  localSeoSpendCapUsd  Float?                @map("local_seo_spend_cap_usd")
  // Milestone 16: local-SEO pull audit trail (cost accounting) + GBP scaffold.
  localPulls           LocalPull[]
  gbpAccounts          GbpAccount[]
  // Milestone 18: content autopilot kill switches (workspace-level).
  autopilotKills       AutopilotKillSwitch[]

  @@map("workspaces")
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  domain       String
  locale       String @default("en-US")
  searchEngine String @default("google") @map("search_engine")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keywords                Keyword[]
  // Milestone 19: newsletter lists, templates, and broadcasts.
  newsletterLists         NewsletterList[]
  newsletterTemplates     NewsletterTemplate[]
  newsletterBroadcasts    NewsletterBroadcast[]
  // Milestone 20: social channels and posts.
  socialChannels          SocialChannel[]
  socialPosts             SocialPost[]
  competitors             Competitor[]
  contentItems            ContentItem[]
  issues                  Issue[]
  fixRuns                 FixRun[]
  siteConnections         SiteConnection[]
  fileChangeLogs          FileChangeLog[]
  sites                   Site[]
  hostingConnections      HostingConnection[]
  deployments             Deployment[]
  siteAudits              SiteAudit[]
  siteIssues              SiteIssue[]
  // Milestone 12: report templates and generated reports scoped to this project.
  reportTemplates         ReportTemplate[]
  reports                 Report[]
  // Milestone 14: retention loops.
  aiVisibilitySnapshots   AIVisibilitySnapshot[]
  decayFindings           ContentDecayFinding[]
  competitorSnapshots     CompetitorSnapshot[]
  radarEvents             CompetitorRadarEvent[]
  visibilityScores        VisibilityScore[]
  // Milestone 15: link intelligence.
  // Weekly scheduled backlink refresh toggle (default on; cron skips when false).
  backlinksEnabled        Boolean                  @default(true) @map("backlinks_enabled")
  backlinks               Backlink[]
  backlinkSummaries       BacklinkSummary[]
  backlinkPulls           BacklinkPull[]
  internalLinkSuggestions InternalLinkSuggestion[]
  // Milestone 16: local SEO.
  localGrids              LocalGrid[]
  localCompetitors        LocalCompetitor[]
  reviews                 Review[]
  reviewSummaries         ReviewSummary[]
  localPulls              LocalPull[]
  // Milestone 17: programmatic SEO.
  programmaticTemplates   ProgrammaticTemplate[]
  programmaticDatasets    ProgrammaticDataset[]
  programmaticPages       ProgrammaticPage[]
  // Milestone 18: content autopilot.
  autopilotRules          AutopilotRule[]
  autopilotRuns           AutopilotRun[]
  autopilotItems          AutopilotItem[]
  autopilotKills          AutopilotKillSwitch[]

  @@map("projects")
}

model Keyword {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phrase     String
  volume     Int?
  difficulty Float?
  cpc        Float?
  intent     KeywordIntent @default(unknown)
  // Saved list name, e.g. "Q4 content targets"
  list       String?
  // Rank tracking (milestone 5): tracked keywords get position checks on schedule/on demand.
  tracked    Boolean       @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rankings              Ranking[]
  contentItems          ContentItem[]
  // Milestone 14: retention loops.
  aiVisibilitySnapshots AIVisibilitySnapshot[]
  decayFindings         ContentDecayFinding[]

  @@unique([projectId, phrase])
  @@map("keywords")
}

model Ranking {
  id        String  @id @default(cuid())
  keywordId String  @map("keyword_id")
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  checkedAt         DateTime @default(now()) @map("checked_at")
  position          Int?
  url               String?
  aiOverviewPresent Boolean  @default(false) @map("ai_overview_present")
  serpFeatures      String[] @default([]) @map("serp_features")

  @@index([keywordId, checkedAt])
  @@map("rankings")
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  domain  String
  addedAt DateTime @default(now()) @map("added_at")

  @@unique([projectId, domain])
  @@map("competitors")
}

model ContentItem {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keywordId String?  @map("keyword_id")
  keyword   Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  status       ContentStatus @default(brief)
  outlineJson  Json?         @map("outline_json")
  bodyMarkdown String?       @map("body_markdown") @db.Text
  seoScore     Float?        @map("seo_score")
  publishedUrl String?       @map("published_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_items")
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name           String
  loginEmail     String     @map("login_email")
  viewerRole     ClientRole @default(viewer) @map("viewer_role")
  // Cron expression or "weekly"/"monthly" for scheduled branded reports
  reportSchedule String?    @map("report_schedule")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports   Report[]
  // Milestone 12: brand kits mapped to this client (per-client white-label).
  brandKits BrandKit[]

  @@unique([workspaceId, loginEmail])
  @@map("clients")
}

model Report {
  id       String  @id @default(cuid())
  // Milestone 12: client is optional — on-demand/scheduled template reports
  // may exist before they are assigned/sent to a client.
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Milestone 12: template + brand kit that produced this report.
  templateId String?         @map("template_id")
  template   ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  brandKitId String?         @map("brand_kit_id")
  brandKit   BrandKit?       @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  // Milestone 12: project whose data fills the report (rankings, visibility).
  projectId  String?         @map("project_id")
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  period  String
  pdfUrl  String?      @map("pdf_url")
  // Milestone 12: local storage path under .data/reports (durable volume in prod).
  pdfPath String?      @map("pdf_path")
  status  ReportStatus @default(ready) @map("status")
  error   String?
  sentAt  DateTime?    @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// Milestone 12: lifecycle of a generated white-label report.
enum ReportStatus {
  queued
  generating
  ready
  failed
  sent
}

// Marketr — white-label brand kit (milestone 12). Workspace-scoped; optionally
// mapped to a client so agencies get per-client branding. Consumed by pdfcn
// report rendering, emailcn emails (M19), ad factory (M21) and studio (M22).
model BrandKit {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  // Logo file stored under .data/reports/logos/<id>.<ext>; path relative to repo root.
  logoPath  String? @map("logo_path")
  // { primary, secondary, accent, text, muted } — hex strings.
  colors    Json    @default("{}")
  // { heading, body } — font family names.
  fonts     Json    @default("{}")
  // Voice/tone notes guiding AI-generated copy inside reports.
  tone      String?
  // Optional client this kit brands (agency white-label per client).
  clientId  String? @map("client_id")
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates           ReportTemplate[]
  reports             Report[]
  // Milestone 19: newsletter templates using this brand kit.
  newsletterTemplates NewsletterTemplate[]

  @@map("brand_kits")
}

// Marketr — editable report template (milestone 12). Content is Tiptap JSON
// (edited with the editorcn block editor in the dashboard) plus optional
// {{placeholders}} resolved at generation time from project data.
model ReportTemplate {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name       String
  // "ranking" (keyword rankings + visibility) | "custom".
  type       String    @default("custom")
  // Tiptap JSON document — single source of truth.
  content    Json
  brandKitId String?   @map("brand_kit_id")
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  // Project whose data fills {{placeholders}} at generation time.
  projectId  String?   @map("project_id")
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // "manual" | "weekly" | "monthly" — picked up by POST /api/cron/reports.
  schedule   String    @default("manual")
  lastRunAt  DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports Report[]

  @@map("report_templates")
}

enum ApiMeter {
  tracked_keywords
  ai_words
  serp_calls
}

model ApiUsage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Billing meter: tracked_keywords / ai_words / serp_calls
  meter    ApiMeter
  quantity Int
  // Billing period, e.g. "2026-09"
  period   String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, meter, period])
  @@map("api_usage")
}

model Issue {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type       String
  severity   IssueSeverity
  url        String?
  detailJson Json?         @map("detail_json")
  status     IssueStatus   @default(open)

  detectedAt DateTime @default(now()) @map("detected_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@map("issues")
}

model FixRun {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  mode          FixMode
  startedAt     DateTime     @default(now()) @map("started_at")
  fixesApplied  Int          @default(0) @map("fixes_applied")
  // Reference to the pre-change snapshot used for rollback
  snapshotRef   String?      @map("snapshot_ref")
  status        FixRunStatus @default(pending)
  reportSummary String?      @map("report_summary") @db.Text
  // Milestone 10: the site this run fixed (null for legacy project runs).
  siteId        String?      @map("site_id")
  site          Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  siteIssues SiteIssue[]

  @@map("fix_runs")
}

// Marketr — per-site fix-agent safety settings (milestone 10). This is the
// visible trust ladder: nothing is auto-fixed unless the user enables the
// agent AND approves the issue's category (or the issue itself). Dry-run is
// on by default so the first runs only propose diffs for review.
model FixAgentSettings {
  id     String @id @default(cuid())
  siteId String @unique @map("site_id")
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(false)
  // Issue categories the agent may fix on schedule WITHOUT per-issue approval.
  // Destructive categories always need per-issue approval regardless.
  allowedCategories String[] @default([]) @map("allowed_categories")
  maxFixesPerRun    Int      @default(10) @map("max_fixes_per_run")
  dryRun            Boolean  @default(true) @map("dry_run")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fix_agent_settings")
}

// Marketr — one audit pass over a site's working copy (milestone 10).
// Findings land as SiteIssue rows; the inbox shows the latest audit's issues.
model SiteAudit {
  id        String  @id @default(cuid())
  siteId    String  @map("site_id")
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  startedAt  DateTime     @default(now()) @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  status     FixRunStatus @default(pending)
  // True when findings came from the deterministic demo scanner.
  mock       Boolean      @default(false)

  totalIssues Int @default(0) @map("total_issues")
  openIssues  Int @default(0) @map("open_issues")
  errorIssues Int @default(0) @map("error_issues")

  issues SiteIssue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId, createdAt])
  @@map("site_audits")
}

// Marketr — one detected site issue (milestone 10). Lifecycle:
// open → approved → fixing → fixed → verified (re-scan confirms the fix).
// Destructive categories always require per-issue approval, even when the
// category is allow-listed in FixAgentSettings.
model SiteIssue {
  id        String     @id @default(cuid())
  siteId    String     @map("site_id")
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId   String?    @map("audit_id")
  audit     SiteAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  // Category key from lib/audit/categories.ts (e.g. "missing-alt").
  category    String
  severity    IssueSeverity
  filePath    String        @map("file_path")
  line        Int?
  detail      String        @db.Text
  fixHint     String?       @map("fix_hint") @db.Text
  // False when the agent cannot fix it (e.g. broken links need human intent).
  autoFixable Boolean       @default(true) @map("auto_fixable")
  destructive Boolean       @default(false)

  status       SiteIssueStatus @default(open)
  approvedBy   String?         @map("approved_by")
  approvedAt   DateTime?       @map("approved_at")
  // Dry-run preview of the change the agent WOULD apply (unified-diff-ish).
  proposedDiff String?         @map("proposed_diff") @db.Text
  fixedAt      DateTime?       @map("fixed_at")
  fixRunId     String?         @map("fix_run_id")
  fixRun       FixRun?         @relation(fields: [fixRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status])
  @@index([siteId, category, status])
  @@map("site_issues")
}

// Marketr — site (SFTP/SSH) connections, milestone 6: the supervised rung of
// the fix-agent trust ladder. Credentials are AES-256-GCM encrypted at rest
// (lib/sitefiles/crypto.ts) and NEVER sent to the client. Production note:
// replace the env-key encryption with a KMS/vault before hosted SaaS launch.
model SiteConnection {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label      String
  host       String
  port       Int          @default(22)
  username   String
  authType   SiteAuthType @default(password) @map("auth_type")
  // AES-256-GCM encrypted secret (password or private key), base64. Server-only.
  secretEnc  String       @map("secret_enc") @db.Text
  // Non-sensitive hint shown in the UI, e.g. "••••a1b2" (sha256 prefix).
  secretHint String?      @map("secret_hint")
  // Demo connections serve the deterministic mock file tree instead of SFTP.
  demo       Boolean      @default(false)

  lastTestedAt DateTime? @map("last_tested_at")
  lastTestOk   Boolean?  @map("last_test_ok")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Sites linked to this connection as their SFTP source (milestone 7).
  sites Site[]

  @@map("site_connections")
}

// Marketr — append-only audit log for the IDE (milestone 6). Every manual
// save and every AI proposal / approved application is recorded: who, what
// file, when, and what changed. This log is the accountability backbone of
// the supervised fix-agent rung.
model FileChangeLog {
  id          String     @id @default(cuid())
  // Milestone 11: projectId is optional so workspace-scoped events (member
  // add/role change/remove) can be audit-logged without a project.
  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Milestone 11: workspace-scoped audit events.
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  connectionId String?          @map("connection_id")
  // Milestone 7: the Site (github/sftp/file) this change belongs to, when the
  // IDE is opened on a Site rather than a raw connection.
  siteId       String?          @map("site_id")
  site         Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  filePath     String           @map("file_path")
  actor        FileChangeActor
  action       FileChangeAction
  summary      String
  // Auth user id who approved an AI proposal (null otherwise).
  approvedBy   String?          @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("file_change_log")
}

// Marketr — a website/landing-page unit (milestone 7). A Site is what the
// builder creates and the IDE edits, regardless of where the files live:
// a GitHub repo, an SFTP host (reusing a milestone-6 SiteConnection), or a
// plain uploaded/managed file set. Secrets live in configEnc (AES-256-GCM,
// lib/sitefiles/crypto.ts) and are never sent to the client.
model Site {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  sourceType       SiteSourceType  @map("source_type")
  // AES-256-GCM encrypted JSON config. GitHub: { token, owner, repo, branch, demo? }.
  // File/SFTP: {} (file) — SFTP reuses sftpConnectionId below.
  configEnc        String          @map("config_enc") @db.Text
  // Optional link to a milestone-6 connection for sftp-source sites.
  sftpConnectionId String?         @map("sftp_connection_id")
  sftpConnection   SiteConnection? @relation(fields: [sftpConnectionId], references: [id], onDelete: SetNull)

  fileChangeLogs   FileChangeLog[]
  deployments      Deployment[]
  fixAgentSettings FixAgentSettings?
  audits           SiteAudit[]
  issues           SiteIssue[]
  fixRuns          FixRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sites")
}

// Marketr — hosting deploy targets (milestone 9). Tokens encrypted in
// configEnc (AES-256-GCM, lib/sitefiles/crypto.ts), decrypted server-side
// only, never sent to the client.
enum DeployTargetType {
  vercel
  cloudflare_pages @map("cloudflare-pages")
}

model HostingConnection {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  target    DeployTargetType
  // AES-256-GCM encrypted JSON. Vercel: { token, projectId?, teamId?, demo? }.
  // Cloudflare: { token, accountId, projectName?, demo? }.
  configEnc String           @map("config_enc") @db.Text

  deployments Deployment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hosting_connections")
}

// Marketr — one deploy of a Site's working copy to Vercel or Cloudflare
// Pages (milestone 9). Persisted so the UI shows URL + status + timestamp
// without calling the provider each time. mock=true rows are demos.
model Deployment {
  id        String  @id @default(cuid())
  siteId    String  @map("site_id")
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  connectionId String?            @map("connection_id")
  connection   HostingConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  target       DeployTargetType
  url          String?
  deploymentId String?          @map("deployment_id")
  status       String           @default("queued")
  mock         Boolean          @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, createdAt])
  @@map("deployments")
}

// Marketr — workspace membership for RBAC (milestone 11).
// Roles form a hierarchy: owner > admin > editor > viewer.
//  - viewer: read-only (GET routes).
//  - editor: read + write, except member management and connection-credential CRUD.
//  - admin: everything except workspace deletion.
//  - owner: full control (workspace deletion, owner transfer via role change).
enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Auth.js user id (subject). Null for pending invites keyed by email.
  userId      String?       @map("user_id")
  email       String?
  name        String?
  role        WorkspaceRole @default(viewer)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@unique([workspaceId, email])
  @@index([userId])
  @@map("workspace_members")
}

// Marketr — alerting hub (milestone 13).
// Slack (incoming webhook), Telegram (bot API), email (SMTP) now;
// WhatsApp intentionally deferred (phased per spec).

enum AlertChannelType {
  slack
  telegram
  email
}

enum AlertEventStatus {
  // Queued for a digest window or quiet-hours hold — not yet attempted.
  queued
  // Delivered to every enabled channel on the rule.
  sent
  // Attempted but every channel failed (see results JSON for per-channel detail).
  failed
  // Suppressed by cooldown/dedup or an explicitly quiet trigger — never sent.
  suppressed
}

model AlertChannel {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        AlertChannelType
  // Encrypted JSON envelope (AES-256-GCM, lib/secrets). Shapes:
  //   slack:    { webhookUrl: string }
  //   telegram: { botToken: string, chatId: string }
  //   email:    { to: string, cc?: string }
  // SMTP server settings are instance-level env vars (see .env.example),
  // not stored per channel.
  configEnc   String           @map("config_enc") @db.Text
  // Non-sensitive UI hint, e.g. "…/T0123/abc" or "chat 12345" / "ops@acme.co".
  hint        String           @default("")
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rules AlertRule[] @relation("AlertRuleChannels")

  @@index([workspaceId])
  @@map("alert_channels")
}

model AlertRule {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  // Trigger key — see lib/alerts/triggers.ts TRIGGERS:
  // rank_drop | rank_gain | ai_overview_change | ai_citation_change | fix_run |
  // report_ready | visibility_delta | content_decay | competitor_radar
  trigger      String
  // JSON conditions, all optional:
  //   { projectIds?: string[], keywordIds?: string[], thresholdPositions?: number,
  //     severities?: string[], onlyTop10?: boolean }
  conditions   Json      @default("{}")
  // Minimum seconds between fires of this rule for the same dedup scope.
  cooldownSec  Int       @default(3600) @map("cooldown_sec")
  // "immediate" — send now; "daily_digest" — batch into one message per day.
  digest       String    @default("immediate")
  // Optional quiet hours, UTC: { start: "22:00", end: "07:00" }. Events inside
  // the window are queued and flushed when the window ends.
  quietHours   Json?     @map("quiet_hours")
  enabled      Boolean   @default(true)
  lastFiredAt  DateTime? @map("last_fired_at")
  lastDigestAt DateTime? @map("last_digest_at")

  channels AlertChannel[] @relation("AlertRuleChannels")
  events   AlertEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, trigger])
  @@map("alert_rules")
}

model AlertEvent {
  id          String           @id @default(cuid())
  ruleId      String           @map("rule_id")
  rule        AlertRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Denormalized for the history UI (rule may be deleted later).
  trigger     String
  title       String
  body        String           @db.Text
  link        String?
  // Dedup key, e.g. "rank_drop:<keywordId>:<yyyy-mm-dd>". Null = no dedup.
  dedupKey    String?          @map("dedup_key")
  // Why a queued event is waiting: "digest" (daily batch) or "quiet" (quiet hours).
  queueReason String?          @map("queue_reason")
  status      AlertEventStatus @default(queued)
  // Per-channel results: [{ channelId, name, type, ok, error?, providerResponse? }]
  results     Json             @default("[]")
  retryCount  Int              @default(0) @map("retry_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  sentAt      DateTime?        @map("sent_at")

  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
  @@index([dedupKey, createdAt])
  @@map("alert_events")
}

// Milestone 14: retention loops — AI search visibility per keyword check.
model AIVisibilitySnapshot {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywordId String  @map("keyword_id")
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  checkedAt         DateTime @default(now()) @map("checked_at")
  aiOverviewPresent Boolean  @default(false) @map("ai_overview_present")
  // Whether the project's own domain was cited inside the AI Overview/answer.
  siteCited         Boolean  @default(false) @map("site_cited")
  citedUrl          String?  @map("cited_url")
  serpFeatures      String[] @default([]) @map("serp_features")
  mock              Boolean  @default(false)

  @@index([projectId, checkedAt])
  @@index([keywordId, checkedAt])
  @@map("ai_visibility_snapshots")
}

// Milestone 14: content decay & refresh engine findings (grouped per ranking URL).
model ContentDecayFinding {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Representative keyword (one finding may cover several phrases on the same URL).
  keywordId String?  @map("keyword_id")
  keyword   Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  url             String?
  // Tracked phrases whose rankings decayed on this URL.
  phrases         String[]  @default([])
  // 0–100. See lib/retention/decay.ts for the formula.
  decayScore      Float     @map("decay_score")
  peakPosition    Int?      @map("peak_position")
  currentPosition Int?      @map("current_position")
  peakAt          DateTime? @map("peak_at")
  // refresh_content | rebuild | internal_links
  suggestedAction String    @map("suggested_action")
  severity        String    @default("info") // info | warn | critical
  status          String    @default("open") // open | actioned | dismissed
  note            String?
  detectedAt      DateTime  @default(now()) @map("detected_at")
  resolvedAt      DateTime? @map("resolved_at")

  @@index([projectId, status])
  @@map("content_decay_findings")
}

// Milestone 14: competitor keyword snapshot for radar diffing (weekly).
model CompetitorSnapshot {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitorDomain String   @map("competitor_domain")
  capturedAt       DateTime @default(now()) @map("captured_at")
  // [{ phrase, position, url, volume }] — top keywords from the SEO provider.
  keywordsJson     Json     @map("keywords_json")
  mock             Boolean  @default(false)

  @@index([projectId, competitorDomain, capturedAt])
  @@map("competitor_snapshots")
}

// Milestone 14: competitor radar events (diff of consecutive snapshots).
model CompetitorRadarEvent {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitorDomain String   @map("competitor_domain")
  // new_keyword | keyword_gain | new_page | lost_to_competitor
  eventType        String   @map("event_type")
  keywordPhrase    String?  @map("keyword_phrase")
  details          Json
  detectedAt       DateTime @default(now()) @map("detected_at")
  read             Boolean  @default(false)

  @@index([projectId, detectedAt])
  @@index([projectId, competitorDomain, detectedAt])
  @@map("competitor_radar_events")
}

// Milestone 14: composite visibility score time series (daily).
model VisibilityScore {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Day bucket (UTC midnight).
  date       DateTime
  score      Int // 0–100
  // { rankings, aiPresence, freshness, coverage, weights } — components 0–100.
  components Json
  mock       Boolean  @default(false)

  @@unique([projectId, date])
  @@index([projectId, date])
  @@map("visibility_scores")
}

// Milestone 15: link intelligence.

enum BacklinkStatus {
  active
  lost
}

// One backlink edge pointing at the project's domain (upserted per pull).
model Backlink {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceDomain String  @map("source_domain")
  sourceUrl    String  @map("source_url")
  targetUrl    String  @map("target_url")
  anchorText   String? @map("anchor_text")
  dofollow     Boolean @default(true)
  // DataForSEO domain_from_rank (0–1000); used for lost-link alert priority.
  sourceRank   Int?    @map("source_rank")
  spamScore    Int?    @map("spam_score")

  firstSeen DateTime?      @map("first_seen")
  lastSeen  DateTime?      @map("last_seen")
  status    BacklinkStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, sourceUrl, targetUrl])
  @@index([projectId, status])
  @@index([projectId, sourceDomain])
  @@map("backlinks")
}

// Daily backlink profile snapshot (from backlinks/summary/live + pull stats).
model BacklinkSummary {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Day bucket (UTC midnight).
  date             DateTime
  total            Int
  referringDomains Int      @map("referring_domains")
  dofollowRatio    Float?   @map("dofollow_ratio")
  // { active, lost, newThisPull, providerTotal, ... }
  snapshot         Json
  mock             Boolean  @default(false)

  @@unique([projectId, date])
  @@index([projectId, date])
  @@map("backlink_summaries")
}

// Cost-accounting record for every backlink pull (preview + run).
model BacklinkPull {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // user | cron | system
  actor            String
  target           String
  rowsRequested    Int     @map("rows_requested")
  rowsReturned     Int     @default(0) @map("rows_returned")
  estimatedCostUsd Float   @map("estimated_cost_usd")
  actualCostUsd    Float?  @map("actual_cost_usd")
  // preview | completed | blocked_cap | blocked_limit | failed
  status           String  @default("preview")
  note             String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@map("backlink_pulls")
}

enum InternalLinkSuggestionStatus {
  pending
  applied
  dismissed
}

// Supervised internal-linking suggestions (milestone 15). "Apply" creates an
// Issue in the fix-agent inbox — pages are never auto-edited.
model InternalLinkSuggestion {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceUrl       String                       @map("source_url")
  targetUrl       String                       @map("target_url")
  suggestedAnchor String                       @map("suggested_anchor")
  // orphan | high_value_underlinked | keyword_relevant
  reason          String
  score           Int // 0–100
  status          InternalLinkSuggestionStatus @default(pending)

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([projectId, status])
  @@index([projectId, score])
  @@map("internal_link_suggestions")
}

enum ReviewSentiment {
  pos
  neu
  neg
}

// Geo-grid definitions (milestone 16): a keyword tracked across a square grid
// of map-pack lookups around a center point.
model LocalGrid {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  keyword      String
  // Client's business name as shown on Google (matched per cell).
  businessName String    @map("business_name")
  centerLat    Float     @map("center_lat")
  centerLng    Float     @map("center_lng")
  radiusMiles  Float     @default(5) @map("radius_miles")
  // Grid dimension (5 = 5×5 = 25 cells). Clamped 2–9 in lib/local/grid.ts.
  gridSize     Int       @default(5) @map("grid_size")
  // manual | weekly
  schedule     String    @default("weekly")
  enabled      Boolean   @default(true)
  lastRunAt    DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")

  results LocalGridResult[]

  @@index([projectId])
  @@map("local_grids")
}

// One completed geo-grid run: per-cell positions + summary.
model LocalGridResult {
  id          String    @id @default(cuid())
  localGridId String    @map("local_grid_id")
  localGrid   LocalGrid @relation(fields: [localGridId], references: [id], onDelete: Cascade)

  runAt       DateTime @default(now()) @map("run_at")
  // GridCellResult[] JSON: [{ row, col, lat, lng, position, topBusiness }]
  cells       Json
  coveragePct Float    @map("coverage_pct")
  avgPosition Float?   @map("avg_position")
  costUsd     Float    @default(0) @map("cost_usd")
  mock        Boolean  @default(false)

  @@index([localGridId, runAt])
  @@map("local_grid_results")
}

// Tracked local competitors (milestone 16): GBP/review intelligence without
// any Google approval — sourced from DataForSEO business data.
model LocalCompetitor {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  businessName String  @map("business_name")
  placeId      String? @map("place_id")
  domain       String?
  // Search center for the business-data lookup (defaults to a grid center).
  lat          Float?
  lng          Float?
  enabled      Boolean @default(true)

  lastSnapshotAt DateTime? @map("last_snapshot_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  snapshots LocalCompetitorSnapshot[]

  @@index([projectId])
  @@map("local_competitors")
}

model LocalCompetitorSnapshot {
  id                String          @id @default(cuid())
  localCompetitorId String          @map("local_competitor_id")
  localCompetitor   LocalCompetitor @relation(fields: [localCompetitorId], references: [id], onDelete: Cascade)

  date        DateTime @default(now())
  rating      Float?
  reviewCount Int?     @map("review_count")
  categories  String[] @default([])
  address     String?
  mock        Boolean  @default(false)

  @@index([localCompetitorId, date])
  @@map("local_competitor_snapshots")
}

// Ingested Google reviews (milestone 16).
model Review {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Provider review id, or a synthetic sha1 id when the provider gives none.
  externalId   String          @map("external_id")
  businessName String          @map("business_name")
  author       String?
  rating       Int?
  text         String?
  publishedAt  DateTime?       @map("published_at")
  sentiment    ReviewSentiment @default(neu)
  // llm | heuristic — how the sentiment was classified.
  sentimentVia String          @default("heuristic") @map("sentiment_via")
  responded    Boolean         @default(false)
  mock         Boolean         @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, externalId])
  @@index([projectId, rating])
  @@index([projectId, sentiment])
  @@map("reviews")
}

// Weekly review rollup (milestone 16).
model ReviewSummary {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  period      String   @default("weekly")
  periodStart DateTime @map("period_start")
  avgRating   Float?   @map("avg_rating")
  count       Int
  posCount    Int      @default(0) @map("pos_count")
  neuCount    Int      @default(0) @map("neu_count")
  negCount    Int      @default(0) @map("neg_count")
  // [{ theme, count }] JSON from lib/local/sentiment.ts extractThemes().
  topThemes   Json     @default("[]") @map("top_themes")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, period, periodStart])
  @@map("review_summaries")
}

// Cost-accounting audit trail for metered local-SEO operations (milestone 16).
// Mirrors BacklinkPull (milestone 15).
model LocalPull {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // user | cron | system
  actor            String
  // geo_grid | competitor_refresh | reviews_ingest
  kind             String
  requestsMade     Int     @default(0) @map("requests_made")
  estimatedCostUsd Float   @map("estimated_cost_usd")
  actualCostUsd    Float?  @map("actual_cost_usd")
  // preview | completed | blocked_cap | failed
  status           String  @default("preview")
  note             String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@map("local_pulls")
}

// Programmatic SEO builder (milestone 17).
// Template: URL/title/description/content patterns with {{variables}} that
// get multiplied across dataset rows into individual pages.
model ProgrammaticTemplate {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                String
  // e.g. /services/{{city}}/{{service}} ({var} single-brace form also accepted)
  urlPattern          String @map("url_pattern")
  titleTemplate       String @map("title_template") @db.Text
  descriptionTemplate String @map("description_template") @db.Text
  // Tiptap JSON doc; leaf text may contain {{variables}}.
  contentBlocks       Json   @map("content_blocks")

  // Quality gates (enforced server-side on approve/publish).
  minWordCount         Int     @default(300) @map("min_word_count")
  // Max share of pages allowed to share an identical content hash (0-1).
  duplicateRateCap     Float   @default(0.05) @map("duplicate_rate_cap")
  // New pages start noindex until published.
  noindexUntilApproved Boolean @default(true) @map("noindex_until_approved")

  // Milestone 17 push: default publish target for this template's pages.
  // "none" | "csv" | "wordpress" | "webflow" | "marketr-site". Pages may
  // override this per-page (ProgrammaticPage.publishTarget).
  defaultPublishTarget       String  @default("none") @map("default_publish_target")
  // Site id for wordpress/webflow/marketr-site targets (nullable = unset).
  defaultTargetSiteId        String? @map("default_target_site_id")
  // Webflow CMS collection id for webflow pushes.
  defaultWebflowCollectionId String? @map("default_webflow_collection_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages          ProgrammaticPage[]
  autopilotRules AutopilotRule[]

  @@map("programmatic_templates")
}

model ProgrammaticDataset {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  // Column names in upload order.
  schema        Json
  // Array of { [column]: value } objects. Capped at 10_000 rows server-side.
  rows          Json
  rowCount      Int    @map("row_count")
  // variable -> column name overrides; auto-mapped by default.
  columnMapping Json?  @map("column_mapping")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages ProgrammaticPage[]

  @@map("programmatic_datasets")
}

model ProgrammaticPage {
  id         String               @id @default(cuid())
  projectId  String               @map("project_id")
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId String               @map("template_id")
  template   ProgrammaticTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  datasetId  String?              @map("dataset_id")
  dataset    ProgrammaticDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  rowIndex     Int                    @map("row_index")
  // Substituted URL path, e.g. /services/austin/plumbing
  url          String
  slug         String
  status       ProgrammaticPageStatus @default(draft)
  // { title, description, contentBlocks (Tiptap doc), wordCount }
  content      Json?
  contentHash  String?                @map("content_hash")
  noindex      Boolean                @default(true)
  canonical    String?
  // string[] quality flags: missing_variable | thin_content | duplicate_content | slug_collision
  qualityFlags Json                   @default("[]") @map("quality_flags")
  publishedUrl String?                @map("published_url")
  publishedAt  DateTime?              @map("published_at")

  // Milestone 17 push: per-page publish-target override ("none" = inherit
  // the template default), target site, and the remote refs used for
  // idempotent in-place updates (externalId = WP post id / Webflow item id /
  // site file path).
  publishTarget       String  @default("none") @map("publish_target")
  targetSiteId        String? @map("target_site_id")
  webflowCollectionId String? @map("webflow_collection_id")
  externalId          String? @map("external_id")
  externalUrl         String? @map("external_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, slug])
  @@index([projectId, status])
  @@map("programmatic_pages")
}

// Google Business Profile management scaffold (milestone 16).
// BEHIND the FEATURE_GBP_MANAGEMENT flag until the GBP API application is
// approved. No live Google calls exist yet — see lib/local/gbp.ts.
model GbpAccount {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  posts    GbpPost[]
  insights GbpInsight[]

  @@index([workspaceId])
  @@map("gbp_accounts")
}

model GbpPost {
  id           String     @id @default(cuid())
  gbpAccountId String     @map("gbp_account_id")
  gbpAccount   GbpAccount @relation(fields: [gbpAccountId], references: [id], onDelete: Cascade)

  locationId  String    @map("location_id")
  title       String
  summary     String
  // draft | scheduled | published | failed
  status      String    @default("draft")
  scheduledAt DateTime? @map("scheduled_at")
  externalId  String?   @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([gbpAccountId, status])
  @@map("gbp_posts")
}

model GbpInsight {
  id           String     @id @default(cuid())
  gbpAccountId String     @map("gbp_account_id")
  gbpAccount   GbpAccount @relation(fields: [gbpAccountId], references: [id], onDelete: Cascade)

  locationId        String   @map("location_id")
  date              DateTime
  views             Int      @default(0)
  searches          Int      @default(0)
  directionRequests Int      @default(0) @map("direction_requests")
  calls             Int      @default(0)
  websiteClicks     Int      @default(0) @map("website_clicks")
  mock              Boolean  @default(false)

  @@unique([gbpAccountId, locationId, date])
  @@map("gbp_insights")
}

// Marketr — content autopilot (milestone 18).
// Scheduled pipeline: source candidates → AI draft → approval gate →
// publish through the M17 push-publish path. Per-workspace autopilot scope,
// approval policies, full audit trail, pause/kill switch.
enum AutopilotSource {
  // M14 decay queue: refresh_content findings.
  decay_refresh
  // M17 programmatic templates: ready pages from one template.
  programmatic_template
  // Keyword gaps: tracked keywords with no content item yet.
  keyword_opportunity
}

enum AutopilotCadence {
  daily
  weekly
  manual
}

enum AutopilotRunStatus {
  running
  completed
  failed
  killed
}

enum AutopilotItemKind {
  decay_refresh
  programmatic_page
  keyword_brief
}

enum AutopilotItemStatus {
  pending
  approved
  rejected
  published
  killed
}

model AutopilotRule {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                   String
  // Which candidate source this rule pulls from.
  source                 AutopilotSource
  // Only for programmatic_template source: which template's ready pages.
  programmaticTemplateId String?               @map("programmatic_template_id")
  programmaticTemplate   ProgrammaticTemplate? @relation(fields: [programmaticTemplateId], references: [id], onDelete: SetNull)
  cadence                AutopilotCadence      @default(manual)
  // Cap on items generated per run (1–50).
  maxItemsPerRun         Int                   @default(5) @map("max_items_per_run")
  // Auto-approve without human review (default OFF). Only ever applied to
  // low-risk decay_refresh items; every auto-approval is audit-logged.
  autoApprove            Boolean               @default(false) @map("auto_approve")
  // Target settings shared with the M17 push path:
  // { kind: "wordpress"|"webflow"|"marketr-site"|"csv", siteId?, connectionId? }
  publishTarget          Json?                 @map("publish_target")
  enabled                Boolean               @default(true)

  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  runs  AutopilotRun[]
  items AutopilotItem[]

  @@index([projectId, enabled])
  @@map("autopilot_rules")
}

model AutopilotRun {
  id        String        @id @default(cuid())
  ruleId    String        @map("rule_id")
  rule      AutopilotRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status         AutopilotRunStatus @default(running)
  itemsGenerated Int                @default(0) @map("items_generated")
  itemsApproved  Int                @default(0) @map("items_approved")
  itemsPublished Int                @default(0) @map("items_published")
  // Who started the run: user id, or "cron".
  createdBy      String?            @map("created_by")
  error          String?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  items AutopilotItem[]

  @@index([ruleId, startedAt])
  @@index([projectId, startedAt])
  @@map("autopilot_runs")
}

model AutopilotItem {
  id        String        @id @default(cuid())
  runId     String        @map("run_id")
  run       AutopilotRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleId    String        @map("rule_id")
  rule      AutopilotRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind          AutopilotItemKind
  // Id of the source record: ContentDecayFinding / ProgrammaticPage / Keyword.
  sourceRef     String              @map("source_ref")
  title         String
  // AI draft, Tiptap JSON (editorcn editable source of truth).
  draftJson     Json?               @map("draft_json")
  draftMarkdown String?             @map("draft_markdown")
  status        AutopilotItemStatus @default(pending)
  // Explicit per-item audit note when auto-approved.
  autoApproved  Boolean             @default(false) @map("auto_approved")
  reviewNote    String?             @map("review_note")
  publishedUrl  String?             @map("published_url")
  publishedAt   DateTime?           @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ruleId, kind, sourceRef])
  @@index([projectId, status])
  @@index([runId, status])
  @@map("autopilot_items")
}

model AutopilotKillSwitch {
  id          String     @id @default(cuid())
  // Exactly one of workspaceId / projectId is set: workspace row kills every
  // project in the workspace; project row kills one project.
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "workspace:<id>" or "project:<id>" — unique because Postgres treats
  // NULLs as distinct in composite unique constraints.
  scopeKey    String     @unique @map("scope_key")

  killed   Boolean   @default(false)
  killedAt DateTime? @map("killed_at")
  killedBy String?   @map("killed_by")
  reason   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("autopilot_kill_switches")
}

// ---------------------------------------------------------------------------
// Marketr — newsletter builder (milestone 19).
// Editor model: Tiptap JSON email blocks (see lib/newsletter). Brand kits
// (milestone 12) supply fonts/colors at render time. Sending is Resend
// Broadcasts with a BYO workspace API key (encrypted, lib/secrets).
// ---------------------------------------------------------------------------

// Milestone 19 — workspace newsletter settings: BYO Resend key + defaults.
model NewsletterSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Encrypted Resend API key (AES-256-GCM envelope, lib/secrets). The raw key
  // is NEVER returned to clients — only the hint is readable in the UI.
  resendKeyEnc    String? @map("resend_key_enc") @db.Text
  resendKeyHint   String? @map("resend_key_hint")
  defaultFromName String? @map("default_from_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_settings")
}

enum NewsletterDomainStatus {
  pending
  verified
  failed
}

// Milestone 19 — per-client sending domain. Broadcasts are blocked
// server-side unless the domain's status is verified.
model NewsletterDomain {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  domain         String
  resendDomainId String?                @map("resend_domain_id")
  status         NewsletterDomainStatus @default(pending)
  // Exact DNS records Resend requires, as returned by its API:
  // [{ name, type: "TXT"|"MX"|"CNAME", value, purpose: "spf"|"dkim"|"dmarc-note" }].
  dnsRecords     Json                   @default("[]") @map("dns_records")
  verifiedAt     DateTime?              @map("verified_at")

  broadcasts NewsletterBroadcast[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, domain])
  @@map("newsletter_domains")
}

// Milestone 19 — subscriber list (one Resend audience per list).
model NewsletterList {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  doubleOptIn      Boolean @default(true) @map("double_opt_in")
  resendAudienceId String? @map("resend_audience_id")

  subscribers Subscriber[]
  broadcasts  NewsletterBroadcast[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_lists")
}

enum SubscriberStatus {
  subscribed
  unsubscribed
  bounced
  complained
}

// Milestone 19 — one subscriber. `token` powers the per-send unsubscribe link
// (public route, no auth — the token is the capability).
model Subscriber {
  id     String         @id @default(cuid())
  listId String         @map("list_id")
  list   NewsletterList @relation(fields: [listId], references: [id], onDelete: Cascade)

  email  String
  name   String?
  status SubscriberStatus @default(subscribed)
  token  String           @unique @default(cuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([listId, email])
  @@map("subscribers")
}

// Milestone 19 — editable newsletter template. Content is Tiptap JSON email
// blocks (emailHeader/emailHero/emailText/emailImage/emailButton/
// emailDivider/emailFooter — see lib/newsletter), the editable source of
// truth, same pattern as milestone 12 report templates.
model NewsletterTemplate {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  tiptap     Json
  brandKitId String?   @map("brand_kit_id")
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  isStarter  Boolean   @default(false) @map("is_starter")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_templates")
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

// Milestone 19 — one newsletter send. `templateSnapshot` is the immutable
// Tiptap JSON at send time (editing the template later does not change it).
model NewsletterBroadcast {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  listId   String           @map("list_id")
  list     NewsletterList   @relation(fields: [listId], references: [id], onDelete: Restrict)
  domainId String           @map("domain_id")
  domain   NewsletterDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  subject           String
  templateSnapshot  Json            @map("template_snapshot")
  brandKitId        String?         @map("brand_kit_id")
  status            BroadcastStatus @default(draft)
  scheduledAt       DateTime?       @map("scheduled_at")
  // Guardrail: a test send must complete before any broadcast.
  testSentAt        DateTime?       @map("test_sent_at")
  testSentTo        String?         @map("test_sent_to")
  resendBroadcastId String?         @map("resend_broadcast_id")
  // { sent, delivered, opened, clicked, bounced, complained } — best effort.
  stats             Json            @default("{}")
  error             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_broadcasts")
}

// Marketr — social scheduling via Buffer (milestone 20).
model SocialSettings {
  id              String    @id @default(cuid())
  workspaceId     String    @unique @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Buffer access token, encrypted at rest (BYO credential, like Resend in M19).
  bufferTokenEnc  String?   @map("buffer_token_enc")
  bufferTokenHint String?   @map("buffer_token_hint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_settings")
}

enum SocialPostStatus {
  draft
  scheduled
  sent
  failed
  cancelled
}

// A Buffer profile (channel) synced into a project. enable/disable is per project.
model SocialChannel {
  id              String  @id @default(cuid())
  projectId       String  @map("project_id")
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bufferProfileId String  @map("buffer_profile_id")
  // Normalized service key (twitter, instagram, tiktok, linkedin, facebook,
  // threads, youtube, bluesky, pinterest) or the raw Buffer service string.
  service         String
  handle          String?
  enabled         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, bufferProfileId])
  @@map("social_channels")
}

model SocialPost {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // SocialContent JSON (text, per-channel overrides, media, link, utm).
  content         Json
  // Target service keys, e.g. ["twitter", "linkedin"].
  services        String[]
  scheduledFor    DateTime?        @map("scheduled_for")
  status          SocialPostStatus @default(draft)
  // Idempotency record: [{ channelId, profileId, updateId, service }].
  bufferUpdateIds Json             @default("[]") @map("buffer_update_ids")
  // Bounded retry bookkeeping for transient Buffer failures.
  attempts        Int              @default(0)
  nextAttemptAt   DateTime?        @map("next_attempt_at")
  error           String?
  // Cached analytics payload: { byChannel, totals, syncedAt }.
  stats           Json             @default("{}")
  statsSyncedAt   DateTime?        @map("stats_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_posts")
}
