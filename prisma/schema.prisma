  campaign_archived
  campaign_link_attached
  campaign_link_detached
  link_proposal_resolved
  // Phase 3 (accounts): workspace lifecycle + agency client records.
  // Deletion is recorded in workspace_lifecycle_events (survives the cascade).
  workspace_created
  workspace_renamed
  client_created
  client_updated
  client_deleted
  // Phase 4a (GDPR): a full workspace data export was downloaded.
  workspace_exported
  // Phase 4a (identity): 2FA/passkey lifecycle, workspace security policy,
