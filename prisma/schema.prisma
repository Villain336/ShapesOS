  keyword          String    @map("keyword")
  locale           String    @default("en-US") @map("locale")
  estimate         Float     @map("estimate")
  uncertaintyBand  Json?     @map("uncertainty_band") // [lower, upper] — "estimated range," never a score
  inputsProvenance Json?     @map("inputs_provenance")
  modelVersion     String    @map("model_version")
  evaluatedAt      DateTime  @default(now()) @map("evaluated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, keyword, locale, modelVersion])
  @@index([workspaceId, evaluatedAt])
  @@map("difficulty_estimate")
}

// M7 verification battery: demand-driven link verification state.
model LinkVerification {
  id          String                 @id @default(cuid()) @map("id")
  workspaceId String                 @map("workspace_id")
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
