// ============================================================
// Phase 7 F-track fragment: ctv (merged by coordinator, 2026-09-25)
// ============================================================
// Marketr — Phase 7 F4 (CTV/commercials buying path) data models.
//
// ASSEMBLY NOTE: this fragment is merged into prisma/schema.prisma by the
// phase-7 coordinator. It is a fragment — do NOT `prisma generate` against
// it directly. Validate the assembled schema with `prisma validate`.
//
// Table names: ctv_campaigns, ctv_creative_validations, ctv_spots, ctv_ios,
// ctv_pixels (spec §4, F4 tables). This fragment owns only these five.
// The `approvalObjectId` scalar references the phase-5 safety track's
// media_approvals(id); the `qrId`/`purlId` scalars on ctv_spots reference
// phase-5 tracking_links rows. Relations are scalar-only until the
// fragments are merged.
//
// All rows are workspace-isolated. Money values are integer cents.
// No key material, no raw credentials — only config refs (see ctv_campaigns
// vibeConfigRef → Secure Vault). Pixel URLs are signed but carry no PII.

// F4: CTV campaign. platform ∈ vibe | mntn | roku | tatari | tvscientific |
// seat:ttd | seat:dv360 | seat:amazon | seat:basis. mode ∈ api | concierge.
// status: draft | pending_vendor_approval | human_placed | live |
// reconciling | paused | complete | cancelled.
model CtvCampaign {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  platform String // "vibe" | "mntn" | "roku" | "tatari" | "tvscientific" | "seat:ttd" | "seat:dv360" | "seat:amazon" | "seat:basis"
  mode     String @default("concierge") // "api" | "concierge"
  status   String @default("draft") @map("status")

  // Phase 5 per-buy approval object binding this buy. Every spend action
  // behind this object; autopilot drafts, never executes.
  approvalObjectId String? @map("approval_object_id")

  budgetCents    Int?      @map("budget_cents")
  currency       String    @default("USD")
  flightStart    DateTime? @map("flight_start")
  flightEnd      DateTime? @map("flight_end")
  targetingJson  Json?     @map("targeting_json")
  creativeIds    String[]  @map("creative_ids")
  creativeHashes String[]  @map("creative_hashes")

  // Vibe adapter binding: external campaign id + advertiser id once created
  // in Vibe (test-mode campaigns are flagged here, never billed).
  vibeAdvertiserId String? @map("vibe_advertiser_id")
  vibeCampaignId   String? @map("vibe_campaign_id")
  vibeTestMode     Boolean @default(true) @map("vibe_test_mode")
  vibeConfigRef    String? @map("vibe_config_ref") // vault ref, never raw creds

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spots       CtvSpot[]
  ios         CtvIo[]
  pixels      CtvPixel[]
  validations CtvCreativeValidation[]

  @@index([workspaceId, status])
  @@map("ctv_campaigns")
}

// F4: ffprobe creative validation result. Blocks submission of
// non-compliant creative. ffprobeJson is the raw parsed probe; checks are
// the named pass/fail list; publisherRulesVersion pins the publisher table.
model CtvCreativeValidation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId     String?      @map("campaign_id")
  campaign       CtvCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creativeId     String       @map("creative_id") // file-asset id or content hash
  creativeSha256 String?      @map("creative_sha256")

  ffprobeJson           Json    @map("ffprobe_json")
  pass                  Boolean
  checks                Json // [{ name, passed, detail }]
  durationSeconds       Float?  @map("duration_seconds")
  publisher             String? // publisher the rules were evaluated against
  publisherRulesVersion String  @map("publisher_rules_version")

  validatedBy String?  @map("validated_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, creativeId])
  @@map("ctv_creative_validations")
}

// F4: per-spot QR/pURL assignment. One dynamic QR + pURL per placement
// (show genre, daypart, demo). qrId/purlId reference phase-5 tracking_links.
model CtvSpot {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String      @map("campaign_id")
  campaign   CtvCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  placementLabel String  @map("placement_label")
  showGenre      String? @map("show_genre")
  daypart        String? @map("daypart")
  demo           String? @map("demo")
  creativeId     String? @map("creative_id")

  qrId   String? @map("qr_id") // phase-5 tracking_links(id)
  purlId String? @map("purl_id") // phase-5 tracking_links(id)
  qrSvg  String? @map("qr_svg") // rendered couch-distance QR (SVG)

  flightFrom DateTime? @map("flight_from")
  flightTo   DateTime? @map("flight_to")
  status     String    @default("active") // "active" | "ended"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, campaignId])
  @@map("ctv_spots")
}

// F4: concierge IO. state: draft | pending_vendor_approval | human_placed |
// live | reconciling | cancelled. IO payload carries the IO document +
// creative brief generated by Marketr; the human places the buy in the
// vendor UI. Alert-only: Marketr cannot pause these buys.
model CtvIo {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String      @map("campaign_id")
  campaign   CtvCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  vendor             String // "mntn" | "roku" | "tatari" | "tvscientific"
  ioPayload          Json      @map("io_payload") // IO doc + creative brief (generated)
  state              String    @default("draft") @map("state")
  placedBy           String?   @map("placed_by")
  placedAt           DateTime? @map("placed_at")
  vendorConfirmation String?   @map("vendor_confirmation") // human-entered confirmation ref

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, campaignId])
  @@map("ctv_ios")
}

// F4: impression-pixel hosting. pixelUrl is a signed Marketr-hosted 1x1
// pixel; impressions log to the local ledger (never a third party).
model CtvPixel {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String      @map("campaign_id")
  campaign   CtvCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  pixelUrl              String @map("pixel_url") // signed Marketr-hosted pixel URL
  pixelToken            String @map("pixel_token") // HMAC of campaign id
  viewThroughWindowDays Int    @default(14) @map("view_through_window_days")
  impressionsCount      Int    @default(0) @map("impressions_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pixelToken])
  @@map("ctv_pixels")
}

// ============================================================
// Phase 7 F-track fragment: dsp (merged by coordinator, 2026-09-25)
// ============================================================
// Marketr — Phase 7 F5 DSP READINESS track: Prisma fragment.
//
// Merged into prisma/schema.prisma by the coordinator's schema-merge step.
// Do NOT edit prisma/schema.prisma directly (track ownership rule).
// Conventions: cuid() ids, @map snake_case columns, workspace isolation,
// @@map table names. Margin ledger is append-only (post-only, never update).
//
// HARD CONSTRAINTS this model enforces (SPEC-PHASE7 §9.13, MASTER-PLAN §3.3):
// - ZERO custody: no table may hold a client payment instrument. dsp_adapters
//   holds only a config_ref (vault://...) — never credential material, PANs,
//   or tokens. Contracts and billing sit with the agency/client — never
//   Marketr. Marketr orchestrates, approves, kill-switches, and accounts.
// - The margin ledger keeps client-billed spend, platform fees, passthroughs,
//   and Marketr margin as DISTINCT columns. There is no combined-total
//   column; the service layer (lib/flywheel/dsp/ledger.ts) refuses any row
//   where client_billed != platform_fees + passthrough + marketr_margin, so
//   the margin can never be silently folded into another line.
// - fee_schedules are versioned (version + effective_from); every
//   margin_ledger row pins the fee_schedule_version live at the spend period.

enum DspKind {
  ttd
  dv360
  amazon
  basis
}

enum DspSeatStatus {
  none
  pending
  connected
}

// Seat-agnostic DSP adapter: the DSP is a plug-in behind a stable internal
// interface. v1 ships the model, not the seats — adapters fail closed
// without a connected agency seat.
model DspAdapter {
  id          String        @id @default(cuid()) @map("id")
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  dsp         DspKind       @map("dsp")
  seatStatus  DspSeatStatus @default(none) @map("seat_status")
  // Vault reference ONLY (vault://...). Never credential material.
  configRef   String?       @map("config_ref")
  connectedAt DateTime?     @map("connected_at")
  connectedBy String?       @map("connected_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, dsp])
  @@index([workspaceId])
  @@map("dsp_adapters")
}

// Versioned fee-schedule registry. fee_lines holds take rates, tech fees,
// minimums (JSON — versioned atomically with version/effective_from).
// Margin math is always audited against the schedule live at the spend time.
model FeeSchedule {
  id            String    @id @default(cuid()) @map("id")
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  dsp           DspKind   @map("dsp")
  version       Int       @map("version")
  feeLinesJson  Json      @map("fee_lines_json")
  effectiveFrom DateTime  @map("effective_from")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, dsp, version])
  @@index([workspaceId, dsp, effectiveFrom])
  @@map("fee_schedules")
}

// Margin accounting ledger (append-only). Four distinct money lines — never
// commingled. fee_schedule_version pins the live schedule for the period so
// margin math is auditable against the schedule that was live then.
model MarginLedgerRow {
  id                 String    @id @default(cuid()) @map("id")
  workspaceId        String    @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  period             String    @map("period") // YYYY-MM
  dspAdapterId       String    @map("dsp_adapter_id")
  dsp                DspKind   @map("dsp")
  clientBilledCents  Int       @map("client_billed_cents")
  platformFeesCents  Int       @map("platform_fees_cents")
  passthroughCents   Int       @map("passthrough_cents")
  marketrMarginCents Int       @map("marketr_margin_cents")
  feeScheduleVersion Int       @map("fee_schedule_version")
  note               String?   @map("note")
  postedBy           String    @map("posted_by")
  postedAt           DateTime  @default(now()) @map("posted_at")

  @@index([workspaceId, period])
  @@index([workspaceId, dspAdapterId])
  @@map("margin_ledger")
}

// ============================================================
// Phase 7 F-track fragment: launch (merged by coordinator, 2026-09-25)
// ============================================================
// Marketr — Phase 7 launch-readiness track (F6) data models.
//
// ASSEMBLY NOTE: this fragment is merged into prisma/schema.prisma by the
// phase-7 coordinator. It is a fragment — do NOT `prisma generate` against
// it directly. Validate the assembled schema with `prisma validate`.
//
// This fragment owns: launch_checklist.
//
// The checklist rows are seeded from the canonical catalog in
// lib/flywheel/launch/catalog.ts (the spec §F6 item list). Each row tracks
// one readiness item: its category (security|legal|community|build), its
// status, an evidence URL proving completion, and when it completed.
//
// All rows are workspace-isolated. No secrets, no PII, no credentials —
// evidence URLs only. The launch_checklist table itself is workspace-
// isolated per the F6 hard constraint.
//
// SPEC: docs/specs/SPEC-PHASE7.md §2/F6, §4 (launch_checklist), §5 (routes), §10 (exit
// gate 9). The open-core split is DEFERRED — this table tracks readiness
// only; no public-flip state lives here.

model LaunchChecklist {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Stable catalog key (e.g. "secret-history-scan") from
  // lib/flywheel/launch/catalog.ts. Unique per workspace so re-seeding is
  // idempotent.
  key String @map("key")

  // Human-readable item title (denormalized from the catalog at seed time
  // so history survives catalog edits).
  item String @map("item")

  // security | legal | community | build
  category String @map("category")

  // pending | in_progress | complete
  status String @default("pending") @map("status")

  // Proof of completion (commit link, doc path, CI run URL). Nullable until
  // complete.
  evidenceUrl String? @map("evidence_url")

  // Optional operator note (e.g. why an item is N/A, rotation ticket ref).
  note String? @map("note")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId, category])
  @@index([workspaceId, status])
  @@map("launch_checklist")
}

// ============================================================
// Phase 8 G1 — Business Graph substrate (docs/specs/SPEC-PHASE8.md §2 G1, §4).
// Postgres-native graph: append-only graph_facts log, resolved
// graph_nodes current state, bi-temporal graph_edges (Graphiti-style
// valid_at/invalid_at + created_at/expired_at), human-gated ER queue,
// connector hub + sync-job bookkeeping. RLS tenant isolation from day
// one (see migration: FORCE ROW LEVEL SECURITY + app.workspace_id GUC).
// The substrate reads/computes — it never touches spend (§3.1).
// ============================================================

enum GraphEntityType {
  customer
  competitor
  product
  service
  price
  brand
  employee
  location
  campaign_ref
  review
  website
  crm_record
  creative_asset
  keyword
  content
  channel
  offer
  audience
  landing_page
  form_cta
}

enum GraphErStatus {
  pending
  approved
  rejected
}

enum GraphConnectorPlatform {
  hubspot
  salesforce
  shopify
  woocommerce
  google_ads
  meta
  tiktok
  linkedin
}

enum GraphConnectorStatus {
  connected
  pending
  error
  revoked
}

enum GraphSyncTier {
  webhook
  scheduled
  manual
}

enum GraphSyncJobStatus {
  idle
  running
  succeeded
  failed
  backing_off
  dead
}

// Append-only fact log. Application code NEVER updates or deletes rows
// here (safety invariant §9.4) — corrections are new facts; retention
// archival moves rows to cold storage without mutating them.
model GraphFact {
  id             String    @id @default(cuid()) @map("id")
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // connector id | manual | import | onboarding
  source         String    @map("source")
  sourceRecordId String    @map("source_record_id")
  // deterministic node key hint, e.g. "customer:email:amy@example.com"
  entityRef      String    @map("entity_ref")
  factType       String    @map("fact_type")
  payload        Json      @map("payload")
  observedAt     DateTime  @map("observed_at")
  ingestedAt     DateTime  @default(now()) @map("ingested_at")
  // sha256 of the canonicalized payload — idempotent re-ingest
  contentHash    String    @map("content_hash")

  edges GraphEdge[]

  @@unique([workspaceId, source, sourceRecordId, factType, contentHash])
  @@index([workspaceId, entityRef])
  @@index([workspaceId, factType])
  @@index([workspaceId, ingestedAt])
  @@map("graph_facts")
}

// Resolved current state: one row per deduped entity.
model GraphNode {
  id           String          @id @default(cuid()) @map("id")
  workspaceId  String          @map("workspace_id")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType   GraphEntityType @map("entity_type")
  // deterministic: "<entityType>:<normalized dedupe key>" (email for
  // customer, domain for competitor/website, sku for product, ...)
  canonicalKey String          @map("canonical_key")
  displayName  String          @map("display_name")
  // typed queryable core (names, dates, amounts, geo)
  core         Json            @default("{}") @map("core")
  // long tail
  properties   Json            @default("{}") @map("properties")
  firstSeen    DateTime        @default(now()) @map("first_seen")
  lastSeen     DateTime        @default(now()) @map("last_seen")
  // freshness contract: every node carries as_of + source
  asOf         DateTime        @map("as_of")
  asOfSource   String          @map("as_of_source")
  // absorbed duplicates point at the canonical node (reversible merges)
  mergedIntoId String?         @map("merged_into_id")
  mergedInto   GraphNode?      @relation("GraphNodeMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  absorbed     GraphNode[]     @relation("GraphNodeMerge")

  edgesFrom   GraphEdge[]    @relation("GraphEdgeFrom")
  edgesTo     GraphEdge[]    @relation("GraphEdgeTo")
  erQueueA    GraphErQueue[] @relation("GraphErQueueA")
  erQueueB    GraphErQueue[] @relation("GraphErQueueB")
  // Phase 8 (G3): memory facts may anchor to a graph subject node.
  memoryFacts MemoryFact[]

  @@unique([workspaceId, canonicalKey])
  @@index([workspaceId, entityType])
  @@index([workspaceId, mergedIntoId])
  @@map("graph_nodes")
}

// Typed relationships, bi-temporal (Graphiti-style): valid_at/invalid_at
// is world time, created_at/expired_at is transaction time. New facts
// INVALIDATE old edges (set invalid_at/expired_at + superseded_by_id) —
// rows are never deleted, so point-in-time queries stay answerable.
model GraphEdge {
  id             String      @id @default(cuid()) @map("id")
  workspaceId    String      @map("workspace_id")
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromNodeId     String      @map("from_node_id")
  fromNode       GraphNode   @relation("GraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId       String      @map("to_node_id")
  toNode         GraphNode   @relation("GraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  edgeType       String      @map("edge_type")
  properties     Json        @default("{}") @map("properties")
  confidence     Float       @default(1.0) @map("confidence")
  validAt        DateTime    @map("valid_at")
  invalidAt      DateTime?   @map("invalid_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  expiredAt      DateTime?   @map("expired_at")
  sourceFactId   String?     @map("source_fact_id")
  sourceFact     GraphFact?  @relation(fields: [sourceFactId], references: [id], onDelete: SetNull)
  supersededById String?     @map("superseded_by_id")
  supersededBy   GraphEdge?  @relation("GraphEdgeSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     GraphEdge[] @relation("GraphEdgeSupersede")

  @@index([workspaceId, fromNodeId, edgeType])
  @@index([workspaceId, toNodeId, edgeType])
  @@index([workspaceId, edgeType, validAt])
  @@map("graph_edges")
}

// Ambiguous merge candidates for human review. v1: NO auto-merge — every
// merge is a human decision (safety invariant §9.6).
model GraphErQueue {
  id             String        @id @default(cuid()) @map("id")
  workspaceId    String        @map("workspace_id")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodeAId        String        @map("node_a_id")
  nodeA          GraphNode     @relation("GraphErQueueA", fields: [nodeAId], references: [id], onDelete: Cascade)
  nodeBId        String        @map("node_b_id")
  nodeB          GraphNode     @relation("GraphErQueueB", fields: [nodeBId], references: [id], onDelete: Cascade)
  matcherSignals Json          @default("[]") @map("matcher_signals")
  confidence     Float         @map("confidence")
  status         GraphErStatus @default(pending) @map("status")
  decidedBy      String?       @map("decided_by")
  decidedAt      DateTime?     @map("decided_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@map("graph_er_queue")
}

// Connector hub: one row per platform per workspace. Credentials live in
// the vault — authRef/webhookSecretRef are vault reference ids, NEVER
// secrets (safety invariant §9.9).
model GraphConnector {
  id               String                 @id @default(cuid()) @map("id")
  workspaceId      String                 @map("workspace_id")
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform         GraphConnectorPlatform @map("platform")
  authRef          String?                @map("auth_ref")
  tier             GraphSyncTier          @map("tier")
  status           GraphConnectorStatus   @default(pending) @map("status")
  scopesGranted    String[]               @default([]) @map("scopes_granted")
  webhookSecretRef String?                @map("webhook_secret_ref")

  syncJobs GraphSyncJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, platform])
  @@map("graph_connectors")
}

// Sync-job bookkeeping: cursor state, per-platform rate budgets,
// backoff-with-jitter. All sync work is async — nothing on the request path.
model GraphSyncJob {
  id            String             @id @default(cuid()) @map("id")
  workspaceId   String             @map("workspace_id")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectorId   String             @map("connector_id")
  connector     GraphConnector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  tier          GraphSyncTier      @map("tier")
  scheduleCron  String?            @map("schedule_cron")
  cursorState   Json               @default("{}") @map("cursor_state")
  // { dailyOps, usedOps, windowStart, callsPerHour, usedThisHour, ... }
  rateBudget    Json               @default("{}") @map("rate_budget")
  lastRunAt     DateTime?          @map("last_run_at")
  lastSuccessAt DateTime?          @map("last_success_at")
  errorCount    Int                @default(0) @map("error_count")
  backoffUntil  DateTime?          @map("backoff_until")
  status        GraphSyncJobStatus @default(idle) @map("status")

  @@index([workspaceId, connectorId, status])
  @@map("graph_sync_jobs")
}

// ============================================================
// Phase 8 G3 — Growth Memory substrate (docs/specs/SPEC-PHASE8.md §2 G3, §4).
// ============================================================
// Marketr — Growth Memory: three stores + one retrieval contract.
// Merged from prisma/fragments/phase8-memory.prisma by the G3 track
// builder (coordinator commits). See the fragment for full notes.

// migration is prisma/migrations/<ts>_phase8_memory/migration.sql, which
// also carries: pg_trgm + pgvector extensions (honest-fail with setup
// guidance per spec §9.12), tsvector generated columns, trigram GIN
// indexes, HNSW indexes, FORCE ROW LEVEL SECURITY policies, and the
// unified memory_index_view.
//
// Tenant isolation: every memory_* table carries workspace_id with FORCE
// RLS, fail-closed on the app.workspace_id GUC (mirrors G1's graph tables).
// playbook_learnings is deliberately cross-tenant (no workspace_id); rows
// enter only via the anonymization transform + human review gate.

// What happened: run/session/sync/agent-call records. Immutable —
// application code never UPDATEs or DELETEs these rows (spec §9.4).
enum MemoryEpisodeType {
  run
  session
  sync
  agent_call
}

// Procedural outcome verdicts (the F3 archive sink vocabulary).
enum MemoryLearningResult {
  worked
  failed
  inconclusive
}

// Where a learning came from.
enum MemoryLearningSource {
  test_lab
  reallocation
  campaign
  human
  import
  // Phase 13B: lessons distilled by the nightly consolidation pass
  // (episodic → durable learning), as opposed to human/import sources.
  consolidation
}

// Episodic store: raw what-happened. Immutable, never edited.
model MemoryEpisode {
  id          String                      @id @default(cuid()) @map("id")
  workspaceId String                      @map("workspace_id")
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  episodeType MemoryEpisodeType           @map("episode_type")
  actor       String                      @map("actor")
  summary     String                      @map("summary") @db.Text
  // links to graph nodes / campaigns / fragments (ids + kinds)
  refs        Json                        @default("{}") @map("refs")
  startedAt   DateTime                    @map("started_at")
  endedAt     DateTime?                   @map("ended_at")
  // Drift reconciliation (2026-09-26): this column existed in the DB
  // (DEFAULT CURRENT_TIMESTAMP) with no schema field; adopted so a
  // migrate-from-schema never proposes dropping it.
  createdAt   DateTime                    @default(now()) @map("created_at")
  // 384-d MiniLM embedding, written via raw SQL (Prisma Unsupported).
  // NULL until the embedder backfills it.
  embedding   Unsupported("vector(384)")? @map("embedding")
  // Full-text search vector, GENERATED ALWAYS by migration
  // 20260925180000_phase8_memory. Declared Unsupported (same as embedding)
  // so Prisma Migrate never tries to manage or drop it.
  search_tsv  Unsupported("tsvector")?    @map("search_tsv")

  learnings MemoryLearning[]   @relation("LearningSourceEpisode")
  facts     MemoryFact[]       @relation("FactSourceEpisode")
  // Phase 13B: feedback signals attached to agent-call episodes
  // (explicit thumbs, edit-diffs, accepts, regenerations).
  feedback  AgentFeedback[]    @relation("FeedbackSourceEpisode")
  knowledge CompanyKnowledge[] @relation("KnowledgeSourceEpisode")

  @@index([workspaceId, episodeType])
  @@index([workspaceId, startedAt])
  @@map("memory_episodes")
}

// Semantic store: distilled facts, bi-temporal (Graphiti-style).
// Contradictions resolve by invalidation (invalid_at/expired_at +
// superseded_by_id), never deletion (spec §9.5).
model MemoryFact {
  id              String                      @id @default(cuid()) @map("id")
  workspaceId     String                      @map("workspace_id")
  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subjectNodeId   String?                     @map("subject_node_id")
  subjectNode     GraphNode?                  @relation(fields: [subjectNodeId], references: [id], onDelete: SetNull)
  predicate       String                      @map("predicate")
  object          Json                        @map("object")
  confidence      Float                       @default(1.0) @map("confidence")
  // world time: when the fact was true
  validAt         DateTime                    @map("valid_at")
  invalidAt       DateTime?                   @map("invalid_at")
  // transaction time: when we believed it
  createdAt       DateTime                    @default(now()) @map("created_at")
  expiredAt       DateTime?                   @map("expired_at")
  sourceEpisodeId String?                     @map("source_episode_id")
  sourceEpisode   MemoryEpisode?              @relation("FactSourceEpisode", fields: [sourceEpisodeId], references: [id], onDelete: SetNull)
  supersededById  String?                     @map("superseded_by_id")
  supersededBy    MemoryFact?                 @relation("FactSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      MemoryFact[]                @relation("FactSupersede")
  // Decay-to-floor needs to know what survives a prune sweep:
  // user_told facts persist; agent_inferred fade; imported follows policy.
  origin          String                      @default("agent_inferred") @map("origin")
  embedding       Unsupported("vector(384)")? @map("embedding")
  // Full-text search vector, GENERATED ALWAYS by migration
  // 20260925180000_phase8_memory. Declared Unsupported so Prisma Migrate
  // never tries to manage or drop it.
  search_tsv      Unsupported("tsvector")?    @map("search_tsv")

  @@index([workspaceId, predicate])
  @@index([workspaceId, subjectNodeId])
  @@index([workspaceId, validAt])
  @@map("memory_facts")
}

// Procedural store: what worked / what failed / when. The F3 archive sink
// schema made real (lib/flywheel/testlab/memory-sink.ts).
model MemoryLearning {
  id              String                      @id @default(cuid()) @map("id")
  workspaceId     String                      @map("workspace_id")
  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hypothesis      String                      @map("hypothesis") @db.Text
  action          String                      @map("action") @db.Text
  result          MemoryLearningResult        @map("result")
  metricDelta     Json                        @default("{}") @map("metric_delta")
  observedAt      DateTime                    @map("observed_at")
  invalidatedAt   DateTime?                   @map("invalidated_at")
  // campaign / experiment / channel context refs
  contextRefs     Json                        @default("{}") @map("context_refs")
  source          MemoryLearningSource        @map("source")
  sourceEpisodeId String?                     @map("source_episode_id")
  sourceEpisode   MemoryEpisode?              @relation("LearningSourceEpisode", fields: [sourceEpisodeId], references: [id], onDelete: SetNull)
  embedding       Unsupported("vector(384)")? @map("embedding")
  // Full-text search vector, GENERATED ALWAYS by migration
  // 20260925180000_phase8_memory. Declared Unsupported so Prisma Migrate
  // never tries to manage or drop it.
  search_tsv      Unsupported("tsvector")?    @map("search_tsv")

  @@index([workspaceId, result])
  @@index([workspaceId, observedAt])
  @@index([workspaceId, source])
  @@map("memory_learnings")
}

// Consolidation worker bookkeeping (powers GET /api/substrate/memory/consolidation).
model MemoryConsolidationRun {
  id               String    @id @default(cuid()) @map("id")
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  status           String    @default("running") @map("status")
  episodesScanned  Int       @default(0) @map("episodes_scanned")
  factsDistilled   Int       @default(0) @map("facts_distilled")
  factsInvalidated Int       @default(0) @map("facts_invalidated")
  learningsDeduped Int       @default(0) @map("learnings_deduped")
  rowsPruned       Int       @default(0) @map("rows_pruned")
  error            String?   @map("error") @db.Text

  @@index([workspaceId, startedAt])
  @@map("memory_consolidation_runs")
}

// Cross-client learning: anonymized playbook patterns ONLY. No
// workspace_id — deliberately cross-tenant. Rows enter only through the
// anonymization transform (lib/substrate/memory/anonymize.ts) AND a human
// review gate (reviewed_at + anonymization_reviewed_by set). Unreviewed
// patterns never publish (spec §9.3; enforced by RLS + API + battery).
model PlaybookLearning {
  id                      String    @id @default(cuid()) @map("id")
  patternTitle            String    @map("pattern_title")
  patternBody             String    @map("pattern_body") @db.Text
  supportingClientCount   Int       @default(1) @map("supporting_client_count")
  firstObserved           DateTime  @default(now()) @map("first_observed")
  lastObserved            DateTime  @default(now()) @map("last_observed")
  anonymizationReviewedBy String?   @map("anonymization_reviewed_by")
  reviewedAt              DateTime? @map("reviewed_at")

  @@index([reviewedAt])
  @@map("playbook_learnings")
}

// ============================================================
// Phase 13B (G0): Agent Learning + Company Intelligence data model.
// SPEC: docs/phases/PHASE13B-AGENT-LEARNING-SPEC.md §3; full decision
// record: docs/phases/13b/DATA-MODEL.md.
//
// MAPPING DOCTRINE — "no second memory system" (spec §9: Growth Memory
// consolidate is EXTENDED, not replaced):
//   • AgentEpisode      → memory_episodes, episodeType="agent_call".
//     The episodic store IS the immutable "what happened" log; an agent
//     interaction (prompt in, output out, outcome) is already expressible
//     with EpisodeInput{actor=agentId, summary, refs={promptSummary,
//     outputSummary, outcome}}. A separate AgentEpisode table would
//     duplicate the episodic store with a worse audit story — so it
//     does not exist.
//   • AgentLesson       → memory_learnings, source="consolidation".
//     Lessons are procedural ("what worked / failed / when") — exactly
//     the F3 sink schema. lesson text → hypothesis, action → the
//     consolidation pass description, status active|retired →
//     invalidatedAt NULL vs set (retire = invalidate, NEVER delete),
//     confidence → metricDelta.confidence (the JSON extensibility point).
//     Enum gains "consolidation" because the existing sources
//     (test_lab/reallocation/campaign/human/import) describe where a
//     learning came from, and consolidation is a new source.
//   • WorkspacePreference → memory_facts, predicate="pref:<key>",
//     object={value, pinned?}, subjectNodeId=NULL.
//     DEVIATION from the task brief ("subjectNodeId='workspace'"): the
//     FK to graph_nodes would REJECT a literal "workspace" id. NULL +
//     the "pref:" predicate namespace is the honest convention. The
//     semantic store's bi-temporality (validAt/invalidAt, supersede
//     chain) is exactly how preferences evolve; user-pinned prefs use
//     origin="user_told" (decay-to-floor survivor), learner-derived
//     ones use origin="agent_inferred". Helper:
//     lib/substrate/memory/preferences.ts.
//   • LearningPause       → memory_facts, predicate="pref:learning_paused",
//     object={value: bool, pausedAt}. DEVIATION from the task brief
//     (LearningPause model): the pause toggle IS a preference — a
//     dedicated table would be a mini preference system duplicating
//     memory_facts' confidence/bi-temporal/pin semantics. See the same
//     helper module (getLearningPaused / setLearningPaused).
//
// NEW models below are the structured COMPANY-INTELLIGENCE ARTIFACTS,
// not memory: user-editable documents with taxonomy, pin/lock, reviewable
// learner diffs. Memory is the engine; these are the artifacts (§2).
// All six are tenant-scoped (workspace_id NOT NULL), FORCE RLS with the
// app.workspace_id GUC, fail-closed (see migration
// <ts>_phase13b_intelligence).
// ============================================================

// Feedback signals on agent-call episodes — the richest raw material
// for the learning loop (spec §1). Distinct from memory_episodes:
// feedback is a *signal about* an episode (kind + payload), not a
// what-happened narrative.
enum FeedbackKind {
  explicit_up
  explicit_down
  edit_diff
  accepted
  regenerated
}

model AgentFeedback {
  id          String         @id @default(cuid()) @map("id")
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Nullable: feedback can attach to a non-episode artifact (e.g. a
  // static suggestion); when it cites an agent call it links here.
  episodeId   String?        @map("episode_id")
  episode     MemoryEpisode? @relation("FeedbackSourceEpisode", fields: [episodeId], references: [id], onDelete: SetNull)
  // Which agent persona produced the output (e.g. "strategist").
  agentId     String         @map("agent_id")
  kind        FeedbackKind   @map("kind")
  // Kind-specific payload: thumbs → {source}; edit_diff → {before,
  // after, diffStats}; accepted → {withEdits: bool}; regenerated →
  // {reason}. Never raw user PII beyond what episodes already carry —
  // scrubbed by the feedback pipeline (worker 4).
  signal      Json           @map("signal")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind])
  @@index([workspaceId, episodeId])
  @@map("agent_feedback")
}

// The living Brand Voice profile (spec §2). One row per workspace; the
// consolidation loop (worker 6) writes PROPOSALS into pendingUpdates —
// never directly into dimensions — so the user always sees a reviewable
// diff ("I updated your voice profile from your last 12 edits —
// review"). pinnedByUser=true makes the whole profile read-only to the
// learner (spec: "don't touch the voice profile").
model BrandVoiceProfile {
  id             String    @id @default(cuid()) @map("id")
  workspaceId    String    @unique @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // {vocabulary: [...], rhythm, formality, pov, humor, doExamples: [...],
  //  dontExamples: [...]} — vocabulary per Jasper's voice engine shape.
  dimensions     Json      @map("dimensions")
  // {samples: [...ids/hashes], editCount, lastDerivedAt} — provenance so
  // the user can see WHAT the voice was learned from.
  derivedFrom    Json      @map("derived_from")
  confidence     Float     @default(0.0) @map("confidence")
  pinnedByUser   Boolean   @default(false) @map("pinned_by_user")
  // Proposed by the learner, awaiting user review; applied to
  // dimensions only on explicit accept (worker 6 + UI worker 7).
  pendingUpdates Json?     @map("pending_updates")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("brand_voice_profiles")
}

// Company knowledge graph entries (spec §2): products, pricing,
// audiences, competitors, messaging pillars, proof points, positioning.
// A structured, user-editable, agent-readable document — NOT a memory
// fact: it carries a taxonomy, pins, validity eras, and learner-diff
// semantics that semantic triples don't.
enum KnowledgeKind {
  product
  pricing
  audience
  competitor
  pillar
  proof
  positioning
  other
}

model CompanyKnowledge {
  id              String         @id @default(cuid()) @map("id")
  workspaceId     String         @map("workspace_id")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind            KnowledgeKind  @map("kind")
  title           String         @map("title")
  // Structured body; shape per kind (e.g. pricing → {tiers: [...]};
  // competitor → {strengths, weaknesses, url}). Documented in
  // docs/phases/13b/DATA-MODEL.md contract section.
  body            Json           @map("body")
  confidence      Float          @default(1.0) @map("confidence")
  // Pinned = learner may not modify or propose updates to this entry.
  pinned          Boolean        @default(false) @map("pinned")
  sourceEpisodeId String?        @map("source_episode_id")
  sourceEpisode   MemoryEpisode? @relation("KnowledgeSourceEpisode", fields: [sourceEpisodeId], references: [id], onDelete: SetNull)
  // Validity era: pricing that changed has a closed era, history kept.
  validFrom       DateTime?      @map("valid_from")
  validTo         DateTime?      @map("valid_to")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, kind])
  @@index([workspaceId, createdAt])
  @@map("company_knowledge")
}

// Hard style constraints checked on EVERY agent output, pre-delivery
// (spec §2): banned words/phrases, required disclaimers, compliance
// lines. Fail-closed: severity=block violations block delivery;
// severity=flag surfaces a warning. Learner-proposed rules arrive with
// active=false (worker 6) and go live only on user accept.
enum StyleRuleKind {
  ban
  require
  disclaimer
  tone
}

enum StyleRuleSeverity {
  block
  flag
}

model StyleRule {
  id          String            @id @default(cuid()) @map("id")
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        StyleRuleKind     @map("kind")
  // ban → the forbidden phrase/regex; require → the required line;
  // disclaimer → compliance text; tone → guidance snippet.
  pattern     String            @map("pattern") @db.Text
  // ban → suggested replacement; require/disclaimer → insertion
  // context; tone → null.
  replacement String?           @map("replacement") @db.Text
  severity    StyleRuleSeverity @map("severity")
  pinned      Boolean           @default(false) @map("pinned")
  active      Boolean           @default(true) @map("active")
  // "user" | "onboarding" | "consolidation" — who/what created it.
  source      String            @map("source")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([workspaceId, kind, active])
  @@index([workspaceId, createdAt])
  @@map("style_rules")
}

// Content memory (spec §2): everything ever made for this company,
// retrievable for consistency ("we already ran this angle in March —
// here's how it performed"). Distinct from memory_episodes: this is a
// curated artifact with angle/channel/performance, not an immutable
// what-happened log. bodyRef points at the actual artifact (editor doc
// id / URL / asset id) — the body itself is NOT duplicated here.
model ContentRecord {
  id          String    @id @default(cuid()) @map("id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Free-string taxonomy (blog_post, email, social_post, ad, landing,
  // video_script, ...) — kinds grow faster than enums.
  kind        String    @map("kind")
  title       String    @map("title")
  bodyRef     String?   @map("body_ref")
  // The creative angle/hook, for dedupe ("did we already run this?").
  angle       String?   @map("angle") @db.Text
  // Channel it ran on (blog, linkedin, tiktok, email, ...) — null for
  // drafts that never shipped.
  channel     String?   @map("channel")
  // {impressions, clicks, conversions, rankDelta, ...} — fed by the
  // analytics integrations; null until measured. Closes the loop:
  // learn → create → measure → learn (spec §2).
  performance Json?     @map("performance")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind])
  @@map("content_records")
}

// The "human" layer per persona (spec §5). The five personas exist as
// roles from Phase 12; this gives each a persistent voice, continuity,
// and honesty posture.
// DEVIATION from the task brief ("agentId unique"): uniqueness MUST be
// per (workspaceId, agentId). A globally-unique agentId would forbid
// every workspace but the first from defining its own voice for the
// same persona — incoherent under tenant scoping. All reads/writes go
// through withWorkspaceScope (fail-closed).
model PersonaProfile {
  id               String    @id @default(cuid()) @map("id")
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Phase-12 persona key (canonical five, see lib/expert/personas/):
  // "business-strategist" | "agents-orchestrator" |
  // "multi-agent-systems-architect" | "workflow-architect" |
  // "studio-producer".
  agentId          String    @map("agent_id")
  // {register, manner, quirks: [...], taboos: [...]} — how it talks.
  voice            Json      @map("voice")
  // Long-lived continuity: commitments, running jokes, known user
  // facts this persona keeps ("last week you decided X").
  continuityNotes  String    @map("continuity_notes") @db.Text
  // How this persona expresses uncertainty ("my best read is X, I'm
  // not sure about Y") vs. asking a clarifying question.
  uncertaintyStyle String    @map("uncertainty_style") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, agentId])
  @@map("persona_profiles")
}

// ============================================================
// Phase 9 (M1): GrowthOS orchestrator — data + safety core.
// docs/specs/SPEC-PHASE9.md §5. All workspace-scoped, RLS-isolated (migration
// 20260926093000_phase9_growthos_core). Additive only — existing models
// untouched except Workspace.frozenAt (workspace-freeze kill switch).
// ============================================================

enum MissionStatus {
  planned
  active
  paused
  complete
  archived
}

model Mission {
  id           String        @id @default(cuid()) @map("id")
  workspaceId  String        @map("workspace_id")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template     String        @map("template")
  goal         Json          @map("goal")
  status       MissionStatus @default(planned) @map("status")
  planSnapshot Json          @map("plan_snapshot")
  checkpoints  Json          @map("checkpoints")
  budgetCaps   Json          @map("budget_caps")
  termination  Json          @map("termination")
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  events    MissionEvent[]
  approvals MissionApproval[]
  // Phase 12 "Reconsider trio": optional link to a Plane project (sidecar).
  planeLink MissionPlaneLink?

  @@index([workspaceId, status])
  @@map("missions")
}

// Phase 12 "Reconsider trio": link one Marketr mission to one Plane project
// (the AGPL-3.0 project-management sidecar, talked to over HTTP only).
// The link is data, not Plane code — no license contamination. Deleting the
// mission or workspace cascades the link; the Plane side is untouched.
model MissionPlaneLink {
  id               String    @id @default(cuid()) @map("id")
  missionId        String    @unique @map("mission_id")
  mission          Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Plane identifiers (from PLANE_WORKSPACE_SLUG + the project list API).
  planeSlug        String    @map("plane_slug")
  planeProjectId   String    @map("plane_project_id")
  planeProjectName String    @map("plane_project_name")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mission_plane_links")
}

// APPEND-ONLY: app code must never update or delete rows. The hash chain
// (prevHash -> eventHash) makes tampering detectable.
model MissionEvent {
  id          String    @id @default(cuid()) @map("id")
  missionId   String    @map("mission_id")
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts          DateTime  @default(now()) @map("ts")
  actor       String    @map("actor")
  step        String?   @map("step")
  tool        String?   @map("tool")
  args        Json      @default("{}") @map("args")
  observation Json      @default("{}") @map("observation")
  costCents   Int       @default(0) @map("cost_cents")
  eventHash   String    @map("event_hash")
  prevHash    String    @map("prev_hash")

  @@index([missionId, ts])
  @@index([workspaceId, ts])
  @@map("mission_events")
}

enum MissionApprovalStatus {
  pending
  approved
  denied
  expired
  revoked
  executed
}

// Extends the Phase 5 (media_approvals) / Phase 6 (authority_approvals)
// approval object pattern: canonicalized binding JSON + SHA-256 binding
// hash; the executor re-verifies the exact payload before acting.
model MissionApproval {
  id          String                @id @default(cuid()) @map("id")
  missionId   String?               @map("mission_id")
  mission     Mission?              @relation(fields: [missionId], references: [id], onDelete: SetNull)
  workspaceId String                @map("workspace_id")
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action      String                @map("action")
  tier        Int                   @map("tier")
  bindingJson Json                  @map("binding_json")
  bindingHash String                @map("binding_hash")
  status      MissionApprovalStatus @default(pending) @map("status")
  approvers   String[]              @default([]) @map("approvers")
  decidedBy   String?               @map("decided_by")
  decidedAt   DateTime?             @map("decided_at")
  expiresAt   DateTime              @map("expires_at")
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")

  approvalEvents MissionApprovalEvent[]

  @@index([workspaceId, status])
  @@index([missionId, status])
  @@map("mission_approvals")
}

// APPEND-ONLY: hash-chained approval event trail (M1 gap #2, M6). One chain
// per approval_id: prev_hash = previous eventHash ("GENESIS" for the first).
// App code must never update or delete rows.
model MissionApprovalEvent {
  id          String          @id @default(cuid()) @map("id")
  approvalId  String          @map("approval_id")
  approval    MissionApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts          DateTime        @default(now()) @map("ts")
  actor       String          @map("actor")
  action      String          @map("action")
  payloadHash String          @map("payload_hash")
  prevHash    String          @map("prev_hash")
  eventHash   String          @map("event_hash")

  @@index([approvalId, ts])
  @@index([workspaceId, ts])
  @@map("mission_approval_events")
}

// User-editable escalation rules for the automation policy (§P9E).
// condition_json: { kind: "amount_above"|"unseen_treatment"|"no_source_record"|"external_audience", value? }.
// action: "require_approval" | "notify".
model EscalationRule {
  id            String    @id @default(cuid()) @map("id")
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String    @map("name")
  conditionJson Json      @map("condition_json")
  action        String    @map("action")
  enabled       Boolean   @default(true) @map("enabled")
  position      Int       @default(0) @map("position")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, position])
  @@map("escalation_rules")
}

enum PlaybookSource {
  learned
  community
  seed
}

model Playbook {
  id          String         @id @default(cuid()) @map("id")
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String         @map("name")
  source      PlaybookSource @map("source")
  description String?        @map("description") @db.Text
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  versions PlaybookVersion[]

  @@index([workspaceId, source])
  @@map("playbooks")
}

enum PlaybookVersionStatus {
  draft
  eval
  review
  canary
  production
  deprecated
}

// IMMUTABLE: app code must never update or delete rows. New content = new
// version row. Rollback = move the label pointers (labels), never rewrite.
model PlaybookVersion {
  id                 String                @id @default(cuid()) @map("id")
  playbookId         String                @map("playbook_id")
  playbook           Playbook              @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  workspaceId        String                @map("workspace_id")
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version            Int                   @map("version")
  content            Json                  @map("content")
  contentHash        String                @map("content_hash")
  status             PlaybookVersionStatus @default(draft) @map("status")
  labels             String[]              @default([]) @map("labels")
  evalResults        Json?                 @map("eval_results")
  outcomeAttribution Json?                 @map("outcome_attribution")
  createdBy          String                @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")

  @@unique([playbookId, version])
  @@index([workspaceId, status])
  @@map("playbook_versions")
}

enum AutomationBehavior {
  auto
  ask
  never
}

// Per-action automation behavior (Tico's decision: user-customizable
// automation). Resolved by the DoA tier evaluator at execution time.
model AutomationSetting {
  id             String             @id @default(cuid()) @map("id")
  workspaceId    String             @map("workspace_id")
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Phase 5: "*" = every agent; otherwise a rule for one agent ("lead" or a
