  @@unique([workspaceId, targetUrl, sourceUrl])
  @@index([workspaceId, status])
  @@map("link_verification")
}

// Phase 12 (embeds): tenant-scoped GrowthBook flag overrides. Marketr
// keeps the flag *definitions* in GrowthBook (open core) but the admin's
// toggle writes a per-workspace override here — one tenant's experiment
// never leaks into another's. The SDK is seeded with the effective
// (overridden) values; GrowthBook's global default stays untouched unless
// changed in GrowthBook itself.
model WorkspaceFlagOverride {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("workspace_flag_overrides")
}

// ============================================================
// Phase 13C: Clipper (OpusClip-style video clipping) — data model.
// All workspace-scoped, RLS-isolated (migration *_phase13c_clipper).
// Additive only — existing models untouched.
// ============================================================

// A long-form video ingested for clipping ("upload" = fileRef points at
// stored media; "url" = sourceUrl points at the remote original).
model ClipSource {
  id               String    @id @default(cuid()) @map("id")
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin           String    @map("origin") // "upload" | "url"
  title            String    @map("title")
  sourceUrl        String?   @map("source_url")
  fileRef          String?   @map("file_ref")
  durationSec      Float?    @map("duration_sec")
  transcriptStatus String    @default("pending") @map("transcript_status") // pending|processing|ready|failed
  transcript       Json?     @map("transcript") // { words: [{w,start,end}], text }
  createdAt        DateTime  @default(now()) @map("created_at")

  clips Clip[]
  jobs  ClipJob[]

  @@index([workspaceId, createdAt])
  @@map("clip_sources")
}

// A single generated clip candidate: time window + virality score +
// caption styling + render + approval/delivery state.
model Clip {
  id            String     @id @default(cuid()) @map("id")
  workspaceId   String     @map("workspace_id")
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId      String     @map("source_id")
  source        ClipSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startSec      Float      @map("start_sec")
  endSec        Float      @map("end_sec")
  viralityScore Float      @map("virality_score")
  // Why it scored what it did: [{label, detail, weight}, ...].
  scoreReasons  Json       @default("[]") @map("score_reasons")
  // Opening line of the segment (hook display in the UI).
  hookText      String?    @map("hook_text") @db.Text
  // Locked brand-kit caption style: {font, size, position, colors}.
  captionStyle  Json       @default("{}") @map("caption_style")
  // Rendered captions: { segments: [{text, start, end}], style }.
  captions      Json?      @map("captions")
  status        String     @default("draft") @map("status") // draft|approved|queued|posted|failed
  renderStatus  String     @default("pending") @map("render_status") // pending|processing|ready|failed
  outputRef     String?    @map("output_ref")
  // Postiz draft id once handed off (draft-first, never auto-post).
  postizRef     String?    @map("postiz_ref")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@index([sourceId])
  @@map("clips")
}

// Async pipeline work for the clipper: transcribe / generate / render.
// Progress 0..1; payload carries kind-specific inputs/outputs.
model ClipJob {
  id          String      @id @default(cuid()) @map("id")
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    String?     @map("source_id")
  source      ClipSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind        String      @map("kind") // transcribe|generate|render
  status      String      @default("pending") @map("status") // pending|processing|done|failed
  progress    Float       @default(0) @map("progress")
  payload     Json        @default("{}") @map("payload")
  error       String?     @map("error")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("clip_jobs")
}

// ── Phase 13D: voice/text agents (LiveKit + VoiceStudio) ──

// A configured agent in a workspace: lead follow-up (voice/text) or
// voiceover narration. TTS backend defaults to VoiceStudio (local).
model VoiceAgent {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  purpose      String // followup | voiceover
  // VoiceStudio voice id (default backend) or provider voice id when the
  // workspace opts into a BYO provider key.
  voiceId      String    @map("voice_id")
  voiceBackend String    @default("voicestudio") @map("voice_backend") // voicestudio | byo_provider
  // Persona prompt seed, hours, escalation rules, consent-list refs.
  config       Json      @default("{}")
  // Workspace kill switch: when true the agent refuses all new sessions.
  killSwitch   Boolean   @default(false) @map("kill_switch")
  status       String    @default("active") // active | paused | archived
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scripts       CallScript[]
  sessions      CallSession[]
  voiceoverJobs VoiceoverJob[]

  @@index([workspaceId, purpose, status])
  @@map("voice_agents")
}

// A call script. Drafts can NEVER dial — only human-approved scripts may
// be attached to a live session. New objection branches flag for review.
model CallScript {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId     String     @map("agent_id")
  agent       VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String
  version     Int        @default(1)
  // { opening (with AI disclosure), branches, objection handlers, closing }.
  body        Json
  status      String     @default("draft") // draft | approved | rejected | archived
  approvedBy  String?    @map("approved_by")
  approvedAt  DateTime?  @map("approved_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  sessions CallSession[]

  @@index([workspaceId, agentId, status])
  @@map("call_scripts")
}

// One voice/text session with a prospect. Consent-gated: a session may
// only go live when ContactConsent shows opted-in for the channel AND the
// script is approved AND the kill switch is off. Everything else is
// rehearsal. Full transcript + audit trail on every session.
model CallSession {
  id               String      @id @default(cuid())
  workspaceId      String      @map("workspace_id")
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId          String      @map("agent_id")
  agent            VoiceAgent  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  leadId           String      @map("lead_id")
  lead             Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scriptId         String?     @map("script_id")
  script           CallScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  channel          String // voice | sms | chat
  direction        String      @default("outbound") // outbound | inbound
  // Snapshot of the consent record at session start (first-class proof).
  consentProof     Json        @default("{}") @map("consent_proof")
  // Full transcript: [{ role: agent|prospect|system, text, ts }].
  transcript       Json        @default("[]")
  recordingRef     String?     @map("recording_ref")
  recordingConsent Boolean     @default(false) @map("recording_consent")
  outcome          String? // qualified | booked | callback | not_interested | no_answer | refused_no_consent ...
  // Every state transition + human override, for the audit trail.
  auditTrail       Json        @default("[]") @map("audit_trail")
  status           String      @default("rehearsal") // rehearsal | queued | in_progress | completed | cancelled | blocked
  // Set when a consent/killswitch/script gate refuses the session.
  blockReason      String?     @map("block_reason")
  startedAt        DateTime?   @map("started_at")
  endedAt          DateTime?   @map("ended_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@index([agentId, createdAt])
  @@index([leadId])
  @@map("call_sessions")
}

// A TTS narration job: script -> VoiceStudio -> audio, attached to a 13C
// clip or Studio video. Pronunciation snapshot applied at render time.
model VoiceoverJob {
  id            String      @id @default(cuid())
  workspaceId   String      @map("workspace_id")
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId       String?     @map("agent_id")
  agent         VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  script        String      @db.Text
  voiceId       String      @map("voice_id")
  voiceBackend  String      @default("voicestudio") @map("voice_backend")
  // Pronunciation entries applied at render: [{ term, phonetic }].
  pronunciation Json        @default("[]")
  audioRef      String?     @map("audio_ref")
  // Optional attach target: 13C clip id or Studio asset ref.
  clipId        String?     @map("clip_id")
  status        String      @default("pending") // pending | processing | ready | failed
  progress      Float       @default(0)
  error         String?
  durationSec   Float?      @map("duration_sec")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("voiceover_jobs")
}

// Workspace pronunciation dictionary, seeded from the 13B knowledge
// graph (product names, people) and editable per workspace.
model PronunciationEntry {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  term        String
  phonetic    String
  source      String    @default("manual") // knowledge_graph | manual
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, term])
  @@index([workspaceId])
  @@map("pronunciation_entries")
}

// ---------------------------------------------------------------------------
// Phase 14 — Actions & Office (Composio + Univer).
// Composio: universal action layer (hosted). Marketr stores only the
// Composio entity/user reference per workspace — never raw OAuth tokens.
// Univer: native office surface; host-owned snapshots persisted here.
// ---------------------------------------------------------------------------

// One connected third-party app per workspace (Composio entity reference).
model ComposioConnection {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Composio app key, e.g. "gmail", "slack", "hubspot", "notion".
  appKey           String    @map("app_key")
  // Opaque Composio entity/user id — the only credential-adjacent value we
  // store. Raw OAuth tokens live in Composio's cloud (hosted tier).
  composioEntityId String    @map("composio_entity_id")
  status           String    @default("connected") // connected | revoked | error
  // Granted scopes as returned by the Composio OAuth flow (string array).
  scopes           Json      @default("[]")
  lastError        String?   @map("last_error")
  connectedAt      DateTime  @default(now()) @map("connected_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, appKey])
  @@index([workspaceId, status])
  @@map("composio_connections")
}

// Human-in-the-loop approval for a proposed agent action (Phase 14 §3).
// Medium (writes) and high (destructive) tiers land here; low (reads) and
// draft-creators execute freely but are always logged in ComposioActionLog.
model ComposioActionApproval {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appKey         String    @map("app_key")
  toolName       String    @map("tool_name")
  // low | medium | high (derived from the action name; manual overrides win).
  riskTier       String    @map("risk_tier")
  // Proposed tool args with sensitive values redacted at proposal time.
  proposedArgs   Json      @map("proposed_args")
  // Plain-language "what will happen" — never raw JSON in the UI.
  plainSummary   String    @map("plain_summary") @db.Text
  // pending | approved | denied | expired | executed (executed = replay lock)
  status         String    @default("pending")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  decisionReason String?   @map("decision_reason") @db.Text
  expiresAt      DateTime  @map("expires_at")
  // Append-only audit trail: [{ at, actor, event, detail }].
  auditTrail     Json      @default("[]") @map("audit_trail")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  actionLogs ComposioActionLog[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, toolName])
  @@map("composio_action_approvals")
}

// Every executed (or attempted) action: the audit + metering record.
model ComposioActionLog {
  id            String                  @id @default(cuid())
  workspaceId   String                  @map("workspace_id")
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalId    String?                 @map("approval_id")
  approval      ComposioActionApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  appKey        String                  @map("app_key")
  toolName      String                  @map("tool_name")
  riskTier      String                  @map("risk_tier")
  argsSummary   Json                    @default("{}") @map("args_summary")
  resultSummary Json                    @default("{}") @map("result_summary")
  latencyMs     Int?                    @map("latency_ms")
  // Phase 15 slice 4 (spec §4/§5): toolkit attribution — which Composio
  // toolkit the executed tool belonged to (e.g. "hubspot"). Powers the
  // per-toolkit cost attribution ("HubSpot ate 40% of your calls").
  // Nullable: rows written before this slice (or where resolution failed)
  // carry no toolkit and land in the "unknown" attribution bucket.
  toolkitSlug   String?                 @map("toolkit_slug")
  // success | failed | denied | expired
  status        String
  // Who/what triggered it: user id or "agent:<surface>".
  executedBy    String                  @map("executed_by")
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, toolName, createdAt])
  // Phase 15 slice 4: per-toolkit cost attribution queries.
  @@index([workspaceId, toolkitSlug, createdAt])
  @@map("composio_action_logs")
}

// Phase 14 slice 10: platform-wide Composio hosted free-tier counter.
// Deliberately NO row-level security: it holds only an aggregate call count
// per calendar month (no tenant data), and the budget gauge must be readable
// without a workspace scope (composio_action_logs is FORCE RLS, so a direct
// platform-wide count always returns zero).
model ComposioPlatformUsage {
  // "2026-09"
  periodKey String   @id @map("period_key")
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("composio_platform_usage")
}

// Phase 15 slice 1: per-workspace discovered tool catalog (spec §1/§4).
// Replaces the static V1_ACTION_CATALOG pinning with live discovery; the
// v1 catalog itself stays as the verified baseline (never delete it).
// Composio tools remain Composio's IP — we store slugs + metadata only.
model ComposioToolCatalog {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appKey       String    @map("app_key")
  toolkitSlug  String    @map("toolkit_slug")
  toolSlug     String    @map("tool_slug")
  toolLabel    String?   @map("tool_label")
  description  String?   @db.Text
  // Monotonic per (workspaceId, appKey) refresh counter; bumps each refresh.
  version      Int       @default(1)
  discoveredAt DateTime  @default(now()) @map("discovered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, toolkitSlug, toolSlug])
  @@index([workspaceId, appKey])
  @@map("composio_tool_catalog")
}

// Phase 15 slice 5: catalog drift detection (spec §1, §6). One row per
// detected change (added|removed|renamed) per (workspace, toolkit) — the
// nightly diff of live discovery vs the ComposioToolCatalog cache.
// Removed tools keep their last-known cache rows (slice-1 behavior); the
// drift row is what flags them in Actions → Activity.
// Acknowledging is the human's re-approval of the change: it clears the
// banner count AND the stale-override flag for that slug (a renamed tool's
// override must be re-pointed at the new slug before re-approval).
// RLS: same tenant-isolation pattern as slice 1 (FORCE; see migration).
model ComposioCatalogDrift {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appKey         String    @map("app_key")
  toolkitSlug    String    @map("toolkit_slug")
  changeType     String    @map("change_type") // added | removed | renamed
  toolSlug       String    @map("tool_slug")
  oldSlug        String?   @map("old_slug") // renamed: the dead slug
  detectedAt     DateTime  @default(now()) @map("detected_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  @@index([workspaceId, detectedAt])
  @@map("composio_catalog_drift")
}

// Phase 15 slice 3: which toolkits a workspace has enabled in the full
// firehose directory (locked: NO PACKS). Enablement is per-workspace and
// explicit; the proposeAction gate refuses (fail-closed) any tool whose
// toolkit is not enabled. The v1 five (gmail, google_sheets, slack,
// hubspot, notion) are enabled-by-default in code for backward compat —
// existing workspaces see zero regression without a row here.
// RLS: same tenant-isolation pattern as Phase 14/15 slice 1 (migration SQL).
model WorkspaceToolkit {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Composio toolkit slug, e.g. "gmail" / "google_sheets".
  toolkitSlug String    @map("toolkit_slug")
  // appKey snapshot at enable time, e.g. "google-sheets" (nullable — a
  // toolkit may have no v1-style appKey if the router changes shape).
  appKey      String?   @map("app_key")
  // User id that last enabled/disabled this toolkit (nullable — system
  // rows or backfilled defaults may carry no actor).
  enabledBy   String?   @map("enabled_by")
  enabled     Boolean   @default(true)
  enabledAt   DateTime  @default(now()) @map("enabled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, toolkitSlug])
  @@index([workspaceId, enabled])
  @@map("workspace_toolkits")
}

// Phase 15 slice 4: per-workspace Composio call budgets (spec §5).
// Soft cap: usage alerts (default at 80%, fire-once per month) — never
// blocks. Hard cap: executeApproved refuses fail-closed when the monthly
// budget is exhausted. Null monthlyCallBudget = no workspace budget (the
// platform free-tier advisory in budget.ts still applies).
// RLS: same tenant-isolation pattern as Phase 14/15 slices 1–3 (migration
// SQL). One row per workspace.
model WorkspaceActionBudget {
  id                String    @id @default(cuid())
  workspaceId       String    @unique @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Monthly tool-call budget; null = no budget configured.
  monthlyCallBudget Int?      @map("monthly_call_budget")
  // false → soft cap (alerts only). true → hard cap (fail-closed refusal).
  hardCap           Boolean   @default(false) @map("hard_cap")
  // Alert fires when usage crosses this percent of the budget.
  alertThresholdPct Int       @default(80) @map("alert_threshold_pct")
  // Last alerted percent this billing month — fire-once semantics (the
  // alert does not re-fire on every subsequent call); re-armed to null when
  // usage drops below the threshold (month turnover).
  lastAlertedPct    Int?      @map("last_alerted_pct")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("workspace_action_budgets")
}

// A Univer office document (sheet | doc | slide) owned by the host.
// The snapshot is Univer IWorkbookData / IDocumentData JSON; the host owns
// storage and versioning — Univer is the editor, not the database.
model UniverDoc {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // sheet | doc | slide
  kind        String
  title       String
  // Univer snapshot JSON (IWorkbookData / IDocumentData / slide data).
  snapshot    Json
  version     Int       @default(1)
  // Provenance, e.g. "report:<id>", "analytics:overview", "agent:mission:<id>".
  sourceRef   String?   @map("source_ref")
  // private | workspace | link
  shareState  String    @default("private") @map("share_state")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, kind, updatedAt])
  @@map("univer_docs")
}

// ============================================================
// Phase 16 slice 5 — viewable agent runs (Playwright recorder).
// AgentRun is the persisted run lifecycle (an agent turn can request a
// browser run; it links back to the chat thread and/or mission).
// AgentRunRecording holds host-owned artifact paths (video webm + trace
// zip under .run-artifacts/, gitignored). AgentRunEvent is the structured
// run timeline (agui | gate | browser | note). All three carry
// workspace_id and are FORCE RLS fail-closed on the app.workspace_id GUC.
// ============================================================
enum AgentRunKind {
  mission
  playbook
  browser
  follow_up
  // Phase 5: one assistant/task turn (lead agent or a sub-agent).
  chat

  @@map("AgentRunKind")
}

enum AgentRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("AgentRunStatus")
}

enum AgentRunEventType {
  agui
  gate
  browser
  note
  // Phase 7: one model call's tokens + estimated cost (lib/llm/usage.ts).
  usage
  // Phase 8: streamed model text (chunks of deltas, lib/agents/loop.ts) —
  // what the AG-UI SSE route replays live; not a timeline step.
  text

  @@map("AgentRunEventType")
}

model AgentRun {
  id          String         @id @default(cuid()) @map("id")
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        AgentRunKind   @map("kind")
  status      AgentRunStatus @default(queued) @map("status")
  startedBy   String         @map("started_by")
  // Link back to the requesting surface: chat thread and/or mission.
  threadId    String?        @map("thread_id")
  missionId   String?        @map("mission_id")
  // CoAgents snapshot captured at run start (JSON).
  agentState  Json?          @map("agent_state")
  // Next event sequence number (timeline ordering; assigned by service).
  nextSeq     Int            @default(0) @map("next_seq")
  createdAt   DateTime       @default(now()) @map("created_at")
  endedAt     DateTime?      @map("ended_at")
  // Phase 5: which agent ran this ("lead" or a sub-agent key from
  // lib/agents/grants.ts), the sub-agent tree (a delegated run points at the
  // run that handed it off), the tool groups it was granted (server-computed,
  // never widened by a child), and a cooperative cancel request.
  agentKey          String?   @map("agent_key")
  parentRunId       String?   @map("parent_run_id")
  parentRun         AgentRun? @relation("AgentRunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns         AgentRun[] @relation("AgentRunTree")
  allowedTools      String[]  @default([]) @map("allowed_tools")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelRequestedBy String?   @map("cancel_requested_by")

  recording AgentRunRecording?
  events    AgentRunEvent[]
  // Phase 8: the loop's saved transcript (resume after a crash) and the
  // queue jobs that worked on this run.
  transcript AgentRunTranscript?
  jobs       AgentJob[]
  // Phase 8: the code sandbox this run works in (lib/sandbox).
  sandbox   AgentRunSandbox?

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, threadId])
  @@index([workspaceId, missionId])
  @@index([workspaceId, parentRunId])
  @@map("agent_runs")
}

// Phase 8: the code sandbox an agent run works in (lib/sandbox). One row per
// run (run_id unique): the provider ("docker" | "e2b" | "daytona"), the
// provider's sandbox id, the ports exposed for previews, and when it was
// destroyed (run finished, Stop, idle timeout noticed). The sandbox itself
// lives in the provider; this row is how a run finds it again and how the
// restore / preview routes check it is still alive. FORCE RLS.
model AgentRunSandbox {
  id           String    @id @default(cuid()) @map("id")
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runId        String    @unique @map("run_id")
  run          AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider     String    @map("provider")
  sandboxId    String    @map("sandbox_id")
  // "active" | "destroyed"
  status       String    @default("active") @map("status")
  exposedPorts Int[]     @default([]) @map("exposed_ports")
  // Provider access material a different process needs to reattach (E2B's
  // traffic token for previews), as a secrets() envelope. Never sent out.
  secretEnc    String?   @map("secret_enc")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  destroyedAt  DateTime? @map("destroyed_at")

  @@index([workspaceId, status])
  @@map("agent_run_sandboxes")
}

model AgentRunRecording {
  id             String    @id @default(cuid()) @map("id")
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  runId          String    @unique @map("run_id")
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Host-owned artifact paths (repo-local .run-artifacts/, gitignored).
  videoPath      String?   @map("video_path")
  tracePath      String?   @map("trace_path")
  stepCount      Int       @default(0) @map("step_count")
  sizeBytes      BigInt    @default(0) @map("size_bytes")
  // Decision (c): 30 days then summarize (slice 8 sweep drops videos).
  retentionUntil DateTime  @map("retention_until")
  // Slice 8: pinned recordings keep their video past retentionUntil.
  pinned         Boolean   @default(false)
  // Set when the sweep drops the video (trace always kept per decision c).
  videoPurgedAt  DateTime? @map("video_purged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("agent_run_recordings")
}

model AgentRunEvent {
  id          String            @id @default(cuid()) @map("id")
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  runId       String            @map("run_id")
  run         AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Monotonic within the run (assigned atomically by the service).
  seq         Int               @map("seq")
  type        AgentRunEventType @map("type")
  // Short human-readable summary (timeline row); full detail in payload.
  summary     String            @map("summary")
  payload     Json?             @map("payload")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([runId, seq])
  @@index([workspaceId, runId, seq])
  @@map("agent_run_events")
}

// ============================================================================
// Phase 8: agent runtime — durable queue + resumable transcripts.
//
// agent_jobs: one row per unit of background agent work (a chat turn handed
// off by the request, a mission launch). Workers claim rows with
// FOR UPDATE SKIP LOCKED (lib/jobs/claim.ts), hold a lease they extend on a
// heartbeat, and a row whose lease expired is claimed again until
// max_attempts, then it is `dead`. FORCE RLS on app.workspace_id like
// agent_runs; a worker finds WHICH workspaces have due work through a
// SELECT-only discovery policy keyed on app.agent_worker='discover'
// (migration 20261009100000).
// agent_run_transcripts: the agent loop's state (messages, tool results,
// step / cost counters) saved after every step, so a requeued job resumes
// from the last step and never re-runs a tool whose result was saved.
// ============================================================================

enum AgentJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
  dead

  @@map("AgentJobStatus")
}

model AgentJob {
  id          String         @id @default(cuid()) @map("id")
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Handler key (lib/agents/queue/handlers.ts): chat_turn | mission | …
  kind        String         @map("kind")
  payload     Json           @map("payload")
  status      AgentJobStatus @default(queued) @map("status")
  attempts    Int            @default(0) @map("attempts")
  maxAttempts Int            @default(3) @map("max_attempts")
  // Not claimable before this (retry backoff).
  runAfter    DateTime       @default(now()) @map("run_after")
  heartbeatAt DateTime?      @map("heartbeat_at")
  // A running row whose lease passed is presumed orphaned (worker died).
  leaseUntil  DateTime?      @map("lease_until")
  lockedBy    String?        @map("locked_by")
  // The AgentRun this job works on (the run carries the transcript).
  runId       String?        @map("run_id")
  run         AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  lastError   String?        @map("last_error")
  result      Json?          @map("result")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  finishedAt  DateTime?      @map("finished_at")

  @@index([status, runAfter])
  @@index([workspaceId, status, runAfter])
  @@index([workspaceId, runId])
  @@map("agent_jobs")
}

model AgentRunTranscript {
  runId       String    @id @map("run_id")
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // lib/agents/loop.ts LoopState (versioned JSON).
  state       Json      @map("state")
  step        Int       @default(0) @map("step")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("agent_run_transcripts")
}

// ============================================================================
// Phase 16 slice 9: branded report engine — draft-for-approval send flow.
//
// A ReportSendApproval is the gate object for one branded report: a template
// name + pinned semver version, the brand kit, the reporting period, and the
// figure payload. It moves pending → approved → rendered behind the Phase 14
// gate (approve/deny/edit service functions in lib/reports/report-gate.ts),
// with every transition audit-logged via FileChangeLog.
//
// IRON GUARDRAIL (Tico-locked): a figure with no source pointer flags the
// report (`flagged` status) and NEVER renders — the render service refuses
// ungrounded figures outright.
// ============================================================================

enum ReportSendStatus {
  pending
  flagged
  approved
  denied
  rendered
  failed
}

model ReportSendApproval {
  id          String    @id @default(cuid()) @map("id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Template name + PINNED semver (versioned files, never edited in place).
  templateName    String @map("template_name")
  templateVersion String @map("template_version")

  // Brand kit for this report (null = default violet per theming law).
  brandKitId String?   @map("brand_kit_id")
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  // Human labels.
  clientName String @map("client_name")
  period     String

  // { meta: Record<string,string>, figures: ReportFigure[] } — see lib/reports.
  payload Json

  status     ReportSendStatus @default(pending) @map("status")
  reviewNote String?          @map("review_note")
  // Absolute path of the rendered PDF (set on `rendered`).
  pdfPath    String?          @map("pdf_path")
  error      String?

  createdBy String    @map("created_by")
  decidedBy String?   @map("decided_by")
  decidedAt DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status, createdAt])
  @@map("report_send_approvals")
}

// ============================================================================
// Phase 10 (ops-core) — CRM accounts: companies, contacts, deals. Lead stays
// the capture record (forms, imports, inbox); converting a lead dedupes onto
// a Contact (by email) and Company (by domain, then name). A Deal is a real
// opportunity on a CRM pipeline's stage machine (crm_pipelines.stages).
// ============================================================================

enum OpsDealStatus {
  open
  won
  lost
}

model OpsCompany {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // Lower-cased registrable domain ("acme.com"); the dedupe key when set.
  domain      String?
  website     String?
  phone       String?
  industry    String?
  // Owning user (Auth.js subject id), optional.
  ownerId     String?   @map("owner_id")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  contacts OpsContact[]
  deals    OpsDeal[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
  @@map("ops_companies")
}

model OpsContact {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String?     @map("company_id")
  company     OpsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  // Lower-cased; the dedupe key when set.
  email       String?
  phone       String?
  title       String?
  ownerId     String?     @map("owner_id")
  // The capture lead this contact was converted from (crm_leads.id).
  leadId      String?     @map("lead_id")
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  deals OpsDeal[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, leadId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, name])
  @@map("ops_contacts")
}

model OpsDeal {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  // Stage machine: crm_pipelines.stages; stage must be one of its ids.
  pipelineId      String        @map("pipeline_id")
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage           String
  // Integer cents.
  valueCents      Int           @default(0) @map("value_cents")
  status          OpsDealStatus @default(open)
  ownerId         String?       @map("owner_id")
  ownerName       String?       @map("owner_name")
  contactId       String?       @map("contact_id")
  contact         OpsContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?       @map("company_id")
  company         OpsCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // The capture lead this deal came from (crm_leads.id), if any.
  leadId          String?       @map("lead_id")
  expectedCloseAt DateTime?     @map("expected_close_at")
  closedAt        DateTime?     @map("closed_at")
  lostReason      String?       @map("lost_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  projects OpsProject[]

  @@index([workspaceId, pipelineId, stage])
  @@index([workspaceId, status, expectedCloseAt])
  @@index([workspaceId, leadId])
  @@map("ops_deals")
}

// ============================================================================
// Phase 10 (ops-core) — inventory: warehouses, locations, variants,
// transfers, reorder rules. Extends the Phase 17 Ops layer (same RLS
// pattern, same append-only stock ledger). Phase 13's digital twin binds
// racks/bins/docks to OpsLocation rows — keep the hierarchy clean:
// warehouse → zone → aisle → rack → shelf → bin (docks sit under the
// warehouse or a zone). Per-location stock is DERIVED from the ledger
// (OpsInventoryTxn.locationId/variantId), never stored separately.
// ============================================================================

enum OpsLocationKind {
  zone
  aisle
  rack
  shelf
  bin
  dock
}

enum OpsTransferStatus {
  draft
  done
  cancelled
}

model OpsWarehouse {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // Short code shown everywhere, e.g. "WH-01". Unique per workspace.
  code        String
  address     String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  locations    OpsLocation[]
  reorderRules OpsReorderRule[]

  @@unique([workspaceId, code])
  @@map("ops_warehouses")
}

model OpsLocation {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseId String          @map("warehouse_id")
  warehouse   OpsWarehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  // Null = directly under the warehouse.
  parentId    String?         @map("parent_id")
  parent      OpsLocation?    @relation("OpsLocationTree", fields: [parentId], references: [id], onDelete: NoAction)
  children    OpsLocation[]   @relation("OpsLocationTree")
  kind        OpsLocationKind
  // Code unique within the warehouse, e.g. "A", "A-03", "A-03-2-B".
  code        String
  name        String?
  // Denormalized display path "WH-01/A/A-03/A-03-2-B" (set on create;
  // codes are immutable so it never goes stale).
  path        String
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  inventoryTxns    OpsInventoryTxn[]
  transfersOut     OpsTransfer[]     @relation("OpsTransferFrom")
  transfersIn      OpsTransfer[]     @relation("OpsTransferTo")
  reorderReceiving OpsReorderRule[]

  @@unique([warehouseId, code])
  @@index([workspaceId, warehouseId, parentId])
  @@map("ops_locations")
}

// A sellable variant of a product with its own SKU/attributes. Products
// without explicit variants get ONE default variant (isDefault) — created
// by the migration for existing products and lazily for new ones on their
// first stock move — so stockQty users keep working (stockQty stays the
// product total).
model OpsProductVariant {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String     @map("product_id")
  product     OpsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  // { color: "red", size: "L" }
  attributes  Json       @default("{}")
  // Null = the product's price.
  priceCents  Int?       @map("price_cents")
  isDefault   Boolean    @default(false) @map("is_default")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  inventoryTxns OpsInventoryTxn[]
  reorderRules  OpsReorderRule[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, productId])
  @@map("ops_product_variants")
}

// Stock transfer between two locations: draft → done (books a paired
// -qty/+qty txn per line in ONE transaction; product totals unchanged) or
// cancelled. lines: [{ productId, variantId?, qty }].
model OpsTransfer {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromLocationId String            @map("from_location_id")
  fromLocation   OpsLocation       @relation("OpsTransferFrom", fields: [fromLocationId], references: [id], onDelete: NoAction)
  toLocationId   String            @map("to_location_id")
  toLocation     OpsLocation       @relation("OpsTransferTo", fields: [toLocationId], references: [id], onDelete: NoAction)
  lines          Json
  status         OpsTransferStatus @default(draft)
  note           String?           @db.Text
  createdBy      String?           @map("created_by")
  doneAt         DateTime?         @map("done_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  inventoryTxns OpsInventoryTxn[]

  @@index([workspaceId, status, createdAt])
  @@map("ops_transfers")
}

// Min/max reorder rule per product (+ optional variant) and warehouse.
// The reorder cron drafts ONE OpsPurchaseOrder per breach (never sends —
// sending stays gated): openPurchaseOrderId holds the draft until it is
// received or cancelled, so a breach never drafts twice.
model OpsReorderRule {
  id                  String             @id @default(cuid())
  workspaceId         String             @map("workspace_id")
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId           String             @map("product_id")
  product             OpsProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           String?            @map("variant_id")
  variant             OpsProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId         String             @map("warehouse_id")
  warehouse           OpsWarehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  // Where receipts land (must be inside the warehouse); null = unlocated.
  receiveLocationId   String?            @map("receive_location_id")
  receiveLocation     OpsLocation?       @relation(fields: [receiveLocationId], references: [id], onDelete: SetNull)
  minQty              Int                @map("min_qty")
  maxQty              Int                @map("max_qty")
  supplierName        String?            @map("supplier_name")
  unitCostCents       Int?               @map("unit_cost_cents")
  active              Boolean            @default(true)
  openPurchaseOrderId String?            @map("open_purchase_order_id")
  lastTriggeredAt     DateTime?          @map("last_triggered_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([workspaceId, productId, warehouseId, variantId])
  @@index([workspaceId, active])
  @@map("ops_reorder_rules")
}

// ============================================================================
// Phase 17 slice 1 — Business Operations: DocType-style entity convention.
//
// Every Operations entity is tenant-scoped (workspace_id FK, ON DELETE
// CASCADE), RLS-ready (the slice-1 migration enables FORCE ROW LEVEL
// SECURITY with the app.workspace_id tenant principal — see
// prisma/migrations/20260930211000_phase17_ops_entities/migration.sql),
// and agent-addressable by construction through the auto REST convention
// GET/POST/PATCH /api/ops/{entity} (lib/ops/doctype.ts).
//
// Money law (locked): OpsPayment rows are RECORDS ONLY — Marketr never
// holds funds. Amounts are integer cents. Invoice SEND and every payment
// write are gated through the Phase 14 approval gate (lib/ops/gate.ts).
//
// ERPNext is patterns-only, clean-room: these models are original Marketr
// work. No ERPNext code, schema, or UI text exists in this repo.
// ============================================================================

enum OpsOrderStatus {
  draft
  confirmed
  fulfilled
  cancelled
}

enum OpsPaymentKind {
  charge
  refund
}

enum OpsPaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum OpsPurchaseOrderStatus {
  draft
  sent
  received
  cancelled
}

enum OpsInvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

enum OpsInventoryReason {
  sale
  restock
  adjustment
  // Phase 10 (ops-core): one leg of a location-to-location transfer.
  transfer
}

enum OpsProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum OpsWorkflowRunStatus {
  running
  succeeded
  failed
  compensated
}

// Phase 17 slice 5: HR essentials enums.
enum OpsTeamMemberStatus {
  active
  inactive
}

enum OpsLeaveType {
  vacation
  sick
  personal
}

enum OpsLeaveStatus {
  requested
  approved
  denied
  taken
}

// Catalog: sellable products/services. trackInventory=false means the
// product is a service / non-stocked item (stockQty ignored).
model OpsProduct {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  sku               String
  // Integer minor units (cents).
  priceCents        Int       @map("price_cents")
  stockQty          Int       @default(0) @map("stock_qty")
  trackInventory    Boolean   @default(true) @map("track_inventory")
  // Low-stock alert threshold: alert when trackInventory && stockQty <=
  // lowStockThreshold. Slice 3. Default 0 = alert only when out of stock.
  lowStockThreshold Int       @default(0) @map("low_stock_threshold")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  inventoryTxns OpsInventoryTxn[]
  // Phase 10 (ops-core)
  variants      OpsProductVariant[]
  reorderRules  OpsReorderRule[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, name])
  @@map("ops_products")
}

// Commerce order: customer ref, line items, lifecycle
// draft → confirmed → fulfilled (cancelled terminal). Totals are
// server-computed from line items (never trusted from the client).
model OpsOrder {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // CRM adjacency: the lead-turned-customer this order belongs to.
  customerId    String?        @map("customer_id")
  // [{ name, sku?, qty, priceCents }]
  lineItems     Json           @map("line_items")
  status        OpsOrderStatus @default(draft)
  subtotalCents Int            @map("subtotal_cents")
  taxCents      Int            @default(0) @map("tax_cents")
  totalCents    Int            @map("total_cents")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  payments OpsPayment[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, customerId])
  @@map("ops_orders")
}

// Payment RECORDS ONLY — funds never touch Marketr. A row records that a
// charge/refund happened on the provider (Stripe). Every write is a gated
// write (medium minimum; bulk refunds high) via lib/ops/gate.ts.
model OpsPayment {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId     String?          @map("order_id")
  order       OpsOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider    String           @default("stripe")
  kind        OpsPaymentKind   @default(charge)
  // Integer minor units (cents), always positive; kind says the direction.
  amountCents Int              @map("amount_cents")
  status      OpsPaymentStatus @default(pending)
  // Provider-side reference (Stripe payment intent / charge id).
  providerRef String?          @map("provider_ref")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([workspaceId, orderId, createdAt])
  @@index([workspaceId, kind, status])
  @@map("ops_payments")
}

// Discount codes: rules JSON evaluated at order time
// ({ percentOff?, amountOffCents?, minSubtotalCents?, productSkus? }).
model OpsPromotion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  rules       Json      @default("{}")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@map("ops_promotions")
}

// Invoice: draft → sent → paid (overdue derived by age). Sending is a
// gated write (medium, approval required — money is a red lane).
model OpsInvoice {
  id             String           @id @default(cuid())
  workspaceId    String           @map("workspace_id")
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // CRM adjacency: the lead-turned-customer being billed.
  customerId     String?          @map("customer_id")
  // [{ description, qty, priceCents }]
  lineItems      Json             @map("line_items")
  taxCents       Int              @default(0) @map("tax_cents")
  totalCents     Int              @map("total_cents")
  status         OpsInvoiceStatus @default(draft)
  sentAt         DateTime?        @map("sent_at")
  // Payment due date. Set explicitly at draft time or defaulted to
  // sentAt + 30 days when the invoice is sent. Drives the overdue sweep.
  dueAt          DateTime?        @map("due_at")
  // Idempotency / dedupe key for agent retries (nullable = not set).
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, customerId])
  @@map("ops_invoices")
}

// Immutable stock ledger: every stock change is a txn row; the product's
// stockQty is the materialized balance, updated in the SAME transaction as
// the txn row (so inventory decrements exactly once per sale).
model OpsInventoryTxn {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String             @map("product_id")
  product     OpsProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Signed: sale = negative, restock = positive, adjustment = either.
  delta       Int
  reason      OpsInventoryReason
  // Who/what moved the stock: user id or "agent:<surface>".
  actor       String?
  note        String?            @db.Text
  // Phase 10 (ops-core): where and which variant. Null location =
  // unlocated stock (pre-location history); variant backfilled to the
  // product's default variant.
  variantId   String?            @map("variant_id")
  variant     OpsProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction)
  locationId  String?            @map("location_id")
  location    OpsLocation?       @relation(fields: [locationId], references: [id], onDelete: NoAction)
  transferId  String?            @map("transfer_id")
  transfer    OpsTransfer?       @relation(fields: [transferId], references: [id], onDelete: NoAction)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, reason, createdAt])
  @@index([workspaceId, locationId, productId])
  @@map("ops_inventory_txns")
}

// Purchase order: supplier ref, line items, lifecycle.
// Slice 3. Sending is a gated money commitment (OPS_PO_SEND); receiving
// is a free fulfillment write that atomically books restock inventory
// txns for line items carrying a productId.
model OpsPurchaseOrder {
  id            String                 @id @default(cuid())
  workspaceId   String                 @map("workspace_id")
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Supplier: a CRM lead id (optional) + free-text name fallback.
  supplierId    String?                @map("supplier_id")
  supplierName  String?                @map("supplier_name")
  // [{ productId?, name, sku?, qty, priceCents }]
  lineItems     Json                   @map("line_items")
  taxCents      Int                    @default(0) @map("tax_cents")
  subtotalCents Int                    @map("subtotal_cents")
  totalCents    Int                    @map("total_cents")
  status        OpsPurchaseOrderStatus @default(draft)
  sentAt        DateTime?              @map("sent_at")
  receivedAt    DateTime?              @map("received_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, supplierId])
  @@map("ops_purchase_orders")
}

// Client delivery work: milestones JSON
// ([{ title, dueAt?, status }]), linked to CRM lead/deal.
model OpsProject {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?          @map("customer_id")
  name        String
  milestones  Json             @default("[]")
  status      OpsProjectStatus @default(planning)
  // CRM adjacency (Wave B canonical models).
  leadId      String?          @map("lead_id")
  // Phase 10 (ops-core): a real relation (was a dangling string).
  dealId      String?          @map("deal_id")
  deal        OpsDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  timeEntries OpsTimeEntry[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, leadId])
  @@map("ops_projects")
}

// Project time-entry ledger (slice 4): billable/effort hours on a project.
// Integer minutes (never floats — the same integer-math discipline as
// money). Entries are append-only through the API: log a new row to
// correct, never edit history. `billed` marks entries already invoiced;
// the complete-project nudge surfaces unbilled time.
model OpsTimeEntry {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String     @map("project_id")
  project     OpsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Duration in integer minutes.
  minutes     Int
  description String?    @db.Text
  // Who logged the time: user id or "agent:<surface>".
  actor       String?
  occurredAt  DateTime   @default(now()) @map("occurred_at")
  billed      Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, projectId, occurredAt])
  @@index([workspaceId, projectId, billed])
  @@map("ops_time_entries")
}

// HR essentials (Phase 17 slice 5, clean-room): team directory + leave
// requests. v1 only — full HR (leave balances, payroll) waits for v2.
model OpsTeamMember {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  title       String?
  email       String?
  startDate   DateTime?           @map("start_date")
  status      OpsTeamMemberStatus @default(active)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  leaveRequests OpsLeaveRequest[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, name])
  @@map("ops_team_members")
}

model OpsLeaveRequest {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId    String         @map("member_id")
  member      OpsTeamMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        OpsLeaveType
  startDate   DateTime       @map("start_date")
  endDate     DateTime       @map("end_date")
  status      OpsLeaveStatus @default(requested)
  // Who approved/denied (user id), set when the decision is recorded.
  decidedBy   String?        @map("decided_by")
  decidedAt   DateTime?      @map("decided_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, memberId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@map("ops_leave_requests")
}

// Medusa-Workflows-inspired transactional record (clean-room): a named
// multi-step operation with its steps and an append-only compensation log.
// When a step fails, the compensation log drives rollback so a failed order
// workflow never leaves a half-charged customer.
model OpsWorkflowRun {
  id              String               @id @default(cuid())
  workspaceId     String               @map("workspace_id")
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowName    String               @map("workflow_name")
  // Slice 6: idempotency key — one run per (workspace, runKey), so an
  // approved workflow plan can never execute twice (replay lock).
  runKey          String?              @map("run_key")
  // [{ name, status, at?, detail? }] — the saga steps in order.
  steps           Json                 @default("[]")
  // [{ step, action, at, result }] — append-only compensation record.
  compensationLog Json                 @default("[]") @map("compensation_log")
  status          OpsWorkflowRunStatus @default(running)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Slice 6: NULLs are distinct in a Postgres unique index, so pre-slice-6
  // rows (runKey NULL) are unaffected; every new run carries a key.
  @@unique([workspaceId, runKey])
  @@index([workspaceId, workflowName, createdAt])
  @@index([workspaceId, status])
  @@map("ops_workflow_runs")
}

// Audit by construction: the DocType route factory (lib/ops/doctype.ts)
// writes one row per request — reads and draft-creators included
// ("runs freely (logged)"). Append-only; never updated or deleted by the
// API surface.
model OpsAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Entity slug: "invoices", "products", ...
  entity      String
  entityId    String?   @map("entity_id")
  // list | get | create | update | gate_proposed | gate_denied | gate_executed
  action      String
  actor       String
  summary     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, entity, createdAt])
  @@index([workspaceId, entityId])
  @@map("ops_audit_events")
}

// ============================================================================
// Phase 18 slice 1: Ad Platforms ontology — "Buy everywhere, approve everything"
// ----------------------------------------------------------------------------
// Platform-agnostic paid-media core for Grow pillar → Advertising. Zero
// custody of client spend; autopilot never buys media. EVERY spend action
// (launch, budget change, new flight) flows through SpendProposal →
// SpendApproval and executes only against a matching, unexpired approval
// with an identical scope hash (see lib/adplatforms/gate.ts).
//
// Naming note: the spec's `AdCampaign` / `AdCreative` names are already taken
// by the creative-generation models (M12), so the paid-media entities are
// `PaidAdCampaign` / `PaidAdGroup` / `PaidAdCreative` to avoid collision.
// ============================================================================

enum AdPlatformKey {
  amazon
  stackadapt
  walmart
  spotify
}

enum AdPlatformAuthKind {
  oauth
  api_key
  guided
}

enum AdAccountStatus {
  pending
  connected
  expired
  revoked
  error
}

enum PaidAdStatus {
  draft
  proposed
  live
  paused
  ended
}

enum SpendProposalKind {
  launch
  pause
  budget_change
  new_flight
}

enum SpendProposalStatus {
  pending
  approved
  rejected
  executed
  expired
}

// Platform registry row. Tenant-scoped per repo convention (each workspace
// gets its own four rows at seed/enablement time); capability flags drive
// which actions the UI and the gate expose per platform.
model AdPlatform {
  id                   String             @id @default(cuid())
  workspaceId          String             @map("workspace_id")
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key                  AdPlatformKey
  displayName          String             @map("display_name")
  authKind             AdPlatformAuthKind @map("auth_kind")
  // Capability flags — what slice-N connectors actually support.
  supportsApiLaunch    Boolean            @default(false) @map("supports_api_launch")
  supportsReportingApi Boolean            @default(false) @map("supports_reporting_api")
  guidedOnly           Boolean            @default(false) @map("guided_only")
  enabled              Boolean            @default(true)

  accounts AdAccount[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@map("ad_platforms")
}

// One linked advertiser account per platform. The OAuth/API token itself
// lives in the Latchkey vault — tokenRef is an opaque vault reference
// ("vault:oauth:<platform>:<id>"), NEVER the credential.
model AdAccount {
  id                String          @id @default(cuid())
  workspaceId       String          @map("workspace_id")
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformId        String          @map("platform_id")
  platform          AdPlatform      @relation(fields: [platformId], references: [id], onDelete: Cascade)
  name              String?
  externalAccountId String          @map("external_account_id")
  // Opaque vault reference to the stored credential. Nullable until the
  // OAuth/API-key flow completes.
  tokenRef          String?         @map("token_ref")
  status            AdAccountStatus @default(pending)
  // Reserved for the agency white-label open decision (Phase 18 spec §6):
  // sub-accounts (GHL-style snapshots) get per-client ad accounts in v2.
  subAccountId      String?         @map("sub_account_id")

  campaigns PaidAdCampaign[]
  reports   AdReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, platformId, externalAccountId])
  @@index([workspaceId, status])
  @@map("ad_accounts")
}

// Unified paid campaign across all platforms. Platform-native naming is
// mapped into this shape by each slice-N connector.
model PaidAdCampaign {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String        @map("account_id")
  account     AdAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Denormalized for queries that must not join through the account.
  platformKey AdPlatformKey @map("platform_key")

  name        String
  objective   String?
  externalId  String?      @map("external_id")
  status      PaidAdStatus @default(draft)
  // Lifetime budget in minor currency units (cents). Null = unmanaged.
  budgetCents Int?         @map("budget_cents")
  flightStart DateTime?    @map("flight_start")
  flightEnd   DateTime?    @map("flight_end")

  groups           PaidAdGroup[]
  reports          AdReport[]
  // Wave 2 ChatGPT Ads: 1:1 conversational-intent extension (optional).
  chatGPTExtension ChatGPTCampaign?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, accountId, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, platformKey])
  @@map("paid_ad_campaigns")
}

model PaidAdGroup {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String         @map("campaign_id")
  campaign    PaidAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  externalId  String?      @map("external_id")
  status      PaidAdStatus @default(draft)
  budgetCents Int?         @map("budget_cents")

  creatives PaidAdCreative[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, campaignId])
  @@map("paid_ad_groups")
}

model PaidAdCreative {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupId     String      @map("group_id")
  group       PaidAdGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name           String
  externalId     String? @map("external_id")
  // Asset refs: [{ url, kind: image|video|audio, hash }] — hashed at
  // approval time so the executor can re-verify (TOCTOU protection).
  assetRefs      Json    @default("[]") @map("asset_refs")
  platformStatus String? @map("platform_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, groupId])
  @@map("paid_ad_creatives")
}

// THE gate. Every launch, budget change, or new flight creates one.
// Execution is impossible without a matching SpendApproval row — the gate
// (lib/adplatforms/gate.ts) fails closed on: missing approval, rejected /
// expired / already-executed proposal, or scope-hash mismatch (what was
// approved must be byte-identical to what executes).
model SpendProposal {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind       SpendProposalKind
  action     String // launch | pause | adjust_budget — mirrors the governed action
  // Polymorphic target: "campaign" | "group". Kept as strings so v2 can
  // add targets without a schema change.
  targetType String            @map("target_type")
  targetId   String            @map("target_id")
  // Full execution payload (budgets, flight dates, creative refs). The
  // scopeHash binds approval → execution: canonical JSON → SHA-256.
  payload    Json
  scopeHash  String            @map("scope_hash")

  status     SpendProposalStatus @default(pending)
  proposedBy String              @map("proposed_by")
  proposedAt DateTime            @default(now()) @map("proposed_at")
  decidedBy  String?             @map("decided_by")
  decidedAt  DateTime?           @map("decided_at")
  // Proposals expire un-acted-upon so a stale approval can never fire.
  expiresAt  DateTime            @map("expires_at")

  approval SpendApproval?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, targetType, targetId])
  @@map("spend_proposals")
}

// Immutable approval record. NO updatedAt — the service layer never updates
// or deletes these rows; a changed mind is a new proposal.
model SpendApproval {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposalId  String        @unique @map("proposal_id")
  proposal    SpendProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  approver  String   @map("approver")
  decidedAt DateTime @default(now()) @map("decided_at")
  // Must equal the proposal's scopeHash at approval time AND at execution
  // time. Any drift = fail closed.
  scopeHash String   @map("scope_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, approver])
  @@map("spend_approvals")
}

// Normalized daily metrics per campaign. Connectors (slices 2–5) map raw
// platform exports into this shape via lib/adplatforms/reporting.ts.
// Lineage: report row → campaign → SpendApproval → platform receipt id.
model AdReport {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformId  String         @map("platform_id")
  accountId   String         @map("account_id")
  account     AdAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId  String         @map("campaign_id")
  campaign    PaidAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // The day these metrics describe (date portion only).
  date         DateTime @db.Date
  spendCents   Int      @default(0) @map("spend_cents")
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  // Stored (not derived) so a platform's own CTR survives rounding.
  ctr          Float?   @map("ctr")
  conversions  Float    @default(0)
  revenueCents Int      @default(0) @map("revenue_cents")

  // Lineage: which approval authorized the spend, and the platform's own
  // receipt/report id for the row.
  approvalId        String? @map("approval_id")
  platformReceiptId String? @map("platform_receipt_id")
  // Raw platform row for audit/reconciliation.
  raw               Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, campaignId, date])
  @@index([workspaceId, date])
  @@map("ad_reports")
}

// Wave 2 — ChatGPT Ads module: conversational-intent campaigns.
//
// ChatGPT ads are bought through the Phase 18 StackAdapt rail (a confirmed
// OpenAI launch partner) — there is no public self-serve OpenAI ads API, so
// no new AdPlatformKey is added. ChatGPTCampaign is a 1:1 extension of the
// Phase 18 PaidAdCampaign (which carries platformKey=stackadapt, the ad
// account link, and the external id); this model carries the
// conversational-intent fields. Every spend action still flows through the
// Phase 18 SpendProposal → SpendApproval gate; this module never executes
// spend itself.
// ============================================================================

enum ChatGPTCampaignStatus {
  draft
  proposed
  approved
  live
  paused
  ended
}

enum ChatGPTTier {
  free
  go
}

enum ChatGPTBidStrategy {
  cpc
  cpm
}

enum CreativeVariantSource {
  ai_generated
  human
}

enum CreativeApprovalStatus {
  pending
  approved
  rejected
}

model ChatGPTCampaign {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 1:1 extension of the Phase 18 paid campaign (stackadapt platform key).
  campaignId  String         @unique @map("campaign_id")
  campaign    PaidAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  objective            String?
  targetTiers          ChatGPTTier[]         @map("target_tiers")
  // Conversation-topic intent tags (Audience Tools, June 2026).
  topicIntentTags      String[]              @map("topic_intent_tags")
  // Budgets in minor currency units (cents). At least one must be set —
  // propose_chatgpt_campaign fails closed without a budget cap.
  budgetDailyCents     Int?                  @map("budget_daily_cents")
  budgetTotalCents     Int?                  @map("budget_total_cents")
  bidStrategy          ChatGPTBidStrategy    @default(cpc) @map("bid_strategy")
  // StackAdapt campaign id once launched (buying on-ramp).
  stackAdaptExternalId String?               @map("stackadapt_external_id")
  status               ChatGPTCampaignStatus @default(draft)

  creatives CreativeVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("chatgpt_campaigns")
}

model CreativeVariant {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String          @map("campaign_id")
  campaign    ChatGPTCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  headline        String
  body            String
  ctaLabel        String?                @map("cta_label")
  locale          String                 @default("en-US")
  source          CreativeVariantSource  @default(human)
  // Provenance: who made this ad (provider + model), answerable on demand.
  aiProviderUsed  String?                @map("ai_provider_used")
  aiModelUsed     String?                @map("ai_model_used")
  approvalStatus  CreativeApprovalStatus @default(pending) @map("approval_status")
  // OpenAI policy flags raised during review (empty = clean).
  policyFlags     String[]               @default([]) @map("policy_flags")
  // Lineage: localized/mutated variants keep their parent link.
  parentVariantId String?                @map("parent_variant_id")
  parentVariant   CreativeVariant?       @relation("VariantLineage", fields: [parentVariantId], references: [id], onDelete: SetNull)
  childVariants   CreativeVariant[]      @relation("VariantLineage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, campaignId])
  @@index([workspaceId, approvalStatus])
  @@map("creative_variants")
}

// ── Wave 2 context.dev: daily credit budget (slice 1) ────────────────────────
// One row per workspace per UTC day (day = YYYY-MM-DD). recordSpend charges
// atomically via upsert+increment; the gate (decideBudget) runs before any
// Context.dev API call. Over-budget calls route to approval, never charge.
model ContextDevBudget {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  day         String
  creditsUsed Int    @default(0) @map("credits_used")
  capCredits  Int    @default(100) @map("cap_credits")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, day])
  @@index([workspaceId])
  @@map("context_dev_budgets")
}

// ── Wave 2 context.dev: knowledge sources, crawl jobs, chunks (slice 2) ─────
// KnowledgeSource: a registered external source. Own domains (workspace
// Project domains) auto-activate; third-party domains sit at pending_approval
// until a tenant approves them once per domain (add_source governed action).
// CrawlJob: one batch crawl/map execution. KnowledgeChunk: append-only
// provenance ledger — every chunk records source URL + fetch time so "what
// did the agent know and when" stays answerable. RAG attach reads this table.
model KnowledgeSource {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  url        String
  // page | sitemap | brand
  sourceType String @map("source_type")
  // manual | daily | weekly
  cadence    String @default("manual")
  // active | pending_approval | archived
  status     String @default("pending_approval")
  // Lowercased registrable domain, for the one-time-per-domain approval rule.
  domain     String

  jobs     CrawlJob[]
  chunks   KnowledgeChunk[]
  monitors Monitor[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, domain])
  @@map("knowledge_sources")
}

model CrawlJob {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    String          @map("source_id")
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // queued | running | complete | failed
  status       String  @default("queued")
  pagesFetched Int     @default(0) @map("pages_fetched")
  creditsUsed  Int     @default(0) @map("credits_used")
  error        String?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  chunks KnowledgeChunk[]

  @@index([workspaceId, status])
  @@index([sourceId])
  @@map("crawl_jobs")
}

model KnowledgeChunk {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobId       String          @map("job_id")
  job         CrawlJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceId    String          @map("source_id")
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  sourceUrl   String   @map("source_url")
  fetchedAt   DateTime @map("fetched_at")
  // 1-based chunk ordinal within the page.
  ord         Int
  contentHash String   @map("content_hash")
  markdown    String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, sourceId])
  @@index([jobId])
  @@map("knowledge_chunks")
}

// ── Wave 2 context.dev: research tasks (slice 3) ───────────────────────────
// ResearchTask: one sourced Q&A execution. Stores the question, locale,
// structured json_content, cited source URLs, and a heuristic confidence so
// "what did the agent know and when" stays answerable. Zero-source answers
// are stored as failed — the citation contract is never silently broken.
model ResearchTask {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  question    String
  locale      String   @default("en")
  // fast | ultra
  mode        String   @default("fast")
  // complete | partial | failed
  status      String   @default("complete")
  jsonContent Json     @map("json_content")
  sources     String[]
  confidence  Float    @default(0)
  creditsUsed Int      @default(0) @map("credits_used")
  error       String?

  monitorChanges MonitorChange[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("research_tasks")
}

// ── Wave 2 context.dev: change monitors (slice 4) ──────────────────────────
// Monitor: a scheduled watch on a page. Each run scrapes the URL, hashes the
// markdown, and compares to lastSeenHash; a new hash writes a MonitorChange
// with a diff digest. Identical hashes dedup silently (no change row).
// Optionally spawns a ResearchTask per change (opt-in, budget-gated).
model Monitor {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  url     String
  // hourly | daily | weekly
  cadence String @default("daily")
  // active | paused | archived
  status  String @default("active")

  lastSeenHash        String?   @map("last_seen_hash")
  lastContent         String?   @map("last_content")
  lastCheckedAt       DateTime? @map("last_checked_at")
  lastChangeAt        DateTime? @map("last_change_at")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  // Spawn a ResearchTask on each detected change (budget-gated).
  autoResearch        Boolean   @default(false) @map("auto_research")

  sourceId String?          @map("source_id")
  source   KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  changes MonitorChange[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("monitors")
}

model MonitorChange {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitorId   String    @map("monitor_id")
  monitor     Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  detectedAt DateTime @default(now()) @map("detected_at")
  prevHash   String?  @map("prev_hash")
  newHash    String   @map("new_hash")
  digest     String
  excerpt    String?

  researchTaskId String?       @map("research_task_id")
  researchTask   ResearchTask? @relation(fields: [researchTaskId], references: [id], onDelete: SetNull)

  @@index([monitorId, detectedAt])
  @@index([workspaceId, detectedAt])
  @@map("monitor_changes")
}

// ── Wave 2 context.dev: brand-kit sync proposals (slice 5) ──────────────────
// BrandSync: a Context.dev brand profile fetched for a domain, diffed against
// a BrandKit, and held for approval. Nothing touches the live kit until an
// editor approves — the theming (BrandTheme reads the default kit per render)
// refreshes automatically once the kit row is updated.
model BrandSync {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Target kit; null = create a new kit from the profile on approval.
  brandKitId String?   @map("brand_kit_id")
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  domain String
  // pending_approval | approved(legacy) | rejected | applied | unchanged | failed
  status String @default("pending_approval")

  profileJson Json    @map("profile_json")
  diffJson    Json    @default("[]") @map("diff_json")
  creditsUsed Int     @default(0) @map("credits_used")
  error       String?

  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("brand_syncs")
}

// ── Wave 2 WFH mode (slice 1): WorkMode object + toggle ──────────────────────
// Per-user OS mode switch (wfh / office / hybrid). One active row per
// (workspace, user); preference changes are recorded in WfhModeHistory for
// the 13B learning loop.

enum WfhMode {
  wfh
  office
  hybrid
}

enum WfhStandupCadence {
  daily
  none
}

enum WfhNotificationProfile {
  realtime
  batched
}

model WfhWorkMode {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Auth.js user id (subject). The mode is per-user, not per-workspace.
  userId      String    @map("user_id")
  email       String?

  mode                WfhMode                @default(office)
  // Effective WFH days for hybrid mode (lowercase 3-letter codes: mon..sun).
  wfhDays             String[]               @default([]) @map("wfh_days")
  // Protected focus hours, minutes since midnight local (e.g. 540 = 09:00).
  focusStartMin       Int                    @default(540) @map("focus_start_min")
  focusEndMin         Int                    @default(1020) @map("focus_end_min")
  focusBlockMinutes   Int                    @default(90) @map("focus_block_minutes")
  standupCadence      WfhStandupCadence      @default(daily) @map("standup_cadence")
  notificationProfile WfhNotificationProfile @default(batched) @map("notification_profile")
  // Digest window times (minutes since midnight local). Empty = 09:00 + 16:00 defaults.
  digestTimesMin      Int[]                  @default([]) @map("digest_times_min")
  // IANA timezone for the user's local day: standups, digests, focus hours.
  timezone            String                 @default("UTC")
  // Mandatory first-enable setup interstitial completed at (wfh days, focus
  // hours, standup cadence). Enabling wfh/hybrid without this fails closed.
  setupCompletedAt    DateTime?              @map("setup_completed_at")

  history   WfhModeHistory[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([workspaceId, mode])
  @@map("wfh_work_modes")
}

model WfhModeHistory {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workModeId  String      @map("work_mode_id")
  workMode    WfhWorkMode @relation(fields: [workModeId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")

  previousMode WfhMode @map("previous_mode")
  newMode      WfhMode @map("new_mode")
  reason       String  @default("user_toggle")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workModeId, createdAt])
  @@map("wfh_mode_history")
}

// ── Wave 2 WFH mode (slice 2): async-first notification digest queue ─────────
// Routine notifications held for digest windows while WFH is effective.
// Urgent items are never queued (fail-open-toward-quiet is for senders only).

model WfhDigestItem {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  kind    String
  title   String
  body    String? @db.Text
  link    String?
  urgency String  @default("routine")

  // Digest window this item waits for (minutes since midnight local).
  windowMin Int       @map("window_min")
  // queued | sent
  status    String    @default("queued")
  sentAt    DateTime? @map("sent_at")

  queuedAt DateTime @default(now()) @map("queued_at")

  @@index([workspaceId, userId, status, windowMin])
  @@map("wfh_digest_items")
}

// ── Wave 2 WFH mode (slice 3): focus blocks + calendar connections ──────────
// FocusBlock: a protected deep-work block. Hard (auto-decline) protection
// requires a connected calendar + the one-time auto-decline consent gate.
// Calendar OAuth itself is a stub until the parked calendar integration lands.

model WfhFocusBlock {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  title      String
  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")
  // none | daily | weekdays | weekly
  recurrence String   @default("none")
  // soft (decline-with-suggestion) | hard (auto-decline, consent-gated)
  protection String   @default("soft")
  // user | os_suggested | ritual
  source     String   @default("user")
  // scheduled | protected | overridden | completed | cancelled
  status     String   @default("scheduled")

  calendarConnectionId String?                @map("calendar_connection_id")
  calendarConnection   WfhCalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)

  // Event ids this block defended against (read-only link into calendar data).
  defendedEventIds String[] @default([]) @map("defended_event_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, userId, status, startAt])
  @@map("wfh_focus_blocks")
}

model WfhCalendarConnection {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId               String    @map("user_id")
  // google | microsoft
  provider             String
  // connected | disconnected (OAuth arrives with the parked calendar integration)
  status               String    @default("disconnected")
  // One-time consent: "the OS may decline meetings on my behalf during focus blocks".
  autoDeclineConsentAt DateTime? @map("auto_decline_consent_at")

  focusBlocks WfhFocusBlock[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId, provider])
  @@map("wfh_calendar_connections")
}

// ── Wave 2 WFH mode (slice 4): async standups ───────────────────────────────
// Written yesterday/today/blockers updates (+optional video), team visibility,
// comment/reaction thread. One standup per user per workday. A missed standup
// is a nudge, never a gate.

model WfhStandup {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  // Workday covered, normalized to noon UTC.
  date       DateTime
  yesterday  String
  today      String
  blockers   String?
  videoUrl   String?  @map("video_url")
  // team | private
  visibility String   @default("team")

  comments  WfhStandupComment[]
  reactions WfhStandupReaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId, date])
  @@index([workspaceId, date, visibility])
  @@map("wfh_standups")
}

model WfhStandupComment {
  id        String     @id @default(cuid())
  standupId String     @map("standup_id")
  standup   WfhStandup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  body      String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([standupId, createdAt])
  @@map("wfh_standup_comments")
}

model WfhStandupReaction {
  id        String     @id @default(cuid())
  standupId String     @map("standup_id")
  standup   WfhStandup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  emoji     String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([standupId, userId])
  @@map("wfh_standup_reactions")
}

// ── Wave 2 WFH mode (slice 5): team rituals ─────────────────────────────────
// Workspace-level opt-in rituals (wins, kudos, virtual coffee, demo Friday).
// Subscriptions are opt-in; participation is logged; dead rituals are surfaced
// for retirement, never auto-deleted.

model WfhRitual {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String    @map("created_by")

  // wins | kudos | virtual-coffee | demo-friday
  type        String
  title       String
  description String
  // daily | weekly | biweekly | monthly
  cadence     String   @default("weekly")
  anchorDate  DateTime @map("anchor_date")
  // IANA timezone the cadence steps in (weekly = same local time across DST).
  timezone    String   @default("UTC")
  active      Boolean  @default(true)

  subscriptions  WfhRitualSubscription[]
  participations WfhRitualParticipation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, active])
  @@map("wfh_rituals")
}

model WfhRitualSubscription {
  id       String    @id @default(cuid())
  ritualId String    @map("ritual_id")
  ritual   WfhRitual @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  userId   String    @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ritualId, userId])
  @@map("wfh_ritual_subscriptions")
}

model WfhRitualParticipation {
  id         String    @id @default(cuid())
  ritualId   String    @map("ritual_id")
  ritual     WfhRitual @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  note       String?
  occurredAt DateTime  @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ritualId, occurredAt])
  @@map("wfh_ritual_participations")
}

// ── Wave 2 WFH mode (slice 6): home-office expense pack ─────────────────────
// Pre-wired categories with allocation rules (flat % or square footage).
// A category pack + allocation engine, NOT a full expense product. A finance
// ledger consumes rows via the toLedgerEntry post hook (lib/wfh/expenses.ts).

model WfhExpenseCategory {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  // utilities | internet | phone | equipment | supplies | home-office-space
  key              String
  name             String
  description      String
  allocationMethod String @default("flat_percent") @map("allocation_method")
  allocationPct    Float  @default(0) @map("allocation_pct")
  officeSqft       Float? @map("office_sqft")
  totalSqft        Float? @map("total_sqft")

  expenses WfhExpense[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId, key])
  @@map("wfh_expense_categories")
}

model WfhExpense {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  categoryId String             @map("category_id")
  category   WfhExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  amountCents      Int      @map("amount_cents")
  currency         String   @default("USD")
  occurredOn       DateTime @map("occurred_on")
  allocationMethod String   @map("allocation_method")
  allocationPct    Float    @map("allocation_pct")
  deductibleCents  Int      @map("deductible_cents")
  note             String?
  receiptUrl       String?  @map("receipt_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, userId, occurredOn])
  @@map("wfh_expenses")
}

// ── Wave 2 WFH mode (slice 7): 13B learning-loop signals ─────────────────────
// Behavioral facts (focus overridden, standup submitted, ritual joined…)
// for the preference-learning loop. Facts, never judgments.

model WfhLearningSignal {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")

  // focus_block_created | focus_block_overridden | focus_block_completed |
  // standup_submitted | ritual_joined | ritual_retired | mode_enabled | mode_disabled
  signalType String   @map("signal_type")
  // focus | standup | ritual | mode
  source     String
  payload    Json
  occurredAt DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, userId, occurredAt])
  @@map("wfh_learning_signals")
}

// ── Wave 2 Insurance (slice 1): policy inventory ontology ───────────────────
// Manage side of the insurance module: carriers, policies, renewals.
// Quote/bind side (Submissions, Quotes, Certificates) arrives in slices 2–4.
// Insurance is a money red-lane domain: premiums are consequential payments,
// propose → explicit approval → licensed rail executes; the OS never holds
// premium funds (zero custody). SPEC-INSURANCE.md §4.

enum InsuranceLineOfBusiness {
  gl
  wc
  bop
  cyber
  professional_liability
  commercial_auto
  umbrella
}

enum InsurancePolicyStatus {
  active
  pending_renewal
  expired
  cancelled
}

enum InsuranceAppointmentPath {
  direct
  dais_market_access
  subappointment
}

enum InsuranceRemarketStatus {
  detected
  remarketing
  quoted
  bound
  auto_renew_surfaced
}

// An insurance carrier or MGA reachable through the vendor rail.
model InsuranceCarrier {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name            String
  amBestRating    String?                  @map("am_best_rating")
  naicCode        String?                  @map("naic_code")
  appointmentPath InsuranceAppointmentPath @map("appointment_path")
  // Lines supported: ["gl","bop","wc",...] — JSON so new lines need no schema change.
  linesSupported  Json                     @default("[]") @map("lines_supported")

  policies InsurancePolicy[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("insurance_carriers")
}

// An in-force (or historical) insurance contract. Coverage data renders ONLY
// from vendor/carrier truth — the OS never invents limits or premiums.
model InsurancePolicy {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  carrierId   String           @map("carrier_id")
  carrier     InsuranceCarrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  policyNumber            String                  @map("policy_number")
  line                    InsuranceLineOfBusiness
  namedInsured            String                  @map("named_insured")
  effectiveAt             DateTime                @map("effective_at")
  expiresAt               DateTime                @map("expires_at")
  // Limits in minor currency units (cents).
  limitPerOccurrenceCents Int?                    @map("limit_per_occurrence_cents")
  limitAggregateCents     Int?                    @map("limit_aggregate_cents")
  deductibleCents         Int?                    @map("deductible_cents")
  annualPremiumCents      Int?                    @map("annual_premium_cents")
  paymentSchedule         String?                 @map("payment_schedule")
  status                  InsurancePolicyStatus   @default(active)
  // "coverforce" | "manual" — where this record came from.
  source                  String                  @default("manual")
  // Raw vendor payload snapshot for audit and re-parsing.
  rawPayload              Json                    @default("{}") @map("raw_payload")

  renewals        InsuranceRenewal[]
  // Quote → policy lineage (slice 3b): quotes bound into this policy.
  quotes          InsuranceQuote[]
  // Zero-custody payment handoffs: premium funds move carrier-direct; the OS
  // holds nothing. This table deliberately carries NO OS account fields.
  paymentHandoffs InsurancePaymentHandoff[]
  // Prior-term lineage: a renewal creates a new Policy row linked back here.
  priorPolicyId   String?                   @map("prior_policy_id")
  priorPolicy     InsurancePolicy?          @relation("PolicyLineage", fields: [priorPolicyId], references: [id], onDelete: SetNull)
  nextTerms       InsurancePolicy[]         @relation("PolicyLineage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Slice 5: certificates issued from this policy.
  certificates InsuranceCertificate[]

  @@unique([workspaceId, policyNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, expiresAt])
  @@map("insurance_policies")
}

// A certificate of insurance (ACORD 25 style). SPEC-INSURANCE.md §4.1, §4.3,
// §5: COIs render ONLY from the in-force issuing policy's truth — the agent
// prepares a draft, the human reviews (issue_certificate governed action),
// and the PDF artifact is generated at issue time from the verified payload.
// Never from drafts or quotes; unverified fields render "not confirmed".
enum InsuranceCertificateStatus {
  draft
  issued
  revoked
}

model InsuranceCertificate {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policyId    String          @map("policy_id")
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  holderName            String  @map("holder_name")
  holderAddress         String? @map("holder_address")
  additionalInsured     Boolean @default(false) @map("additional_insured")
  waiverOfSubrogation   Boolean @default(false) @map("waiver_of_subrogation")
  operationsDescription String? @map("operations_description")

  issueDate DateTime @map("issue_date")
  validFrom DateTime @map("valid_from")
  validTo   DateTime @map("valid_to")

  // PDF artifact, stored like the e-sign sealed evidence (Bytes + sha256).
  pdfBytes Bytes?  @map("pdf_bytes")
  pdfHash  String? @map("pdf_hash")

  status InsuranceCertificateStatus @default(draft)

  requestedBy  String? @map("requested_by")
  // Contract / client reference that asked for this certificate (holder-request
  // tracking links back to the requesting contract or client record).
  requestedFor String? @map("requested_for")

  issuedBy String?   @map("issued_by")
  issuedAt DateTime? @map("issued_at")

  // The issue_certificate governed approval proposed at prepare time.
  approvalId String? @map("approval_id")

  revokedReason String?   @map("revoked_reason")
  revokedAt     DateTime? @map("revoked_at")
  revokedBy     String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("insurance_certificates")
}

// A policy coming due. Auto-renewals are detected and surfaced — never
// silently accepted; the agent flags premium/coverage deltas before approval.
model InsuranceRenewal {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policyId    String          @map("policy_id")
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  renewalDate       DateTime                @map("renewal_date")
  remarketStatus    InsuranceRemarketStatus @default(detected) @map("remarket_status")
  priorPremiumCents Int?                    @map("prior_premium_cents")
  newPremiumCents   Int?                    @map("new_premium_cents")
  // (new - prior) / prior * 100, stored when a renewal quote is bound.
  premiumDeltaPct   Float?                  @map("premium_delta_pct")
  alertSentAt       DateTime?               @map("alert_sent_at")
  // Carrier's auto-renewal terms snapshot (slice 4). Auto-renewals are
  // detected and surfaced, NEVER silently accepted — the snapshot plus the
  // delta flags go to human review before any renewal approval.
  autoRenewTerms    Json?                   @map("auto_renew_terms")

  // Submissions created by remarketing this renewal (slice 4).
  submissions InsuranceSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, policyId, renewalDate])
  @@index([workspaceId, renewalDate])
  @@index([workspaceId, remarketStatus])
  @@map("insurance_renewals")
}

// ── Wave 2 Insurance (slice 2): quoting ontology ─────────────────────────────
// Submission = the risk data packet sent to carriers. Quote = a priced offer.
// Declines and referrals are first-class outcomes with documented reasons
// (SPEC-INSURANCE.md §4.5).

enum InsuranceSubmissionStatus {
  draft
  submitted
  quoted
  declined
  expired
}

enum InsuranceQuoteStatus {
  draft
  quoted
  declined
  referred
  expired
  bound
}

model InsuranceSubmission {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  line                          InsuranceLineOfBusiness
  applicantName                 String                    @map("applicant_name")
  operationsDescription         String?                   @map("operations_description")
  state                         String
  classCode                     String?                   @map("class_code")
  payrollCents                  Int?                      @map("payroll_cents")
  revenueCents                  Int?                      @map("revenue_cents")
  targetLimitPerOccurrenceCents Int?                      @map("target_limit_per_occurrence_cents")
  targetLimitAggregateCents     Int?                      @map("target_limit_aggregate_cents")
  // Loss history: [{ year, claimCount, totalCents }] — JSON, never invented.
  lossHistory                   Json                      @default("[]") @map("loss_history")
  status                        InsuranceSubmissionStatus @default(draft)
  vendorRef                     String?                   @map("vendor_ref")
  submittedBy                   String                    @map("submitted_by")
  // The renewal this submission was created to remarket (slice 4). Null for
  // ordinary new-business submissions.
  renewalId                     String?                   @map("renewal_id")
  renewal                       InsuranceRenewal?         @relation(fields: [renewalId], references: [id], onDelete: SetNull)

  quotes InsuranceQuote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("insurance_submissions")
}

model InsuranceQuote {
  id           String              @id @default(cuid())
  workspaceId  String              @map("workspace_id")
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissionId String              @map("submission_id")
  submission   InsuranceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  carrierName             String               @map("carrier_name")
  quotedPremiumCents      Int?                 @map("quoted_premium_cents")
  limitPerOccurrenceCents Int?                 @map("limit_per_occurrence_cents")
  limitAggregateCents     Int?                 @map("limit_aggregate_cents")
  quoteExpiry             DateTime?            @map("quote_expiry")
  status                  InsuranceQuoteStatus @default(draft)
  // Vendor's reasoning / decline notes, verbatim. Never paraphrased into coverage.
  vendorNotes             String?              @map("vendor_notes")
  // Raw vendor quote payload snapshot.
  rawPayload              Json                 @default("{}") @map("raw_payload")
  // Set when this quote is bound: the policy it became (slice 3b lineage).
  // A renewal quote may also reference the prior term's policy in
  // rawPayload.renewalOfPolicyId; binding then sets the new policy's
  // priorPolicyId.
  policyId                String?              @map("policy_id")
  policy                  InsurancePolicy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, submissionId])
  @@index([workspaceId, status])
  @@map("insurance_quotes")
}

// ── Wave 2 Insurance slice 3b: zero-custody payment handoff ─────────────────
// One record per bound policy documenting that premium funds move
// carrier-direct through the vendor rail. The OS never holds, floats, or
// routes premium funds (SPEC-INSURANCE.md §4.4 rule 2) — so this model
// deliberately carries NO OS account fields: no account numbers, routing
// numbers, wallet ids, or balances. custodyAssertion is always
// "carrier_direct"; binding.ts asserts this in code (assertZeroCustodyHandoff)
// so a future schema edit adding a custody field fails loudly instead of
// silently.
model InsurancePaymentHandoff {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policyId    String          @map("policy_id")
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  // Premium amount the carrier will collect, from vendor bind data.
  // Null = "not confirmed" (never a guess).
  amountCents      Int?    @map("amount_cents")
  // Who gets paid: carrier name (+ NAIC when the vendor supplies it).
  // Always the carrier — never an OS account.
  payeeCarrier     String  @map("payee_carrier")
  payeeCarrierNaic String? @map("payee_carrier_naic")
  // The vendor rail's payment reference (carrier-direct transaction).
  vendorPaymentRef String? @map("vendor_payment_ref")
  // Zero-custody assertion. Always "carrier_direct".
  custodyAssertion String  @default("carrier_direct") @map("custody_assertion")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, policyId])
  @@map("insurance_payment_handoffs")
}

// ── Wave 2 Insurance (licensed-partner decision, Tico 2026-10-01) ────────────
// Producer-of-record model: LICENSED PARTNER. The partner holds the insurance
// licenses; Marketr provides the software. No bind may execute unless an
// active, appointed licensed partner is on file for the workspace — the bind
// path fails closed with PARTNER_NOT_APPOINTED otherwise.

enum InsurancePartnerStatus {
  active
  suspended
  revoked
}

model InsuranceLicensedPartner {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name            String
  contactEmail    String?                  @map("contact_email")
  // Producer license number(s), as issued by the state DOI.
  licenseNumber   String?                  @map("license_number")
  // States the partner is licensed/appointed in, e.g. ["NC","SC"].
  statesLicensed  Json                     @default("[]") @map("states_licensed")
  appointmentPath InsuranceAppointmentPath @map("appointment_path")
  status          InsurancePartnerStatus   @default(active)
  appointedAt     DateTime?                @map("appointed_at")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("insurance_licensed_partners")
}

// Wave 2 Insurance slice 3a: governed-action audit trail (SPEC-INSURANCE.md §4.3–4.4).
// One record per human decision on a governed action (approved or denied):
// who approved, what was approved (payload snapshot), timestamp, and the
// vendor transaction reference once the licensed rail executes.
model InsuranceAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // "request_quote" | "bind_policy" | "issue_certificate".
  action               String
  // "quote" | "policy" | "certificate".
  subjectType          String   @map("subject_type")
  subjectId            String   @map("subject_id")
  // "approved" | "denied".
  result               String
  decidedBy            String?  @map("decided_by")
  decidedAt            DateTime @map("decided_at")
  // Payload snapshot as approved: premium/limits/carrier/effective dates.
  // Fields not present at approval read "not confirmed" at render; never invented.
  payload              Json
  // Set when the licensed rail executes (post-approval). Nullable until then.
  vendorTransactionRef String?  @map("vendor_transaction_ref")
  note                 String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, action, createdAt])
  @@map("insurance_audit_events")
}

// Wave 2 Insurance slice 3a: request_quote standing rules.
// A workspace may pre-approve quoting per line of business, so request_quote
// needs one approval OR a standing rule. bind_policy NEVER has a standing
// rule (hard refusal in governance.ts) — no auto-bind in v1.
model InsuranceQuoteRule {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // InsuranceLineOfBusiness value, e.g. "general_liability".
  lineOfBusiness String  @map("line_of_business")
  approvedBy     String? @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, lineOfBusiness])
  @@map("insurance_quote_rules")
}

// Dataset Builder slice 1: Ingest (BUSINESS-OS-FEATURE-SPECS.md §1).
// Source = where business knowledge comes from (upload, Google Drive,
// website crawl, copy-paste). Document = one ingested file/page/text.
// Chunk = one extract of a document, ALWAYS pointing at its document
// (non-nullable FK, ON DELETE CASCADE) — zero orphaned chunks, enforced
// by the database and mirrored by verifyNoOrphanedChunks() in
// lib/datasetbuilder/register.ts.
enum DatasetSourceKind {
  upload
  drive
  web
  paste
}

enum DatasetDocumentStatus {
  pending
  ready
  failed
}

model DatasetSource {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind        DatasetSourceKind @map("kind")
  // Human label, e.g. "Pricing one-pager.pdf" or "Acme help center crawl".
  name        String
  // Origin identifier: drive file id, crawled URL, uploaded filename.
  externalRef String?           @map("external_ref")
  // Kind-specific config (drive connection id, crawl depth, …).
  config      Json              @default("{}")

  documents DatasetDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, kind])
  @@map("dataset_sources")
}

model DatasetDocument {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Non-nullable: a document always belongs to exactly one source.
  sourceId String        @map("source_id")
  source   DatasetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  name      String
  mimeType  String?               @map("mime_type")
  byteSize  Int?                  @map("byte_size")
  charCount Int                   @default(0) @map("char_count")
  status    DatasetDocumentStatus @default(pending)
  error     String?

  chunks DatasetChunk[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, sourceId])
  @@map("dataset_documents")
}

model DatasetChunk {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Non-nullable: the zero-orphaned-chunks invariant. A chunk is never
  // written without a live document pointer.
  documentId String          @map("document_id")
  document   DatasetDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Ordinal position of the chunk within its document (0-based).
  position  Int
  // Character offsets into the document's extracted text.
  charStart Int    @map("char_start")
  charEnd   Int    @map("char_end")
  text      String

  createdAt DateTime @default(now()) @map("created_at")

  classifications DatasetClassification[]
  versionChunks   DatasetVersionChunk[]

  @@unique([documentId, position])
  @@map("dataset_chunks")
}

// ---- Slice 2: classification + human review ---------------------------
enum DatasetType {
  faq
  product_catalog
  policy
  process_sop
  company_fact
  pricing
}

enum ClassificationStatus {
  applied
  pending_review
  rejected
}

enum ReviewItemStatus {
  pending
  approved
  rejected
}

model DatasetClassification {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Non-nullable: a classification always points at a live chunk. A
  // classification of an orphaned chunk is as invalid as the chunk itself.
  chunkId String       @map("chunk_id")
  chunk   DatasetChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  datasetType   DatasetType          @map("dataset_type")
  confidence    Float
  // Lineage: which engine classified this chunk, and which version.
  engine        String
  engineVersion String               @map("engine_version")
  status        ClassificationStatus @default(applied)

  reviewItem    DatasetReviewItem?
  versionChunks DatasetVersionChunk[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Re-running an engine replaces its own classification, never duplicates it.
  @@unique([chunkId, engine])
  @@index([workspaceId, datasetType, status])
  @@map("dataset_classifications")
}

model DatasetReviewItem {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Exactly one review item per classification — the queue can never
  // lose or double-count a pending decision.
  classificationId String                @unique @map("classification_id")
  classification   DatasetClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  status    ReviewItemStatus @default(pending)
  note      String?
  decidedBy String?          @map("decided_by")
  decidedAt DateTime?        @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@map("dataset_review_items")
}

// ---- Slice 3: versioned dataset compiler -------------------------------
model Dataset {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One dataset per type per workspace — "the pricing dataset".
  type DatasetType @map("type")
  // Human label, e.g. "Pricing".
  name String

  // Phase 4b: staleness-alert dedupe — the compiled version the last
  // "dataset is stale" alert fired for (re-arms after a recompile).
  staleAlertedVersion Int?      @map("stale_alerted_version")
  staleAlertedAt      DateTime? @map("stale_alerted_at")

  versions DatasetVersion[]

  // Slice 4: publish records — which version is live on which target.
  publishes DatasetPublish[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, type])
  @@map("datasets")
}

model DatasetVersion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  datasetId String  @map("dataset_id")
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // Monotonic per dataset: v1, v2, …
  version    Int
  chunkCount Int  @map("chunk_count")
  // Compile-time transform lineage: which compiler, which settings, when.
  settings   Json @default("{}")

  chunks DatasetVersionChunk[]

  compiledAt DateTime @default(now()) @map("compiled_at")

  @@unique([datasetId, version])
  @@index([workspaceId, datasetId])
  @@map("dataset_versions")
}

model DatasetVersionChunk {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  versionId String         @map("version_id")
  version   DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  // Per-chunk lineage: version ← chunk ← classification, tracing back to
  // Source/Document through the chunk's own FK chain. A version chunk can
  // never point at a missing version, chunk, or classification — the
  // zero-orphaned-data invariant extends down to compiled snapshots.
  chunkId          String                @map("chunk_id")
  chunk            DatasetChunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  classificationId String                @map("classification_id")
  classification   DatasetClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  // Model lineage copied at compile time so it survives engine renames.
  engine           String
  engineVersion    String                @map("engine_version")

  compiledAt DateTime @default(now()) @map("compiled_at")

  @@unique([versionId, chunkId])
  @@index([workspaceId, versionId])
  @@map("dataset_version_chunks")
}

model DatasetPublish {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  datasetId String  @map("dataset_id")
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // Publish target: "briefnow" | "rag".
  target      String
  // Pinned compiled version number (monotonic v1, v2, …).
  version     Int
  versionId   String @map("version_id")
  chunkCount  Int    @map("chunk_count")
  // briefnow → adapter package path; rag → snapshot pointer
  // (rag://workspace/type/vN).
  artifactRef String @map("artifact_ref")

  publishedAt DateTime @default(now()) @map("published_at")

  @@unique([datasetId, target, version])
  @@index([workspaceId, datasetId, target])
  @@map("dataset_publishes")
}

// Legal/Compliance slice 1: Obligation map (BUSINESS-OS-FEATURE-SPECS.md §4).
// LegalProfile captures industry + business model + jurisdictions per tenant;
// ObligationTemplate is structured seed data (industry/jurisdiction filters);
// Obligation is the per-tenant computed instance with tenant-controlled status.
// Guardrails: every output carries the information-not-advice label; templates
// carry a source reference and never invent form numbers, statutes, or deadlines.

model LegalProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // food | drones | saas | services (see lib/legal/types.ts INDUSTRIES).
  industry      String
  // sole_proprietor | llc | corporation | partnership.
  businessModel String   @map("business_model")
  // e.g. ["NC"]. "national" templates apply in every jurisdiction.
  jurisdictions String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_profiles")
}

model ObligationTemplate {
  id  String @id @default(cuid())
  // Stable slug, e.g. "nc-sos-registration". Joins tenant Obligation rows.
  key String @unique

  // Empty = applies to all industries.
  industries    String[]
  // "national" = applies in every jurisdiction; otherwise codes like "NC".
  jurisdictions String[]

  category       ObligationCategory
  title          String
  description    String
  // Where the claim comes from, e.g. "IRS — irs.gov (verify before acting)".
  // Never empty: the no-invention guardrail requires a source on every template.
  sourceRef      String             @map("source_ref")
  // Renewal cadence in plain words; null when unknown rather than invented.
  renewalCadence String?            @map("renewal_cadence")
  // True when specifics were deliberately left out for verification.
  needsReview    Boolean            @default(false) @map("needs_review")

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("obligation_templates")
}

enum ObligationCategory {
  license
  filing
  tax
  insurance
  permit
}

model Obligation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  templateKey String @map("template_key")

  status       ObligationStatus @default(open)
  snoozedUntil DateTime?        @map("snoozed_until")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, templateKey])
  @@index([workspaceId, status])
  @@map("obligations")
}

enum ObligationStatus {
  open
  snoozed
  dismissed
  done
}

// Legal/Compliance slice 4: Change radar (BUSINESS-OS-FEATURE-SPECS.md §4).
// RegulationChange is structured seed data (industry/jurisdiction filters)
// for regulation changes that may affect the tenant — v1 = illustrative
// seed feed, NO live scraping. LegalRadarTriage is the tenant's per-change
// triage state; absence of a row means "new".
// Guardrails: every output carries the information-not-advice label; changes
// carry a source reference and never invent bill numbers, statute citations,
// or effective dates (effectiveDate is null unless verified).

model RegulationChange {
  id  String @id @default(cuid())
  // Stable slug, e.g. "nc-privacy-update". Joins tenant triage rows.
  key String @unique

  // Empty = applies to all industries.
  industries    String[]
  // "national" = applies in every jurisdiction; otherwise codes like "NC".
  jurisdictions String[]

  category            RegulationChangeCategory
  title               String
  plainEnglishSummary String                   @map("plain_english_summary")
  // Where the claim comes from. Never empty: the no-invention guardrail
  // requires a source on every change.
  sourceRef           String                   @map("source_ref")
  // Only when the date itself was verified — never a guess.
  effectiveDate       DateTime?                @map("effective_date")
  publishedAt         DateTime                 @map("published_at")
  // True for the illustrative v1 seed feed.
  seedFlag            Boolean                  @default(true) @map("seed_flag")

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("regulation_changes")
}

enum RegulationChangeCategory {
  privacy
  licensing
  tax
  employment
  insurance
  safety
  other
}

model LegalRadarTriage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  changeKey String @map("change_key")

  status RadarTriageStatus @default(reviewed)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, changeKey])
  @@index([workspaceId, status])
  @@map("legal_radar_triage")
}

enum RadarTriageStatus {
  reviewed
  dismissed
}

// Legal/Compliance slice 2: Deadline engine (BUSINESS-OS-FEATURE-SPECS.md §4).
// LegalDeadline is the per-tenant computed deadline for one obligation:
// the tenant sets/confirms the due date (source "tenant_set"), and recurring
// reminders are computed from the renewal cadence anchored to that real date
// (source "computed"). A null dueDate is ALWAYS rendered as "date needed" —
// the engine never invents calendar dates. Escalation tiers (90/30/7 days,
// overdue) are computed at read time; lastAlertedTier records which tier the
// sweep already emitted so each tier fires at most once.

enum DeadlineRecurrence {
  none
  monthly
  quarterly
  semiannual
  annual
  biennial
}

enum DeadlineSource {
  tenant_set
  computed
}

enum DeadlineStatus {
  open
  done
  dismissed
}

model LegalDeadline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Obligation template key this deadline tracks (e.g. "nc-annual-report").
  templateKey String @map("template_key")
  // Denormalized title from the template at creation time.
  title       String

  // Null = the tenant has not confirmed a date yet ("date needed").
  dueDate          DateTime?          @map("due_date")
  recurrence       DeadlineRecurrence @default(none)
  // The series' original due date. Each next occurrence is anchor + n×cadence
  // (never prev + cadence), so Jan 31 monthly stays end-of-month. Null =
  // this row's own dueDate is the anchor (first occurrence / tenant re-dated).
  recurrenceAnchor DateTime?          @map("recurrence_anchor")
  source           DeadlineSource     @default(tenant_set)
  status           DeadlineStatus     @default(open)

  // Escalation bookkeeping: the tier the sweep last emitted for this deadline.
  lastAlertedTier String?   @map("last_alerted_tier")
  lastAlertedAt   DateTime? @map("last_alerted_at")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@map("legal_deadlines")
}

// Legal/Compliance slice 3: Document vault (BUSINESS-OS-FEATURE-SPECS.md §4).
// LegalDocument is the logical document (formation doc, contract, license,
// EIN letter, policy, other). LegalDocumentVersion holds one uploaded file
// per version: a new upload of the same logical document adds a version row —
// history is never overwritten. Expiry dates are tenant-set ("tenant_set")
// or read from the document itself ("read_from_document") — the engine never
// guesses one. Escalation tiers (90/30/7 days, overdue) are computed at read
// time from the CURRENT version's expiryDate; lastAlertedTier records which
// tier the sweep already emitted so each tier fires at most once per version.

enum LegalDocumentType {
  formation
  contract
  license
  ein_letter
  policy
  other
}

enum LegalExpirySource {
  tenant_set
  read_from_document
}

model LegalDocument {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  docType LegalDocumentType @map("doc_type")
  title   String
  notes   String?

  currentVersionId String?               @map("current_version_id")
  currentVersion   LegalDocumentVersion? @relation("LegalDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions LegalDocumentVersion[] @relation("LegalDocumentVersions")

  @@index([workspaceId, docType])
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id         String        @id @default(cuid())
  documentId String        @map("document_id")
  document   LegalDocument @relation("LegalDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber   Int           @map("version_number")
  workspaceFileId String        @map("workspace_file_id")
  workspaceFile   WorkspaceFile @relation(fields: [workspaceFileId], references: [id], onDelete: Cascade)

  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Null = no expiry recorded yet ("date needed"). Never guessed.
  expiryDate   DateTime?          @map("expiry_date")
  expirySource LegalExpirySource? @map("expiry_source")
  issuer       String?

  // Version-chain bookkeeping: a new version supersedes the previous one.
  supersedesVersionId String?                @map("supersedes_version_id")
  supersedes          LegalDocumentVersion?  @relation("LegalDocumentVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy        LegalDocumentVersion[] @relation("LegalDocumentVersionSupersedes")

  // Documents that point at this version as their current one.
  currentOf LegalDocument[] @relation("LegalDocumentCurrentVersion")

  // Escalation bookkeeping: the tier the sweep last emitted for this version.
  lastAlertedTier String?   @map("last_alerted_tier")
  lastAlertedAt   DateTime? @map("last_alerted_at")

  @@unique([documentId, versionNumber])
  @@index([workspaceFileId])
  @@map("legal_document_versions")
}

// Legal/Compliance slice 5: Digital-properties module — Hullcheck synergy
// (BUSINESS-OS-FEATURE-SPECS.md §4). The digital side of the Legal surface:
// a tenant's websites/apps (DigitalProperty) and the plain-English findings
// against them (DigitalFinding), organized by Hullcheck's layer taxonomy
// (detect / fix / prove / harden / document / comply). v1 findings come from
// the tenant's self-assessment or manual import — source is always labeled,
// and "hullcheck_engine" is reserved for the future scan engine (the import
// path rejects it until the engine exists; see lib/legal/digital.ts).

enum DigitalPropertyKind {
  website
  app
}

enum HullcheckLayer {
  detect
  fix
  prove
  harden
  document
  comply
}

enum DigitalFindingSeverity {
  critical
  high
  medium
  low
}

enum DigitalFindingStatus {
  open
  fixed
  dismissed
}

enum DigitalFindingSource {
  self_assessment
  manual_import
  hullcheck_engine
}

model LegalDigitalProperty {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name  String
  url   String?
  kind  DigitalPropertyKind
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  findings LegalDigitalFinding[]

  @@index([workspaceId])
  @@map("legal_digital_properties")
}

model LegalDigitalFinding {
  id         String               @id @default(cuid())
  propertyId String               @map("property_id")
  property   LegalDigitalProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Stable self-assessment checklist item key; null for freeform manual findings.
  itemKey String? @map("item_key")

  hullcheckLayer      HullcheckLayer         @map("hullcheck_layer")
  title               String
  // "What this means for your business" (Hullcheck SPEC §3) — plain English, always present.
  plainEnglishSummary String                 @map("plain_english_summary")
  severity            DigitalFindingSeverity
  status              DigitalFindingStatus   @default(open)
  source              DigitalFindingSource
  // Optional link into slice 1's obligation templates (by key).
  obligationKey       String?                @map("obligation_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId, status])
  @@map("legal_digital_findings")
}

// Funding/VC slice 1: Starter network (BUSINESS-OS-FEATURE-SPECS.md §3).
// Boardy AI ships as a PRELOADED starter contact in every tenant's funding
// graph — the first card in the deck, never the gateway. Boardy's job is to
// help the founder get MORE contacts through warm intros matched to the
// founder's target investor profile; the front door is the founder's own
// raise workflow (FundingRound target investor profile below).
//
// There is NO programmatic Boardy API or MCP — https://boardy.ai/agentskill
// is an instruction page for an EMAIL flow, and Boardy's double-opt-in norms
// govern his side. The graph models Boardy as a contact intros are requested
// THROUGH; the agent-drafted email rail lands in the Connector Agent slices.
//
// Guardrails (slice 1 scaffolding; full enforcement lands in Connector slice 4):
// - Intro requests are context-rich and one-per-(contact, investor) pair:
//   no bulk creation, no spray-and-pray.
// - Rate limits on intro requests protect Boardy's reputation — the asset.

enum FundingContactSource {
  boardy_starter
  founder_added
  boardy_intro
  connector_import
}

model FundingContact {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Boardy starter row: name "Boardy", role "AI superconnector".
  name   String
  role   String?
  handle String? // email or other contact handle, e.g. boardy@boardy.ai
  note   String?

  source           FundingContactSource @default(founder_added)
  // Human-readable marker: Boardy is THE preloaded starter contact.
  isStarterContact Boolean              @default(false) @map("is_starter_contact")
  // Idempotency key: "boardy_starter" on the starter row, null otherwise.
  // Nulls are distinct in Postgres, so founder-added rows never collide.
  starterKey       String?              @map("starter_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  interactions  FundingInteraction[]
  introRequests FundingIntroRequest[]

  @@unique([workspaceId, starterKey])
  @@index([workspaceId, source])
  @@map("funding_contacts")
}

enum FundingInvestorStage {
  target
  contacted
  meeting
  diligence
  term_sheet
  passed
  // Slice 2: terminal outcomes. `won` = the investor committed; `lost` =
  // the founder walked away; `passed` (slice 1) = the investor passed.
  won
  lost
}

// Slice 2: who supplied the enrichment data. v1 = manual/structured entry
// only — `enriched` marks fields fetched through a provider later, and every
// enriched row must carry fetched-at. No live scraping in v1.
enum FundingEnrichmentSource {
  self_reported
  enriched
}

model FundingInvestor {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name  String
  firm  String?
  email String?
  // Slice 2 enrichment: the person's role/title at the firm.
  title String?

  // Investor's known check range and thesis (founder-entered for now).
  checkSizeMin Int?     @map("check_size_min")
  checkSizeMax Int?     @map("check_size_max")
  stages       String[]
  sectors      String[]
  thesisFit    String?  @map("thesis_fit")

  // Enrichment provenance: which fields came from the founder
  // (self_reported) vs an enrichment fetch (enriched, + fetched-at).
  enrichmentSource    FundingEnrichmentSource @default(self_reported) @map("enrichment_source")
  enrichmentFetchedAt DateTime?               @map("enrichment_fetched_at")
  enrichmentNotes     String?                 @map("enrichment_notes")

  stage  FundingInvestorStage @default(target)
  // How this investor entered the pipeline (e.g. "boardy_intro", "crunchbase").
  source String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  interactions           FundingInteraction[]
  introRequests          FundingIntroRequest[]
  followUps              FundingFollowUp[]
  // Slice 5 (connector plug-in): introductions brokered to this investor
  // by the tenant's connector agent in FUNDING mode.
  connectorIntroductions ConnectorIntroduction[]

  @@index([workspaceId, stage])
  @@map("funding_investors")
}

enum FundingInteractionKind {
  email
  call
  meeting
  intro
  deck_sent
  note
  // Slice 2: recorded automatically by stage transitions (with an actor).
  stage_change
}

model FundingInteraction {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  occurredAt DateTime               @default(now()) @map("occurred_at")
  kind       FundingInteractionKind
  summary    String
  // Who recorded the interaction (founder email/handle, "founder", "agent").
  // Slice 2: always set on auto-recorded stage_change rows.
  actor      String?

  contactId  String?          @map("contact_id")
  contact    FundingContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  investorId String?          @map("investor_id")
  investor   FundingInvestor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, occurredAt])
  @@map("funding_interactions")
}

// Slice 2: follow-up reminders on an investor. The follow-up sweep
// (lib/funding/followup-sweep.ts) surfaces due/upcoming/overdue rows
// through the alert hub (trigger "funding_followup"), at most once per
// tier per follow-up (recorded on lastAlertedTier).
model FundingFollowUp {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  investorId String          @map("investor_id")
  investor   FundingInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  dueAt DateTime @map("due_at")
  note  String
  done  Boolean  @default(false)

  doneAt          DateTime? @map("done_at")
  // Sweep dedup: the escalation tier already alerted for ("upcoming",
  // "due_today", "overdue"), null when never alerted.
  lastAlertedTier String?   @map("last_alerted_tier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, done, dueAt])
  @@index([investorId])
  @@map("funding_follow_ups")
}

enum FundingIntroStatus {
  draft
  pending_approval
  approved
  sent
  accepted
  declined
  expired
}

model FundingIntroRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The connector making the intro (e.g. the Boardy starter contact).
  contactId  String          @map("contact_id")
  contact    FundingContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // The target investor.
  investorId String          @map("investor_id")
  investor   FundingInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  status FundingIntroStatus @default(draft)

  // Context-required fields — guardrail: no context, no intro, ever.
  reason     String // why THIS investor, why now
  founderAsk String  @map("founder_ask") // the specific ask
  fitNotes   String? @map("fit_notes") // thesis-fit evidence

  requestedAt   DateTime  @default(now()) @map("requested_at")
  decidedAt     DateTime? @map("decided_at")
  decidedBy     String?   @map("decided_by")
  declineReason String?   @map("decline_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Guardrail: exactly ONE intro request per (contact, investor) pair per
  // tenant. A declined request is edited/reopened in place, never duplicated —
  // this is the schema-level no-spray-and-pray rule.
  @@unique([workspaceId, contactId, investorId])
  @@index([workspaceId, status])
  @@map("funding_intro_requests")
}

enum FundingDataRoomDocKind {
  pitch_deck
  financials
  metrics
  other
}

model FundingDataRoomDoc {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title   String
  // docType (spec §3): pitch_deck / financials / metrics / other — the
  // slice-1 `kind` enum already covers these exact values, so it IS the
  // docType; no new enum was introduced.
  kind    FundingDataRoomDocKind
  version Int                    @default(1)
  fileUrl String?                @map("file_url")
  notes   String?

  // Slice 3: immutable version chain. Each upload is a NEW
  // FundingDataRoomDocVersion row; the doc points at the current one.
  // Published version rows are never mutated — only superseded.
  currentVersionId String?                    @map("current_version_id")
  currentVersion   FundingDataRoomDocVersion? @relation("FundingDataRoomCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions    FundingDataRoomDocVersion[] @relation("FundingDocVersions")
  shareLinks  FundingShareLink[]
  // Funding/VC slice 4: deterministic pitch-deck reviews of this doc.
  deckReviews FundingDeckReview[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, kind])
  @@map("funding_data_room_docs")
}

// Funding/VC slice 3: Data room version chain (BUSINESS-OS-FEATURE-SPECS.md
// §3). One row per upload — a new version never mutates a published one;
// the doc's currentVersion pointer moves forward instead.
model FundingDataRoomDocVersion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String             @map("document_id")
  document   FundingDataRoomDoc @relation("FundingDocVersions", fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber   Int           @map("version_number")
  workspaceFileId String        @map("workspace_file_id")
  workspaceFile   WorkspaceFile @relation(fields: [workspaceFileId], references: [id], onDelete: Cascade)

  fileName  String  @map("file_name")
  mimeType  String? @map("mime_type")
  sizeBytes Int     @map("size_bytes")

  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Version-chain bookkeeping: a new version supersedes the previous one.
  supersedesVersionId String?                     @map("supersedes_version_id")
  supersedes          FundingDataRoomDocVersion?  @relation("FundingDocVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy        FundingDataRoomDocVersion[] @relation("FundingDocVersionSupersedes")

  // Documents that point at this version as their current one.
  currentOf FundingDataRoomDoc[] @relation("FundingDataRoomCurrentVersion")

  // Share links pinned to this version; views of this version.
  pinnedShareLinks FundingShareLink[]
  views            FundingDocView[]

  // Funding/VC slice 4: deterministic pitch-deck reviews of this version.
  deckReviews FundingDeckReview[]

  @@unique([documentId, versionNumber])
  @@index([workspaceFileId])
  @@map("funding_data_room_versions")
}

// Funding/VC slice 3: shareable, expiring data-room links (spec §3).
// A link shares one doc (resolving to its current version at access time,
// or a pinned version) or the whole room (docId = null). Expiry is
// enforced at access time; revoked links 404.
model FundingShareLink {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // null = whole-room link.
  docId        String?                    @map("doc_id")
  doc          FundingDataRoomDoc?        @relation(fields: [docId], references: [id], onDelete: Cascade)
  // null = resolve to the doc's current version at access time.
  docVersionId String?                    @map("doc_version_id")
  docVersion   FundingDataRoomDocVersion? @relation(fields: [docVersionId], references: [id], onDelete: SetNull)

  token        String    @unique // fsr_<32 hex>
  expiresAt    DateTime? @map("expires_at")
  // Viewer-email allowlist: empty = open link. Allowlisted links require
  // the email query param to match (case-insensitive) at access time.
  viewerEmails String[]  @map("viewer_emails")
  revoked      Boolean   @default(false)
  revokedAt    DateTime? @map("revoked_at")

  views FundingDocView[]

  // Slice 5 (connector plug-in): intros whose draft offer message carries
  // a data-room share-link offer minted for the introduction.
  connectorIntroductions ConnectorIntroduction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, revoked])
  @@map("funding_share_links")
}

// Funding/VC slice 3: per-viewer analytics (spec §3: "who opened what,
// when"). Logged by the public token route before serving the file.
// viewerIdentity = allowlisted email when provided, otherwise a
// fingerprint hash (no cookies, no tracking).
model FundingDocView {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  linkId       String                     @map("link_id")
  link         FundingShareLink           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  // The exact version served (pinned, or current at access time).
  docVersionId String?                    @map("doc_version_id")
  docVersion   FundingDataRoomDocVersion? @relation(fields: [docVersionId], references: [id], onDelete: SetNull)

  viewerIdentity String  @map("viewer_identity")
  userAgent      String? @map("user_agent")
  durationMs     Int?    @map("duration_ms")

  openedAt DateTime @default(now()) @map("opened_at")

  @@index([workspaceId, openedAt])
  @@index([linkId, openedAt])
  @@map("funding_doc_views")
}

enum FundingRoundStatus {
  planning
  active
  paused
  closed
}

model FundingRound {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  status   FundingRoundStatus @default(planning)
  // One active round per tenant: the founder's current raise workflow entry.
  isActive Boolean            @default(false) @map("is_active")

  // Target investor profile — the front door of the funding feature.
  checkSizeMin  Int?     @map("check_size_min") // USD
  checkSizeMax  Int?     @map("check_size_max") // USD
  stages        String[] // e.g. ["pre-seed", "seed"]
  sectors       String[] // thesis sectors, e.g. ["fintech", "dev-tools"]
  thesisSummary String?  @map("thesis_summary")

  targetClose DateTime? @map("target_close")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checklistItems FundingRoundChecklistItem[]
  capTableRows   FundingCapTableStakeholder[]
  deckReviews    FundingDeckReview[]

  @@index([workspaceId, isActive])
  @@map("funding_rounds")
}

// Funding/VC slice 4: Round readiness checklist (BUSINESS-OS-FEATURE-SPECS.md
// §3). One row per (round, checklist key); statuses are manual — the founder
// owns the checklist. Evidence is a JSON bag of links — it may hold
// read-only cross-links into the Legal feature (legalDocumentId pointing at
// LegalDocument rows, e.g. docType=formation for incorporation,
// docType=ein_letter for EIN), data-room refs (dataRoomDocId, shareLinkId),
// plain URLs, and the selected SAFE template key. Nothing here is ever
// legal advice; the LEGAL_DISCLAIMER label ships on SAFE-template surfaces.
enum FundingChecklistItemKey {
  incorporation
  ein
  cap_table
  safe_template
  pitch_deck
  financials
  data_room_links
}

enum FundingChecklistItemStatus {
  todo
  doing
  done
  waived
}

model FundingRoundChecklistItem {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roundId String       @map("round_id")
  round   FundingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  key    FundingChecklistItemKey
  status FundingChecklistItemStatus @default(todo)

  // Evidence bag. Shape: { links: [{ label, url?, legalDocumentId?,
  // dataRoomDocId?, shareLinkId? }], safeTemplateKey?, safeTemplateParams?,
  // testedAt?, note? }. Read-only cross-links: the store never writes to
  // Legal rows from here, it only reads them for signals.
  evidence Json? @default("{}")

  notes String?

  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Exactly one row per (round, checklist key).
  @@unique([roundId, key])
  @@index([workspaceId, roundId])
  @@map("funding_round_checklist_items")
}

enum FundingStakeholderType {
  founder
  investor
  employee
  advisor
}

// Funding/VC slice 4: cap table — v1 is MANUAL entry only, no live Carta
// sync. Shares are BigInt at the schema level; rollups are pure functions
// in lib/funding/readiness.ts (fully-diluted %, founder %, investor %).
model FundingCapTableStakeholder {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roundId String       @map("round_id")
  round   FundingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  name           String
  type           FundingStakeholderType
  shares         BigInt // share count, >= 0
  shareClass     String?                @map("share_class") // e.g. "Common", "Series Seed Preferred", "SAFE"
  vestingSummary String?                @map("vesting_summary") // free text, e.g. "4yr/1yr cliff"
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, roundId])
  @@map("funding_cap_table_stakeholders")
}

// Funding/VC slice 4: deterministic pitch-deck review. The rubric scores are
// ALWAYS computed by the pure `reviewDeck` function in
// lib/funding/deck-review.ts over the latest pitch-deck version's metadata +
// optional founder-supplied deck text — never by an LLM. The stored
// `results` JSON cites the signal every finding came from; anything not
// found is "not_detected", never invented. (The repo's intelligence layer
// has no general text-completion interface, so v1 ships fully deterministic
// — the narrative is a template over the deterministic findings.)
model FundingDeckReview {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roundId String       @map("round_id")
  round   FundingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // The deck version reviewed. SetNull: the review is a snapshot — deleting
  // the doc keeps the review, with docId/versionId nulled.
  docId        String?                    @map("doc_id")
  doc          FundingDataRoomDoc?        @relation(fields: [docId], references: [id], onDelete: SetNull)
  docVersionId String?                    @map("doc_version_id")
  docVersion   FundingDataRoomDocVersion? @relation(fields: [docVersionId], references: [id], onDelete: SetNull)

  // sha256 of the normalized review input (metadata + deck text) — two
  // reviews with the same hash have byte-identical results.
  inputHash String @map("input_hash")

  // 0–100 deterministic overall score.
  overallScore Int @map("overall_score")

  // Array of { criterion, label, score, maxScore, verdict
  // ("pass"|"partial"|"not_detected"), signals: [{ source: "deck_text" |
  // "metadata", excerpt?, field?, value? }], note }.
  results Json

  // Deterministic template narrative over the findings (not LLM-drafted).
  narrative String

  // True when the founder supplied deck text; text-driven criteria are
  // "not_detected" when false.
  deckTextProvided Boolean @map("deck_text_provided")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, roundId, createdAt])
  @@map("funding_deck_reviews")
}

// ---------------------------------------------------------------------------
// Connector Agent — slice 1: graph core (SPEC-CONNECTOR-AGENT.md §6).
//
// Tenant-scoped, vault-held contact graph. Every model carries workspaceId;
// there are no cross-tenant edges in the schema. IntroPaths are computed
// (slice 3), never persisted across tenants. DB tables use the
// connector_agent_* prefix to avoid colliding with the OS connector layer's
// existing connector_* tables (connector_connections, etc.).
// ---------------------------------------------------------------------------

enum ConnectorCompanySizeBand {
  solo
  startup
  smb
  midmarket
  enterprise
}

enum ConnectorCompanyRelationship {
  customer
  prospect
  investor
  partner
  vendor
}

enum ConnectorImportSource {
  manual
  csv
  email
  calendar
  boardy_starter
}

// Slice 2: import-batch lifecycle. A batch is created in `consented` state
// (consent recorded); the import job moves it to `running`, then to
// `completed` or `failed`. `consented` is also the RESTING state after
// consent without a run yet.
enum ConnectorImportBatchStatus {
  consented
  running
  completed
  failed
}

// One consented import run. Explicit tenant consent per source is recorded
// HERE (consentedBy + consentedAt) — slice 2's import job may not write
// Person rows without a batch row carrying consent. Slice 2 adds the run
// lifecycle: cursor (incremental-sync watermark), stats JSON, completedAt,
// error.
//
// The durable per-source consent grant itself lives on
// ConnectorSourceConsent (one row per workspace+source, set BEFORE any
// import runs). This batch row copies its consentedBy/consentedAt at run
// start — the consent record is the gate, the batch is the receipt.
model ConnectorImportBatch {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  source      ConnectorImportSource
  consentedBy String                @map("consented_by")
  consentedAt DateTime              @default(now()) @map("consented_at")
  note        String?

  status      ConnectorImportBatchStatus @default(consented)
  // Incremental-sync watermark: Gmail = ISO date of the newest message
  // processed; Calendar = ISO date of the newest event processed. The next
  // run only fetches newer contacts.
  cursor      String?
  // Run stats: { fetched, created, dedupSkipped, excludedSkipped,
  //            relationshipSeeded, errors[] }.
  stats       Json?
  completedAt DateTime?                  @map("completed_at")
  error       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  persons ConnectorPerson[]

  @@index([workspaceId])
  @@index([workspaceId, source])
  @@map("connector_agent_import_batches")
}

// Slice 2: the durable per-source consent grant. ONE row per
// (workspace, source). Explicit tenant consent is recorded here BEFORE any
// import runs; runImport refuses to run without it (code: no_consent).
// Deleting the row revokes consent — subsequent runs are blocked.
model ConnectorSourceConsent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  source      ConnectorImportSource
  consentedBy String                @map("consented_by")
  consentedAt DateTime              @default(now()) @map("consented_at")
  // Scopes the tenant agreed to at consent time (e.g. gmail.readonly) —
  // informational; the vault holds the actual granted scopes.
  scopes      String[]              @default([])
  note        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, source])
  @@index([workspaceId])
  @@map("connector_agent_source_consents")
}

// Slice 2: exclusion rule kinds for the tenant's import exclusion list.
enum ConnectorExclusionType {
  // Whole email domain (e.g. "competitor.com"; subdomains match too).
  domain
  // Exact email address (lowercased).
  email
  // Case-insensitive substring match on the contact's display name.
  person_name
}

// Slice 2: one exclusion rule. Checked BEFORE any Person row is created —
// an excluded contact never becomes a Person. Tenant-level: applies to
// every import run in this workspace.
model ConnectorExclusion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type  ConnectorExclusionType
  // Normalized at write: lowercased + trimmed. Domains stored bare
  // ("acme.com", never "@acme.com").
  value String
  note  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, type, value])
  @@index([workspaceId])
  @@map("connector_agent_exclusions")
}

// A human in the tenant's graph. Provenance (which import, when, with whose
// consent) is mandatory on every row.
model ConnectorPerson {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  roles   String[] @default([])
  handles String[] @default([])

  // Slice 2: dedup key. Namespaced per source, e.g. "gmail:email:a@b.com",
  // "gcal:email:a@b.com". Unique within the tenant; nulls never collide.
  externalId String? @map("external_id")

  importBatchId String?               @map("import_batch_id")
  importBatch   ConnectorImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  consentedBy   String                @map("consented_by")
  consentedAt   DateTime              @default(now()) @map("consented_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relationship ConnectorRelationship?
  employments  ConnectorEmployment[]

  // Slice 4: introductions where this person is side A (the mutual, asked
  // for the intro) or side B (the target, offered the intro). Named
  // relations because one model has two FKs to ConnectorPerson.
  introsAsSideA ConnectorIntroduction[] @relation("IntroSideA")
  introsAsSideB ConnectorIntroduction[] @relation("IntroSideB")

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@map("connector_agent_persons")
}

// An employer/org node. relationship = this org's relationship TO THE TENANT.
model ConnectorCompany {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  industry     String?
  sizeBand     ConnectorCompanySizeBand?     @map("size_band")
  relationship ConnectorCompanyRelationship?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employments ConnectorEmployment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("connector_agent_companies")
}

// Person N:M Company employment history.
model ConnectorEmployment {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  personId  String           @map("person_id")
  person    ConnectorPerson  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String           @map("company_id")
  company   ConnectorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title     String?
  startYear Int?    @map("start_year")
  endYear   Int?    @map("end_year")
  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, personId, companyId])
  @@index([workspaceId])
  @@map("connector_agent_employments")
}

// The edge between the tenant and a Person (1:1 tenant–Person).
// warmthScore is RECOMPUTED from the interaction signals below — never
// hand-set as the only signal (see lib/connector/types.ts computeWarmth).
model ConnectorRelationship {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  personId String          @unique @map("person_id")
  person   ConnectorPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  // Recomputed warmth, 0–100.
  warmthScore      Int       @default(0) @map("warmth_score")
  warmthComputedAt DateTime? @map("warmth_computed_at")

  // Interaction signals the score is derived from.
  lastTouchAt           DateTime? @map("last_touch_at")
  touchCount            Int       @default(0) @map("touch_count")
  inboundCount          Int       @default(0) @map("inbound_count")
  outboundCount         Int       @default(0) @map("outbound_count")
  lastReciprocalTouchAt DateTime? @map("last_reciprocal_touch_at")

  // Free-text context + the tenant's own guardrails, e.g. "don't ask for
  // intros more than quarterly".
  notes      String?
  boundaries String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("connector_agent_relationships")
}

// ---------------------------------------------------------------------------
// Connector Agent — slice 4: double-opt-in lifecycle (SPEC-CONNECTOR-AGENT.md
// §6). The Introduction is the brokered intro with a strict state machine:
//
//   proposed → side_a_accepted → side_b_accepted → made → followed_up
//   Terminal: declined, expired, withdrawn.
//
// Side A = the mutual (the ask goes to them, after tenant approval).
// Side B = the target (the offer goes to them only after A accepts).
// Drafts are data; sends happen only via the tenant's connected messaging
// account, only after tenant approval + dual acceptance, and every send is
// an auditable event (ConnectorIntroductionEvent — the full lineage).
// One Introduction per pair for ACTIVE intros: enforced by a partial unique
// index in the slice-4 migration (Prisma cannot express partial indexes).
// ---------------------------------------------------------------------------

enum ConnectorIntroductionStatus {
  proposed
  side_a_accepted
  side_b_accepted
  made
  followed_up
  declined
  expired
  withdrawn
}

enum ConnectorIntroductionEventKind {
  proposed
  tenant_approved
  tenant_declined
  ask_sent_to_side_a
  side_a_accepted
  side_a_declined
  offer_sent_to_side_b
  side_b_accepted
  side_b_declined
  intro_sent
  followup_proposed
  followup_sent
  withdrawn
  expired
  // Slice 5: raise-workflow writeback lineage (FUNDING mode).
  funding_writeback
  funding_writeback_failed
}

enum ConnectorIntroductionActorKind {
  agent
  tenant
  side_a
  side_b
  system
}

// Slice 5: the connector's operating mode. Tenant-scoped preference
// (ConnectorSetting) and per-introduction record (each proposal is
// mode-scoped). LEADS = customer/partner intros; FUNDING = investor
// intros plugged into the Funding/VC module.
enum ConnectorMode {
  leads
  funding
}

// Slice 5: tenant-level connector preference (one row per workspace).
// The UI's LEADS/FUNDING switch writes here; per-query/per-proposal
// mode overrides ride along on the request.
model ConnectorSetting {
  id          String        @id @default(cuid())
  workspaceId String        @unique @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mode        ConnectorMode @default(leads)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("connector_agent_settings")
}

model ConnectorIntroduction {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The pair. Side A = the mutual the tenant asks; side B = the target.
  personAId String          @map("person_a_id")
  personA   ConnectorPerson @relation("IntroSideA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId String          @map("person_b_id")
  personB   ConnectorPerson @relation("IntroSideB", fields: [personBId], references: [id], onDelete: Cascade)

  status ConnectorIntroductionStatus @default(proposed)

  // Slice 5: mode the proposal was made in. FUNDING-mode intros link to
  // the investor CRM (fundingInvestorId) and write back to the raise
  // workflow when made; LEADS-mode intros never touch funding rows.
  mode              ConnectorMode    @default(leads)
  fundingInvestorId String?          @map("funding_investor_id")
  fundingInvestor   FundingInvestor? @relation(fields: [fundingInvestorId], references: [id], onDelete: SetNull)

  // Slice 5: data-room offer attached to the draft offer message. Always
  // a real minted share link (never a placeholder) — lineage back to it
  // lives here.
  dataRoomShareLinkId String?           @map("data_room_share_link_id")
  dataRoomShareLink   FundingShareLink? @relation(fields: [dataRoomShareLinkId], references: [id], onDelete: SetNull)

  // The computed IntroPath used, frozen at propose time. IntroPaths are
  // computed (slice 3), never persisted — the snapshot preserves the
  // lineage the tenant approved.
  introPathSnapshot Json @map("intro_path_snapshot")

  // Draft copy (data until tenant-approved, then sent via the tenant's
  // connected messaging account).
  draftAskMessage   String @map("draft_ask_message")
  draftOfferMessage String @map("draft_offer_message")

  // Tenant approval gate (v1: every draft is tenant-approved).
  tenantApproved   Boolean   @default(false) @map("tenant_approved")
  tenantApprovedBy String?   @map("tenant_approved_by")
  tenantApprovedAt DateTime? @map("tenant_approved_at")

  // Double-opt-in lineage (human actors only — enforced in the store).
  sideAAcceptedBy String?   @map("side_a_accepted_by")
  sideAAcceptedAt DateTime? @map("side_a_accepted_at")
  sideBAcceptedBy String?   @map("side_b_accepted_by")
  sideBAcceptedAt DateTime? @map("side_b_accepted_at")

  // The made send: legal ONLY from side_b_accepted (the money rule).
  madeMessage String?   @map("made_message")
  madeSentVia String?   @map("made_sent_via")
  madeSentBy  String?   @map("made_sent_by")
  madeSentAt  DateTime? @map("made_sent_at")

  // Decline / withdraw / expire lineage.
  declinedBy    String?   @map("declined_by")
  declinedAt    DateTime? @map("declined_at")
  declineReason String?   @map("decline_reason")
  withdrawnBy   String?   @map("withdrawn_by")
  withdrawnAt   DateTime? @map("withdrawn_at")
  expiredAt     DateTime? @map("expired_at")

  // Tenant per-instance rate-limit override (recorded for the audit).
  rateLimitOverrideMaxAsks    Int? @map("rate_limit_override_max_asks")
  rateLimitOverrideWindowDays Int? @map("rate_limit_override_window_days")

  // Followups: only after made, once, unless the tenant approves more.
  followupCount        Int     @default(0) @map("followup_count")
  pendingFollowupDraft String? @map("pending_followup_draft")
  pendingFollowupTo    String? @map("pending_followup_to")

  events ConnectorIntroductionEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, personAId])
  @@index([workspaceId, mode])
  @@map("connector_agent_introductions")
}

// Every approval event on an Introduction: who proposed, who accepted,
// what was said, when. The lifecycle timeline is rendered from this.
model ConnectorIntroductionEvent {
  id             String                @id @default(cuid())
  workspaceId    String                @map("workspace_id")
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  introductionId String                @map("introduction_id")
  introduction   ConnectorIntroduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  kind          ConnectorIntroductionEventKind
  actorKind     ConnectorIntroductionActorKind @map("actor_kind")
  actorIdentity String                         @map("actor_identity")
  message       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([introductionId, createdAt])
  @@map("connector_agent_introduction_events")
}

// Connector Agent slice 6: opt-in discoverability + Boardy escalation rail.
// SPEC-CONNECTOR-AGENT.md §5/§6.
//
// Directory profile — the ONLY cross-tenant-readable connector data.
// Opt-in only (Tico 2026-09-30): discoverable=false (default) is invisible
// to matching. Reversible: unpublishing is a plain update. Per-facet
// publish toggles: name+role vs fuller profile. The private graph
// (ConnectorPerson/Relationship/...) is NEVER read across tenants.
model ConnectorDirectoryProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  discoverable Boolean @default(false)

  name       String?
  role       String?
  company    String?
  bio        String?  @db.Text
  industries String[] @default([])
  lookingFor String?  @map("looking_for")

  // Facet toggles: shareNameRole = name+role facet; shareFull = fuller
  // profile facet (company, bio, industries, lookingFor). Only published
  // facets are exposed to matching tenants.
  shareNameRole Boolean @default(true) @map("share_name_role")
  shareFull     Boolean @default(false) @map("share_full")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("connector_agent_directory_profiles")
}

// Boardy escalation lifecycle. boardy.ai/agentskill is an instruction page
// for an EMAIL flow, not a programmatic API (verified 2026-09-30) — so the
// rail is: agent drafts → tenant approves per instance (human-only) → sends
// from the tenant's own address to boardy@boardy.ai → Boardy's reply is
// triaged as a priority thread. Boardy is FREE to use (Tico 2026-09-30).
// The native loop NEVER blocks on this rail: escalation is optional and
// async — propose/send paths throw cleanly and never touch introductions.
enum ConnectorBoardyRequestStatus {
  draft
  approved
  declined
  sent
  replied
  cancelled
}

model ConnectorBoardyRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status ConnectorBoardyRequestStatus @default(draft)

  // The context-rich draft: who the target is, why, what the tenant offers.
  targetName     String        @map("target_name")
  targetRole     String?       @map("target_role")
  targetContext  String        @map("target_context") @db.Text
  offerSummary   String        @map("offer_summary") @db.Text
  draftedSubject String        @map("drafted_subject")
  draftedBody    String        @map("drafted_body") @db.Text
  mode           ConnectorMode @default(leads)

  // Approval gate: NO send without tenant approval (human-only).
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  // Send lineage: from the tenant's own address via their connected account.
  sentVia String?   @map("sent_via")
  sentAt  DateTime? @map("sent_at")

  // Reply triage: Boardy's reply flagged as a priority thread.
  priorityThread Boolean   @default(false) @map("priority_thread")
  replySummary   String?   @map("reply_summary") @db.Text
  repliedAt      DateTime? @map("replied_at")

  events ConnectorBoardyRequestEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("connector_agent_boardy_requests")
}

// Audit lineage for one Boardy request: what was said, by whom, when.
model ConnectorBoardyRequestEvent {
  id        String                 @id @default(cuid())
  requestId String                 @map("request_id")
  request   ConnectorBoardyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kind          String
  actorKind     String  @map("actor_kind")
  actorIdentity String  @map("actor_identity")
  message       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("connector_agent_boardy_request_events")
}

// CAD + Hardware slice 1: CAD viewer + versioning (BUSINESS-OS-FEATURE-SPECS.md
// §2). Tenant-scoped CAD project + model registry with immutable version
// chains, visual-diff metadata, and expiring/revocable share links.
// Reference customer: the autonomous drone platform build (drone airframes).
enum CadModelFormat {
  stl
  obj
  step
}

model CadProject {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  createdBy   String? @map("created_by")

  models CadModel[]

  // Slice 4: tasks/issues on this project (optionally pinned to a revision).
  tasks CadTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("cad_projects")
}

model CadModel {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId String     @map("project_id")
  project   CadProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  createdBy   String? @map("created_by")

  // The live tip of the immutable version chain. New uploads never mutate
  // published version rows — this pointer moves forward instead.
  currentVersionId String?          @map("current_version_id")
  currentVersion   CadModelVersion? @relation("CadModelCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions   CadModelVersion[] @relation("CadModelVersions")
  diffs      CadModelDiff[]
  shareLinks CadShareLink[]

  annotations CadAnnotation[]
  proposals   CadDesignProposal[]
  mfgRuns     CadMfgRun[]
  mfgFlags    CadManufacturabilityFlag[]

  // Slice 3: BOMs pinned to versions + export/quote requests per model.
  bomVersions    CadBomVersion[]
  exportRequests CadExportRequest[]

  // Change-request state (slice 2): set ONLY by approving a design proposal
  // (human-only). Cleared when a new version is published.
  changeRequested           Boolean   @default(false) @map("change_requested")
  changeRequestedAt         DateTime? @map("change_requested_at")
  changeRequestedBy         String?   @map("change_requested_by")
  changeRequestedProposalId String?   @map("change_requested_proposal_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, projectId])
  @@map("cad_models")
}

// One row per upload. Immutable once published: no update path exists.
model CadModelVersion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation("CadModelVersions", fields: [modelId], references: [id], onDelete: Cascade)

  versionNumber   Int           @map("version_number")
  workspaceFileId String        @map("workspace_file_id")
  workspaceFile   WorkspaceFile @relation(fields: [workspaceFileId], references: [id], onDelete: Cascade)

  fileName  String         @map("file_name")
  mimeType  String?        @map("mime_type")
  sizeBytes Int            @map("size_bytes")
  // sha256 of the original bytes — integrity + dedup reference.
  checksum  String
  format    CadModelFormat

  // Geometry stats, parsed from the real bytes at upload (null = the format
  // was not parseable — STEP always lands here; marked unavailable, never
  // invented). Drives the visual-diff metadata.
  triangleCount  Int?   @map("triangle_count")
  bboxMin        Json?  @map("bbox_min")
  bboxMax        Json?  @map("bbox_max")
  volumeEstimate Float? @map("volume_estimate")

  // STEP has no three.js loader: this is false for STEP, always.
  previewAvailable Boolean @map("preview_available")

  notes      String?
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  supersedesVersionId String?           @map("supersedes_version_id")
  supersedes          CadModelVersion?  @relation("CadVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy        CadModelVersion[] @relation("CadVersionSupersedes")

  // Models / share links pointing at this version.
  currentOf        CadModel[]     @relation("CadModelCurrentVersion")
  pinnedShareLinks CadShareLink[]
  diffsFrom        CadModelDiff[] @relation("CadDiffFrom")
  diffsTo          CadModelDiff[] @relation("CadDiffTo")

  annotations     CadAnnotation[]
  proposalTargets CadDesignProposal[]        @relation("CadProposalTargetVersion")
  mfgRuns         CadMfgRun[]
  mfgFlags        CadManufacturabilityFlag[]

  // Slice 3: BOMs pinned to this version + cost estimates + export requests.
  bomVersions    CadBomVersion[]
  costEstimates  CadCostEstimate[]
  exportRequests CadExportRequest[]

  // Slice 4: tasks/issues pinned to this immutable revision. The pin is a
  // reference only — closing or editing a task never mutates this row.
  taskPins CadTask[] @relation("CadTaskPinnedVersion")

  @@unique([modelId, versionNumber])
  @@index([workspaceFileId])
  @@map("cad_model_versions")
}

// Visual-diff metadata between two versions of one model. availability is
// "computed" only when BOTH sides yielded real parsed stats; otherwise every
// numeric field is null ("unavailable" — the UI says so, never a guess).
model CadModelDiff {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  fromVersionId String          @map("from_version_id")
  fromVersion   CadModelVersion @relation("CadDiffFrom", fields: [fromVersionId], references: [id], onDelete: Cascade)
  toVersionId   String          @map("to_version_id")
  toVersion     CadModelVersion @relation("CadDiffTo", fields: [toVersionId], references: [id], onDelete: Cascade)

  availability  String
  triangleDelta Int?   @map("triangle_delta")
  sizeDelta     Json?  @map("size_delta")
  centerDelta   Float? @map("center_delta")
  volumeFrom    Float? @map("volume_from")
  volumeTo      Float? @map("volume_to")
  volumeDelta   Float? @map("volume_delta")

  computedAt DateTime @default(now()) @map("computed_at")

  @@unique([modelId, fromVersionId, toVersionId])
  @@map("cad_model_diffs")
}

// Tokenized collaborator links. Fail-closed: unknown, revoked, or expired
// tokens resolve to LINK_NOT_FOUND / LINK_REVOKED / LINK_EXPIRED — the public
// surface 404s all three. null pinnedVersionId = the model's current version
// at access time.
model CadShareLink {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  pinnedVersionId String?          @map("pinned_version_id")
  pinnedVersion   CadModelVersion? @relation(fields: [pinnedVersionId], references: [id], onDelete: SetNull)

  // cadsl_<32 hex>, unique — returned ONCE at creation.
  token     String    @unique
  label     String?
  expiresAt DateTime  @map("expires_at")
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, modelId])
  @@map("cad_share_links")
}

// CAD + Hardware slice 2: AI design assistant — annotations, design change
// proposals (draft-for-approval), manufacturability runs + flags.
//
// THE PROPOSAL-EXECUTION BOUNDARY (v1): proposals are parsed, reviewed, and
// approved by a human; approval marks the model "change requested". v1 NEVER
// rewrites geometry — no code path exists that edits mesh bytes from a
// proposal. The design intent is carried out in the tenant's CAD tool and
// published as a new version, which clears the change-requested flag.

// Text annotations anchored to a model version: a 3D point [x,y,z], a region
// {min:[x,y,z], max:[x,y,z]}, or neither (= whole-model note). Immutable
// once written; removal is a delete, never an edit.
model CadAnnotation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  versionId String          @map("version_id")
  version   CadModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  author String
  body   String
  point  Json?
  region Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, modelId])
  @@map("cad_annotations")
}

// A natural-language edit request parsed into a structured, reviewable
// proposal. Status lifecycle: draft → approved | rejected. Approving is
// human-only and is the ONLY path that sets CadModel.changeRequested.
model CadDesignProposal {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  targetVersionId String          @map("target_version_id")
  targetVersion   CadModelVersion @relation("CadProposalTargetVersion", fields: [targetVersionId], references: [id], onDelete: Cascade)

  // The verbatim natural-language request.
  requestedText String   @map("requested_text")
  requestedBy   String   @map("requested_by")
  requestedAt   DateTime @default(now()) @map("requested_at")

  // Parsed structure — reviewable, editable while draft, NEVER executed.
  operation          String
  parameters         Json
  targetFeatureLabel String? @map("target_feature_label")
  targetRegion       Json?   @map("target_region")
  rationale          String?
  parseConfidence    String  @map("parse_confidence") // high | medium | low

  status       String    @default("draft") // draft | approved | rejected
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, modelId, status])
  @@map("cad_design_proposals")
}

// One manufacturability analysis attempt over a model version's REAL mesh
// geometry. status "unavailable" = the check could not run (STEP has no
// extractable mesh in v1) — the reason is recorded and no flags are invented.
model CadMfgRun {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  versionId String          @map("version_id")
  version   CadModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  status            String // complete | unavailable
  unavailableReason String? @map("unavailable_reason")
  // Mesh files carry no unit metadata: every measurement is labeled with
  // this assumption (default "mm (assumed)").
  unitAssumption    String  @map("unit_assumption")
  // Per-check outcomes: [{ check, status: computed|unavailable, detail }].
  checks            Json
  // Source pointers for ingested process limits (clean sourcing — no
  // orphaned claims): [{ rule, source, accessed }].
  references        Json

  startedBy   String    @map("started_by")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  flags CadManufacturabilityFlag[]

  @@index([workspaceId, modelId, versionId])
  @@map("cad_mfg_runs")
}

// One deterministic manufacturability finding. Every flag cites the
// measurement it came from (measurement JSON) — never invented. Dismissal
// requires a reason (audit trail).
model CadManufacturabilityFlag {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runId String    @map("run_id")
  run   CadMfgRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  versionId String          @map("version_id")
  version   CadModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  checkType   String @map("check_type") // wall_thickness | overhang | tolerance
  severity    String // info | warning | risk
  // The measurement this flag cites — the numbers, their sample, and the
  // threshold they were judged against.
  measurement Json
  message     String

  dismissed       Boolean   @default(false)
  dismissedBy     String?   @map("dismissed_by")
  dismissedAt     DateTime? @map("dismissed_at")
  dismissalReason String?   @map("dismissal_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, modelId, versionId])
  @@map("cad_mfg_flags")
}

// CAD + Hardware slice 3: prototype pipeline — rate cards, BOMs pinned to
// model versions, cost estimates, vendor export / quote requests.
// v1 boundary: NO live vendor APIs. A quote request is a draft-for-approval
// record; "send" only records the tenant's own transmission (who, when, to
// whom, via which connected account) — it never places an order.

// Tenant-configurable process rate card. Rates are USD; `rates` follows the
// RateCardRates shape documented in lib/cad/prototype.ts
// ({ setupUsd, perUnitUsd, perCm3Usd, notes }). `source` is a source pointer
// for ingested vendor/datasheet reference data (clean-sourcing); null for
// hand-entered cards.
model CadRateCard {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  process   String // 3d_print | pcb | cnc (validated in lib/cad/prototype.ts)
  currency  String  @default("USD")
  rates     Json    @default("{}")
  isDefault Boolean @default(false) @map("is_default")
  source    String?

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimates CadCostEstimate[]

  @@index([workspaceId, process])
  @@map("cad_rate_cards")
}

// One BOM revision, pinned to a single immutable model version.
// bomNumber is sequential per model. v1: all lines are tenant-entered
// ("manual"); derived sources are rejected until a derived method exists.
model CadBomVersion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  // The model version this BOM describes. Never moves when new versions publish.
  modelVersionId String          @map("model_version_id")
  modelVersion   CadModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  bomNumber Int     @map("bom_number")
  notes     String?

  // Phase 4b: "manual" (tenant-entered) | "derived" (generated from the
  // pinned version's real mesh geometry by lib/cad/bom-derive.ts).
  origin     String @default("manual")
  // Derived BOMs only: method + version, source file checksum, unit
  // assumption, body split, material + density source, warnings.
  derivation Json?

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  lines     CadBomLine[]
  estimates CadCostEstimate[]

  @@unique([modelId, bomNumber])
  @@index([workspaceId, modelId])
  @@map("cad_bom_versions")
}

model CadBomLine {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  bomVersionId String        @map("bom_version_id")
  bomVersion   CadBomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)

  partName     String  @map("part_name")
  qty          Float
  unitName     String  @default("pcs") @map("unit_name")
  materialSpec String? @map("material_spec")
  supplier     String?
  // USD per unit. Null = unknown: contributes $0, flagged in the rollup.
  unitCostUsd  Float?  @map("unit_cost_usd")
  // "manual" | "derived:<method>". Derived lines are written only by the
  // derive path (lib/cad/bom-derive.ts), never entered by hand.
  source       String  @default("manual")
  sortOrder    Int     @default(0) @map("sort_order")

  // Phase 4b: per-unit geometry for derived lines (mm³ / grams; mesh units
  // assumed mm). Null = not computable (open/degenerate mesh, no material)
  // or a manual line — never zero-filled.
  volumeMm3   Float? @map("volume_mm3")
  massG       Float? @map("mass_g")
  // The measurement the line cites (triangles, closed?, bbox, status).
  measurement Json?

  // Slice 4: optional link into the tenant's parts inventory. When set and
  // the line's unit cost was not entered manually, the preferred supplier's
  // quoted cost (USD only — no FX is ever invented) is used as the line's
  // unit cost with source "supplier_quote:…". Deleting the part nulls this.
  inventoryPartId String?  @map("inventory_part_id")
  inventoryPart   CadPart? @relation(fields: [inventoryPartId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bomVersionId, sortOrder])
  @@index([inventoryPartId])
  @@map("cad_bom_lines")
}

// Labeled cost estimate pinned to (model version, BOM version, rate card).
// `basis` is the CostBreakdown from lib/cad/prototype.ts — isEstimate: true,
// the rate card cited by id/name, warnings for uncomputable components.
// This is an estimate, never a vendor quote.
model CadCostEstimate {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelVersionId String          @map("model_version_id")
  modelVersion   CadModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  bomVersionId String        @map("bom_version_id")
  bomVersion   CadBomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)

  rateCardId String      @map("rate_card_id")
  rateCard   CadRateCard @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  quantity       Float
  currency       String @default("USD")
  bomTotalUsd    Float  @map("bom_total_usd")
  processCostUsd Float  @map("process_cost_usd")
  grandTotalUsd  Float  @map("grand_total_usd")
  perUnitUsd     Float? @map("per_unit_usd")
  // Labeled breakdown + warnings (CostBreakdown).
  basis          Json

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, modelVersionId])
  @@map("cad_cost_estimates")
}

// Vendor export / quote request. Lifecycle: draft → confirmed → sent.
// - draft: tenant-entered; reviewable.
// - confirmed (human-only): the export package (model file + manifest with
//   checksum + process params + contact) is written to the workspace file
//   store. manifestPath points at it.
// - sent (human-only): records the tenant's own transmission — sentBy,
//   sentAt, recipient, sentViaAccount (the tenant's connected account name).
//   v1 NEVER places an order and calls no vendor API; the send row is the
//   auditable event.
model CadExportRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  modelId String   @map("model_id")
  model   CadModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  modelVersionId String          @map("model_version_id")
  modelVersion   CadModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  // 3d_print | pcb | cnc (validated in lib/cad/prototype.ts)
  process        String
  quantity       Float
  processOptions Json   @default("{}") @map("process_options")
  // { name, email, addressLines } — tenant-entered on the form.
  contact        Json

  // draft | confirmed | sent (validated in lib/cad/prototype.ts)
  status String @default("draft")

  // Logical path of the package manifest written at confirm time.
  manifestPath String? @map("manifest_path")

  confirmedBy String?   @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")

  // Send lineage: the tenant's own account, recorded, never a live send.
  sentBy         String?   @map("sent_by")
  sentAt         DateTime? @map("sent_at")
  recipient      String?
  sentViaAccount String?   @map("sent_via_account")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, modelId])
  @@map("cad_export_requests")
}

// CAD + Hardware slice 4: hardware project management.
// Parts inventory (tenant-scoped catalog, auditable stock events),
// supplier tracking with quoted-cost sourcing, and revision-linked
// tasks/issues. Everything is tenant-scoped via workspaceId, like every
// other CAD row.

// One cataloged part. onHandQty is NEVER edited in place by anything other
// than a CadStockEvent row (adjustPartStock); the current value is the
// auditable sum of events, materialized here for cheap reads.
model CadPart {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name            String
  // SKU or MPN — free text, tenant's own part numbering.
  sku             String?
  // mechanical | electrical | fastener | pcb | cable | tooling | consumable | other
  category        String  @default("other")
  onHandQty       Float   @default(0) @map("on_hand_qty")
  reorderPoint    Float   @default(0) @map("reorder_point")
  unitOfMeasure   String  @default("pcs") @map("unit_of_measure")
  storageLocation String? @map("storage_location")

  stockEvents   CadStockEvent[]
  supplierLinks CadPartSupplier[]
  bomLines      CadBomLine[]

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@map("cad_parts")
}

// One auditable stock adjustment. Rows are append-only: adjustments are
// events (who/when/delta/reason), never silent overwrites of onHandQty.
model CadStockEvent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  partId String  @map("part_id")
  part   CadPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  // Positive = stock in, negative = stock out. Quantity after this event.
  delta         Float
  quantityAfter Float  @map("quantity_after")
  // Required: "why" is the audit trail. e.g. "received PO-114", "used in airframe v7 build".
  reason        String
  actor         String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, partId])
  @@map("cad_stock_events")
}

// A supplier the tenant buys from: who they are, how long they take, notes.
model CadSupplier {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  // Free text: name/phone/email of the tenant's contact there.
  contact  String?
  // Free text: "10 business days", "2–3 weeks" — the supplier's stated lead time.
  leadTime String? @map("lead_time")
  notes    String?

  partLinks CadPartSupplier[]

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("cad_suppliers")
}

// Part ↔ supplier link. The quote is the sourcing for every cost figure
// derived from it: quotedUnitCost + currency + quotedDate + quoteSource
// (who/what said this price — a quote PDF name, an email, a URL).
// Cost figures are NEVER invented; a link with no quote carries no cost.
model CadPartSupplier {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  partId String  @map("part_id")
  part   CadPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  supplierId String      @map("supplier_id")
  supplier   CadSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  quotedUnitCost Float?    @map("quoted_unit_cost")
  // 3-letter ISO code.
  currency       String    @default("USD")
  quotedDate     DateTime? @map("quoted_date")
  // Source citation, e.g. "quote PDF mcmaster-quote-2026-09-30.pdf" or
  // "emailed by sales@acmefasteners.com 2026-09-28". Required with a cost.
  quoteSource    String?   @map("quote_source")

  // One preferred supplier per part (enforced in the store: marking one
  // preferred demotes the others).
  preferred Boolean @default(false)

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partId, supplierId])
  @@index([workspaceId, partId])
  @@map("cad_part_suppliers")
}

// A task or issue on a CAD project, optionally pinned to one immutable
// model revision (e.g. "fix motor mount clearance" pinned to airframe v7).
// The pin is a reference: closing/editing a task never alters the version.
model CadTask {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId String     @map("project_id")
  project   CadProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional pin to a specific immutable revision. The version row is never
  // mutated through this link (see taskPins on CadModelVersion).
  modelVersionId String?          @map("model_version_id")
  modelVersion   CadModelVersion? @relation("CadTaskPinnedVersion", fields: [modelVersionId], references: [id], onDelete: SetNull)

  // "task" | "issue" (validated in lib/cad/hardware.ts).
  kind        String  @default("task")
  title       String
  description String?

  // open | in_progress | blocked | done (validated).
  status   String @default("open")
  // low | medium | high (validated).
  priority String @default("medium")

  assignee String?
  dueDate  DateTime? @map("due_date")

  comments CadTaskComment[]

  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, projectId])
  @@index([workspaceId, status])
  @@index([modelVersionId])
  @@map("cad_tasks")
}

// Comments and the activity trail on a task. Status changes, creation, and
// version pins are recorded here as system events so the trail is one list.
// Rows are append-only (no update/delete path).
model CadTaskComment {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taskId String  @map("task_id")
  task   CadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // "comment" | "created" | "status_change" | "version_pin" (validated).
  eventKind String @default("comment") @map("event_kind")
  body      String
  author    String
  // Machine-readable detail for system events: { from, to } for
  // status_change, { versionId } for version_pin.
  eventMeta Json?  @map("event_meta")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, taskId])
  @@map("cad_task_comments")
}

// ---------------------------------------------------------------------------
// Phase 1 (H6): Activepieces tenant binding.
//
// The Activepieces engine is one host-wide sidecar, so a flow id alone says
// nothing about which tenant owns it. A flow can be triggered — and its runs
// read — only from the workspace it is bound to. flow_id is globally unique:
// a flow belongs to exactly one workspace. Bindings are created by platform
// operators (MARKETR_PLATFORM_OPERATORS); see lib/integrations/activepieces/bindings.ts.
// ---------------------------------------------------------------------------
model AutomationFlowBinding {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flowId      String    @unique @map("flow_id")
  boundBy     String    @map("bound_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("automation_flow_bindings")
}

// Phase 1: durable idempotency for outreach provider webhooks (Smartlead /
// Instantly). One row per (provider, provider event id), claimed before the
// event is processed — redeliveries and replays across instances and
// restarts collapse to a no-op. Replaces the in-process Set.
model OutreachWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @map("event_id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([workspaceId, receivedAt])
  @@map("outreach_webhook_events")
}

// Phase 3 (J): notification center. One row per recipient, so read state is
// per user (readAt). Producers (lib/notifications/producers.ts) fan out to
// the members who should see it and are best-effort: a failed write never
// fails the action that triggered it. dedupKey makes a producer idempotent
// per recipient (e.g. "approval_needed:mission:<id>").
enum NotificationKind {
  approval_needed
  approval_decided
  alert_fired
  run_failed
  invite_accepted
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Auth.js user id of the recipient.
  userId      String           @map("user_id")
  kind        NotificationKind
  title       String
  body        String?
  // Relative dashboard link (always starts with "/dashboard").
  href        String?
  // What it is about, e.g. sourceType "mission_approval" + the row id.
  sourceType  String?          @map("source_type")
  sourceId    String?          @map("source_id")
  dedupKey    String?          @map("dedup_key")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([userId, dedupKey])
  @@index([userId, workspaceId, readAt])
  @@index([userId, workspaceId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

// ============================================================
// Phase 4a: outbound webhooks (lib/webhooks). Per-workspace endpoints with an
// event filter and an HMAC-SHA256 signing secret (stored as a secrets()
// envelope, shown once). Every event becomes one durable delivery row per
// endpoint; /api/cron/webhooks drains due rows with exponential backoff and
// dead-letters after the last attempt. Both tables are FORCE RLS on the
// app.workspace_id GUC (migration 20261005300000_phase4a_webhooks_search).
// ============================================================
enum WebhookDeliveryStatus {
  pending
  delivering
  succeeded
  dead
}

model WebhookEndpoint {
  id                  String            @id @default(cuid())
  workspaceId         String            @map("workspace_id")
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url                 String
  description         String?
  // Event types this endpoint receives; empty = every event.
  events              String[]          @default([])
  // secrets() envelope of the raw signing secret ("whsec_…").
  secretEnc           String            @map("secret_enc")
  // Non-sensitive hint for the UI (prefix + last characters).
  secretHint          String            @map("secret_hint")
  enabled             Boolean           @default(true)
  createdBy           String            @map("created_by")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime?         @map("last_success_at")
  lastFailureAt       DateTime?         @map("last_failure_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deliveries          WebhookDelivery[]

  @@index([workspaceId, enabled])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  workspaceId    String                @map("workspace_id")
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpointId     String                @map("endpoint_id")
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Shared by every endpoint's copy of the same event ("evt_…").
  eventId        String                @map("event_id")
  eventType      String                @map("event_type")
  // Idempotency per endpoint for producers that may fire twice.
  dedupKey       String?               @map("dedup_key")
  // The exact JSON envelope that is signed and POSTed.
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  responseStatus Int?                  @map("response_status")
  // First 1 KB of the last response body (never request secrets).
  responseBody   String?               @map("response_body")
  lastError      String?               @map("last_error")
  durationMs     Int?                  @map("duration_ms")
  // Manual redelivery of an earlier delivery row.
  redeliveryOf   String?               @map("redelivery_of")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([endpointId, dedupKey])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("webhook_deliveries")
}

// ===========================================================================
// Phase 4a (identity): two-factor auth, passkeys, SCIM 2.0.
// User-level tables (user_security, user_recovery_codes, user_passkeys,
// auth_challenges) are keyed by the Auth.js subject and hold no workspace
// data, so they carry no tenant RLS. SCIM tables are workspace-owned and
// FORCE RLS (app.workspace_id); the SCIM bearer token names its workspace so
// the lookup itself runs inside that scope.
// ===========================================================================

model UserSecurity {
  // Auth.js subject (token.sub).
  userId             String    @id @map("user_id")
  email              String?
  name               String?
  // TOTP secret (base32), sealed with the credential envelope (lib/sitefiles/crypto.ts).
  totpSecretEnc      String?   @map("totp_secret_enc")
  totpEnabledAt      DateTime? @map("totp_enabled_at")
  // Replay protection: the last RFC 6238 time step accepted.
  totpLastStep       BigInt?   @map("totp_last_step")
  // Enrollment in progress (sealed); promoted on a confirmed code.
  totpPendingEnc     String?   @map("totp_pending_enc")
  totpPendingAt      DateTime? @map("totp_pending_at")
  // Stable random WebAuthn user handle (base64url), never PII.
  webauthnUserHandle String?   @unique @map("webauthn_user_handle")
  createdAt          DateTime  @default(now()) @map("created_at")
  // Account deleted (GDPR): sessions that signed in before this can no
  // longer provision a workspace; every other field is cleared.
  accountDeletedAt   DateTime? @map("account_deleted_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_security")
}

model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // SHA-256 of the normalized 80-bit code; the code itself is shown once.
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_recovery_codes")
}

model UserPasskey {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // Snapshot of the account at registration: a usernameless passkey sign-in
  // restores the session's name/email from here.
  email        String?
  userName     String?   @map("user_name")
  // base64url credential id.
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?   @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  aaguid       String?
  name         String
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_passkeys")
}

// Server-side, single-use, expiring challenges: WebAuthn registration and
// authentication challenges, and second-factor proofs minted after enrollment.
model AuthChallenge {
  id         String    @id @default(cuid())
  kind       String
  userId     String?   @map("user_id")
  challenge  String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_challenges")
}

// Phase 6: email + password accounts and email magic links. Sign-in stays
// Auth.js stateless JWT (no adapter); an email account's stable subject is
// user_id = "email:<normalized email>". No workspace data: no tenant RLS.
model EmailAccount {
  id              String    @id @default(cuid())
  // "email:<email>" — the Auth.js subject (token.sub).
  userId          String    @unique @map("user_id")
  // Normalized (trimmed, lower-cased) address.
  email           String    @unique
  name            String?
  // "scrypt$N$r$p$salt$hash" (lib/auth/email/password.ts). Null for
  // magic-link-only accounts and after a magic link verifies an account whose
  // password was never proven by the mailbox owner.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("email_accounts")
}

enum EmailAuthTokenPurpose {
  verify
  login
  reset
}

// Single-use, expiring email links. Only the SHA-256 of the token is stored;
// consumption is one guarded UPDATE (used_at IS NULL AND expires_at > now).
model EmailAuthToken {
  id           String                @id @default(cuid())
  tokenHash    String                @unique @map("token_hash")
  // Normalized address the link was sent to (an account may not exist yet:
  // an open-signup magic link creates it on first use).
  email        String
  purpose      EmailAuthTokenPurpose
  // verify only: the password chosen in the signup that sent this link
  // (scrypt hash). Verifying activates exactly that password, so a second
  // signup for the same unverified address can't plant its own.
  passwordHash String?               @map("password_hash")
  expiresAt    DateTime              @map("expires_at")
  usedAt       DateTime?             @map("used_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("email_auth_tokens")
}

model ScimToken {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // SHA-256 of the raw token; the raw token is shown once.
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  createdBy   String    @map("created_by")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("scim_tokens")
}

model ScimGroup {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  displayName String            @map("display_name")
  externalId  String?           @map("external_id")
  // The workspace role members of this group get (never owner).
  role        WorkspaceRole
  members     ScimGroupMember[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([workspaceId, displayName])
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId     String          @map("group_id")
  group       ScimGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId    String          @map("member_id")
  member      WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@id([groupId, memberId])
  @@index([memberId])
  @@index([workspaceId])
  @@map("scim_group_members")
}

// ============================================================
// Phase 4b (4b-INBOX-MOBILE): CRM conversation inbox + mobile push.
// ============================================================

// Per-user read marker for one lead's conversation thread. A thread is
// unread for a user when it has an inbound message newer than lastReadAt
// (or any inbound message and no marker). FORCE RLS on workspace_id.
model ConversationRead {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  leadId      String    @map("lead_id")
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lastReadAt  DateTime  @map("last_read_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, userId, leadId])
  @@index([leadId])
  @@map("conversation_reads")
}

// An Expo push token registered by the mobile app for one user in one
// workspace. enabled=false is the user's opt-out; mutedKinds opts out of
// single notification kinds. Tokens Expo reports as DeviceNotRegistered are
// deleted. FORCE RLS on workspace_id. (expo_token matches the GDPR export
// secret-column rule, so it never leaves the database in an export.)
model PushDevice {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id")
  expoToken    String    @map("expo_token")
  // "ios" | "android"
  platform     String
  deviceName   String?   @map("device_name")
  enabled      Boolean   @default(true)
  mutedKinds   String[]  @default([]) @map("muted_kinds")
  failureCount Int       @default(0) @map("failure_count")
  lastError    String?   @map("last_error")
  lastSentAt   DateTime? @map("last_sent_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, expoToken])
  @@index([workspaceId, userId])
  @@map("push_devices")
}

// ---------------------------------------------------------------------------
// Phase 4b: social loop. A SocialPublication is a ShapesOS-owned post record
// (text + media + UTM-tagged link) that goes draft → pending_approval →
// approved → scheduled/published through the social provider (Postiz, or the
// mock provider without credentials). SocialPostMetric holds engagement per
// post per channel per day, ingested from the provider and fed into
// Attribution. Both tables are FORCE RLS on app.workspace_id.
// ---------------------------------------------------------------------------

enum SocialPublicationStatus {
  draft
  pending_approval
  approved
  scheduled
  published
  failed
  cancelled
}

model SocialPublication {
  id            String                  @id @default(cuid())
  workspaceId   String                  @map("workspace_id")
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     String                  @map("created_by")
  content       String
  // Outbound link; UTM-tagged per channel at dispatch time.
  link          String?
  utmCampaign   String?                 @map("utm_campaign")
  // [{ id, identifier, name }] — provider channel (integration) targets.
  channels      Json                    @default("[]")
  // [{ fileId, filename, mimeType, kind, sizeBytes, width?, height? }]
  media         Json                    @default("[]")
  // "now" or "schedule" (the requested publish timing).
  publishMode   String                  @default("now") @map("publish_mode")
  scheduledFor  DateTime?               @map("scheduled_for")
  status        SocialPublicationStatus @default(draft)
  // Where the draft came from: compose | studio | ads.
  source        String                  @default("compose")
  sourceRef     String?                 @map("source_ref")
  // postiz | mock — set when dispatched.
  provider      String?
  // [{ postId, integrationId, platform, releaseUrl?, state? }]
  providerRefs  Json                    @default("[]") @map("provider_refs")
  requestedBy   String?                 @map("requested_by")
  requestedAt   DateTime?               @map("requested_at")
  decidedBy     String?                 @map("decided_by")
  decidedAt     DateTime?               @map("decided_at")
  decisionNote  String?                 @map("decision_note")
  publishedAt   DateTime?               @map("published_at")
  error         String?
  metricsSyncedAt DateTime?             @map("metrics_synced_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  metrics       SocialPostMetric[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, createdAt])
  @@map("social_publications")
}

model SocialPostMetric {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publicationId String            @map("publication_id")
  publication   SocialPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  // Provider channel (integration) id and normalized platform key.
  integrationId String            @map("integration_id")
  platform      String
  day           DateTime          @db.Date
  impressions   Int               @default(0)
  likes         Int               @default(0)
  comments      Int               @default(0)
  shares        Int               @default(0)
  clicks        Int               @default(0)
  // postiz | mock (mock rows are sample data, labelled in the UI).
  source        String            @default("postiz")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([publicationId, integrationId, day])
  @@index([workspaceId, day])
  @@map("social_post_metrics")
}

// ---------------------------------------------------------------------------
// Phase 6 (runtime): in-app cron runner (lib/cron/runner.ts). One row per job
// run, written by whichever replica claimed the run under the per-tick
// advisory lock. Host-wide (no workspace) — read only by platform operators.
// Pruned after CRON_RUN_RETENTION_DAYS (lib/cron/store.ts).
// ---------------------------------------------------------------------------

enum CronRunStatus {
  running
  ok
  failed
  timeout
}

model CronRun {
  id           String        @id @default(cuid())
  // Job key from lib/cron/jobs.ts (e.g. "webhooks", "scheduler-tick").
  job          String
  // The schedule slot this run covers (UTC minute).
  scheduledFor DateTime      @map("scheduled_for")
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  status       CronRunStatus @default(running)
  httpStatus   Int?          @map("http_status")
  durationMs   Int?          @map("duration_ms")
  error        String?

  @@index([job, startedAt])
  @@index([startedAt])
  @@map("cron_runs")
}

// Phase 6 (infra): shared rate-limit + login-lockout counters, so limits hold
// across app replicas (lib/api/rate-limit-store.ts, RATE_LIMIT_STORE).
// GLOBAL table, deliberately no workspace_id and no RLS: keys are opaque
// limiter keys ("write:user:<id>", "login:ip:<ip>", ...) used BEFORE a tenant
// is resolved (pre-auth login, the proxy). Rows hold counters and timestamps
// only — never tenant content — and only the limiter module touches it.
// Times are epoch milliseconds (BIGINT) so the window math is integer math.
model RateLimitBucket {
  key         String  @id
  windowStart BigInt  @map("window_start")
  count       Int
  lockedUntil BigInt? @map("locked_until")
  expiresAt   BigInt  @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// Phase 8 (ship): what a repository is built with, detected on its first
// clone into a run's sandbox (lockfiles → package manager; package.json
// scripts / pyproject / Makefile → test, lint, build commands) and reused by
// later runs (lib/sandbox/repo-profile.ts; the sandbox's run_tests reads it).
// One row per repository per workspace; FORCE RLS on app.workspace_id.
model RepoProfile {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // "owner/name", lower-cased.
  repoFullName   String    @map("repo_full_name")
  packageManager String?   @map("package_manager")
  language       String?
  // { install?, test?, lint?, build?, typecheck? } — shell commands.
  commands       Json      @default("{}")
  // Files the detection read (package.json, pnpm-lock.yaml, Makefile, …).
  detectedFrom   String[]  @default([]) @map("detected_from")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, repoFullName])
  @@map("repo_profiles")
}

// Phase 9 (repos): every branch an agent pushed (shapes/<runId>) and its pull
// request, one row per (repository, branch). Written by saveShipState when a
// push or a PR lands on a run's ship state (lib/ship/pull-requests.ts). It is
// how a GitHub webhook (or the opt-in poller) finds the workspace, run and
// chat thread a PR belongs to, and what the Repositories view lists.
// FORCE RLS on app.workspace_id, plus ONE SELECT-only routing policy
// (app.github_route = 'lookup') used to map an incoming delivery to its
// workspace — every write runs under the row's own tenant GUC.
model AgentPullRequest {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // "owner/name", lower-cased.
  repoFullName       String    @map("repo_full_name")
  // shapes/<runId> — the only branch this work pushes.
  branch             String
  // The run whose id names the branch (ShipState.cloneRunId).
  runId              String    @map("run_id")
  threadId           String?   @map("thread_id")
  prNumber           Int?      @map("pr_number")
  prUrl              String?   @map("pr_url")
  // pushed (no PR yet) | open | closed | merged
  state              String    @default("pushed")
  // success | failure | pending | none (rolled-up checks on the head commit)
  checks             String?
  lastFeedbackAt     DateTime? @map("last_feedback_at")
  lastFeedback       String?   @map("last_feedback")
  lastFeedbackUrl    String?   @map("last_feedback_url")
  // A continuation job is queued (later feedback coalesces into it).
  pendingSince       DateTime? @map("pending_since")
  continuations      Int       @default(0)
  lastContinuedAt    DateTime? @map("last_continued_at")
  lastContinuedRunId String?   @map("last_continued_run_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  deliveries GitHubWebhookDelivery[]

  @@unique([repoFullName, branch])
  @@index([workspaceId, state, updatedAt])
  @@map("agent_pull_requests")
}

// Phase 9 (repos): GitHub feedback received for an agent pull request — one
// row per webhook delivery (X-GitHub-Delivery) or per item the poller saw
// ("poll:<kind>:<id>"); the primary key is the dedupe. A continuation turn
// consumes the rows it was started for (continued_run_id).
// FORCE RLS on app.workspace_id; cascades from the workspace and the PR row.
model GitHubWebhookDelivery {
  deliveryId     String           @id @map("delivery_id")
  workspaceId    String           @map("workspace_id")
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pullRequestId  String           @map("pull_request_id")
  pullRequest    AgentPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  // webhook event name (pull_request_review, issue_comment, …) or "poll"
  event          String
  action         String?
  // feedback (continues the work) | info (recorded only)
  kind           String
  author         String?
  summary        String
  url            String?
  continuedRunId String?          @map("continued_run_id")
  receivedAt     DateTime         @default(now()) @map("received_at")

  @@index([workspaceId, receivedAt])
  @@index([pullRequestId, continuedRunId])
  @@map("github_webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 9 (apps): internal mini-apps. A zod-validated spec (lib/apps/spec.ts:
// entities + fields, views, actions with a tier, per-view/action min role)
// rendered at /dashboard/apps/[slug]; records live in a scoped JSONB store
// validated server-side against the spec (lib/apps/records.ts). Agents can
// only write the DRAFT spec; publishing (admin) copies it to `spec`, bumps
// `version` and snapshots it in mini_app_versions, so records written under
// an older version stay readable. All three tables FORCE RLS on
// app.workspace_id and cascade from workspaces.
// ---------------------------------------------------------------------------
model MiniApp {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // URL segment (/dashboard/apps/<slug>); fixed at creation.
  slug           String
  name           String
  description    String?
  // The live spec (null until the first publish) and its version (0 = never published).
  spec           Json?
  version        Int       @default(0)
  // False = hidden from the runtime (records kept); true once published.
  published      Boolean   @default(false)
  // The working draft: builder and agent edits land here, never on `spec`.
  draftSpec      Json      @map("draft_spec")
  draftUpdatedBy String?   @map("draft_updated_by")
  createdBy      String    @map("created_by")
  publishedBy    String?   @map("published_by")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  versions MiniAppVersion[]
  records  MiniAppRecord[]

  @@unique([workspaceId, slug])
  @@map("mini_apps")
}

// One immutable snapshot per published version (old records render with it).
model MiniAppVersion {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId       String    @map("app_id")
  app         MiniApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  version     Int
  spec        Json
  publishedBy String    @map("published_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([appId, version])
  @@index([workspaceId])
  @@map("mini_app_versions")
}

// A record of one entity of one app. `data` is validated against the spec
// version current at write time (`specVersion`).
model MiniAppRecord {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId       String    @map("app_id")
  app         MiniApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  // Entity key from the spec ("tickets", "vendors", ...).
  entity      String
  data        Json      @default("{}")
  specVersion Int       @map("spec_version")
  createdBy   String    @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, appId, entity, createdAt])
  @@index([appId, entity])
  @@map("mini_app_records")
}
