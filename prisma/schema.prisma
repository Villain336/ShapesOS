// ---------------------------------------------------------------------------
// Marketr — redesign (2026-09-22): automation canvas workflows.
// Node-graph workflows per project: triggers, actions, approval gates, logic.
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  draft
  active
  paused
  archived
}

enum WorkflowRunStatus {
  queued
  running
  waiting_approval
  succeeded
  failed
  cancelled
}

enum WorkflowStepStatus {
  pending
  running
  waiting_approval
  succeeded
  failed
  skipped
}

model Workflow {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      WorkflowStatus @default(draft)
  // Cron expression for the schedule trigger; null = manual-only workflow.
  schedule    String?
  // IANA timezone the schedule is read in (never the server's local zone).
  timezone    String         @default("UTC")
  enabled     Boolean        @default(true)
  createdBy   String?        @map("created_by")
  lastRunAt   DateTime?      @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nodes WorkflowNode[]
  edges WorkflowEdge[]
  runs  WorkflowRun[]
  // Phase 6: signing secret for the webhook trigger's inbound URL (1:1).
  webhook         WorkflowWebhook?
  webhookReceipts WorkflowWebhookReceipt[]

  @@index([projectId, status])
  @@map("workflows")
}

// Phase 6 (runtime): the webhook trigger's signing secret. One per workflow,
// minted on demand from the canvas, shown once, stored only as a secrets()
// envelope (same convention as webhook_endpoints.secret_enc). Kept out of the
// workflows row so GET /api/workflows/[id] never carries it.
model WorkflowWebhook {
  workflowId     String    @id @map("workflow_id")
  workflow       Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  secretEnc      String    @map("secret_enc")
  secretHint     String    @map("secret_hint")
  createdBy      String?   @map("created_by")
  lastReceivedAt DateTime? @map("last_received_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("workflow_webhooks")
}

// Phase 6 (runtime): replay guard for the inbound workflow webhook. Each
// accepted signature is recorded once per workflow; the same signed request
// inside the 5-minute window is refused. Rows older than the window are
// pruned on the next receipt.
model WorkflowWebhookReceipt {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // The v1 HMAC (hex) that verified — unique per signed request.
  signature  String
  runId      String?  @map("run_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([workflowId, signature])
  @@index([workflowId, receivedAt])
  @@map("workflow_webhook_receipts")
}

model WorkflowNode {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Node category: "trigger" | "action" | "approval" | "logic".
  kind      String
  // Node type within the category, e.g. trigger: schedule|rank_drop|
  // competitor_published|decay_detected|webhook|manual; action:
  // generate_draft|run_audit|apply_internal_links|send_alert|generate_report|
  // publish_approved; approval: approval_gate; logic: condition|delay.
  type      String
  label     String
  // Node-specific config JSON (cron expression, thresholds, template ids…).
  config    Json   @default("{}")
  // Canvas position.
  positionX Float  @map("position_x")
  positionY Float  @map("position_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workflowId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceNodeId String  @map("source_node_id")
  targetNodeId String  @map("target_node_id")
  // For condition branches: "true" | "false"; null = default path.
  label        String?

  @@index([workflowId])
  @@map("workflow_edges")
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status                WorkflowRunStatus @default(queued)
  // What started the run: "manual" | "schedule" | "webhook" | event key.
  triggerKind           String            @map("trigger_kind")
  createdBy             String?           @map("created_by")
  error                 String?
  // Autopilot item id when the run is paused at an approval gate.
  pendingApprovalItemId String?           @map("pending_approval_item_id")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  steps WorkflowRunStep[]

  @@index([workflowId, startedAt])
  @@index([projectId, startedAt])
  @@map("workflow_runs")
}

model WorkflowRunStep {
  id        String             @id @default(cuid())
  runId     String             @map("run_id")
  run       WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String             @map("node_id")
  nodeKind  String             @map("node_kind")
  nodeLabel String             @map("node_label")
  status    WorkflowStepStatus @default(pending)
  input     Json?
  output    Json?
  error     String?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([runId, startedAt])
  @@map("workflow_run_steps")
}

// ---------------------------------------------------------------------------
// Marketr — redesign (2026-09-22): AI chat threads (project-scoped,
// LLM-style command center) and per-project team chat channels.
// ---------------------------------------------------------------------------

model AiChatThread {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  title     String  @default("New chat")
  // Phase 5: the task's agent ("lead" or a sub-agent key) and the tool groups
  // it may use (server-computed grant; empty = the agent's defaults).
  agentKey     String   @default("lead") @map("agent_key")
  allowedTools String[] @default([]) @map("allowed_tools")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AiChatMessage[]

  @@index([projectId, userId, updatedAt])
  @@map("ai_chat_threads")
}

model AiChatMessage {
  id       String       @id @default(cuid())
  threadId String       @map("thread_id")
  thread   AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // "user" | "assistant" | "tool".
  role      String
  content   String @db.Text
  // Tool calls executed for this message:
  // [{ tool, args, resultSummary, status, confirmed? }].
  toolCalls Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("ai_chat_messages")
}

model ChatChannel {
  id        String  @id @default(cuid())
  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String  @default("Project chat")

  createdAt DateTime @default(now()) @map("created_at")

  messages TeamChatMessage[]

  @@map("chat_channels")
}

model TeamChatMessage {
  id         String      @id @default(cuid())
  channelId  String      @map("channel_id")
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  // Denormalized display-name snapshot (email or name at send time).
  authorName String      @map("author_name")
  body       String      @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@map("team_chat_messages")
}

// ---------------------------------------------------------------------------
// Milestone 21: user-installable skills, connectors, workspace/project settings.
// ---------------------------------------------------------------------------
//
// Design notes (minor deviations from docs/specs/SPEC-SKILLS-CONNECTORS-SETTINGS.md §6,
// recorded here deliberately):
// - The 12 built-in connectors are code-defined in
//   lib/connectors/native/registry.ts (matching the existing provider pattern
//   in lib/providers/index.ts), NOT rows in the Connector table. The Connector
//   model exists only for workspace-custom MCP servers. ConnectorConnection
//   therefore keys on connectorKey (string) with an optional connectorId FK
//   for custom servers. This avoids a nullable partial-unique-index problem
//   and keeps built-ins versioned with the codebase.
// - Project.domain / Project.locale already exist on Project; ProjectSettings
//   holds the rest (brand context, extra domains, overrides, approval mode,
//   publishing controls) rather than duplicating them.

enum SkillSource {
  registry
  url
  upload
}

enum SkillTrustTier {
  built_in
  pinned_url
}

enum ConnectorKind {
  native
  mcp
}

enum ConnectorAuthType {
  oauth2
  api_key
  none
}

enum ConnectionStatus {
  active
  needs_reauth
  revoked
}

// Phase B (B3): cached per-connection health. Derived, refreshed by the
// health checker (lib/connectors/health.ts); never the source of truth for
// auth — ConnectorConnection.status + the vault are.
enum ConnectorHealthStatus {
  healthy
  degraded
  needs_reauth
  error
  unknown
}

model ConnectorHealth {
  id           String              @id @default(cuid())
  // One row per connection; the checker upserts on connectionId.
  connectionId String              @unique @map("connection_id")
  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // Denormalized for the workspace summary query (the authorization
  // boundary is still re-checked via ConnectorConnection on every read).
  workspaceId  String              @map("workspace_id")
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete

  status        ConnectorHealthStatus @default(unknown)
  lastCheckAt   DateTime              @map("last_check_at")
  lastSuccessAt DateTime?             @map("last_success_at")
  // Closed-set error code (see lib/connectors/health.ts ERROR_CODES) —
  // never a raw provider message.
  lastError     String?               @map("last_error")
  quotaUsed     Float?                @map("quota_used")
  quotaLimit    Float?                @map("quota_limit")

  // Alert spam guard: cooldown + escalation state (see docs/security/THREAT-MODEL-connector-health.md).
  lastAlertAt       DateTime? @map("last_alert_at")
  consecutiveErrors Int       @default(0) @map("consecutive_errors")

  @@index([workspaceId])
  @@map("connector_health")
}

model Skill {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String         @db.Text
  source        SkillSource
  sourceRef     String?        @map("source_ref")
  version       String         @default("1.0.0")
  // Commit SHA the install is pinned to (url source). Null = not pinned.
  shaPin        String?        @map("sha_pin")
  skillMd       String         @map("skill_md") @db.Text
  // Tool names the skill may invoke, e.g. "google-search-console.query".
  declaredTools String[]       @map("declared_tools")
  trustTier     SkillTrustTier @map("trust_tier")
  installedBy   String?        @map("installed_by")
  installedAt   DateTime       @default(now()) @map("installed_at")

  projects        ProjectSkill[]
  // Phase B (W2, track B2): schedules that run this skill + their run history.
  scheduledSkills ScheduledSkill[]
  skillRuns       SkillRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("skills")
}

model ProjectSkill {
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String   @map("skill_id")
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  enabledBy String?  @map("enabled_by")
  enabledAt DateTime @default(now()) @map("enabled_at")

  @@id([projectId, skillId])
  @@map("project_skills")
}

// Workspace-custom MCP servers only. Built-in connectors live in code
// (lib/connectors/native/registry.ts).
model Connector {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  kind        ConnectorKind         @default(mcp)
  displayName String                @map("display_name")
  authType    ConnectorAuthType     @default(none) @map("auth_type")
  // For MCP: { endpoint, transport: "http" | "stdio", command? }
  config      Json?
  mcpEndpoint String?               @map("mcp_endpoint")
  createdBy   String?               @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  // Opposite side of ConnectorConnection.connector (M21 connectors).
  connections ConnectorConnection[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("connectors")
}

model ConnectorConnection {
  id            String           @id @default(cuid())
  // Connector key: built-in native key (e.g. "google-search-console") or a
  // custom Connector.key for workspace MCP servers.
  connectorKey  String           @map("connector_key")
  connectorId   String?          @map("connector_id")
  connector     Connector?       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  workspaceId   String           @map("workspace_id")
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Auth.js user id that owns this credential (per-user OAuth).
  userId        String           @map("user_id")
  status        ConnectionStatus @default(active)
  scopes        String[]
  // Non-sensitive display metadata (account email, property list, ...).
  meta          Json?
  connectedAt   DateTime         @default(now()) @map("connected_at")
  lastRefreshAt DateTime?        @map("last_refresh_at")

  credential      ConnectorCredential?
  projectBindings ProjectDataSource[]
  health          ConnectorHealth?

  @@index([workspaceId])
  @@index([userId])
  @@index([connectorKey])
  @@map("connector_connections")
}

model ConnectorCredential {
  connectionId  String              @id @map("connection_id")
  connection    ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // AES-256-GCM envelope via lib/secrets (never logged, never sent to clients).
  encryptedBlob String              @map("encrypted_blob") @db.Text
  keyVersion    String              @default("env-v1") @map("key_version")
  expiresAt     DateTime?           @map("expires_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("connector_credentials")
}

model ProjectDataSource {
  id            String              @id @default(cuid())
  projectId     String              @map("project_id")
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId  String              @map("connection_id")
  connection    ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectorKey  String              @map("connector_key")
  // Per-project binding config, e.g. { property: "https://example.com" } for
  // Search Console, { folderId } for Drive.
  projectConfig Json?               @map("project_config")
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([projectId, connectionId])
  @@index([projectId])
  @@map("project_data_sources")
}

model FileAttachment {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Chat session (AiChatThread id) or brief context; null = project-level.
  sessionId    String?  @map("session_id")
  source       String // "upload" | "connector"
  connectorKey String?  @map("connector_key")
  externalRef  String?  @map("external_ref")
  filename     String
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  // Local disk path under .data/attachments (uploads). Null for connector refs.
  storagePath  String?  @map("storage_path")
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([sessionId])
  @@map("file_attachments")
}

model WorkspaceSettings {
  workspaceId          String    @id @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultModel         String?   @map("default_model")
  defaultApprovalMode  String    @default("supervised") @map("default_approval_mode")
  notificationDefaults Json?     @map("notification_defaults")
  dataGovernance       Json?     @map("data_governance")
  // Tool namespaces the agent may use; empty = all enabled.
  agentAllowList       String[]  @default([]) @map("agent_allow_list")
  // Phase 14: manual risk-tier overrides for Composio tools, keyed by tool
  // slug → "low" | "medium" | "high". Overrides win over verb-derived
  // classification (spec §3).
  toolTierOverrides    Json?     @map("tool_tier_overrides")
  updatedBy            String?   @map("updated_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("workspace_settings")
}

model ProjectSettings {
  projectId            String   @id @map("project_id")
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // JSON overrides of any workspace default, e.g. { defaultModel, notificationDefaults }.
  overrides            Json?
  // Brand context text injected into the agent prompt for this project.
  brandContext         String?  @map("brand_context") @db.Text
  // Extra domains beyond Project.domain.
  domains              String[]
  approvalModeOverride String?  @map("approval_mode_override")
  publishingControls   Json?    @map("publishing_controls")
  updatedBy            String?  @map("updated_by")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("project_settings")
}

// Granular permission grants beyond the role hierarchy (milestone 21).
// owner/admin always hold every permission; grants extend to others.
model PermissionGrant {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Exactly one of userId / role is set (enforced in code).
  userId      String?        @map("user_id")
  role        WorkspaceRole?
  // "skills.install" | "connectors.connect" (open string for future grants).
  permission  String
  grantedBy   String         @map("granted_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([workspaceId, userId])
  @@map("permission_grants")
}

enum WorkspaceFileKind {
  skill
  memory
  artifact
  file
}

// Phase B (W3, track B1): registry-gated private workspace filesystem.
// The DB registry is the isolation boundary; storage keys are opaque UUIDs.
model WorkspaceFile {
  id                         String                      @id @default(cuid())
  workspaceId                String                      @map("workspace_id")
  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Normalized logical path, e.g. "/files/reports/q3.pdf". Unique among
  // live (non-trashed) files per workspace.
  logicalPath                String                      @map("logical_path")
  // Opaque UUID storage key. Never serialized to clients.
  storageKey                 String                      @unique @map("storage_key")
  filename                   String                      @db.VarChar(255)
  mimeType                   String                      @map("mime_type")
  sizeBytes                  Int                         @map("size_bytes")
  kind                       WorkspaceFileKind
  createdBy                  String                      @map("created_by")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  // Trash: set on soft-delete, 30-day retention, then purge.
  trashedAt                  DateTime?                   @map("trashed_at")
  // Legal/Compliance slice 3: Document vault — versions referencing this file.
  legalDocumentVersions      LegalDocumentVersion[]
  fundingDataRoomDocVersions FundingDataRoomDocVersion[]
  // CAD + Hardware slice 1: model versions referencing this file.
  cadModelVersions           CadModelVersion[]

  @@index([workspaceId, trashedAt])
  @@index([workspaceId, kind])
  @@map("workspace_files")
}

model WorkspaceQuota {
  workspaceId String    @id @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  limitBytes  BigInt    @map("limit_bytes")
  usedBytes   BigInt    @default(0) @map("used_bytes")

  @@map("workspace_quotas")
}

// ---------------------------------------------------------------------------
// Phase B (W2, track B2): scheduled skills + parallel subagent runs.
// ---------------------------------------------------------------------------

enum ScheduleTriggerType {
  cron
  event
}

enum ScheduleApprovalMode {
  supervised
  scheduled
  autopilot
}

enum ScheduleStatus {
  active
  paused
}

enum SkillRunTrigger {
  cron
  event
  manual
}

enum SkillRunStatus {
  pending
  awaiting_approval
  approved
  running
  succeeded
  failed
  rejected
  cancelled
  // Phase C gaps (G1): pre-run cap gate blocked this run before execution (T9).
  blocked
}

enum SubagentRunStatus {
  pending
  running
  succeeded
  failed
  skipped
}

// A skill schedule: fires a skill on a cron expression or a workspace event.
model ScheduledSkill {
  id               String               @id @default(cuid())
  workspaceId      String               @map("workspace_id")
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Null = workspace-wide (fires across the workspace's projects where the
  // skill is enabled). Set = project-scoped (creatable by project editors).
  projectId        String?              @map("project_id")
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId          String               @map("skill_id")
  skill            Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  triggerType      ScheduleTriggerType  @map("trigger_type")
  // Strict 5-field cron ("0 9 * * 1"). Null for event schedules.
  cronExpr         String?              @map("cron_expr")
  // IANA zone the cron is read in as wall-clock time (Phase 4a). Validated
  // on write; default UTC (the behaviour before this column existed).
  timezone         String               @default("UTC")
  // Event bus source key, e.g. "rank_drop". Null for cron schedules.
  eventSource      String?              @map("event_source")
  // Per-source config, e.g. { "dropThreshold": 3 } for rank_drop.
  eventConfigJson  Json?                @map("event_config_json")
  // JSON array of schedule ids this run must not re-trigger (cycle guard is
  // enforced at fire time; the lineage is carried on SkillRun).
  createdBy        String               @map("created_by")
  approvalMode     ScheduleApprovalMode @map("approval_mode")
  concurrencyLimit Int                  @default(4) @map("concurrency_limit")
  status           ScheduleStatus       @default(active)
  lastRunAt        DateTime?            @map("last_run_at")
  nextRunAt        DateTime?            @map("next_run_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  runs SkillRun[]

  @@index([workspaceId, status])
  @@index([nextRunAt])
  @@index([workspaceId, skillId])
  @@map("scheduled_skills")
}

// One execution of a skill: from a schedule (cron/event) or manual trigger.
model SkillRun {
  id           String          @id @default(cuid())
  scheduleId   String?         @map("schedule_id")
  schedule     ScheduledSkill? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  workspaceId  String          @map("workspace_id")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String?         @map("project_id")
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId      String          @map("skill_id")
  skill        Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  trigger      SkillRunTrigger
  // Server-side trigger lineage (schedule ids, oldest first) for cycle
  // detection. Never client-supplied.
  lineage      String[]        @default([])
  // Firing event payload (event-triggered runs): stored so the run detail
  // view can show exactly what fired the run.
  eventPayload Json?           @map("event_payload")
  status       SkillRunStatus  @default(pending)
  // True when this run was created by the missed-cron catch-up (fires once,
  // marked missed per the decided policy).
  wasMissed    Boolean         @default(false) @map("was_missed")
  startedAt    DateTime        @default(now()) @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  // Integer credits (metering ledger arrives in Phase C; fields exist now).
  creditsUsed  Int             @default(0) @map("credits_used")
  // Filesystem logical path, e.g. /artifacts/runs/<run-id>/report.md
  outputPath   String?         @map("output_path")
  error        String?         @db.Text
  approvedBy   String?         @map("approved_by")
  approvedAt   DateTime?       @map("approved_at")

  subagents SubagentRun[]

  @@index([workspaceId, startedAt])
  @@index([scheduleId])
  @@index([skillId])
  @@index([status])
  @@map("skill_runs")
}

// One parallel subagent inside a skill run. Each is separately audited and
// credit-metered; grants never exceed the parent run's envelope.
model SubagentRun {
  id          String            @id @default(cuid())
  skillRunId  String            @map("skill_run_id")
  skillRun    SkillRun          @relation(fields: [skillRunId], references: [id], onDelete: Cascade)
  taskLabel   String            @map("task_label")
  status      SubagentRunStatus @default(pending)
  startedAt   DateTime          @default(now()) @map("started_at")
  finishedAt  DateTime?         @map("finished_at")
  creditsUsed Int               @default(0) @map("credits_used")
  // Summary of what the subagent produced (deterministic mock in this track).
  result      String?           @db.Text

  @@index([skillRunId])
  @@map("subagent_runs")
}

// Phase C (W5): Marketr as MCP server — workspace API keys.
model McpApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  userId      String    @map("user_id")
  name        String
  // SHA-256 hex of the raw key. Raw key material is NEVER stored.
  keyHash     String    @unique @map("key_hash")
  // Public prefix (e.g. "mcpk_a1b2c3") for display/identification only.
  keyPrefix   String    @map("key_prefix")
  // Per-tool scopes, e.g. ["tools:list_projects"]. Fixed constants, no wildcards.
  scopes      String[]  @map("scopes")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mcp_api_keys")
}

// Phase C (W5): OAuth 2.1 Dynamic Client Registration (RFC 7591) clients.
model McpOAuthClient {
  // Opaque public client id (e.g. "mcpc_<random>").
  clientId     String     @id @map("client_id")
  // Null until the first consent approval claims the client (public DCR, RFC 7591).
  userId       String?    @map("user_id")
  // Bound at authorization time: the token's tenant.
  workspaceId  String?    @map("workspace_id")
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  clientName   String?    @map("client_name")
  redirectUris String[]   @map("redirect_uris")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mcp_oauth_clients")
}

// Phase C (W5): single-use authorization codes (OAuth 2.1 code flow + PKCE).
model McpOAuthCode {
  code          String    @id
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  redirectUri   String    @map("redirect_uri")
  scopes        String[]
  // S256 code challenge (plain verifier never stored).
  codeChallenge String?   @map("code_challenge")
  expiresAt     DateTime  @map("expires_at")
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@index([workspaceId])
  @@map("mcp_oauth_codes")
}

// Phase C (W5): access tokens (SHA-256 hash stored; raw token never stored).
model McpOAuthToken {
  // SHA-256 hex of the raw token.
  tokenHash   String    @id @map("token_hash")
  clientId    String    @map("client_id")
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  scopes      String[]
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mcp_oauth_tokens")
}

// Phase C gaps (G3): distributed rate-limit counters for PostgresRateLimiter.
// Incremented atomically via a single INSERT ... ON CONFLICT DO UPDATE
// statement (see migration 20260922250000_mcp_ratelimit); never via
// read-modify-write. Expired windows are deleted opportunistically.
model McpRateLimit {
  bucketKey   String   @map("bucket_key")
  windowStart BigInt   @map("window_start")
  count       Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@id([bucketKey, windowStart])
  @@index([windowStart])
  @@map("mcp_rate_limits")
}

// ─── Phase C (W4): hosted metering ───────────────────────────────────────────
// Immutable usage ledger. Application code only ever CREATES UsageEvent rows
// (lib/metering/service.ts exposes no update/delete); the migration adds a
// Postgres trigger that rejects UPDATE/DELETE outright (see
// lib/metering/THREAT-MODEL-METERING.md T5).
model UsageEvent {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String?   @map("project_id")
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Null = system/scheduler actor.
  actorId        String?   @map("actor_id")
  // Key into lib/metering/credits.ts CREDIT_COSTS (versioned, v1).
  action         String
  // Integer credits only — 1 credit = $0.01. Never floats.
  credits        Int
  // Set server-side at insert; callers cannot supply it.
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  // Caller-supplied idempotency key; UNIQUE so replays can never double-charge.
  idempotencyKey String    @unique @map("idempotency_key")
  // Unverified human pointer for disputes (run id, report path) — see T7.
  evidenceRef    String?   @map("evidence_ref")
  // Phase C gaps (G1): MCP API key / OAuth client this charge is attributed
  // to. Null for non-MCP charges. Server-validated to the workspace (T8).
  keyId          String?   @map("key_id")
  // Overage invoicing: portion of `credits` that fell beyond the paid pool
  // (included + purchased) at charge time. Factual accounting written by
  // meter() in-transaction; the invoice cron sums this per month. 0 for
  // in-cap charges and zero-cost actions. See SEAM.md "Overage accrual".
  overageCredits Int       @default(0) @map("overage_credits")
  // Phase 7: LLM token usage (action "llm_tokens", written by lib/llm/usage.ts
  // through meter()). Null on every other action. Token counts per class —
  // inputTokens is the uncached remainder — plus the estimated vendor cost in
  // micro-USD (lib/llm/pricing.ts; null when a price is unknown, never guessed).
  llmProvider         String? @map("llm_provider")
  llmModel            String? @map("llm_model")
  llmWorkload         String? @map("llm_workload")
  llmInputTokens      Int?    @map("llm_input_tokens")
  llmOutputTokens     Int?    @map("llm_output_tokens")
  llmCacheReadTokens  Int?    @map("llm_cache_read_tokens")
  llmCacheWriteTokens Int?    @map("llm_cache_write_tokens")
  llmCostMicroUsd     BigInt? @map("llm_cost_micro_usd")

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, action])
  @@index([projectId])
  @@index([workspaceId, keyId])
  @@map("usage_events")
}

// Per-workspace credit pool for the current billing period. Mutated ONLY
// inside meter()'s locked transaction (check-then-append is atomic) and the
// locked period-rollover path — see T2/T6.
model CreditBalance {
  workspaceId        String    @id @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  includedCredits    Int       @map("included_credits")
  purchasedCredits   Int       @default(0) @map("purchased_credits")
  // Null = no purchased credits outstanding.
  purchasedExpiresAt DateTime? @map("purchased_expires_at")
  usedCredits        Int       @default(0) @map("used_credits")
  periodStart        DateTime  @map("period_start")

  @@map("credit_balances")
}

// Spend guard. Default: hard cap ON at 100% of (included + purchased),
// alert at 80%. Admins may raise the cap or disable the block (opt-in
// overage); the alert still fires.
model SpendCap {
  workspaceId String    @id @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Effective cap in credits. Defaults to included + purchased; an admin can
  // set a custom (higher or lower) value.
  capCredits  Int       @map("cap_credits")
  blockAtCap  Boolean   @default(true) @map("block_at_cap")
  // Percent of capCredits at which the warning alert fires (default 80).
  alertAtPct  Int       @default(80) @map("alert_at_pct")
  // Once-per-period alert guard: the warning fires only when lastAlertAt is
  // null or older than the current periodStart.
  lastAlertAt DateTime? @map("last_alert_at")
  // Phase C gaps (G1): explicit auto-overage opt-in. Default false — the
  // hard cap stays the default. The billing track flips this on opt-in.
  autoOverage Boolean   @default(false) @map("auto_overage")

  @@map("spend_caps")
}

// ── Hosted Stripe billing state (overage invoicing track) ────────────────────
// The UsageEvent ledger stays the source of truth for what was spent; these
// tables record the money side: which Stripe customer belongs to which
// workspace, which invoices were issued, and exactly-once webhook guards.
// Self-hosted Marketr never creates rows here (billing methods fail closed
// without Stripe keys). See lib/metering/THREAT-MODEL-BILLING.md B10–B15.

model BillingWorkspace {
  workspaceId                String    @id @map("workspace_id")
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Stripe Customer bound to this workspace (B10). Written only from a
  // signed webhook or an admin-session checkout creation — never from
  // client-supplied input.
  stripeCustomerId           String?   @map("stripe_customer_id")
  // True once a setup-mode Checkout completed and the payment method was
  // attached as the customer's default for invoices (B11). Required to
  // enable auto-overage while billing is configured.
  hasPaymentMethod           Boolean   @default(false) @map("has_payment_method")
  // Watermark: overage events with occurredAt <= this value are invoiced.
  // Sub-minimum amounts are NOT invoiced but the watermark does not advance,
  // so they carry forward and are billed once the $5 minimum is reached (B15).
  lastOverageInvoicedThrough DateTime? @map("last_overage_invoiced_through")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("billing_workspaces")
}

model BillingOverageInvoice {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // YYYY-MM of the COMPLETED billing month this invoice covers (derived from
  // cutoff - 1ms). Covers all unbilled overage before that month's end,
  // including carried-forward amounts.
  period           String
  overageCredits   Int       @map("overage_credits")
  amountCents      Int       @map("amount_cents")
  stripeInvoiceId  String?   @map("stripe_invoice_id")
  hostedInvoiceUrl String?   @map("hosted_invoice_url")
  invoicePdfUrl    String?   @map("invoice_pdf_url")
  // finalized | paid | failed. Updated by invoice.paid / invoice.payment_failed
  // webhooks (B13); dunning after failure is a documented follow-up.
  status           String    @default("finalized")
  // overageinvoice:<workspaceId>:<YYYY-MM> — replay-safe per workspace per
  // month (B12).
  idempotencyKey   String    @unique @map("idempotency_key")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, period])
  @@map("billing_overage_invoices")
}

// Exactly-once guard for setup-mode Checkout completions (B11): a replayed
// checkout.session.completed (mode=setup) must not re-attach or double-count.
model BillingSetupIdempotency {
  idempotencyKey  String    @id @map("idempotency_key")
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  stripeSessionId String    @map("stripe_session_id")
  appliedAt       DateTime  @default(now()) @map("applied_at")

  @@index([workspaceId])
  @@map("billing_setup_idempotency")
}

// Drift reconciliation (2026-09-26): billing_topup_idempotency was created
// lazily at runtime by lib/metering/billing.ts (ensureIdempotencyTable) and
// therefore existed in the DB without a Prisma model. It is now adopted:
// the migration uses CREATE TABLE IF NOT EXISTS (no-op where it exists),
// and the runtime DDL remains as a safety net for code paths that run
// before migrations. Doubles as the credit top-up purchase history.
model BillingTopupIdempotency {
  idempotencyKey  String    @id @map("idempotency_key")
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credits         Int       @map("credits")
  amountCents     Int       @map("amount_cents")
  stripeSessionId String    @map("stripe_session_id")
  source          String    @map("source")
  appliedAt       DateTime  @default(now()) @map("applied_at")

  @@map("billing_topup_idempotency")
}

// ── Lead Pipeline CRM (Phase 1 / R1) ─────────────────────────────────────
// The Lead is the central object of the agency-in-a-box thesis: every
// channel (digital, physical, media) feeds one pipeline per client.
// Tenant rule: every row carries workspaceId; every query filters on it.

enum LeadSource {
  website_form
  phone
  referral
  import
  ad
  ooh
  direct_mail
  booking
  other
}

enum LeadActivityType {
  created
  note
  email
  call
  sms
  meeting
  stage_change
  score_change
  form_submit
  import
  // Phase 2 (C2): logged when a lead newly reaches won with a value — the
  // revenue event the attribution dashboard reads.
  revenue
}

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional link to the white-label Client this pipeline serves. Null =
  // agency-internal pipeline.
  clientId    String?   @map("client_id")
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  // Ordered stage machine: [{ id: "new", label: "New", color: "violet" }, ...].
  // Lead.stage must be one of these ids (validated in lib/crm).
  stages      Json
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  leads        Lead[]
  captureForms LeadCaptureForm[]
  // Phase 10 (ops-core): real deals on this pipeline's stages.
  opsDeals     OpsDeal[]

  @@index([workspaceId])
  @@map("crm_pipelines")
}

model Lead {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId  String    @map("pipeline_id")
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  // Optional link to the SEO project this lead is attributed to.
  projectId   String?   @map("project_id")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name         String
  email        String?
  phone        String?
  company      String?
  title        String?
  source       LeadSource @default(other)
  sourceDetail String?    @map("source_detail")
  // Stage id — must exist in Pipeline.stages (validated in lib/crm).
  stage        String     @default("new")
  // 0–100, computed deterministically by lib/crm/scoring.ts (rules v1).
  score        Int        @default(0)
  valueCents   Int?       @map("value_cents")
  ownerId      String?    @map("owner_id")
  ownerName    String?    @map("owner_name")
  starred      Boolean    @default(false)
  customFields Json?      @map("custom_fields")
  // Dedup identity: "email:<normalized>" | "phone:<digits>". Unique per
  // workspace when present; the unique constraint is the race-safe backstop
  // behind the check-then-insert in the API (P2002 → 409 duplicate).
  dedupKey     String?    @map("dedup_key")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  activities          LeadActivity[]
  // Phase 2 (C2): marketing touches attributed to this lead.
  attributionTouches  AttributionTouch[]
  bundleRedemptions   BundleRedemption[]
  // Phase 2 (R5): tracked calls and bookings linked to this lead.
  calls               Call[]
  bookings            Booking[]
  // Phase 3: consent, messaging, sequences, review requests, prospect conversion.
  consents            ContactConsent[]
  outboundMessages    OutboundMessage[]
  sequenceEnrollments SequenceEnrollment[]
  reviewRequests      ReviewRequest[]
  convertedProspects  Prospect[]
  // Phase 13D: voice/text agent sessions.
  callSessions        CallSession[]
  // Phase 4b: per-user conversation-inbox read state.
  conversationReads   ConversationRead[]

  @@unique([workspaceId, dedupKey])
  @@index([workspaceId, pipelineId, stage])
  @@index([workspaceId, score])
  @@map("crm_leads")
}

model LeadActivity {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String           @map("lead_id")
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  body        String?
  // Human-readable actor ("Tico", "Public form", "Import", "System").
  actor       String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("crm_lead_activities")
}

model LeadCaptureForm {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId  String    @map("pipeline_id")
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  // sha256 hex of the public token. The token itself is shown once at
  // creation and never stored; lookup is by hash.
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  enabled     Boolean   @default(true)
  // Optional field config: [{ key: "company", label: "Company", required: true }]
  fields      Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([pipelineId])
  @@map("crm_capture_forms")
}

// ── Phase 2 (C2): Revenue attribution ──────────────────────────────────────
// Pure-software, read-only analytics on the Lead model. Touches are the raw
// marketing contacts; lib/attribution/models.ts turns them into channel
// credit under first-touch / last-touch / linear. No new billing meter
// (attribution quality is the tier upsell).

/**
 * The nature of a marketing touch. `first` = the touch that created the lead.
 */
enum AttributionTouchType {
  first
  visit
  form
  call
  manual
}

model AttributionTouch {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String    @map("lead_id")
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Normalized grouping key used by the dashboard (e.g. "paid_search",
  // "organic_search", "email", "website", "phone", "referral",
  // "social_organic", "direct_mail", "ooh", "qr_code", "direct", "other").
  // Mapping rules live in lib/attribution/touches.ts (channelFor).
  channel    String
  // Raw UTM values as captured.
  source     String?
  medium     String?
  campaign   String?
  // Optional link to a ContentItem (Marketr page) for revenue-influenced
  // content. Loose reference (no FK): content can be deleted without
  // destroying the attribution record.
  contentId  String?              @map("content_id")
  touchType  AttributionTouchType @default(visit) @map("touch_type")
  occurredAt DateTime             @default(now()) @map("occurred_at")
  // Dedup identity: sha256 of the touch's natural key with occurredAt
  // truncated to the hour. A double-submitted form or a re-imported CSV row
  // collapses to one touch. Unique per lead; the race-safe backstop is the
  // P2002 handler in lib/attribution/touches.ts (logTouch).
  dedupHash  String               @map("dedup_hash")
  // Raw extras (utm_term, utm_content, page URL, referrer…).
  meta       Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([leadId, dedupHash])
  @@index([workspaceId, channel])
  @@index([workspaceId, campaign])
  @@index([workspaceId, occurredAt])
  @@map("attr_touches")
}

model AttributionSpend {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Same normalized vocabulary as AttributionTouch.channel.
  channel     String
  campaign    String?
  amountCents Int       @map("amount_cents")
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  // Ad APIs don't exist yet, so spend is entered manually; organic/physical
  // channels legitimately carry $0 spend (CPL/CAC/ROAS then report null).
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, channel])
  @@index([workspaceId, periodStart, periodEnd])
  @@map("attr_spend")
}

// Phase 2 (R5): call tracking & appointment booking.
//
// Number provisioning is provider-backed (Twilio in production, a fake
// telephony provider in tests/dev). The FakeTelephonyProvider is the only
// one wired today — real Twilio credentials plug into lib/calls/provider.ts
// without touching these models.
//
// Call model notes:
// - `externalSid` is the provider's call SID (Twilio CallSid / fake SID).
//   UNIQUE so retried status webhooks collapse to one Call (idempotency).
// - Inbound calls match/create leads: `leadId` links the caller to the CRM,
//   and a call-source attribution touch feeds C2.
// - `status`: in_progress | completed | missed | voicemail | busy | failed.
model CallNumber {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // E.164 globally unique (a real number can only belong to one account).
  e164         String    @unique
  provider     String    @default("fake")
  providerSid  String?   @map("provider_sid")
  friendlyName String?   @map("friendly_name")
  // Campaign/source label this number tracks (DNI resolution key).
  campaign     String?
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  calls   Call[]
  bundles AttributionBundle[]

  @@index([workspaceId, status])
  @@index([workspaceId, campaign])
  @@map("call_number")
}

// A reminder/outreach message queued for a booking. Delivery is provider-
// backed behind lib/calls/reminders.ts (MailPort); the row is the audit
// trail: when it was due, when it was sent (or why it was skipped), and
// whose quiet hours it respected.
model Reminder {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookingId   String    @map("booking_id")
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind        String // confirmation | reminder_24h | reminder_1h
  // The channel it was queued for: email (SMS is a future channel).
  channel     String    @default("email")
  to          String
  subject     String
  body        String    @db.Text
  // scheduled | sent | skipped_opt_out | failed
  // (quiet-hour reminders are DEFERRED — dueAt pushed to 08:00 local, row
  // stays scheduled — never skipped; sendDueReminders enforces this).
  status      String    @default("scheduled")
  // The recipient-local time the reminder was due (quiet-hours evaluated in
  // the booking page's timezone).
  dueAt       DateTime  @map("due_at")
  sentAt      DateTime? @map("sent_at")
  failReason  String?   @map("fail_reason")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, status, dueAt])
  @@index([bookingId])
  @@map("reminder")
}

// A tracked phone call. Created by the inbound-voice webhook (in_progress)
// and finalized by the status callback (completed/missed/…). The status
// callback also meters call_minutes, matches/creates the lead, and logs
// the call-source attribution touch (see lib/calls/inbound.ts).
model Call {
  id            String     @id @default(cuid())
  workspaceId   String     @map("workspace_id")
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  numberId      String     @map("number_id")
  number        CallNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  // Provider's call SID (Twilio CallSid / fake SID). UNIQUE = idempotency
  // for retried status webhooks.
  externalSid   String     @unique @map("external_sid")
  from          String
  to            String
  direction     String     @default("inbound")
  status        String     @default("in_progress")
  startedAt     DateTime   @map("started_at")
  endedAt       DateTime?  @map("ended_at")
  durationSec   Int        @default(0) @map("duration_sec")
  recordingUrl  String?    @map("recording_url")
  transcription String?    @db.Text
  summary       String?    @db.Text
  // Lead the caller matched to (by caller number) or created from the call.
  leadId        String?    @map("lead_id")
  lead          Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // The call-source attribution touch (channel "phone", source
  // "tracking-number") this call produced, if any.
  touchId       String?    @map("touch_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, startedAt])
  @@index([numberId])
  @@index([workspaceId, from])
  @@index([leadId])
  @@map("call")
}

// A public, token-gated appointment booking page (same token pattern as
// LeadCaptureForm: mkbook_<32 hex>, stored as sha256). `settings` carries:
// durationMin, bufferMin, workingHours {mon..sun: [open,close] in 24h local},
// timezone (IANA), and reminder offsets.
model BookingPage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String    @unique
  tokenHash   String    @unique @map("token_hash")
  title       String
  description String?   @db.Text
  enabled     Boolean   @default(true)
  settings    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([workspaceId, enabled])
  @@map("booking_page")
}

// One booked appointment on a BookingPage. Bookings create or attach to a
// Lead (matched by email or phone) and log an attribution touch
// (channel "booking") so C2 sees them. TCPA posture: `consentGiven` is
// required at booking time for reminders; `remindersOptedOut` suppresses
// all future reminder sends; quiet hours are enforced per the page's
// timezone when reminders are sent.
model Booking {
  id                String      @id @default(cuid())
  workspaceId       String      @map("workspace_id")
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId            String      @map("page_id")
  page              BookingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  leadId            String?     @map("lead_id")
  lead              Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name              String
  email             String?
  phone             String?
  startAt           DateTime    @map("start_at")
  endAt             DateTime    @map("end_at")
  status            String      @default("scheduled")
  consentGiven      Boolean     @default(false) @map("consent_given")
  remindersOptedOut Boolean     @default(false) @map("reminders_opted_out")
  remindersSent     Int         @default(0) @map("reminders_sent")
  notes             String?     @db.Text
  createdAt         DateTime    @default(now()) @map("created_at")

  reminders Reminder[]

  @@index([workspaceId, startAt])
  @@index([pageId, startAt])
  @@index([leadId])
  @@map("booking")
}

// ---------------------------------------------------------------------------
// Physical attribution kit (P2): one-click measurement bundle per campaign.
// A bundle ties four artifacts to one campaign key:
//   - a tracking phone number (CallNumber via the R5 provider abstraction),
//   - a QR code (generated on demand from the vanity URL; nothing stored),
//   - a vanity URL slug (/r/<slug> → logs a scan, then 302s to destination),
//   - a promo code (WAVE-XXXXXX, redeemable on lead forms / redeem endpoint).
// Scans are anonymous events (BundleScan); attribution credit flows through
// AttributionTouch rows carrying the bundle's campaign name, so first/last/
// linear models credit them with zero model changes.
// ---------------------------------------------------------------------------

model AttributionBundle {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name           String
  // Campaign key stamped on every touch this bundle generates. This is what
  // the attribution dashboard groups by — keep it stable per campaign.
  campaignName   String  @map("campaign_name")
  destinationUrl String  @map("destination_url")
  // Public redirect slug: /r/<vanitySlug>. Globally unique (not just
  // per-workspace): the public route resolves the slug with no workspace
  // key, so two workspaces sharing a slug would make /r/<slug> ambiguous.
  // The slug is the capability.
  vanitySlug     String  @unique @map("vanity_slug")
  utmSource      String  @default("physical") @map("utm_source")
  utmMedium      String  @default("qr") @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")
  // Globally unique promo code (e.g. WAVE-7K2QX9). The code is the capability.
  promoCode      String  @unique @map("promo_code")

  // Tracking number provisioned at bundle creation (R5 provider layer).
  numberId String?     @map("number_id")
  number   CallNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)

  status  String @default("active") // active | disabled
  // QR render preset index; "regenerate" cycles it (QR content is the vanity
  // URL, so regeneration is a style change, not a content change).
  qrStyle Int    @default(0) @map("qr_style")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scans       BundleScan[]
  redemptions BundleRedemption[]

  @@index([workspaceId, status])
  @@map("attribution_bundle")
}

// One deduped vanity-URL scan: (bundle, ip-hash, UTC day). Anonymous by
// design — no lead exists at scan time. Identified scans (a ?lead= param
// matching a workspace lead) additionally log an AttributionTouch.
model BundleScan {
  id       String            @id @default(cuid())
  bundleId String            @map("bundle_id")
  bundle   AttributionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  ipHash String @map("ip_hash")
  day    String // yyyy-mm-dd (UTC)

  userAgent String? @map("user_agent") @db.VarChar(512)
  referer   String? @db.VarChar(1024)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bundleId, ipHash, day])
  @@index([bundleId, day])
  @@map("bundle_scan")
}

// A promo-code redemption tied to one lead. Unique per (bundle, lead) so a
// re-submitted code doesn't double-count the response.
model BundleRedemption {
  id       String            @id @default(cuid())
  bundleId String            @map("bundle_id")
  bundle   AttributionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  leadId   String            @map("lead_id")
  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  code String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bundleId, leadId])
  @@index([bundleId])
  @@map("bundle_redemption")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — acquisition loop (R3 nurture, R4 review engine, R6 prospecting).
// All tables are workspace-scoped. Channel values: "sms" | "email" | "voice".
// ─────────────────────────────────────────────────────────────────────────────

// R3: per-contact per-channel consent state machine (TCPA / CAN-SPAM).
// status: "unknown" | "pending" | "opted_in" | "opted_out".
// source: "form" | "import" | "manual" | "api" | "booking" | "inbound_sms".
model ContactConsent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String    @map("lead_id")
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel     String
  status      String    @default("unknown")
  source      String?
  consentedAt DateTime? @map("consented_at")
  optedOutAt  DateTime? @map("opted_out_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, leadId, channel])
  @@index([workspaceId, channel, status])
  @@map("contact_consent")
}

// R3: the send ledger — every outbound (and inbound) customer message.
// kind: "sequence" | "speed_to_lead" | "missed_call_textback" |
//       "review_request" | "broadcast" | "manual".
// status: "queued" | "sent" | "delivered" | "failed" | "suppressed".
// suppressionReason: "opt_out" | "no_consent" | "quiet_hours" | "cap" |
//                    "invalid_contact" | "duplicate".
// provider: "fake" | "twilio" | "resend".
model OutboundMessage {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId            String?   @map("lead_id")
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  channel           String
  direction         String    @default("outbound")
  kind              String
  subject           String?
  body              String
  status            String    @default("queued")
  suppressionReason String?   @map("suppression_reason")
  provider          String    @default("fake")
  providerSid       String?   @map("provider_sid")
  scheduledFor      DateTime? @map("scheduled_for")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  // When a dispatcher claimed the row (queued → sending). A "sending" row
  // older than the stale window is recovered by dispatchDue.
  claimedAt         DateTime? @map("claimed_at")
  error             String?
  costCents         Int       @default(0) @map("cost_cents")
  // ApprovalItem id that authorized this send (C3 ladder).
  approvalId        String?   @map("approval_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, leadId, createdAt])
  @@index([workspaceId, status, scheduledFor])
  @@map("outbound_message")
}

// R3/C3: human approval queue for outbound sends and AI-drafted copy.
// kind: "sequence_send" | "review_response" | "broadcast" | "prospect_export".
// status: "pending" | "approved" | "rejected" | "expired".
model ApprovalItem {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String
  // Payload awaiting approval: rendered message, target lead, channel…
  payload     Json
  status      String    @default("pending")
  requestedBy String?   @map("requested_by")
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, status, createdAt])
  @@map("approval_item")
}

// R3: nurture sequences. steps: [{ channel, delayMinutes, template, subject? }].
// status: "draft" | "active" | "paused" | "archived".
// approvalPolicy: "manual" — Phase 3 ships manual-only (every send approved).
model NurtureSequence {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  steps          Json      @default("[]")
  status         String    @default("draft")
  approvalPolicy String    @default("manual") @map("approval_policy")
  dailyCap       Int?      @map("daily_cap")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  enrollments SequenceEnrollment[]

  @@index([workspaceId, status])
  @@map("nurture_sequence")
}

// R3: lead enrollment in a sequence.
// status: "active" | "paused" | "completed" | "unenrolled" | "bounced".
model SequenceEnrollment {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequenceId  String          @map("sequence_id")
  sequence    NurtureSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId      String          @map("lead_id")
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String          @default("active")
  currentStep Int             @default(0) @map("current_step")
  nextRunAt   DateTime?       @map("next_run_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([sequenceId, leadId])
  @@index([workspaceId, status, nextRunAt])
  @@map("sequence_enrollment")
}

// R4: review requests. token powers the public QR landing page /r/review/<token>.
// status: "sent" | "viewed" | "completed" | "expired".
model ReviewRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String    @map("lead_id")
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token       String    @unique
  channel     String
  status      String    @default("sent")
  reviewUrl   String?   @map("review_url")
  messageId   String?   @map("message_id")
  sentAt      DateTime  @default(now()) @map("sent_at")
  viewedAt    DateTime? @map("viewed_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([workspaceId, status])
  @@map("review_request")
}

// R4: per-workspace review-site configuration. site: "google" | "facebook" |
// "yelp" | "custom".
model ReviewSiteConfig {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        String    @default("google")
  reviewUrl   String    @map("review_url")
  delayDays   Int       @default(1) @map("delay_days")
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, site])
  @@map("review_site_config")
}

// R6: prospect lists with ICP definition.
// icp: { industries[], employeeRange, geo, techSignals[], titles[] }.
// status: "draft" | "building" | "ready" | "archived".
model ProspectList {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  icp         Json      @default("{}")
  status      String    @default("draft")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  prospects Prospect[]

  @@index([workspaceId, status])
  @@map("prospect_list")
}

// R6: enriched prospects. status: "new" | "enriching" | "enriched" | "failed" |
// "in_sequence" | "converted". research: AI icebreakers/first lines/summary.
model Prospect {
  id             String       @id @default(cuid())
  workspaceId    String       @map("workspace_id")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listId         String       @map("list_id")
  list           ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade)
  company        String?
  name           String?
  email          String?
  phone          String?
  title          String?
  website        String?
  enrichmentData Json?        @map("enrichment_data")
  research       Json?
  status         String       @default("new")
  score          Int          @default(0)
  leadId         String?      @map("lead_id")
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dedupKey       String?      @map("dedup_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  lookups EnrichmentLookup[]

  @@unique([workspaceId, dedupKey])
  @@index([listId, status])
  @@map("prospect")
}

// R6: waterfall lookup audit trail + cost accounting.
model EnrichmentLookup {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospectId  String    @map("prospect_id")
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  provider    String
  // "hit" | "miss" | "error" | "skipped"
  status      String
  costCents   Int       @default(0) @map("cost_cents")
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([prospectId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("enrichment_lookup")
}

// ─── Phase 4: direct mail ────────────────────────────────────────────────

// T1: workspace mail-provider connections. Keys stored as AES-256-GCM
// envelopes (lib/secrets) — never returned to clients, never logged.
// provider: "lob" | "postgrid" | "fake". mode: "test" | "live".
// Live mode is visually fenced in UI and requires per-campaign approval.
model MailProvider {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider         String
  mode             String    @default("test")
  testKeyEnc       String?   @map("test_key_enc") @db.Text
  liveKeyEnc       String?   @map("live_key_enc") @db.Text
  webhookSecretEnc String?   @map("webhook_secret_enc") @db.Text
  // "healthy" | "degraded" | "unconfigured" | "error"
  health           String    @default("unconfigured")
  healthCheckedAt  DateTime? @map("health_checked_at")
  healthMessage    String?   @map("health_message")

  campaigns MailCampaign[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, provider])
  @@index([workspaceId, mode])
  @@map("mail_provider")
}

// T2: Creative Studio creatives. The studio is the central home for ALL
// creative/design work; channelTemplate ("print" | "email" | "social") keeps
// the door open for non-print templates later without rework.
// formatTrack: "addressed" (4x6 postcard, #10 letter) | "eddm" (flats only,
// min 6.125"x11.5" — 4x6 MUST be rejected for eddm at validation).
// status: "draft" | "ready" | "archived".
model MailCreative {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name            String
  channelTemplate String  @default("print") @map("channel_template")
  formatTrack     String  @map("format_track")
  size            String
  // "upload"
  source          String  @default("upload")
  pdfUrl          String? @map("pdf_url")
  // SHA-256 of the canonical PDF bytes; bound to approvals.
  creativeHash    String? @map("creative_hash")
  version         Int     @default(1)
  status          String  @default("draft")
  // Format validation report (dimensions, pages, bleed notes).
  validation      Json?

  campaigns MailCampaign[]

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, formatTrack, status])
  @@index([workspaceId, channelTemplate])
  @@map("mail_creative")
}

// Phase 11: native design editor ("Canvas"). One design = one multi-page
// canvas document stored as JSON (pages → elements). Workspace-scoped;
// the editor never auto-publishes — exports are human-downloaded.
model Design {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  // Design document: { version, pages: [{ id, width, height, background,
  // elements: [{ id, type: text|image|shape|group, ... }] }] }
  document    Json      @default("{}")
  // PNG data-URL thumbnail for the designs list (regenerated on save).
  thumbnail   String?   @db.Text
  // Template key this design was started from, if any (see lib/design/templates).
  templateKey String?   @map("template_key")
  // Brand kit applied — client colors/fonts feed text presets and swatches.
  brandKitId  String?   @map("brand_kit_id")
  brandKit    BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  // Feature 6: approval workflow. draft | in_review | approved | changes_requested.
  approvalStatus String  @default("draft") @map("approval_status")
  approvalNote   String? @map("approval_note")

  // Feature 6: collaboration back-relations.
  shares   DesignShare[]
  comments DesignComment[]

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@map("designs")
}

// Phase 12 (embeds): rrweb replay sessions for opt-in public share links.
// Events are the rrweb `eventWithTime` payloads, stored as a JSON array.
// Tenant-scoped via workspaceId; the public share token hash is the only
// lookup key from the outside (no oracle — see lib/integrations/replay.ts).
model DesignReplaySession {
  id          String      @id @default(cuid())
  shareId     String      @map("share_id")
  share       DesignShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  designId    String      @map("design_id")

  events    Json      @default("[]")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([shareId, startedAt])
  @@index([workspaceId])
  @@map("design_replay_sessions")
}

// Phase 12 (embeds): Documenso API-only signing requests. Marketr creates
// the document + signers and tracks status via the Documenso v1 API against
// an unmodified CE instance. NO embedded signing UI (Enterprise feature —
// see the Documenso license row in docs/phase12/integration-survey.md).
model SigningRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title               String
  templateName        String? @map("template_name")
  documensoDocumentId String? @map("documenso_document_id")
  // draft | pending (sent, awaiting signatures) | completed | declined | ...
  status              String  @default("draft") @map("status")
  signers             Json    @default("[]") @map("signers")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@map("signing_requests")
}

// Wave 2 quick wins — E-sign module (SPEC-GAP-ESIGN.md).
// First-class envelope ontology on top of the Phase 12 Documenso API-only
// integration (lib/integrations/documenso.ts). The vendor seals the PDF; we
// mirror the evidence. Nothing is ever "signed" here without the vendor's
// sealed artifact + completion event.
model EsignEnvelope {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title        String
  // draft | sent | partially-signed | completed | declined | expired | voided | error
  status       String @default("draft") @map("status")
  // sequential | parallel
  signingOrder String @default("sequential") @map("signing_order")

  // Vendor identity. vendor = "documenso" in v1 (adapter interface leaves
  // room for the DocuSign reserve rail behind the same shape).
  vendor       String  @default("documenso") @map("vendor")
  vendorRef    String? @map("vendor_ref")
  vendorStatus String? @map("vendor_status")

  // Source document metadata (bytes live transiently; the vendor holds them).
  documentName  String? @map("document_name")
  documentSize  Int?    @map("document_size")
  // The exact bytes the approver reviews; the send confirmation token binds
  // to their hash so a changed draft can never be sent on a stale approval.
  sourcePdf     Bytes?  @map("source_pdf")
  sourcePdfHash String? @map("source_pdf_hash")

  // Sealed PDF mirror, fetched ONLY on the vendor's completion event.
  sealedPdf          Bytes?    @map("sealed_pdf")
  sealedPdfHash      String?   @map("sealed_pdf_hash")
  sealedPdfFetchedAt DateTime? @map("sealed_pdf_fetched_at")

  // Links into not-yet-built modules: legal/compliance contract object,
  // proposal / invoice pipeline rows. Generic refs, no FKs — those modules
  // resolve them when they land.
  contractType String? @map("contract_type")
  contractRef  String? @map("contract_ref")
  pipelineRef  Json?   @map("pipeline_ref")

  templateId String?        @map("template_id")
  template   EsignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  expiresAt  DateTime? @map("expires_at")
  voidReason String?   @map("void_reason")

  signers    EsignSigner[]
  fields     EsignField[]
  events     EsignAuditEvent[]
  vaultEntry EsignVaultEntry?

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([vendorRef])
  @@map("esign_envelopes")
}

model EsignSigner {
  id         String        @id @default(cuid())
  envelopeId String        @map("envelope_id")
  envelope   EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  name             String
  email            String
  // signer | approver | cc
  role             String    @default("signer") @map("role")
  orderIndex       Int       @default(0) @map("order_index")
  // pending | viewed | signed | declined
  status           String    @default("pending") @map("status")
  signedAt         DateTime? @map("signed_at")
  // IP/device snapshot + identity evidence from the vendor. Email + access
  // code in v1; IDV method when the reserve rail lands.
  identityEvidence Json?     @map("identity_evidence")

  @@index([envelopeId, orderIndex])
  @@map("esign_signers")
}

model EsignField {
  id         String        @id @default(cuid())
  envelopeId String        @map("envelope_id")
  envelope   EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  signerId  String? @map("signer_id")
  // signature | initials | date | text | checkbox
  fieldType String  @map("field_type")
  page      Int     @default(1) @map("page")
  x         Float   @default(0) @map("x")
  y         Float   @default(0) @map("y")
  width     Float   @default(150) @map("width")
  height    Float   @default(40) @map("height")
  required  Boolean @default(true) @map("required")
  value     String? @map("value")

  @@index([envelopeId])
  @@map("esign_fields")
}

model EsignTemplate {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name               String
  // Source document for the blueprint (stored asset ref / uploaded name).
  sourceDocumentName String? @map("source_document_name")
  // Blueprint PDF bytes — instantiateTemplate mints drafts from these exact
  // bytes so the template's document can never drift from what was approved.
  sourceDocument     Bytes?  @map("source_document")
  sourceDocumentHash String? @map("source_document_hash")
  sourceDocumentSize Int?    @map("source_document_size")
  // Field layout: [{ fieldType, page, x, y, width, height, required, signerRole }]
  fieldLayout        Json    @default("[]") @map("field_layout")
  // Signer roles: [{ role, orderIndex, required }]
  signerRoles        Json    @default("[]") @map("signer_roles")
  // Merge-field mapping: { "{{client.name}}": "crm.contact.name", ... }
  mergeFieldMapping  Json    @default("{}") @map("merge_field_mapping")
  // Template bound to a contract type (e.g. MSA template → MSA contract
  // object in the legal/compliance module, which arrives next phase).
  contractType       String? @map("contract_type")

  envelopes   EsignEnvelope[]
  ownerUserId String?         @map("owner_user_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@map("esign_templates")
}

// Hash-chained, vendor-verified evidence log. One row per governed action +
// one row per ingested vendor webhook event (dedupe via bodyHash — identical
// deliveries are no-ops, never double-applied).
model EsignAuditEvent {
  id         String        @id @default(cuid())
  envelopeId String        @map("envelope_id")
  envelope   EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  // created | sent | viewed | signed | completed | declined | expired |
  // voided | sealed_pdf_fetched | webhook_ignored
  event        String  @map("event")
  actor        String  @default("system") @map("actor")
  // SHA-256 of the canonical event payload; chains to the previous event's
  // hash (hash-chained evidence log per SPEC-GAP-ESIGN.md §4.4).
  hash         String  @map("hash")
  previousHash String? @map("previous_hash")
  // Idempotency: SHA-256 of the raw webhook body (or of the canonical
  // governed-action payload). Unique — replays are no-ops.
  bodyHash     String  @unique @map("body_hash")
  payload      Json?   @map("payload")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([envelopeId, createdAt])
  @@map("esign_audit_events")
}

// Wave 2 E-sign module: the legal vault. A vault entry anchors a completed
// envelope's sealed artifact: the sealed PDF hash + the audit chain's head
// hash are captured at vault time, so any later tampering is detectable.
// Retention policy lives here; a legal hold blocks purging.

model EsignVaultEntry {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  envelopeId  String        @unique @map("envelope_id")
  envelope    EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  sealedPdfHash String   @map("sealed_pdf_hash")
  auditHeadHash String   @map("audit_head_hash")
  eventCount    Int      @map("event_count")
  signerCount   Int      @map("signer_count")
  storedAt      DateTime @default(now()) @map("stored_at")

  retentionUntil  DateTime? @map("retention_until")
  legalHold       Boolean   @default(false) @map("legal_hold")
  legalHoldReason String?   @map("legal_hold_reason")
  purgedAt        DateTime? @map("purged_at")

  @@index([workspaceId, storedAt])
  @@map("esign_vault_entries")
}

// Phase 12 (Worker 1): GrapesJS page drafts — responsive landing pages and
// email templates. Complementary to the Konva Canvas editor (Canvas = PNG/SVG
// assets; GrapesJS = HTML documents). html/css/components all snapshot the
// editor state; the freshest authoritative copy is components (project data).
model PageDraft {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  // landing | email
  kind        String  @default("landing") @map("kind")
  // Seed template key this draft was started from, if any (see
  // lib/grapes/templates).
  templateKey String? @map("template_key")
  // Exported HTML/CSS snapshot for download + copy.
  html        String? @map("html") @db.Text
  css         String? @map("css") @db.Text
  // GrapesJS project data (editor.getProjectData()) — reloads the canvas exactly.
  components  Json?   @map("components")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@map("page_drafts")
}

// Phase 11 (Feature 6): public share links for designs. Only the SHA-256 of
// the token is stored — the raw token is shown once at creation and is never
// persisted. Lookup is by token hash; unknown / revoked / expired all 404
// identically (no oracle).
model DesignShare {
  id          String    @id @default(cuid())
  designId    String    @map("design_id")
  design      Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // SHA-256 hex of the share token. Never the raw token.
  tokenHash String    @map("token_hash")
  createdBy String?   @map("created_by")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Phase 12 (embeds): rrweb session replay opt-in for this share link.
  // Off by default — the workspace explicitly enables it per link.
  replayOptIn Boolean @default(false) @map("replay_opt_in")

  replaySessions DesignReplaySession[]

  @@unique([tokenHash])
  @@index([designId])
  @@map("design_shares")
}

// Phase 11 (Feature 6): team comments on a design. Comments are workspace-
// internal (require login); the public share page renders them read-only.
// elementId + x/y optionally pin a comment to an element / a canvas position.
model DesignComment {
  id          String    @id @default(cuid())
  designId    String    @map("design_id")
  design      Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  authorName  String    @map("author_name")
  authorEmail String?   @map("author_email")
  body        String    @db.Text
  elementId   String?   @map("element_id")
  x           Float?
  y           Float?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([designId, createdAt])
  @@map("design_comments")
}

// T1: a mail campaign. Approval binds creativeHash + pieceCount + maxSpend.
model MailCampaign {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name             String
  providerId       String?       @map("provider_id")
  provider         MailProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  creativeId       String?       @map("creative_id")
  creative         MailCreative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  // { kind: "crm_segment" | "prospect_list" | "csv", ref: string }
  audienceSource   Json          @map("audience_source")
  pieceCount       Int           @default(0) @map("piece_count")
  verifiedCount    Int           @default(0) @map("verified_count")
  quarantinedCount Int           @default(0) @map("quarantined_count")
  estCostCents     Int           @default(0) @map("est_cost_cents")
  actualCostCents  Int?          @map("actual_cost_cents")
  // "draft" | "verifying" | "pending_approval" | "approved" | "sending" |
  // "complete" | "cancelled" | "failed"
  status           String        @default("draft")
  // In-home window target (date-based; physical mail has days of latency).
  inHomeStart      DateTime?     @map("in_home_start")
  inHomeEnd        DateTime?     @map("in_home_end")
  mailedAt         DateTime?     @map("mailed_at")

  pieces    MailPiece[]
  approvals MailApproval[]

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@map("mail_campaign")
}

// T1: one addressed piece. qrSlug reuses the Phase 2 physical-attribution
// kit (bundle-style slugs). verificationStatus: "pending" | "valid" |
// "corrected" | "quarantined".
model MailPiece {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId             String?   @map("lead_id")
  addressSnapshot    Json      @map("address_snapshot")
  verificationStatus String    @default("pending") @map("verification_status")
  providerPieceId    String?   @map("provider_piece_id")
  qrSlug             String?   @map("qr_slug")
  // "queued" | "sent" | "in_transit" | "delivered" | "returned" | "failed" | "suppressed"
  status             String    @default("queued")
  suppressionReason  String?   @map("suppression_reason")
  costCents          Int?      @map("cost_cents")
  sentAt             DateTime? @map("sent_at")
  deliveredAt        DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([qrSlug])
  @@index([campaignId, status])
  @@map("mail_piece")
}

// T1: raw provider webhook events. eventId is the idempotency key —
// duplicate/out-of-order deliveries collapse to one ledger entry.
model MailWebhookEvent {
  id          String     @id @default(cuid())
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  provider    String
  eventId     String     @map("event_id")
  eventType   String     @map("event_type")
  payload     Json
  processedAt DateTime?  @map("processed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, processedAt])
  @@index([workspaceId])
  @@map("mail_webhook_event")
}

// T1: C3 approval binding — creative hash + piece count + max spend.
// status: "pending" | "approved" | "rejected" | "expired".
model MailApproval {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creativeHash  String    @map("creative_hash")
  pieceCount    Int       @map("piece_count")
  maxSpendCents Int       @map("max_spend_cents")
  status        String    @default("pending")
  approverId    String?   @map("approver_id")
  decidedAt     DateTime? @map("decided_at")
  note          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([campaignId, status])
  @@map("mail_approval")
}

// T3: EDDM concierge orders. No API send — human/mailhouse executes;
// Marketr plans, briefs, tracks, and attributes.
model EddmOrder {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  zips         Json
  // [{ zip, routeId, households, selected }]
  routes       Json      @default("[]")
  pieceCount   Int       @default(0) @map("piece_count")
  creativeId   String?   @map("creative_id")
  mailhouse    String?
  briefPdfUrl  String?   @map("brief_pdf_url")
  // "draft" | "briefed" | "at_mailhouse" | "dropped" | "complete" | "cancelled"
  status       String    @default("draft")
  costCents    Int       @default(0) @map("cost_cents")
  postageCents Int       @default(0) @map("postage_cents")
  printCents   Int       @default(0) @map("print_cents")
  dropDate     DateTime? @map("drop_date")
  inHomeStart  DateTime? @map("in_home_start")
  inHomeEnd    DateTime? @map("in_home_end")
  qrSlug       String?   @map("qr_slug")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([qrSlug])
  @@index([workspaceId, status])
  @@map("eddm_order")
}

// ===========================================================================
// Phase 5: Media Buying v1 (S1–S4 safety + B1–B3 buying paths + A1 attribution)
//
// Merged from prisma/fragments/phase5-{safety,buying,attribution}.prisma.
//
// KNOWN MERGE DECISION (MediaReceipt): the buying and attribution fragments
// each declared a MediaReceipt with complementary fields. Merged here into
// ONE model with the union of fields. approvalRef is REQUIRED — every
// receipt traces to a safety-track approval (zero-custody invariant).
// @@unique([workspaceId, buyId, platformInvoiceRef]): platformInvoiceRef is
// nullable; Postgres/Prisma treat NULLs as distinct, so human-upload receipts
// without an invoice ref do not collide with each other.
//
// CONVENTIONS: cuid() ids, @map snake_case columns, @@map table names,
// workspace isolation on every table, onDelete: Cascade on workspace
// relations. Enum names have no @@map, so Postgres enum types are the
// PascalCase schema names — the raw-SQL stores in lib/media/db.ts cast to
// these quoted PascalCase names.
// ===========================================================================

enum MediaApprovalStatus {
  draft
  pending
  approved
  executed
  expired
  revoked
}

enum MediaApprovalType {
  buy
  io_brief
  pool_draw
}

enum MediaApprovalMethod {
  none
  sso
  otp
  signed_link
}

enum MediaApprovalEventAction {
  created
  submitted
  approved
  approval_rejected
  revoked
  expired
  requeued
  executed
  execution_halted
  encumbered
  encumbrance_released
  spent
  kill_rule_fired
  circuit_breaker_tripped
  emergency_stop
  quote_refreshed
}

enum BudgetPoolPeriod {
  monthly
  campaign
  one_time
}

enum BudgetPoolStatus {
  active
  frozen
  exhausted
}

enum PoolTransactionKind {
  encumber
  spend
  release
  adjust
}

enum MediaBuyStatus {
  draft
  executing
  executed
  failed
  paused
}

enum KillRuleAction {
  pause
  reduce_budget
  alert
}

enum CardProvider {
  brex
  ramp
  fake
}

enum MediaAuditAction {
  pool_created
  pool_frozen
  pool_unfrozen
  virtual_card_issued
  virtual_card_attached
  kill_rule_created
  kill_rule_toggled
  kill_rule_pack_seeded
  emergency_stop
  buy_executed
  buy_execution_halted
}

// Workspace-scoped append-only audit for money-adjacent safety mutations
// that belong to no single approval: pool create/freeze/unfreeze, virtual
// card issue/attach, kill-rule create/toggle/seed, emergency stop, buy
// execution. Hash-chained per workspace (tamper-evident); complements
// media_approval_events (approval-scoped) and pool_transactions
// (pool-ledger-scoped).
model MediaAuditEvent {
  id          String           @id @default(cuid()) @map("id")
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts          DateTime         @default(now()) @map("ts")
  actor       String           @map("actor")
  action      MediaAuditAction @map("action")
  subjectType String           @map("subject_type") // "pool" | "kill_rule" | "approval" | "workspace"
  subjectId   String?          @map("subject_id")
  payloadHash String           @map("payload_hash")
  prevHash    String           @map("prev_hash")
  eventHash   String           @map("event_hash")
  detail      Json?            @map("detail")

  @@index([workspaceId, ts])
  @@index([workspaceId, action])
  @@map("media_audit_events")
}

// Per-buy binding approval (S3). binding_json is IMMUTABLE once approved —
// any change invalidates binding_hash and the executor HALTs (TOCTOU kill).
model MediaApproval {
  id                 String              @id @default(cuid()) @map("id")
  workspaceId        String              @map("workspace_id")
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId           String?             @map("client_id")
  type               MediaApprovalType   @map("type")
  status             MediaApprovalStatus @default(draft) @map("status")
  bindingJson        Json                @map("binding_json")
  bindingHash        String              @map("binding_hash")
  maxSpendCents      Int                 @map("max_spend_cents")
  currency           String              @default("USD") @map("currency")
  poolId             String?             @map("pool_id")
  quoteId            String?             @map("quote_id")
  quoteExpiresAt     DateTime?           @map("quote_expires_at")
  driftToleranceJson Json                @default("{\"pricePct\": 10, \"spendPct\": 5}") @map("drift_tolerance_json")
  createdBy          String              @map("created_by")
  approversJson      Json                @default("[]") @map("approvers_json")
  twoPersonSatisfied Boolean             @default(false) @map("two_person_satisfied")
  approvalMethod     MediaApprovalMethod @default(none) @map("approval_method")
  // HMAC(approval_secret, approvalId || bindingHash || approver || decidedAt):
  // the cryptographically verified approval record (PubMatic AgenticOS pattern).
  approvalReceipt    String?             @map("approval_receipt")
  approvalsExpiresAt DateTime?           @map("approvals_expires_at")
  approvedAt         DateTime?           @map("approved_at")
  revokedAt          DateTime?           @map("revoked_at")
  revokedBy          String?             @map("revoked_by")
  executedAt         DateTime?           @map("executed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  events MediaApprovalEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@map("media_approvals")
}

// Append-only, hash-chained event log (IAB event-bus pattern).
// event_hash = sha256(prev_hash || canonical(ts, approval_id, actor, action, payload_hash)).
model MediaApprovalEvent {
  id          String                   @id @default(cuid()) @map("id")
  approvalId  String                   @map("approval_id")
  workspaceId String                   @map("workspace_id")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts          DateTime                 @default(now()) @map("ts")
  actor       String                   @map("actor")
  action      MediaApprovalEventAction @map("action")
  payloadHash String                   @map("payload_hash")
  prevHash    String                   @map("prev_hash")
  eventHash   String                   @map("event_hash")
  detail      Json?                    @map("detail")

  approval MediaApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId, ts])
  @@index([workspaceId, ts])
  @@map("media_approval_events")
}

// Non-custodial budget pool (S2): a cap with a ledger. The money itself
// NEVER passes through Marketr — spend flows from the client's own
// accounts/cards. remaining = cap - spent; encumbered = reserved by
// approved-but-unexecuted buys. Over-encumbrance is rejected by the
// service layer (conditional UPDATE on remaining_cents >= amount).
model BudgetPool {
  id                        String           @id @default(cuid()) @map("id")
  workspaceId               String           @map("workspace_id")
  workspace                 Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId                  String           @map("client_id")
  name                      String           @map("name")
  period                    BudgetPoolPeriod @map("period")
  capCents                  Int              @map("cap_cents")
  remainingCents            Int              @map("remaining_cents")
  encumberedCents           Int              @default(0) @map("encumbered_cents")
  currency                  String           @default("USD") @map("currency")
  platformAllowlist         String[]         @map("platform_allowlist")
  autoApproveThresholdCents Int              @default(0) @map("auto_approve_threshold_cents")
  alertThresholdsJson       Json             @default("[50, 75, 90]") @map("alert_thresholds_json")
  // Client's OWN virtual card ref only. Never a PAN, never key material.
  virtualCardRef            String?          @map("virtual_card_ref")
  cardProvider              CardProvider     @default(fake) @map("card_provider")
  status                    BudgetPoolStatus @default(active) @map("status")
  createdBy                 String           @map("created_by")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@map("budget_pools")
}

// Append-only pool ledger. Every encumber/spend/release/adjust writes a row
// with running balances so the ledger is independently auditable.
model PoolTransaction {
  id                     String              @id @default(cuid()) @map("id")
  poolId                 String              @map("pool_id")
  workspaceId            String              @map("workspace_id")
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalId             String?             @map("approval_id")
  kind                   PoolTransactionKind @map("kind")
  amountCents            Int                 @map("amount_cents")
  runningRemainingCents  Int                 @map("running_remaining_cents")
  runningEncumberedCents Int                 @map("running_encumbered_cents")
  actor                  String              @map("actor")
  ts                     DateTime            @default(now()) @map("ts")
  note                   String?             @map("note")

  @@index([poolId, ts])
  @@index([workspaceId, ts])
  @@map("pool_transactions")
}

// Executed buy record. Created only by the executor after pre-flight passes.
model MediaBuy {
  id                  String         @id @default(cuid()) @map("id")
  workspaceId         String         @map("workspace_id")
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalId          String         @unique @map("approval_id")
  poolId              String         @map("pool_id")
  platform            String         @map("platform")
  clientAdAccountId   String         @map("client_ad_account_id")
  status              MediaBuyStatus @default(draft) @map("status")
  platformCampaignRef String?        @map("platform_campaign_ref")
  receiptUrl          String?        @map("receipt_url")
  executedAt          DateTime?      @map("executed_at")
  actualSpendCents    Int?           @map("actual_spend_cents")
  failureCount        Int            @default(0) @map("failure_count")
  killRulesRegistered Json           @default("[]") @map("kill_rules_registered")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([poolId])
  @@map("media_buys")
}

// Sweeper rule (S4). Every sweeper action is logged to the approval's event
// log tracing back to the human who created the rule (Birch pattern).
model KillRule {
  id              String         @id @default(cuid()) @map("id")
  workspaceId     String         @map("workspace_id")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId        String?        @map("client_id")
  name            String         @map("name")
  scopeJson       Json           @default("{}") @map("scope_json")
  conditionJson   Json           @map("condition_json")
  window          String         @default("1h") @map("window")
  action          KillRuleAction @map("action")
  cooldownMinutes Int            @default(60) @map("cooldown_minutes")
  enabled         Boolean        @default(true) @map("enabled")
  createdBy       String         @map("created_by")
  lastFiredAt     DateTime?      @map("last_fired_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, enabled])
  @@index([workspaceId, clientId])
  @@map("kill_rules")
}

// ---------------------------------------------------------------------------
// Phase 5 B1/B2/B3: buying paths
// ---------------------------------------------------------------------------

// B1: DOOH plan (planner output). An approved plan compiles to a launch
// packet (launch_packet_url). Status: draft → planned → packet_ready →
// launched (client-account execution) | cancelled.
model DoohPlan {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional back-link to the safety track's media_buys row (the approval
  // binding lives there, not here).
  buyId String? @map("buy_id")

  name           String
  vendor         String @map("vendor") // "blip" | "blindspot" | "adomni" | "fake"
  // { markets: [{ city, state, radius_mi }], placements: [{ boardId, name,
  //   city, state, lat?, lng?, formats: [wIn x hIn] }], dayparts: [{ name,
  //   hours: [start,end], weight }], flightStart, flightEnd }
  placementsJson Json   @map("placements_json")
  // Estimate provenance: { basis: "documented_estimate", vendor,
  //   lineItems: [{ label, units, unitCents, totalCents }], notes }
  estimateJson   Json   @map("estimate_json")
  estimateCents  Int    @map("estimate_cents")
  currency       String @default("USD")

  // Creative Studio references (id + sha256). DOOH sizes are validated by
  // the planner against DOOH_SIZE_SPECS in lib/media/dooh.ts.
  creativeIds    String[] @map("creative_ids")
  creativeHashes String[] @map("creative_hashes")

  // Per-placement tracking assignments (placement_ref → link slug),
  // coordinated with the attribution track's /api/media/links shape.
  trackingAssignments Json? @map("tracking_assignments")

  launchPacketUrl String? @map("launch_packet_url")
  status          String  @default("draft") @map("status")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  packets LaunchPacket[]

  @@index([workspaceId, vendor, status])
  @@map("dooh_plans")
}

// Launch packet: the durable execution artifact for an approved DOOH buy.
// One packet per plan revision; the packet_sha256 covers the rendered PDF
// bytes so the executor can prove the packet hasn't drifted since approval.
model LaunchPacket {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  planId String   @map("plan_id")
  plan   DoohPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Approval binding this packet was compiled from (safety track object).
  approvalId   String @map("approval_id")
  bindingHash  String @map("binding_hash")
  packetSha256 String @map("packet_sha256")
  pdfUrl       String @map("pdf_url")
  version      Int    @default(1)

  generatedBy String?  @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([workspaceId, planId])
  @@map("launch_packets")
}

// B2: streaming-audio buy plan + generated brief (Spotify Ads Manager /
// Acast / AudioGo). Execution is self-serve in the client's own account.
model AudioBuy {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  buyId String? @map("buy_id")

  name         String
  vendor       String // "spotify" | "acast" | "audiogo" | "fake"
  // { markets, stations: [{ name, type: streaming|podcast, dayparts }],
  //   spotMix: [{ lengthSec, count, label }], flightStart, flightEnd }
  stationsJson Json   @map("stations_json")
  // { spotLengthSec, spotCount, dailyBudgetCents, lifetimeCents,
  //   productionCents, basis: "documented_estimate" }
  budgetJson   Json   @map("budget_json")
  budgetCents  Int    @map("budget_cents")
  currency     String @default("USD")

  creativeIds    String[] @map("creative_ids")
  creativeHashes String[] @map("creative_hashes")

  // Per-station promo codes / vanity URLs assigned at brief time.
  trackingAssignments Json? @map("tracking_assignments")

  briefUrl String? @map("brief_url")
  status   String  @default("draft") @map("status") // draft → briefed → launched | cancelled

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, vendor, status])
  @@map("audio_buys")
}

// B3: IO brief (IAB/AAAA template) for rep-driven radio / newspaper /
// magazine buys. The rep keeps the signature; Marketr plans, briefs,
// and captures proof-of-run.
model IoBrief {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  buyId String? @map("buy_id")

  name    String
  channel String // "radio" | "newspaper" | "magazine"

  // Station/publication selection: [{ name, market, callSign?, daypartMix?,
  //   placement }].
  inventoryJson Json   @map("inventory_json")
  // IAB/AAAA terms: { deliverables[], prices[], maximumSpendCents (THE
  // binding max), flightStart, flightEnd, thirdPartyAdServer, cancelTerms,
  //  paymentTerms, notes }.
  ioTermsJson   Json   @map("io_terms_json")
  maxSpendCents Int    @map("max_spend_cents")
  currency      String @default("USD")

  creativeIds    String[] @map("creative_ids")
  creativeHashes String[] @map("creative_hashes")

  // Rep contact: { name, email, phone, company, rateCardRef }.
  repContact      Json?     @map("rep_contact")
  // "draft" | "sent_to_rep" | "signed" | "proof_received" | "cancelled".
  signatureStatus String    @default("draft") @map("signature_status")
  signedAt        DateTime? @map("signed_at")
  proofOfRunUrl   String?   @map("proof_of_run_url")

  briefPdfUrl String? @map("brief_pdf_url")
  status      String  @default("draft") @map("status")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, channel, signatureStatus])
  @@map("io_briefs")
}

// Receipt capture — MERGED MODEL (buying ∪ attribution fragments).
// The browser-agent executor (or a human from the launch packet checklist)
// stores the operator receipt/invoice here. `verified` is set when the
// receipt's key terms were parsed back against the approved binding;
// `reconciled` + `varianceCents` are set by A1 reconciliation when the
// ledger is trued up against platform actuals.
// approvalRef is REQUIRED: every receipt traces to a safety-track approval
// (zero-custody invariant).
model MediaReceipt {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  buyId              String  @map("buy_id")
  // "browser_executor" | "human_upload".
  capturedBy         String  @map("captured_by")
  // Operator invoice/reference number, when parseable.
  platformInvoiceRef String? @map("platform_invoice_ref")
  amountCents        Int?    @map("amount_cents")
  currency           String  @default("USD")
  receiptUrl         String? @map("receipt_url")
  // Parsed order-confirmation terms from the DOM-verified screen (browser
  // executor) or the uploaded invoice (human).
  parsedTermsJson    Json?   @map("parsed_terms_json")
  verified           Boolean @default(false) @map("verified")
  reconciled         Boolean @default(false) @map("reconciled")
  varianceCents      Int?    @map("variance_cents")
  approvalRef        String  @map("approval_ref")

  capturedAt DateTime @default(now()) @map("captured_at")

  // platformInvoiceRef is nullable: NULLs are treated as distinct, so
  // human-upload receipts without an invoice ref never collide.
  @@unique([workspaceId, buyId, platformInvoiceRef])
  @@index([workspaceId, buyId])
  @@map("media_receipts")
}

// Buying-lifecycle audit trail (append-only). The safety track owns the
// hash-chained media_approval_events for the proposed → approved →
// executed transition; this table audits the buying track's own
// lifecycle: plan created, packet compiled, brief generated, signature
// moved, receipt recorded. Append-only by API surface (no UPDATE/DELETE
// exposure) — the approval-event chain is the legal record.
model MediaBuyingEvent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  actor       String  @map("actor")
  action      String  @map("action")
  entityType  String  @map("entity_type")
  entityId    String  @map("entity_id")
  payloadHash String? @map("payload_hash")
  detail      Json    @default("{}") @map("detail")

  ts DateTime @default(now()) @map("ts")

  @@index([workspaceId, entityId, ts])
  @@map("media_buying_events")
}

// ---------------------------------------------------------------------------
// Phase 5 A1: offline attribution
// ---------------------------------------------------------------------------

model TrackingLink {
  id             String    @id @default(cuid()) @map("id")
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  buyId          String?   @map("buy_id")
  placementRef   String    @map("placement_ref")
  slug           String    @map("slug")
  destinationUrl String    @map("destination_url")
  utmJson        Json      @default("{}") @map("utm_json")
  engine         String    @default("marketr") @map("engine") // marketr | dub
  status         String    @default("active") @map("status") // active | paused | archived
  scansCount     Int       @default(0) @map("scans_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  scanEvents ScanEvent[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, buyId])
  @@map("tracking_links")
}

model ScanEvent {
  id         String       @id @default(cuid()) @map("id")
  linkId     String       @map("link_id")
  link       TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  occurredAt DateTime     @default(now()) @map("occurred_at")
  userAgent  String?      @map("user_agent")
  ipHash     String?      @map("ip_hash") // sha256(ip + daily salt); never the raw IP
  referer    String?      @map("referer")

  @@index([linkId, occurredAt])
  @@map("scan_events")
}

model PromoCode {
  id               String    @id @default(cuid()) @map("id")
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  buyId            String?   @map("buy_id")
  code             String    @map("code")
  channelRef       String    @map("channel_ref")
  redemptionsCount Int       @default(0) @map("redemptions_count")
  maxRedemptions   Int?      @map("max_redemptions")
  status           String    @default("active") @map("status") // active | paused | expired
  createdAt        DateTime  @default(now()) @map("created_at")

  redemptions RedemptionEvent[]

  @@unique([workspaceId, code])
  @@index([workspaceId, buyId])
  @@map("promo_codes")
}

model RedemptionEvent {
  id          String    @id @default(cuid()) @map("id")
  promoCodeId String    @map("promo_code_id")
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  orderRef    String?   @map("order_ref")

  @@index([promoCodeId, occurredAt])
  @@map("redemption_events")
}

// A1 attribution call numbers. Named MediaCallNumber (not CallNumber)
// because Phase 2 R5 call tracking already owns model `CallNumber`
// (table `call_number`); that model serves DNI/booking flows, while this
// one serves per-station/per-publication offline attribution numbers.
model MediaCallNumber {
  id               String    @id @default(cuid()) @map("id")
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
