  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engine           String    @map("engine")
  promptSetVersion Int       @map("prompt_set_version")
  prompts          Json      @map("prompts")
  cadence          String    @default("weekly") @map("cadence")
