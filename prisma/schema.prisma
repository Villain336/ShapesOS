  count       Int
  posCount    Int      @default(0) @map("pos_count")
  neuCount    Int      @default(0) @map("neu_count")
  negCount    Int      @default(0) @map("neg_count")
  // [{ theme, count }] JSON from lib/local/sentiment.ts extractThemes().
  topThemes   Json     @default("[]") @map("top_themes")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, period, periodStart])
  @@map("review_summaries")
}

// Cost-accounting audit trail for metered local-SEO operations (milestone 16).
// Mirrors BacklinkPull (milestone 15).
model LocalPull {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // user | cron | system
  actor            String
  // geo_grid | competitor_refresh | reviews_ingest
  kind             String
  requestsMade     Int     @default(0) @map("requests_made")
  estimatedCostUsd Float   @map("estimated_cost_usd")
  actualCostUsd    Float?  @map("actual_cost_usd")
  // preview | completed | blocked_cap | failed
  status           String  @default("preview")
  note             String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@map("local_pulls")
}

// Programmatic SEO builder (milestone 17).
// Template: URL/title/description/content patterns with {{variables}} that
// get multiplied across dataset rows into individual pages.
model ProgrammaticTemplate {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                String
  // e.g. /services/{{city}}/{{service}} ({var} single-brace form also accepted)
  urlPattern          String @map("url_pattern")
  titleTemplate       String @map("title_template") @db.Text
  descriptionTemplate String @map("description_template") @db.Text
  // Tiptap JSON doc; leaf text may contain {{variables}}.
  contentBlocks       Json   @map("content_blocks")

  // Quality gates (enforced server-side on approve/publish).
  minWordCount         Int     @default(300) @map("min_word_count")
  // Max share of pages allowed to share an identical content hash (0-1).
  duplicateRateCap     Float   @default(0.05) @map("duplicate_rate_cap")
  // New pages start noindex until published.
  noindexUntilApproved Boolean @default(true) @map("noindex_until_approved")

  // Milestone 17 push: default publish target for this template's pages.
  // "none" | "csv" | "wordpress" | "webflow" | "marketr-site". Pages may
  // override this per-page (ProgrammaticPage.publishTarget).
  defaultPublishTarget       String  @default("none") @map("default_publish_target")
  // Site id for wordpress/webflow/marketr-site targets (nullable = unset).
  defaultTargetSiteId        String? @map("default_target_site_id")
  // Webflow CMS collection id for webflow pushes.
  defaultWebflowCollectionId String? @map("default_webflow_collection_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages          ProgrammaticPage[]
  autopilotRules AutopilotRule[]

  @@map("programmatic_templates")
}

model ProgrammaticDataset {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  // Column names in upload order.
  schema        Json
  // Array of { [column]: value } objects. Capped at 10_000 rows server-side.
  rows          Json
  rowCount      Int    @map("row_count")
  // variable -> column name overrides; auto-mapped by default.
  columnMapping Json?  @map("column_mapping")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages ProgrammaticPage[]

  @@map("programmatic_datasets")
}

model ProgrammaticPage {
  id         String               @id @default(cuid())
  projectId  String               @map("project_id")
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId String               @map("template_id")
  template   ProgrammaticTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  datasetId  String?              @map("dataset_id")
  dataset    ProgrammaticDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  rowIndex     Int                    @map("row_index")
  // Substituted URL path, e.g. /services/austin/plumbing
  url          String
  slug         String
  status       ProgrammaticPageStatus @default(draft)
  // { title, description, contentBlocks (Tiptap doc), wordCount }
  content      Json?
  contentHash  String?                @map("content_hash")
  noindex      Boolean                @default(true)
  canonical    String?
  // string[] quality flags: missing_variable | thin_content | duplicate_content | slug_collision
  qualityFlags Json                   @default("[]") @map("quality_flags")
  publishedUrl String?                @map("published_url")
  publishedAt  DateTime?              @map("published_at")

  // Milestone 17 push: per-page publish-target override ("none" = inherit
  // the template default), target site, and the remote refs used for
  // idempotent in-place updates (externalId = WP post id / Webflow item id /
  // site file path).
  publishTarget       String  @default("none") @map("publish_target")
  targetSiteId        String? @map("target_site_id")
  webflowCollectionId String? @map("webflow_collection_id")
  externalId          String? @map("external_id")
  externalUrl         String? @map("external_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, slug])
  @@index([projectId, status])
  @@map("programmatic_pages")
}

// Google Business Profile management scaffold (milestone 16).
// BEHIND the FEATURE_GBP_MANAGEMENT flag until the GBP API application is
// approved. No live Google calls exist yet — see lib/local/gbp.ts.
model GbpAccount {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  posts    GbpPost[]
  insights GbpInsight[]

  @@index([workspaceId])
  @@map("gbp_accounts")
}

model GbpPost {
  id           String     @id @default(cuid())
  gbpAccountId String     @map("gbp_account_id")
  gbpAccount   GbpAccount @relation(fields: [gbpAccountId], references: [id], onDelete: Cascade)

  locationId  String    @map("location_id")
  title       String
  summary     String
  // draft | scheduled | published | failed
  status      String    @default("draft")
  scheduledAt DateTime? @map("scheduled_at")
  externalId  String?   @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([gbpAccountId, status])
  @@map("gbp_posts")
}

model GbpInsight {
  id           String     @id @default(cuid())
  gbpAccountId String     @map("gbp_account_id")
  gbpAccount   GbpAccount @relation(fields: [gbpAccountId], references: [id], onDelete: Cascade)

  locationId        String   @map("location_id")
  date              DateTime
  views             Int      @default(0)
  searches          Int      @default(0)
  directionRequests Int      @default(0) @map("direction_requests")
  calls             Int      @default(0)
  websiteClicks     Int      @default(0) @map("website_clicks")
  mock              Boolean  @default(false)

  @@unique([gbpAccountId, locationId, date])
  @@map("gbp_insights")
}

// Marketr — content autopilot (milestone 18).
// Scheduled pipeline: source candidates → AI draft → approval gate →
// publish through the M17 push-publish path. Per-workspace autopilot scope,
// approval policies, full audit trail, pause/kill switch.
enum AutopilotSource {
  // M14 decay queue: refresh_content findings.
  decay_refresh
  // M17 programmatic templates: ready pages from one template.
  programmatic_template
  // Keyword gaps: tracked keywords with no content item yet.
  keyword_opportunity
}

enum AutopilotCadence {
  daily
  weekly
  manual
}

enum AutopilotRunStatus {
  running
  completed
  failed
  killed
}

enum AutopilotItemKind {
  decay_refresh
  programmatic_page
  keyword_brief
}

enum AutopilotItemStatus {
  pending
  approved
  rejected
  published
  killed
}

model AutopilotRule {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                   String
  // Which candidate source this rule pulls from.
  source                 AutopilotSource
  // Only for programmatic_template source: which template's ready pages.
  programmaticTemplateId String?               @map("programmatic_template_id")
  programmaticTemplate   ProgrammaticTemplate? @relation(fields: [programmaticTemplateId], references: [id], onDelete: SetNull)
  cadence                AutopilotCadence      @default(manual)
  // Cap on items generated per run (1–50).
  maxItemsPerRun         Int                   @default(5) @map("max_items_per_run")
  // Auto-approve without human review (default OFF). Only ever applied to
  // low-risk decay_refresh items; every auto-approval is audit-logged.
  autoApprove            Boolean               @default(false) @map("auto_approve")
  // Target settings shared with the M17 push path:
  // { kind: "wordpress"|"webflow"|"marketr-site"|"csv", siteId?, connectionId? }
  publishTarget          Json?                 @map("publish_target")
  enabled                Boolean               @default(true)

  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  runs  AutopilotRun[]
  items AutopilotItem[]

  @@index([projectId, enabled])
  @@map("autopilot_rules")
}

model AutopilotRun {
  id        String        @id @default(cuid())
  ruleId    String        @map("rule_id")
  rule      AutopilotRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status         AutopilotRunStatus @default(running)
  itemsGenerated Int                @default(0) @map("items_generated")
  itemsApproved  Int                @default(0) @map("items_approved")
  itemsPublished Int                @default(0) @map("items_published")
  // Who started the run: user id, or "cron".
  createdBy      String?            @map("created_by")
  error          String?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  items AutopilotItem[]

  @@index([ruleId, startedAt])
  @@index([projectId, startedAt])
  @@map("autopilot_runs")
}

model AutopilotItem {
  id        String        @id @default(cuid())
  runId     String        @map("run_id")
  run       AutopilotRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleId    String        @map("rule_id")
  rule      AutopilotRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind          AutopilotItemKind
  // Id of the source record: ContentDecayFinding / ProgrammaticPage / Keyword.
  sourceRef     String              @map("source_ref")
  title         String
  // AI draft, Tiptap JSON (editorcn editable source of truth).
  draftJson     Json?               @map("draft_json")
  draftMarkdown String?             @map("draft_markdown")
  status        AutopilotItemStatus @default(pending)
  // Explicit per-item audit note when auto-approved.
  autoApproved  Boolean             @default(false) @map("auto_approved")
  reviewNote    String?             @map("review_note")
  publishedUrl  String?             @map("published_url")
  publishedAt   DateTime?           @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ruleId, kind, sourceRef])
  @@index([projectId, status])
  @@index([runId, status])
  @@map("autopilot_items")
}

model AutopilotKillSwitch {
  id          String     @id @default(cuid())
  // Exactly one of workspaceId / projectId is set: workspace row kills every
  // project in the workspace; project row kills one project.
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "workspace:<id>" or "project:<id>" — unique because Postgres treats
  // NULLs as distinct in composite unique constraints.
  scopeKey    String     @unique @map("scope_key")

  killed   Boolean   @default(false)
  killedAt DateTime? @map("killed_at")
  killedBy String?   @map("killed_by")
  reason   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("autopilot_kill_switches")
}

// ---------------------------------------------------------------------------
// Marketr — newsletter builder (milestone 19).
// Editor model: Tiptap JSON email blocks (see lib/newsletter). Brand kits
// (milestone 12) supply fonts/colors at render time. Sending is Resend
// Broadcasts with a BYO workspace API key (encrypted, lib/secrets).
// ---------------------------------------------------------------------------

// Milestone 19 — workspace newsletter settings: BYO Resend key + defaults.
model NewsletterSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Encrypted Resend API key (AES-256-GCM envelope, lib/secrets). The raw key
  // is NEVER returned to clients — only the hint is readable in the UI.
  resendKeyEnc    String? @map("resend_key_enc") @db.Text
  resendKeyHint   String? @map("resend_key_hint")
  defaultFromName String? @map("default_from_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_settings")
}

enum NewsletterDomainStatus {
  pending
  verified
  failed
}

// Milestone 19 — per-client sending domain. Broadcasts are blocked
// server-side unless the domain's status is verified.
model NewsletterDomain {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  domain         String
  resendDomainId String?                @map("resend_domain_id")
  status         NewsletterDomainStatus @default(pending)
  // Exact DNS records Resend requires, as returned by its API:
  // [{ name, type: "TXT"|"MX"|"CNAME", value, purpose: "spf"|"dkim"|"dmarc-note" }].
  dnsRecords     Json                   @default("[]") @map("dns_records")
  verifiedAt     DateTime?              @map("verified_at")

  broadcasts NewsletterBroadcast[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, domain])
  @@map("newsletter_domains")
}

// Milestone 19 — subscriber list (one Resend audience per list).
model NewsletterList {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  doubleOptIn      Boolean @default(true) @map("double_opt_in")
  resendAudienceId String? @map("resend_audience_id")

  subscribers Subscriber[]
  broadcasts  NewsletterBroadcast[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_lists")
}

enum SubscriberStatus {
  subscribed
  unsubscribed
  bounced
  complained
}

// Milestone 19 — one subscriber. `token` powers the per-send unsubscribe link
// (public route, no auth — the token is the capability).
model Subscriber {
  id     String         @id @default(cuid())
  listId String         @map("list_id")
  list   NewsletterList @relation(fields: [listId], references: [id], onDelete: Cascade)

  email  String
  name   String?
  status SubscriberStatus @default(subscribed)
  token  String           @unique @default(cuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([listId, email])
  @@map("subscribers")
}

// Milestone 19 — editable newsletter template. Content is Tiptap JSON email
// blocks (emailHeader/emailHero/emailText/emailImage/emailButton/
// emailDivider/emailFooter — see lib/newsletter), the editable source of
// truth, same pattern as milestone 12 report templates.
model NewsletterTemplate {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  tiptap     Json
  brandKitId String?   @map("brand_kit_id")
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  isStarter  Boolean   @default(false) @map("is_starter")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_templates")
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

// Milestone 19 — one newsletter send. `templateSnapshot` is the immutable
// Tiptap JSON at send time (editing the template later does not change it).
model NewsletterBroadcast {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  listId   String           @map("list_id")
  list     NewsletterList   @relation(fields: [listId], references: [id], onDelete: Restrict)
  domainId String           @map("domain_id")
  domain   NewsletterDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  subject           String
  templateSnapshot  Json            @map("template_snapshot")
  brandKitId        String?         @map("brand_kit_id")
  status            BroadcastStatus @default(draft)
  scheduledAt       DateTime?       @map("scheduled_at")
  // Guardrail: a test send must complete before any broadcast.
  testSentAt        DateTime?       @map("test_sent_at")
  testSentTo        String?         @map("test_sent_to")
  resendBroadcastId String?         @map("resend_broadcast_id")
  // { sent, delivered, opened, clicked, bounced, complained } — best effort.
  stats             Json            @default("{}")
  error             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_broadcasts")
}

// Marketr — social scheduling via Buffer (milestone 20).
model SocialSettings {
  id              String    @id @default(cuid())
  workspaceId     String    @unique @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Buffer access token, encrypted at rest (BYO credential, like Resend in M19).
  bufferTokenEnc  String?   @map("buffer_token_enc")
  bufferTokenHint String?   @map("buffer_token_hint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_settings")
}

enum SocialPostStatus {
  draft
  scheduled
  dispatching
  sent
  failed
  cancelled
}

// A Buffer profile (channel) synced into a project. enable/disable is per project.
model SocialChannel {
  id              String  @id @default(cuid())
  projectId       String  @map("project_id")
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bufferProfileId String  @map("buffer_profile_id")
  // Normalized service key (twitter, instagram, tiktok, linkedin, facebook,
  // threads, youtube, bluesky, pinterest) or the raw Buffer service string.
  service         String
  handle          String?
  enabled         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, bufferProfileId])
  @@map("social_channels")
}

model SocialPost {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // SocialContent JSON (text, per-channel overrides, media, link, utm).
  content         Json
  // Target service keys, e.g. ["twitter", "linkedin"].
  services        String[]
  scheduledFor    DateTime?        @map("scheduled_for")
  status          SocialPostStatus @default(draft)
  // Idempotency record: [{ channelId, profileId, updateId, service }].
  bufferUpdateIds Json             @default("[]") @map("buffer_update_ids")
  // Bounded retry bookkeeping for transient Buffer failures.
  attempts        Int              @default(0)
  nextAttemptAt   DateTime?        @map("next_attempt_at")
  error           String?
  // Cached analytics payload: { byChannel, totals, syncedAt }.
  stats           Json             @default("{}")
  statsSyncedAt   DateTime?        @map("stats_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_posts")
}

// Marketr — Higgsfield-powered ad factory (milestone 21).
model AdSettings {
  id                String    @id @default(cuid())
  workspaceId       String    @unique @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Higgsfield API key (KEY_ID:KEY_SECRET), encrypted at rest (BYO credential,
  // same pattern as Buffer in M20 and Resend in M19). Never sent to the client.
  higgsfieldKeyEnc  String?   @map("higgsfield_key_enc")
  higgsfieldKeyHint String?   @map("higgsfield_key_hint")
  // Server-side monthly spend gate (cents). Default $50 — sane starter, editable.
  monthlyCapCents   Int       @default(5000) @map("monthly_cap_cents")
  // Rolling spend accounting for the current period ("YYYY-MM").
  spendCents        Int       @default(0) @map("spend_cents")
  spendPeriod       String?   @map("spend_period")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ad_settings")
}

enum AdCreativeType {
  image
  video
}

enum AdCreativeStatus {
  queued
  generating
  ready
  failed
  cancelled
}

// One ad campaign per project: objective + brand kit + target channels.
model AdCampaign {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  objective  String?
  // Brand kit (M12) — required before any generation (enforced server-side).
  brandKitId String? @map("brand_kit_id")
  // Target channels, e.g. ["instagram", "tiktok", "facebook"].
  channels   Json    @default("[]")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  creatives AdCreative[]

  @@map("ad_campaigns")
}

// One creative = one generation job (one prompt). Variant fan-out creates
// N rows. Assets hold the finished media URLs.
model AdCreative {
  id         String     @id @default(cuid())
  campaignId String     @map("campaign_id")
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Denormalized for audit/log queries without joining the campaign.
  projectId  String     @map("project_id")

  name          String
  type          AdCreativeType
  // Structured brief snapshot used to compose the prompt.
  brief         Json
  // Final composed prompt sent to the provider.
  prompt        String
  // Full prompt history (regenerations prepend/append here).
  promptHistory Json             @default("[]")
  status        AdCreativeStatus @default(queued)
  // Aspect ratio for this job, e.g. "1:1", "4:5", "9:16", "16:9".
  aspectRatio   String           @default("1:1") @map("aspect_ratio")
  channels      Json             @default("[]")

  // Cost in cents. Estimates are illustrative constants (see lib/ads/brief.ts);
  // actuals come from the provider response when available.
  costEstimateCents Int  @default(0) @map("cost_estimate_cents")
  costActualCents   Int  @default(0) @map("cost_actual_cents")
  // [{ url, variantIndex, costCents }]
  assets            Json @default("[]")

  providerJobId String?   @map("provider_job_id")
  attempts      Int       @default(0)
  nextPollAt    DateTime? @map("next_poll_at")
  error         String?

  approved Boolean @default(false)
  rejected Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId, status])
  @@index([status, nextPollAt])
  @@map("ad_creatives")
}

// ---------------------------------------------------------------------------
// Milestone 22 — Marketing studio (Canva Connect) + Porkbun domains
// ---------------------------------------------------------------------------

// OAuth account for Canva Connect, workspace-scoped. Tokens are encrypted
// AES-256-GCM envelopes (lib/secrets) — never returned to clients.
model StudioCanvaAccount {
  id String @id @default(cuid())

  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  canvaUserId     String?  @map("canva_user_id")
  accessTokenEnc  String   @map("access_token_enc") @db.Text
  refreshTokenEnc String   @map("refresh_token_enc") @db.Text
  tokenExpiresAt  DateTime @map("token_expires_at")
  scopes          String   @default("")

  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("studio_canva_accounts")
}

// BYO Porkbun API keys, workspace-scoped. Encrypted AES-256-GCM envelopes
// (lib/secrets) — never returned to clients. Owner/admin only.
model StudioPorkbunSettings {
  id String @id @default(cuid())

  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  apiKeyEnc    String  @map("api_key_enc") @db.Text
  secretKeyEnc String  @map("secret_key_enc") @db.Text
  apiKeyHint   String? @map("api_key_hint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("studio_porkbun_settings")
}

// Registrant contact used for Porkbun domain purchases. Porkbun's API
// registers with the account's default contact; Marketr collects and shows
// this copy in the wizard for review + ICANN disclosure. Purchase is blocked
// until this row is complete.
model StudioRegistrant {
  id String @id @default(cuid())

  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String
  phone     String
  address   String
  city      String
  state     String @default("")
  zip       String
  country   String @default("US")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("studio_registrants")
}

// Domain managed/purchased through Porkbun, project-scoped.
model StudioDomain {
  id String @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  domain       String
  tld          String
  status       String    @default("pending") // pending | registered | failed | external
  priceUsd     Decimal?  @map("price_usd") @db.Decimal(10, 2)
  orderId      String?   @map("order_id")
  whoisPrivacy Boolean   @default(true) @map("whois_privacy")
  purchasedAt  DateTime? @map("purchased_at")
  expiresAt    DateTime? @map("expires_at")
  nameServers  String?   @map("name_servers") @db.Text // JSON string array
  errorDetail  String?   @map("error_detail") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, domain])
  @@map("studio_domains")
}

// Unified project asset library — Canva exports, uploads, generated assets.
model ProjectAsset {
  id String @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  source        String // canva | upload | generated
  url           String  @db.Text
  mimeType      String? @map("mime_type")
  metadata      String? @db.Text // JSON: canva design id, export format, dimensions…
  canvaDesignId String? @map("canva_design_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, source])
  @@map("project_assets")
}

// ---------------------------------------------------------------------------
// Marketr — redesign (2026-09-22): automation canvas workflows.
// Node-graph workflows per project: triggers, actions, approval gates, logic.
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  draft
  active
  paused
  archived
}

enum WorkflowRunStatus {
  queued
  running
  waiting_approval
  succeeded
  failed
  cancelled
}

enum WorkflowStepStatus {
  pending
  running
  waiting_approval
  succeeded
  failed
  skipped
}

model Workflow {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      WorkflowStatus @default(draft)
  // Cron expression for the schedule trigger; null = manual-only workflow.
  schedule    String?
  enabled     Boolean        @default(true)
  createdBy   String?        @map("created_by")
  lastRunAt   DateTime?      @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nodes WorkflowNode[]
  edges WorkflowEdge[]
  runs  WorkflowRun[]

  @@index([projectId, status])
  @@map("workflows")
}

model WorkflowNode {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Node category: "trigger" | "action" | "approval" | "logic".
  kind      String
  // Node type within the category, e.g. trigger: schedule|rank_drop|
  // competitor_published|decay_detected|webhook|manual; action:
  // generate_draft|run_audit|apply_internal_links|send_alert|generate_report|
  // publish_approved; approval: approval_gate; logic: condition|delay.
  type      String
  label     String
  // Node-specific config JSON (cron expression, thresholds, template ids…).
  config    Json   @default("{}")
  // Canvas position.
  positionX Float  @map("position_x")
  positionY Float  @map("position_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workflowId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceNodeId String  @map("source_node_id")
  targetNodeId String  @map("target_node_id")
  // For condition branches: "true" | "false"; null = default path.
  label        String?

  @@index([workflowId])
  @@map("workflow_edges")
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status                WorkflowRunStatus @default(queued)
  // What started the run: "manual" | "schedule" | "webhook" | event key.
  triggerKind           String            @map("trigger_kind")
  createdBy             String?           @map("created_by")
  error                 String?
  // Autopilot item id when the run is paused at an approval gate.
  pendingApprovalItemId String?           @map("pending_approval_item_id")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  steps WorkflowRunStep[]

  @@index([workflowId, startedAt])
  @@index([projectId, startedAt])
  @@map("workflow_runs")
}

model WorkflowRunStep {
  id        String             @id @default(cuid())
  runId     String             @map("run_id")
  run       WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String             @map("node_id")
  nodeKind  String             @map("node_kind")
  nodeLabel String             @map("node_label")
  status    WorkflowStepStatus @default(pending)
  input     Json?
  output    Json?
  error     String?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([runId, startedAt])
  @@map("workflow_run_steps")
}

// ---------------------------------------------------------------------------
// Marketr — redesign (2026-09-22): AI chat threads (project-scoped,
// LLM-style command center) and per-project team chat channels.
// ---------------------------------------------------------------------------

model AiChatThread {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  title     String  @default("New chat")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AiChatMessage[]

  @@index([projectId, userId, updatedAt])
  @@map("ai_chat_threads")
}

model AiChatMessage {
  id       String       @id @default(cuid())
  threadId String       @map("thread_id")
  thread   AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // "user" | "assistant" | "tool".
  role      String
  content   String @db.Text
  // Tool calls executed for this message:
  // [{ tool, args, resultSummary, status, confirmed? }].
  toolCalls Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("ai_chat_messages")
}

model ChatChannel {
  id        String  @id @default(cuid())
  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String  @default("Project chat")

  createdAt DateTime @default(now()) @map("created_at")

  messages TeamChatMessage[]

  @@map("chat_channels")
}

model TeamChatMessage {
  id         String      @id @default(cuid())
  channelId  String      @map("channel_id")
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  // Denormalized display-name snapshot (email or name at send time).
  authorName String      @map("author_name")
  body       String      @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@map("team_chat_messages")
}

// ---------------------------------------------------------------------------
// Milestone 21: user-installable skills, connectors, workspace/project settings.
// ---------------------------------------------------------------------------
//
// Design notes (minor deviations from SPEC-SKILLS-CONNECTORS-SETTINGS.md §6,
// recorded here deliberately):
// - The 12 built-in connectors are code-defined in
//   lib/connectors/native/registry.ts (matching the existing provider pattern
//   in lib/providers/index.ts), NOT rows in the Connector table. The Connector
//   model exists only for workspace-custom MCP servers. ConnectorConnection
//   therefore keys on connectorKey (string) with an optional connectorId FK
//   for custom servers. This avoids a nullable partial-unique-index problem
//   and keeps built-ins versioned with the codebase.
// - Project.domain / Project.locale already exist on Project; ProjectSettings
//   holds the rest (brand context, extra domains, overrides, approval mode,
//   publishing controls) rather than duplicating them.

enum SkillSource {
  registry
  url
  upload
}

enum SkillTrustTier {
  built_in
  pinned_url
}

enum ConnectorKind {
  native
  mcp
}

enum ConnectorAuthType {
  oauth2
  api_key
  none
}

enum ConnectionStatus {
  active
  needs_reauth
  revoked
}

// Phase B (B3): cached per-connection health. Derived, refreshed by the
// health checker (lib/connectors/health.ts); never the source of truth for
// auth — ConnectorConnection.status + the vault are.
enum ConnectorHealthStatus {
  healthy
  degraded
  needs_reauth
  error
  unknown
}

model ConnectorHealth {
  id          String   @id @default(cuid())
  // One row per connection; the checker upserts on connectionId.
  connectionId String  @unique @map("connection_id")
  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // Denormalized for the workspace summary query (the authorization
  // boundary is still re-checked via ConnectorConnection on every read).
  workspaceId String  @map("workspace_id")

  status      ConnectorHealthStatus @default(unknown)
  lastCheckAt DateTime @map("last_check_at")
  lastSuccessAt DateTime? @map("last_success_at")
  // Closed-set error code (see lib/connectors/health.ts ERROR_CODES) —
  // never a raw provider message.
  lastError   String? @map("last_error")
  quotaUsed   Float?  @map("quota_used")
  quotaLimit  Float?  @map("quota_limit")

  // Alert spam guard: cooldown + escalation state (see THREAT-MODEL-connector-health.md).
  lastAlertAt       DateTime? @map("last_alert_at")
  consecutiveErrors Int       @default(0) @map("consecutive_errors")

  @@index([workspaceId])
  @@map("connector_health")
}

model Skill {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String         @db.Text
  source      SkillSource
  sourceRef   String?        @map("source_ref")
  version     String         @default("1.0.0")
  // Commit SHA the install is pinned to (url source). Null = not pinned.
  shaPin      String?        @map("sha_pin")
  skillMd     String         @map("skill_md") @db.Text
  // Tool names the skill may invoke, e.g. "google-search-console.query".
  declaredTools String[]     @map("declared_tools")
  trustTier   SkillTrustTier @map("trust_tier")
  installedBy String?        @map("installed_by")
  installedAt DateTime       @default(now()) @map("installed_at")

  projects ProjectSkill[]
  // Phase B (W2, track B2): schedules that run this skill + their run history.
  scheduledSkills ScheduledSkill[]
  skillRuns       SkillRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("skills")
}

model ProjectSkill {
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String  @map("skill_id")
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(true)
  enabledBy String? @map("enabled_by")
  enabledAt DateTime @default(now()) @map("enabled_at")

  @@id([projectId, skillId])
  @@map("project_skills")
}

// Workspace-custom MCP servers only. Built-in connectors live in code
// (lib/connectors/native/registry.ts).
model Connector {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  kind        ConnectorKind @default(mcp)
  displayName String        @map("display_name")
  authType    ConnectorAuthType @default(none) @map("auth_type")
  // For MCP: { endpoint, transport: "http" | "stdio", command? }
  config      Json?
  mcpEndpoint String?       @map("mcp_endpoint")
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  // Opposite side of ConnectorConnection.connector (M21 connectors).
  connections ConnectorConnection[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("connectors")
}

model ConnectorConnection {
  id         String           @id @default(cuid())
  // Connector key: built-in native key (e.g. "google-search-console") or a
  // custom Connector.key for workspace MCP servers.
  connectorKey String          @map("connector_key")
  connectorId  String?         @map("connector_id")
  connector    Connector?      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  workspaceId  String          @map("workspace_id")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Auth.js user id that owns this credential (per-user OAuth).
  userId      String          @map("user_id")
  status      ConnectionStatus @default(active)
  scopes      String[]
  // Non-sensitive display metadata (account email, property list, ...).
  meta        Json?
  connectedAt   DateTime      @default(now()) @map("connected_at")
  lastRefreshAt DateTime?     @map("last_refresh_at")

  credential      ConnectorCredential?
  projectBindings ProjectDataSource[]
  health          ConnectorHealth?

  @@index([workspaceId])
  @@index([userId])
  @@index([connectorKey])
  @@map("connector_connections")
}

model ConnectorCredential {
  connectionId String @id @map("connection_id")
  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // AES-256-GCM envelope via lib/secrets (never logged, never sent to clients).
  encryptedBlob String @map("encrypted_blob") @db.Text
  keyVersion    String @default("env-v1") @map("key_version")
  expiresAt     DateTime? @map("expires_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("connector_credentials")
}

model ProjectDataSource {
  id           String              @id @default(cuid())
  projectId    String              @map("project_id")
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId String              @map("connection_id")
  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectorKey String              @map("connector_key")
  // Per-project binding config, e.g. { property: "https://example.com" } for
  // Search Console, { folderId } for Drive.
  projectConfig Json?             @map("project_config")
  createdBy     String?           @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([projectId, connectionId])
  @@index([projectId])
  @@map("project_data_sources")
}

model FileAttachment {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Chat session (AiChatThread id) or brief context; null = project-level.
  sessionId    String?  @map("session_id")
  source       String   // "upload" | "connector"
  connectorKey String?  @map("connector_key")
  externalRef  String?  @map("external_ref")
  filename     String
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  // Local disk path under .data/attachments (uploads). Null for connector refs.
  storagePath  String?  @map("storage_path")
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([sessionId])
  @@map("file_attachments")
}

model WorkspaceSettings {
  workspaceId          String    @id @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultModel         String?   @map("default_model")
  defaultApprovalMode  String    @default("supervised") @map("default_approval_mode")
  notificationDefaults Json?    @map("notification_defaults")
  dataGovernance       Json?    @map("data_governance")
  // Tool namespaces the agent may use; empty = all enabled.
  agentAllowList       String[]  @map("agent_allow_list")
  updatedBy            String?   @map("updated_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("workspace_settings")
}

model ProjectSettings {
  projectId            String    @id @map("project_id")
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // JSON overrides of any workspace default, e.g. { defaultModel, notificationDefaults }.
  overrides            Json?
  // Brand context text injected into the agent prompt for this project.
  brandContext         String?   @map("brand_context") @db.Text
  // Extra domains beyond Project.domain.
  domains              String[]
  approvalModeOverride String?   @map("approval_mode_override")
  publishingControls   Json?     @map("publishing_controls")
  updatedBy            String?   @map("updated_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("project_settings")
}

// Granular permission grants beyond the role hierarchy (milestone 21).
// owner/admin always hold every permission; grants extend to others.
model PermissionGrant {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Exactly one of userId / role is set (enforced in code).
  userId      String?  @map("user_id")
  role        WorkspaceRole?
  // "skills.install" | "connectors.connect" (open string for future grants).
  permission  String
  grantedBy   String   @map("granted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, userId])
  @@map("permission_grants")
}

enum WorkspaceFileKind {
  skill
  memory
  artifact
  file
}

// Phase B (W3, track B1): registry-gated private workspace filesystem.
// The DB registry is the isolation boundary; storage keys are opaque UUIDs.
model WorkspaceFile {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Normalized logical path, e.g. "/files/reports/q3.pdf". Unique among
  // live (non-trashed) files per workspace.
  logicalPath String            @map("logical_path")
  // Opaque UUID storage key. Never serialized to clients.
  storageKey  String            @unique @map("storage_key")
  filename    String            @db.VarChar(255)
  mimeType    String            @map("mime_type")
  sizeBytes   Int               @map("size_bytes")
  kind        WorkspaceFileKind
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  // Trash: set on soft-delete, 30-day retention, then purge.
  trashedAt   DateTime?         @map("trashed_at")

  @@index([workspaceId, trashedAt])
  @@index([workspaceId, kind])
  @@map("workspace_files")
}

model WorkspaceQuota {
  workspaceId String    @id @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  limitBytes  BigInt    @map("limit_bytes")
  usedBytes   BigInt    @default(0) @map("used_bytes")

  @@map("workspace_quotas")
}

// ---------------------------------------------------------------------------
// Phase B (W2, track B2): scheduled skills + parallel subagent runs.
// ---------------------------------------------------------------------------

enum ScheduleTriggerType {
  cron
  event
}

enum ScheduleApprovalMode {
  supervised
  scheduled
  autopilot
}

enum ScheduleStatus {
  active
  paused
}

enum SkillRunTrigger {
  cron
  event
  manual
}

enum SkillRunStatus {
  pending
  awaiting_approval
  approved
  running
  succeeded
  failed
  rejected
  cancelled
  // Phase C gaps (G1): pre-run cap gate blocked this run before execution (T9).
  blocked
}

enum SubagentRunStatus {
  pending
  running
  succeeded
  failed
  skipped
}

// A skill schedule: fires a skill on a cron expression or a workspace event.
model ScheduledSkill {
  id               String               @id @default(cuid())
  workspaceId      String               @map("workspace_id")
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Null = workspace-wide (fires across the workspace's projects where the
  // skill is enabled). Set = project-scoped (creatable by project editors).
  projectId        String?              @map("project_id")
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId          String               @map("skill_id")
  skill            Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  triggerType      ScheduleTriggerType  @map("trigger_type")
  // Strict 5-field cron ("0 9 * * 1"). Null for event schedules.
  cronExpr         String?              @map("cron_expr")
  // Event bus source key, e.g. "rank_drop". Null for cron schedules.
  eventSource      String?              @map("event_source")
  // Per-source config, e.g. { "dropThreshold": 3 } for rank_drop.
  eventConfigJson  Json?                @map("event_config_json")
  // JSON array of schedule ids this run must not re-trigger (cycle guard is
  // enforced at fire time; the lineage is carried on SkillRun).
  createdBy        String               @map("created_by")
  approvalMode     ScheduleApprovalMode @map("approval_mode")
  concurrencyLimit Int                  @default(4) @map("concurrency_limit")
  status           ScheduleStatus       @default(active)
  lastRunAt        DateTime?            @map("last_run_at")
  nextRunAt        DateTime?            @map("next_run_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  runs SkillRun[]

  @@index([workspaceId, status])
  @@index([nextRunAt])
  @@index([workspaceId, skillId])
  @@map("scheduled_skills")
}

// One execution of a skill: from a schedule (cron/event) or manual trigger.
model SkillRun {
  id          String         @id @default(cuid())
  scheduleId  String?        @map("schedule_id")
  schedule    ScheduledSkill? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?        @map("project_id")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId     String         @map("skill_id")
  skill       Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  trigger     SkillRunTrigger
  // Server-side trigger lineage (schedule ids, oldest first) for cycle
  // detection. Never client-supplied.
  lineage     String[]       @default([])
  // Firing event payload (event-triggered runs): stored so the run detail
  // view can show exactly what fired the run.
  eventPayload Json?         @map("event_payload")
  status      SkillRunStatus @default(pending)
  // True when this run was created by the missed-cron catch-up (fires once,
  // marked missed per the decided policy).
  wasMissed   Boolean        @default(false) @map("was_missed")
  startedAt   DateTime       @default(now()) @map("started_at")
  finishedAt  DateTime?      @map("finished_at")
  // Integer credits (metering ledger arrives in Phase C; fields exist now).
  creditsUsed Int            @default(0) @map("credits_used")
  // Filesystem logical path, e.g. /artifacts/runs/<run-id>/report.md
  outputPath  String?        @map("output_path")
  error       String?        @db.Text
  approvedBy  String?        @map("approved_by")
  approvedAt  DateTime?      @map("approved_at")

  subagents SubagentRun[]

  @@index([workspaceId, startedAt])
  @@index([scheduleId])
  @@index([skillId])
  @@index([status])
  @@map("skill_runs")
}

// One parallel subagent inside a skill run. Each is separately audited and
// credit-metered; grants never exceed the parent run's envelope.
model SubagentRun {
  id          String            @id @default(cuid())
  skillRunId  String            @map("skill_run_id")
  skillRun    SkillRun          @relation(fields: [skillRunId], references: [id], onDelete: Cascade)
  taskLabel   String            @map("task_label")
  status      SubagentRunStatus @default(pending)
  startedAt   DateTime          @default(now()) @map("started_at")
  finishedAt  DateTime?         @map("finished_at")
  creditsUsed Int               @default(0) @map("credits_used")
  // Summary of what the subagent produced (deterministic mock in this track).
  result      String?           @db.Text

  @@index([skillRunId])
  @@map("subagent_runs")
}

// Phase C (W5): Marketr as MCP server — workspace API keys.
model McpApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  name        String
  // SHA-256 hex of the raw key. Raw key material is NEVER stored.
  keyHash     String    @unique @map("key_hash")
  // Public prefix (e.g. "mcpk_a1b2c3") for display/identification only.
  keyPrefix   String    @map("key_prefix")
  // Per-tool scopes, e.g. ["tools:list_projects"]. Fixed constants, no wildcards.
  scopes      String[]  @map("scopes")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mcp_api_keys")
}

// Phase C (W5): OAuth 2.1 Dynamic Client Registration (RFC 7591) clients.
model McpOAuthClient {
  // Opaque public client id (e.g. "mcpc_<random>").
  clientId     String   @id @map("client_id")
  // Null until the first consent approval claims the client (public DCR, RFC 7591).
  userId       String?  @map("user_id")
  // Bound at authorization time: the token's tenant.
  workspaceId  String?  @map("workspace_id")
  clientName   String?  @map("client_name")
  redirectUris String[] @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("mcp_oauth_clients")
}

// Phase C (W5): single-use authorization codes (OAuth 2.1 code flow + PKCE).
model McpOAuthCode {
  code          String   @id
  clientId      String   @map("client_id")
  userId        String   @map("user_id")
  workspaceId   String   @map("workspace_id")
  redirectUri   String   @map("redirect_uri")
  scopes        String[]
  // S256 code challenge (plain verifier never stored).
  codeChallenge String?  @map("code_challenge")
  expiresAt     DateTime @map("expires_at")
  used          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("mcp_oauth_codes")
}

// Phase C (W5): access tokens (SHA-256 hash stored; raw token never stored).
model McpOAuthToken {
  // SHA-256 hex of the raw token.
  tokenHash   String    @id @map("token_hash")
  clientId    String    @map("client_id")
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  scopes      String[]
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("mcp_oauth_tokens")
}

// Phase C gaps (G3): distributed rate-limit counters for PostgresRateLimiter.
// Incremented atomically via a single INSERT ... ON CONFLICT DO UPDATE
// statement (see migration 20260922250000_mcp_ratelimit); never via
// read-modify-write. Expired windows are deleted opportunistically.
model McpRateLimit {
  bucketKey   String   @map("bucket_key")
  windowStart BigInt   @map("window_start")
  count       Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@id([bucketKey, windowStart])
  @@index([windowStart])
  @@map("mcp_rate_limits")
}

// ─── Phase C (W4): hosted metering ───────────────────────────────────────────
// Immutable usage ledger. Application code only ever CREATES UsageEvent rows
// (lib/metering/service.ts exposes no update/delete); the migration adds a
// Postgres trigger that rejects UPDATE/DELETE outright (see
// lib/metering/THREAT-MODEL-METERING.md T5).
model UsageEvent {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String?  @map("project_id")
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Null = system/scheduler actor.
  actorId        String?  @map("actor_id")
  // Key into lib/metering/credits.ts CREDIT_COSTS (versioned, v1).
  action         String
  // Integer credits only — 1 credit = $0.01. Never floats.
  credits        Int
  // Set server-side at insert; callers cannot supply it.
  occurredAt     DateTime @default(now()) @map("occurred_at")
  // Caller-supplied idempotency key; UNIQUE so replays can never double-charge.
  idempotencyKey String   @unique @map("idempotency_key")
  // Unverified human pointer for disputes (run id, report path) — see T7.
  evidenceRef    String?  @map("evidence_ref")
  // Phase C gaps (G1): MCP API key / OAuth client this charge is attributed
  // to. Null for non-MCP charges. Server-validated to the workspace (T8).
  keyId          String?  @map("key_id")
  // Overage invoicing: portion of `credits` that fell beyond the paid pool
  // (included + purchased) at charge time. Factual accounting written by
  // meter() in-transaction; the invoice cron sums this per month. 0 for
  // in-cap charges and zero-cost actions. See SEAM.md "Overage accrual".
  overageCredits Int      @default(0) @map("overage_credits")

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, action])
  @@index([projectId])
  @@index([workspaceId, keyId])
  @@map("usage_events")
}

// Per-workspace credit pool for the current billing period. Mutated ONLY
// inside meter()'s locked transaction (check-then-append is atomic) and the
// locked period-rollover path — see T2/T6.
model CreditBalance {
  workspaceId      String   @id @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  includedCredits  Int      @map("included_credits")
  purchasedCredits Int      @default(0) @map("purchased_credits")
  // Null = no purchased credits outstanding.
  purchasedExpiresAt DateTime? @map("purchased_expires_at")
  usedCredits      Int      @default(0) @map("used_credits")
  periodStart      DateTime @map("period_start")

  @@map("credit_balances")
}

// Spend guard. Default: hard cap ON at 100% of (included + purchased),
// alert at 80%. Admins may raise the cap or disable the block (opt-in
// overage); the alert still fires.
model SpendCap {
  workspaceId  String   @id @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Effective cap in credits. Defaults to included + purchased; an admin can
  // set a custom (higher or lower) value.
  capCredits   Int      @map("cap_credits")
  blockAtCap   Boolean  @default(true) @map("block_at_cap")
  // Percent of capCredits at which the warning alert fires (default 80).
  alertAtPct   Int      @default(80) @map("alert_at_pct")
  // Once-per-period alert guard: the warning fires only when lastAlertAt is
  // null or older than the current periodStart.
  lastAlertAt  DateTime? @map("last_alert_at")
  // Phase C gaps (G1): explicit auto-overage opt-in. Default false — the
  // hard cap stays the default. The billing track flips this on opt-in.
  autoOverage  Boolean   @default(false) @map("auto_overage")

  @@map("spend_caps")
}

// ── Hosted Stripe billing state (overage invoicing track) ────────────────────
// The UsageEvent ledger stays the source of truth for what was spent; these
// tables record the money side: which Stripe customer belongs to which
// workspace, which invoices were issued, and exactly-once webhook guards.
// Self-hosted Marketr never creates rows here (billing methods fail closed
// without Stripe keys). See lib/metering/THREAT-MODEL-BILLING.md B10–B15.

model BillingWorkspace {
  workspaceId String @id @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Stripe Customer bound to this workspace (B10). Written only from a
  // signed webhook or an admin-session checkout creation — never from
  // client-supplied input.
  stripeCustomerId String? @map("stripe_customer_id")
  // True once a setup-mode Checkout completed and the payment method was
  // attached as the customer's default for invoices (B11). Required to
  // enable auto-overage while billing is configured.
  hasPaymentMethod Boolean @default(false) @map("has_payment_method")
  // Watermark: overage events with occurredAt <= this value are invoiced.
  // Sub-minimum amounts are NOT invoiced but the watermark does not advance,
  // so they carry forward and are billed once the $5 minimum is reached (B15).
  lastOverageInvoicedThrough DateTime? @map("last_overage_invoiced_through")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("billing_workspaces")
}

model BillingOverageInvoice {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // YYYY-MM of the COMPLETED billing month this invoice covers (derived from
  // cutoff - 1ms). Covers all unbilled overage before that month's end,
  // including carried-forward amounts.
  period           String
  overageCredits   Int     @map("overage_credits")
  amountCents      Int     @map("amount_cents")
  stripeInvoiceId  String? @map("stripe_invoice_id")
  hostedInvoiceUrl String? @map("hosted_invoice_url")
  invoicePdfUrl    String? @map("invoice_pdf_url")
  // finalized | paid | failed. Updated by invoice.paid / invoice.payment_failed
  // webhooks (B13); dunning after failure is a documented follow-up.
  status         String   @default("finalized")
  // overageinvoice:<workspaceId>:<YYYY-MM> — replay-safe per workspace per
  // month (B12).
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId, period])
  @@map("billing_overage_invoices")
}

// Exactly-once guard for setup-mode Checkout completions (B11): a replayed
// checkout.session.completed (mode=setup) must not re-attach or double-count.
model BillingSetupIdempotency {
  idempotencyKey  String   @id @map("idempotency_key")
  workspaceId     String   @map("workspace_id")
  stripeSessionId String   @map("stripe_session_id")
  appliedAt       DateTime @default(now()) @map("applied_at")

  @@map("billing_setup_idempotency")
}

// ── Lead Pipeline CRM (Phase 1 / R1) ─────────────────────────────────────
// The Lead is the central object of the agency-in-a-box thesis: every
// channel (digital, physical, media) feeds one pipeline per client.
// Tenant rule: every row carries workspaceId; every query filters on it.

enum LeadSource {
  website_form
  phone
  referral
  import
  ad
  ooh
  direct_mail
  other
}

enum LeadActivityType {
  created
  note
  email
  call
  sms
  meeting
  stage_change
  score_change
  form_submit
  import
}

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional link to the white-label Client this pipeline serves. Null =
  // agency-internal pipeline.
  clientId    String?   @map("client_id")
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  // Ordered stage machine: [{ id: "new", label: "New", color: "violet" }, ...].
  // Lead.stage must be one of these ids (validated in lib/crm).
  stages      Json
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  leads        Lead[]
  captureForms LeadCaptureForm[]

  @@index([workspaceId])
  @@map("crm_pipelines")
}

model Lead {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId  String    @map("pipeline_id")
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  // Optional link to the SEO project this lead is attributed to.
  projectId   String?   @map("project_id")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name        String
  email       String?
  phone       String?
  company     String?
  title       String?
  source      LeadSource @default(other)
  sourceDetail String?   @map("source_detail")
  // Stage id — must exist in Pipeline.stages (validated in lib/crm).
  stage       String    @default("new")
  // 0–100, computed deterministically by lib/crm/scoring.ts (rules v1).
  score       Int       @default(0)
  valueCents  Int?      @map("value_cents")
  ownerId     String?   @map("owner_id")
  ownerName   String?   @map("owner_name")
  starred     Boolean   @default(false)
  customFields Json?    @map("custom_fields")
  // Dedup identity: "email:<normalized>" | "phone:<digits>". Unique per
  // workspace when present; the unique constraint is the race-safe backstop
  // behind the check-then-insert in the API (P2002 → 409 duplicate).
  dedupKey    String?   @map("dedup_key")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  activities LeadActivity[]

  @@unique([workspaceId, dedupKey])
  @@index([workspaceId, pipelineId, stage])
  @@index([workspaceId, score])
  @@map("crm_leads")
}

model LeadActivity {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String           @map("lead_id")
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  body        String?
  // Human-readable actor ("Tico", "Public form", "Import", "System").
  actor       String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("crm_lead_activities")
}

model LeadCaptureForm {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId  String    @map("pipeline_id")
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  // sha256 hex of the public token. The token itself is shown once at
  // creation and never stored; lookup is by hash.
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  enabled     Boolean   @default(true)
  // Optional field config: [{ key: "company", label: "Company", required: true }]
  fields      Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([pipelineId])
  @@map("crm_capture_forms")
}
