// Typed approval objects for Phase 6 publishing actions.
// bindingJson is hashed at creation (bindingHash); the executor re-verifies
// the exact payload before any external action. Two-person rule: depth-3
// activation and review-reply-post require two distinct approvers.
model AuthorityApproval {
  id                String                  @id @default(cuid()) @map("id")
  workspaceId       String                  @map("workspace_id")
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              AuthorityApprovalType   @map("type")
  status            AuthorityApprovalStatus @default(draft) @map("status")
  bindingJson       Json                    @map("binding_json")
  bindingHash       String                  @map("binding_hash")
  createdBy         String                  @map("created_by")
  approversJson     Json                    @default("[]") @map("approvers_json")
  twoPersonRequired Boolean                 @default(false) @map("two_person_required")
  approvalReceipt   String?                 @map("approval_receipt")
  decidedAt         DateTime?               @map("decided_at")
  executedAt        DateTime?               @map("executed_at")
  revokedAt         DateTime?               @map("revoked_at")
  revokedBy         String?                 @map("revoked_by")
  expiresAt         DateTime?               @map("expires_at")
  createdAt         DateTime                @default(now()) @map("created_at")

  events AuthorityApprovalEvent[]

  @@index([workspaceId, type, status])
  @@map("authority_approvals")
}

model AuthorityApprovalEvent {
  id          String            @id @default(cuid()) @map("id")
  approvalId  String            @map("approval_id")
  approval    AuthorityApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // Phase 4a: no orphans on workspace delete
  ts          DateTime          @default(now()) @map("ts")
  actor       String            @map("actor")
  action      String            @map("action") // created|submitted|approved|approval_rejected|revoked|expired|executed
  payloadHash String            @map("payload_hash")
  prevHash    String            @map("prev_hash")
  eventHash   String            @map("event_hash")
  detail      Json?             @map("detail")

  @@index([approvalId, ts])
  @@index([workspaceId])
  @@map("authority_approval_events")
}

model AuthorityAuditEvent {
  id          String    @id @default(cuid()) @map("id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts          DateTime  @default(now()) @map("ts")
  actor       String    @map("actor")
  action      String    @map("action")
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  payloadHash String    @map("payload_hash")
  prevHash    String    @map("prev_hash")
  eventHash   String    @map("event_hash")
  detail      Json?     @map("detail")

  @@index([workspaceId, ts])
  @@map("authority_audit_events")
}

