// ---------------------------------------------------------------------------
// Phase 8 G2 — The Campaign object
// ---------------------------------------------------------------------------
// The object LINKS to fragment tables (mail_campaign, outreach_campaign,
// media_buy, ctv_campaign, newsletter_broadcast, social_post, experiment,
// recycling_brief); it never re-models them and never touches their rows.
// The word "campaign" is overloaded across ten existing tables, so the model
// is named `growth_campaign` in code (docs/specs/SPEC-PHASE8.md §2 G2).

enum GrowthCampaignObjective {
  lead_gen
  sale
  awareness
  retention
  launch
}

enum GrowthCampaignStatus {
  draft
  active
  paused
  complete
  archived
}

enum CampaignLinkedType {
  mail_campaign
  outreach_campaign
  media_buy
  ctv_campaign
  newsletter_broadcast
  social_post
  experiment
  recycling_brief
}

enum CampaignLinkRole {
  primary
  supporting
}

enum CampaignLinkSource {
  human
  naming_convention
  utm
  api
}

enum LinkProposalStatus {
  pending
  approved
  rejected
}

// The 12 master-plan stages, stored as JSONB on the campaign. Each stage:
// { key, status: not_started|in_progress|complete|blocked|skipped, note?,
//   linkedRefs: [{ linkedType, linkedId, stageKey }] }
// Stage statuses are derived on attach/detach (refs added/removed); humans
// drive status transitions via the UI.
model GrowthCampaign {
  id          String    @id @default(cuid()) @map("id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String                  @map("name")
  objective GrowthCampaignObjective @map("objective")
  status    GrowthCampaignStatus    @default(draft) @map("status")

  stages Json @default("[]") @map("stages")

  // Computed by the rollup engine when links change. Read-only at the API
  // layer — no route writes this; it's a reporting convenience, not a
  // spending envelope (§3.1: nothing here moves money).
  budgetRollupCents Int  @default(0) @map("budget_rollup_cents")
  reportingConfig   Json @default("{}") @map("reporting_config")

  // HubSpot-style hierarchy, ≤3 levels, enforced in code with cycle
  // detection (lib/substrate/campaigns).
  parentCampaignId String?          @map("parent_campaign_id")
  parentCampaign   GrowthCampaign?  @relation("CampaignHierarchy", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  children         GrowthCampaign[] @relation("CampaignHierarchy")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links         CampaignLink[]
  // G2 stub completeness: opposite of CampaignLinkProposal.campaign
  // (added by G1 track so the schema validates; G2 owns the semantics).
  linkProposals CampaignLinkProposal[]

  @@index([workspaceId, status])
  @@index([parentCampaignId])
  @@map("growth_campaigns")
}

// First-class link rows with provenance — never a JSON array — so unlinking
// is surgical and auditable.
model CampaignLink {
  id         String         @id @default(cuid()) @map("id")
  campaignId String         @map("campaign_id")
  campaign   GrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  linkedType CampaignLinkedType @map("linked_type")
  linkedId   String             @map("linked_id")

  role       CampaignLinkRole   @default(primary) @map("role")
  linkSource CampaignLinkSource @default(human) @map("link_source")

  // Opaque platform ref — the object never re-models Meta's ad sets or
  // Google's asset groups. { platform, platform_campaign_ref,
  // hierarchy_snapshot, budget_semantics_note }
  platformRef Json? @map("platform_ref")

  linkedAt DateTime @default(now()) @map("linked_at")
  linkedBy String?  @map("linked_by")

  @@unique([campaignId, linkedType, linkedId])
  @@index([campaignId])
  @@index([linkedType, linkedId])
  @@map("campaign_links")
}

// Human review queue for the backfill proposer. Precision over recall:
// proposals never auto-materialize into links.
model CampaignLinkProposal {
  id          String    @id @default(cuid()) @map("id")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String?         @map("campaign_id")
  campaign   GrowthCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  linkedType CampaignLinkedType @map("linked_type")
  linkedId   String             @map("linked_id")

  // [{ signal: name_similarity|utm_campaign|date_proximity|shared_audience|shared_creative,
  //    detail, score }]
  matchSignals Json  @default("[]") @map("match_signals")
  confidence   Float @default(0) @map("confidence")

  status    LinkProposalStatus @default(pending) @map("status")
  decidedBy String?            @map("decided_by")
  decidedAt DateTime?          @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, linkedType, linkedId])
  @@map("campaign_link_proposals")
}

