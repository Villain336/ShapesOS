// Marketr — Prisma data model (spec §6).
// Source of truth: docs/specs/SPEC.md. Milestone 1: schema only, no business logic yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is provided by prisma.config.ts (env DATABASE_URL at runtime);
  // the env() reference below keeps `prisma generate`/`validate` happy
  // on Prisma 6.19, which requires a url key in this block.
  url      = env("DATABASE_URL")
}

enum Plan {
  self_hosted
  // Phase 3: hosted signups start here (DEPLOYMENT_MODE=hosted). Billed-plan
  // behaviour: a small included pool behind a hard cap, read-only for
  // metered actions once Workspace.trialEndsAt passes (lib/billing/trial.ts).
  trial
  starter
  pro
  agency
}

