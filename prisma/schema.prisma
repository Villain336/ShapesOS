  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@map("data_source")
}

// M6 vendor routing + circuit breaker (monthly budget cap per §4.5).
model SerpVendorConfig {
  id                    String             @id @default(cuid()) @map("id")
  workspaceId           String             @map("workspace_id")
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor                SerpVendor         @map("vendor")
  routingRules          Json               @default("{}") @map("routing_rules")
  monthlyBudgetCapCents Int?               @map("monthly_budget_cap_cents")
  status                VendorConfigStatus @default(active) @map("status")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@unique([workspaceId, vendor])
  @@index([workspaceId, status])
  @@map("serp_vendor_config")
}

// M6/M7 cost tracking + billing input. APPEND-ONLY: enforced in app code
// (no UPDATE/DELETE service methods) — same doctrine as mission_events /
// command_audit.
model ApiMeterEntry {
  id          String       @id @default(cuid()) @map("id")
  workspaceId String       @map("workspace_id")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor      String       @map("vendor")
  meter       ApiMeterKind @map("meter")
  quantity    Int          @default(1) @map("quantity")
  costUsd     Decimal      @map("cost_usd") @db.Decimal(12, 6)
  period      String       @map("period") // billing bucket label, e.g. "2026-09"
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([workspaceId, period])
  @@index([workspaceId, vendor, meter, period])
  @@map("api_meter")
}

// M6 volume cache. DELIBERATELY NOT workspace-scoped: per SPEC §4.7 the
// cache is keyed to never leak one tenant's queries to another's reporting
// — cache hits are aggregate-counted (`hits`), never attributed. RLS is
// still enabled + forced with a fail-closed GUC-presence policy guarded by
// nullif(..., ''): this server's custom GUC placeholders yield '' (not NULL)
// after a SET LOCAL transaction commits, and pooled connections get recycled,
// so a bare IS NOT NULL check would leak (see migration
// 20260926123500_phase10_volume_cache_rls_fix).
model VolumeCache {
  id          String   @id @default(cuid()) @map("id")
  keywordHash String   @map("keyword_hash") // sha256 of normalized keyword (+ locale)
  locale      String   @map("locale")
  volumeBand  String   @map("volume_band") // band, never a false-precision point value (e.g. "1K-10K")
  source      String   @map("source")
  fetchedAt   DateTime @map("fetched_at")
  expiresAt   DateTime @map("expires_at") // TTL 30-90 days per §M6 defensive posture
  hits        Int      @default(0) @map("hits") // aggregate hits, not per-tenant

  @@unique([keywordHash, locale])
  @@index([expiresAt])
  @@map("volume_cache")
}

// M1 rank truth store: aggregated GSC rows per window (raw row retention
// policy enforced by M7 sweeps, per §6).
model GscSnapshot {
  id          String         @id @default(cuid()) @map("id")
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String         @map("project_id")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  windowStart DateTime       @map("window_start")
  windowEnd   DateTime       @map("window_end")
  granularity GscGranularity @default(daily) @map("granularity")
  rows        Json           @default("[]") @map("rows") // aggregated query x page x clicks x impressions x position rows
  pulledAt    DateTime       @default(now()) @map("pulled_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([projectId, windowStart, windowEnd, granularity])
  @@index([workspaceId, pulledAt])
  @@map("gsc_snapshot")
}

// M2 platform-change radar: events from official sources.
model PlatformEvent {
  id                       String              @id @default(cuid()) @map("id")
  workspaceId              String              @map("workspace_id")
  workspace                Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source                   PlatformEventSource @map("source")
  eventType                PlatformEventType   @map("event_type")
  title                    String              @map("title")
  startedAt                DateTime?           @map("started_at")
  endedAt                  DateTime?           @map("ended_at")
  url                      String?             @map("url")
  classificationConfidence Float?              @map("classification_confidence")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  pageImpacts PageImpact[]

  @@index([workspaceId, startedAt])
  @@index([source, eventType])
  @@map("platform_event")
}

// M2 correlation output: per-page/per-query deltas around an event.
model PageImpact {
  id               String        @id @default(cuid()) @map("id")
  workspaceId      String        @map("workspace_id")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformEventId  String        @map("platform_event_id")
  platformEvent    PlatformEvent @relation(fields: [platformEventId], references: [id], onDelete: Cascade)
  projectId        String        @map("project_id")
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page             String        @map("page")
  query            String?       @map("query")
  deltaClicks      Int?          @map("delta_clicks")
  deltaImpressions Int?          @map("delta_impressions")
  impactScore      Float?        @map("impact_score")
  confidenceBand   Json?         @map("confidence_band") // [lower, upper] honest band, never a point score
  createdAt        DateTime      @default(now()) @map("created_at")

  @@index([platformEventId, projectId])
  @@index([workspaceId, impactScore])
  @@map("page_impact")
}

// M3: versioned prompt panels per AI engine.
model GeoPromptPanel {
  id               String    @id @default(cuid()) @map("id")
