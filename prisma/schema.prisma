// Phase 3 (accounts): workspace create / rename / delete audit trail.
// Deliberately NOT a foreign key to workspaces: a deleted workspace's
// cascade must not erase the record that it was deleted, by whom, and when.
// Also the source of truth for "has this user already had a hosted trial".
model WorkspaceLifecycleEvent {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  workspaceName String   @map("workspace_name")
  actorUserId   String   @map("actor_user_id")
  // created | renamed | deleted
  action        String
  detail        Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorUserId, action])
  @@map("workspace_lifecycle_events")
}

