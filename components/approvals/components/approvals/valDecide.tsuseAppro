// ShapesOS — the shared "decide an approval" path (approved flat-feed
// redesign: extracted from app/dashboard/approvals/ApprovalsInbox.tsx so the
// approvals inbox and the Home feed's Needs-you rows run the SAME code, not
// two copies).
//
// Each item's approve/deny action points at its own queue's API, which
// re-checks every rule server-side (role, separation of duties, two-person
// approvals, expiry) — this hook only fires the POST the inbox handed us and
// reports the outcome: on success the caller removes the row (onDecided) and
// the sidebar Needs-you count refreshes; on failure nothing changes and the
// person sees why.

"use client";

import { useCallback, useState } from "react";
import { refreshNeedsYouCount } from "@/components/approvals/NeedsYouBadge";
import { decisionToast } from "@/lib/aos/approvals";
import { toast, toastError } from "@/lib/ui/feedback";
import { useI18n } from "@/components/i18n/I18nProvider";
import type { InboxAction, InboxItem } from "@/lib/approvals/types";

export async function runApprovalAction(action: InboxAction): Promise<void> {
  const res = await fetch(action.url, {
    method: action.method,
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(action.body ?? {}),
  });
  if (!res.ok) {
    let message = `Request failed (${res.status}).`;
    try {
      const body = (await res.json()) as { error?: string };
      if (body.error) message = body.error;
    } catch {
      /* keep the status message */
    }
    throw new Error(message);
  }
}

export interface ApprovalDecide {
  /** The row currently deciding (key + which), null when idle. */
  busy: { key: string; which: "approve" | "deny" } | null;
  /**
   * Fire the item's queue action. onDecided runs only after the queue
   * accepted; on failure the row stays and an error toast explains why.
   */
  decide: (item: InboxItem, which: "approve" | "deny", onDecided: (item: InboxItem, which: "approve" | "deny") => void) => Promise<void>;
}

export function useApprovalDecide(): ApprovalDecide {
  const { t } = useI18n();
  const [busy, setBusy] = useState<ApprovalDecide["busy"]>(null);

  const decide = useCallback<ApprovalDecide["decide"]>(
    async (item, which, onDecided) => {
      const action = which === "approve" ? item.approve : item.deny;
      if (!action) return;
      setBusy({ key: item.key, which });
      try {
        await runApprovalAction(action);
        onDecided(item, which);
        toast({ ...decisionToast(item, which), status: "done" });
        refreshNeedsYouCount();
      } catch (e) {
        toastError(
          which === "approve" ? t("approvals.couldNotApprove") : t("approvals.couldNotDeny"),
          e instanceof Error ? e.message : t("approvals.decisionFailed"),
        );
      } finally {
        setBusy(null);
      }
    },
    [t],
  );

  return { busy, decide };
       }
